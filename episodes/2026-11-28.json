 "transcript": [
  {
   "start": 5.5,
   "end": 6.54,
   "text": "Goedemorgen.",
   "chapter": 0
  },
  {
   "start": 6.54,
   "end": 8.98,
   "text": "Het is zaterdag achtentwintig november.",
   "chapter": 0
  },
  {
   "start": 8.98,
   "end": 13.42,
   "text": "U luistert naar Grondstof, het circulaire nieuwsbulletin van De Graaf Groep.",
   "chapter": 0
  },
  {
   "start": 13.42,
   "end": 14.98,
   "text": "Ik ben Frans van den Berge.",
   "chapter": 0
  },
  {
   "start": 14.98,
   "end": 16.3,
   "text": "Dit zijn de koppen.",
   "chapter": 0
  },
  {
   "start": 16.3,
   "end": 21.14,
   "text": "Brussel stelt de lijst uit met landen die nog Europees metaalschroot mogen ontvangen.",
   "chapter": 0
  },
  {
   "start": 21.14,
   "end": 26.06,
   "text": "Duitsland voert fors minder oud papier uit, en vooral minder naar Nederland.",
   "chapter": 0
  },
  {
   "start": 26.06,
   "end": 30.63,
   "text": "En in Duitsland komt een fabriek die magneten met zeldzame aardmetalen terugwint.",
   "chapter": 0
  },
  {
   "start": 32.97,
   "end": 39.96,
   "text": "De Europese Commissie heeft de lijst uitgesteld met landen die straks nog metaalafval uit de Europese Unie mogen ontvangen.",
   "chapter": 1
  },
  {
   "start": 39.96,
   "end": 42.12,
   "text": "Dat meldt Recycling Magazine.",
   "chapter": 1
  },
  {
   "start": 42.12,
   "end": 47.24,
   "text": "De lijst zou op twintig november verschijnen, maar komt nu naar verwachting eind dit jaar.",
   "chapter": 1
  },
  {
   "start": 47.24,
   "end": 51.48,
   "text": "Het gaat om landen buiten de Oeso, de organisatie van industrielanden.",
   "chapter": 1
  },
  {
   "start": 51.48,
   "end": 58.68,
   "text": "De lijst hoort bij de herziene Europese regels voor afvaltransport, die op eenentwintig mei tweeduizend zevenentwintig ingaan.",
   "chapter": 1
  },
  {
   "start": 58.68,
   "end": 64.68,
   "text": "In het ontwerp van september vallen onder meer India, Indonesië, Pakistan en Vietnam af.",
   "chapter": 1
  },
  {
   "start": 64.68,
   "end": 70.76,
   "text": "Volgens de Metaal Recycling Federatie heeft de Commissie meer tijd nodig om de vele kritiek te verwerken.",
   "chapter": 1
  },
  {
   "start": 70.76,
   "end": 73.64,
   "text": "Staalproducenten willen schroot in Europa houden.",
   "chapter": 1
  },
  {
   "start": 73.64,
   "end": 77.8,
   "text": "Recyclers stellen dat de Europese vraag te klein is voor het aanbod.",
   "chapter": 1
  },
  {
   "start": 77.8,
   "end": 82.29,
   "text": "Ook Egypte vraagt Brussel de uitsluiting te heroverwegen, meldt vakblad Euwid.",
   "chapter": 1
  },
  {
   "start": 84.62,
   "end": 88.38,
   "text": "Duitsland heeft dit jaar fors minder oud papier uitgevoerd.",
   "chapter": 2
  },
  {
   "start": 88.38,
   "end": 95.1,
   "text": "In de eerste negen maanden daalde de export met twaalf procent, tot ongeveer negenhonderdnegentigduizend ton.",
   "chapter": 2
  },
  {
   "start": 95.1,
   "end": 99.9,
   "text": "Dat meldt vakblad Euwid op basis van cijfers van het Duitse statistiekbureau.",
   "chapter": 2
  },
  {
   "start": 99.9,
   "end": 106.22,
   "text": "Houdt dat tempo aan, dan komt de uitvoer over heel dit jaar uit op ongeveer één komma drie miljoen ton.",
   "chapter": 2
  },
  {
   "start": 106.22,
   "end": 113.58,
   "text": "Daarmee zou de export voor het eerst sinds het begin van de metingen in tweeduizend zes onder de één komma vier miljoen ton blijven.",
   "chapter": 2
  },
  {
   "start": 113.58,
   "end": 116.38,
   "text": "De grootste daling in tonnen zit bij Nederland.",
   "chapter": 2
  },
  {
   "start": 116.38,
   "end": 122.62,
   "text": "Daar ging tweehonderdzeventienduizend ton naartoe, ongeveer zestigduizend ton minder dan een jaar eerder.",
   "chapter": 2
  },
  {
   "start": 122.62,
   "end": 130.12,
   "text": "In Italië blijft de vraag uit Azië naar oud karton intussen levendig, en betaalden sommige fabrieken in november een paar euro meer.",
   "chapter": 2
  },
  {
   "start": 132.46,
   "end": 141.33,
   "text": "Het Canadese Cyclic Materials wil in Duitsland zijn eerste Europese fabriek bouwen voor het terugwinnen van magneten met zeldzame aardmetalen.",
   "chapter": 3
  },
  {
   "start": 141.33,
   "end": 148.21,
   "text": "Het bedrijf heeft daarvoor grond gereserveerd op het industriepark van Dow in Schkopau, zo maakte het donderdag bekend.",
   "chapter": 3
  },
  {
   "start": 148.21,
   "end": 156.61,
   "text": "De fabriek moet per jaar vijfentwintigduizend ton afgedankte producten verwerken, zoals elektromotoren, harde schijven en drones.",
   "chapter": 3
  },
  {
   "start": 156.61,
   "end": 159.89,
   "text": "Een geautomatiseerd proces haalt de magneten eruit.",
   "chapter": 3
  },
  {
   "start": 159.89,
   "end": 172.13,
   "text": "Dat levert volgens het bedrijf jaarlijks ongeveer zevenhonderdvijftig ton magneetmateriaal op, naast veertienduizend ton staal, vierduizend zeshonderd ton aluminium en drieduizend ton koper.",
   "chapter": 3
  },
  {
   "start": 172.13,
   "end": 179.65,
   "text": "Samen met latere vestigingen wil Cyclic Materials tot vijftien procent van de Europese vraag naar zeldzame aardmetalen dekken.",
   "chapter": 3
  },
  {
   "start": 179.65,
   "end": 182.99,
   "text": "Een investeringsbedrag en een startdatum noemt het bedrijf niet.",
   "chapter": 3
  },
  {
   "start": 185.32,
   "end": 190.68,
   "text": "Vijftien producenten laten zien hoe zij hergebruik en reparatie in de praktijk brengen.",
   "chapter": 4
  },
  {
   "start": 190.68,
   "end": 198.28,
   "text": "Dat doen zij in de tweede editie van het boek Circulaire Pioniers van Stichting Open, meldt Recycling Magazine deze week.",
   "chapter": 4
  },
  {
   "start": 198.28,
   "end": 205.32,
   "text": "In het boek krijgen keukenapparaten een tweede leven en worden bruikbare onderdelen uit koelmeubels opnieuw ingezet.",
   "chapter": 4
  },
  {
   "start": 205.32,
   "end": 212.2,
   "text": "Warmtepompen worden geschikt gemaakt voor hergebruik, en verlichting wordt vernieuwd zonder het hele armatuur te vervangen.",
   "chapter": 4
  },
  {
   "start": 212.2,
   "end": 215.96,
   "text": "Volgens de stichting gaat circulariteit verder dan recycling.",
   "chapter": 4
  },
  {
   "start": 215.96,
   "end": 218.04,
   "text": "Zij benoemt ook de drempels.",
   "chapter": 4
  },
  {
   "start": 218.04,
   "end": 224.12,
   "text": "Circulaire oplossingen vragen investeringen in techniek, retourstromen en nieuwe verdienmodellen.",
   "chapter": 4
  },
  {
   "start": 224.12,
   "end": 227.48,
   "text": "Hergebruikte producten moeten kunnen concurreren met nieuwe.",
   "chapter": 4
  },
  {
   "start": 227.48,
   "end": 230.88,
   "text": "En regelgeving moet daarvoor voldoende ruimte laten.",
   "chapter": 4
  },
  {
   "start": 230.88,
   "end": 237.76,
   "text": "Samenwerking tussen producenten, importeurs en overheid noemt de stichting onmisbaar om goede voorbeelden op te schalen.",
   "chapter": 4
  },
  {
   "start": 240.1,
   "end": 243.06,
   "text": "En wat betekent dit voor uw organisatie?",
   "chapter": 5
  },
  {
   "start": 243.06,
   "end": 247.3,
   "text": "Het nieuws van vandaag laat zien hoe sterk grondstoffen aan grenzen hangen.",
   "chapter": 5
  },
  {
   "start": 247.3,
   "end": 252.9,
   "text": "Waar schroot en oud papier naartoe mogen, bepaalt mede wat uw afval opbrengt of kost.",
   "chapter": 5
  },
  {
   "start": 252.9,
   "end": 258.74,
   "text": "Bij De Graaf Groep zien we dat schone, goed gescheiden stromen het minst gevoelig zijn voor zulke schommelingen.",
   "chapter": 5
  },
  {
   "start": 258.74,
   "end": 261.06,
   "text": "Het tweede punt is hergebruik.",
   "chapter": 5
  },
  {
   "start": 261.06,
   "end": 267.14,
   "text": "Vraag bij de vervanging van apparatuur, verlichting of keukeninrichting eerst of revisie mogelijk is.",
   "chapter": 5
  },
  {
   "start": 267.14,
   "end": 271.65,
   "text": "En leg bij aankoop vast wat de leverancier aan het einde van de levensduur terugneemt.",
   "chapter": 5
  },
  {
   "start": 272.1,
   "end": 275.82,
   "text": "Het cijfer van de dag is één komma drie miljoen ton.",
   "chapter": 6
  },
  {
   "start": 275.82,
   "end": 282.42,
   "text": "Zoveel oud papier voert Duitsland dit jaar naar verwachting uit, als het tempo van de eerste negen maanden aanhoudt.",
   "chapter": 6
  },
  {
   "start": 282.42,
   "end": 285.52,
   "text": "Dat zou het laagste jaarcijfer zijn sinds tweeduizend zes.",
   "chapter": 6
  },
  {
   "start": 285.97,
   "end": 288.29,
   "text": "Dat was Grondstof voor vandaag.",
   "chapter": 7
  },
  {
   "start": 288.29,
   "end": 291.97,
   "text": "De bronnen bij elk bericht vindt u in de app en in de shownotes.",
   "chapter": 7
  },
  {
   "start": 291.97,
   "end": 294.29,
   "text": "Morgen om negen uur bent u weer bij.",
   "chapter": 7
  },
  {
   "start": 294.29,
   "end": 294.85,
   "text": "Tot dan.",
   "chapter": 7
  }
 ],
