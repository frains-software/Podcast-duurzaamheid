 "transcript": [
  {
   "start": 5.5,
   "end": 6.62,
   "text": "Goedemorgen.",
   "chapter": 0
  },
  {
   "start": 6.62,
   "end": 8.9,
   "text": "Het is zaterdag zeven november.",
   "chapter": 0
  },
  {
   "start": 8.9,
   "end": 13.34,
   "text": "U luistert naar Grondstof, het circulaire nieuwsbulletin van De Graaf Groep.",
   "chapter": 0
  },
  {
   "start": 13.34,
   "end": 14.91,
   "text": "Ik ben Frans van den Berge.",
   "chapter": 0
  },
  {
   "start": 14.91,
   "end": 16.38,
   "text": "Dit zijn de koppen.",
   "chapter": 0
  },
  {
   "start": 16.38,
   "end": 20.82,
   "text": "Brussel stelt de Europese Circular Economy Act opnieuw uit.",
   "chapter": 0
  },
  {
   "start": 20.82,
   "end": 25.26,
   "text": "In de strijd om afvalgroep G-F-L loopt maandag een deadline af.",
   "chapter": 0
  },
  {
   "start": 25.26,
   "end": 29.19,
   "text": "En in Zeewolde is het restafval met bijna zestig procent gedaald.",
   "chapter": 0
  },
  {
   "start": 31.53,
   "end": 36.46,
   "text": "De Europese Commissie stelt de presentatie van de Circular Economy Act uit.",
   "chapter": 1
  },
  {
   "start": 36.46,
   "end": 39.82,
   "text": "Dat meldt vakblad Euwid op vrijdag zes november.",
   "chapter": 1
  },
  {
   "start": 39.82,
   "end": 43.82,
   "text": "De Commissie wil het wetsvoorstel nu op twee december presenteren.",
   "chapter": 1
  },
  {
   "start": 43.82,
   "end": 46.3,
   "text": "Eerder was achttien november genoemd.",
   "chapter": 1
  },
  {
   "start": 46.3,
   "end": 49.74,
   "text": "Oorspronkelijk stond het voorstel voor september gepland.",
   "chapter": 1
  },
  {
   "start": 49.74,
   "end": 55.18,
   "text": "De reden is dat de toetsingsraad van de Commissie tekortkomingen zag in de effectbeoordeling.",
   "chapter": 1
  },
  {
   "start": 55.18,
   "end": 61.58,
   "text": "Het voorstel moet onder meer de systemen voor uitgebreide producentenverantwoordelijkheid beter op elkaar afstemmen.",
   "chapter": 1
  },
  {
   "start": 61.58,
   "end": 66.3,
   "text": "Ook worden gelijke definities en een gelijke indeling van afval verwacht.",
   "chapter": 1
  },
  {
   "start": 66.3,
   "end": 70.7,
   "text": "Daarnaast zijn wijzigingen van de richtlijn voor elektronisch afval te verwachten.",
   "chapter": 1
  },
  {
   "start": 70.7,
   "end": 76.45,
   "text": "Het doet ertoe, omdat deze regels straks bepalen hoe uw afvalstromen in heel Europa worden behandeld.",
   "chapter": 1
  },
  {
   "start": 78.78,
   "end": 86.12,
   "text": "Potentiële kopers van de Canadese afvalgroep G-F-L Environmental hebben tot maandag negen november de tijd.",
   "chapter": 2
  },
  {
   "start": 86.12,
   "end": 90.52,
   "text": "Dan moeten zij bijgewerkte voorstellen indienen om het bedrijf van de beurs te halen.",
   "chapter": 2
  },
  {
   "start": 90.52,
   "end": 92.04,
   "text": "Dat meldt Euwid.",
   "chapter": 2
  },
  {
   "start": 92.04,
   "end": 96.28,
   "text": "Volgens berichten zijn twee consortia van investeerders onder de bieders.",
   "chapter": 2
  },
  {
   "start": 96.28,
   "end": 102.44,
   "text": "G-F-L maakte de overnamebenaderingen voor het eerst bekend bij de kwartaalcijfers van negenentwintig juli.",
   "chapter": 2
  },
  {
   "start": 102.44,
   "end": 108.04,
   "text": "Het bedrijf stelde toen een comité van onafhankelijke bestuurders in om de gesprekken te begeleiden.",
   "chapter": 2
  },
  {
   "start": 108.04,
   "end": 113.8,
   "text": "G-F-L noemt zichzelf de vierde grootste diversifieerde milieudienstverlener van Noord-Amerika.",
   "chapter": 2
  },
  {
   "start": 113.8,
   "end": 117.16,
   "text": "Over bedragen is in de beschikbare bron niets vermeld.",
   "chapter": 2
  },
  {
   "start": 117.16,
   "end": 122.83,
   "text": "Het doet ertoe, omdat investeerders de afvalsector blijven zien als een aantrekkelijke en stabiele markt.",
   "chapter": 2
  },
  {
   "start": 125.17,
   "end": 130.85,
   "text": "Europees commissaris Jessika Roswall heeft duidelijkheid gegeven over herbruikbare verpakkingen.",
   "chapter": 3
  },
  {
   "start": 130.85,
   "end": 133.65,
   "text": "Dat meldt Packaging Europe op drie november.",
   "chapter": 3
  },
  {
   "start": 133.65,
   "end": 137.97,
   "text": "Zij antwoordde op vragen van Europarlementariër Marcin Sypniewski.",
   "chapter": 3
  },
  {
   "start": 137.97,
   "end": 143.25,
   "text": "Verpakkingen die op de markt komen voordat de nieuwe labeleisen gelden, mogen in omloop blijven.",
   "chapter": 3
  },
  {
   "start": 143.25,
   "end": 145.57,
   "text": "Ze hoeven niet opnieuw ontworpen te worden.",
   "chapter": 3
  },
  {
   "start": 145.57,
   "end": 152.37,
   "text": "Bestaande hergebruiksystemen gelden als conform, zolang ze voldoen aan de eisen in de Europese verpakkingsverordening.",
   "chapter": 3
  },
  {
   "start": 152.37,
   "end": 156.85,
   "text": "De nieuwe labelregels gaan vierentwintig maanden na inwerkingtreding gelden.",
   "chapter": 3
  },
  {
   "start": 156.85,
   "end": 162.77,
   "text": "Een aparte uitvoeringsregel bepaalt welke gegevens nodig zijn om het aantal omlopen te berekenen.",
   "chapter": 3
  },
  {
   "start": 162.77,
   "end": 169.91,
   "text": "Het doet ertoe voor bedrijven met kratten, glazen flessen of vaten, want zij hoeven hun bestaande systemen niet meteen aan te passen.",
   "chapter": 3
  },
  {
   "start": 172.24,
   "end": 178.32,
   "text": "In Zeewolde is de hoeveelheid restafval sinds het recycletarief bijna zestig procent gedaald.",
   "chapter": 4
  },
  {
   "start": 178.32,
   "end": 181.84,
   "text": "Dat meldt Zeewolde Actueel op donderdag vijf november.",
   "chapter": 4
  },
  {
   "start": 181.84,
   "end": 187.2,
   "text": "Het vergelijkt de eerste maanden van tweeduizend zesentwintig met dezelfde periode vorig jaar.",
   "chapter": 4
  },
  {
   "start": 187.2,
   "end": 189.52,
   "text": "Daardoor komt er minder geld binnen.",
   "chapter": 4
  },
  {
   "start": 189.52,
   "end": 198.08,
   "text": "Het vaste deel van de afvalstoffenheffing stijgt in tweeduizend zevenentwintig van ruim driehonderdnegentien naar ruim driehonderdzevenenveertig euro.",
   "chapter": 4
  },
  {
   "start": 198.08,
   "end": 203.36,
   "text": "Het college wil de stijging beperken met vierhonderdduizend euro uit de algemene reserve.",
   "chapter": 4
  },
  {
   "start": 203.36,
   "end": 205.84,
   "text": "De raad beslist op zeventien december.",
   "chapter": 4
  },
  {
   "start": 205.84,
   "end": 210.96,
   "text": "Het doet ertoe, omdat succesvolle afvalscheiding de inkomsten van gemeenten onder druk zet.",
   "chapter": 4
  },
  {
   "start": 210.96,
   "end": 213.27,
   "text": "Dat speelt ook bij andere gemeenten met diftar.",
   "chapter": 4
  },
  {
   "start": 215.61,
   "end": 218.57,
   "text": "En wat betekent dit voor uw organisatie?",
   "chapter": 5
  },
  {
   "start": 218.57,
   "end": 222.89,
   "text": "Het uitstel in Brussel geeft u even lucht, maar de richting ligt vast.",
   "chapter": 5
  },
  {
   "start": 222.89,
   "end": 227.69,
   "text": "Producentenverantwoordelijkheid en afvaldefinities worden Europees geharmoniseerd.",
   "chapter": 5
  },
  {
   "start": 227.69,
   "end": 231.93,
   "text": "Breng daarom nu in kaart welke afvalstromen u heeft en wat die kosten.",
   "chapter": 5
  },
  {
   "start": 231.93,
   "end": 237.93,
   "text": "Bij De Graaf Groep zien we dat bedrijven met goede scheiding aan de bron het snelst kunnen inspelen op nieuwe regels.",
   "chapter": 5
  },
  {
   "start": 237.93,
   "end": 241.21,
   "text": "Gebruikt u herbruikbare kratten, bekers of flessen?",
   "chapter": 5
  },
  {
   "start": 241.21,
   "end": 243.85,
   "text": "Dan is de duidelijkheid uit Brussel goed nieuws.",
   "chapter": 5
  },
  {
   "start": 243.85,
   "end": 249.74,
   "text": "Het voorbeeld uit Zeewolde laat ten slotte zien dat scheiden loont, maar dat de tarieven kunnen veranderen.",
   "chapter": 5
  },
  {
   "start": 249.74,
   "end": 251.69,
   "text": "Houd daar rekening mee in uw begroting.",
   "chapter": 5
  },
  {
   "start": 252.14,
   "end": 255.42,
   "text": "Het cijfer van de dag is bijna zestig procent.",
   "chapter": 6
  },
  {
   "start": 255.42,
   "end": 262.3,
   "text": "Zoveel minder restafval leverde Zeewolde in met het recycletarief, vergeleken met dezelfde periode vorig jaar.",
   "chapter": 6
  },
  {
   "start": 262.3,
   "end": 265.8,
   "text": "Het laat zien dat een prikkel in het tarief gedrag snel verandert.",
   "chapter": 6
  },
  {
   "start": 266.25,
   "end": 268.57,
   "text": "Dat was Grondstof voor vandaag.",
   "chapter": 7
  },
  {
   "start": 268.57,
   "end": 272.25,
   "text": "De bronnen bij elk bericht vindt u in de app en in de shownotes.",
   "chapter": 7
  },
  {
   "start": 272.25,
   "end": 274.57,
   "text": "Morgen om negen uur bent u weer bij.",
   "chapter": 7
  },
  {
   "start": 274.57,
   "end": 275.01,
   "text": "Tot dan.",
   "chapter": 7
  }
 ],
