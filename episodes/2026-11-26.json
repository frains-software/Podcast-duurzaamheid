 "transcript": [
  {
   "start": 5.5,
   "end": 6.54,
   "text": "Goedemorgen.",
   "chapter": 0
  },
  {
   "start": 6.54,
   "end": 9.18,
   "text": "Het is donderdag zesentwintig november.",
   "chapter": 0
  },
  {
   "start": 9.18,
   "end": 13.5,
   "text": "U luistert naar Grondstof, het circulaire nieuwsbulletin van De Graaf Groep.",
   "chapter": 0
  },
  {
   "start": 13.5,
   "end": 15.02,
   "text": "Ik ben Frans van den Berge.",
   "chapter": 0
  },
  {
   "start": 15.02,
   "end": 17.02,
   "text": "Dit zijn de koppen.",
   "chapter": 0
  },
  {
   "start": 17.02,
   "end": 23.26,
   "text": "Brussel geeft bedrijven acht maanden langer de tijd voor digitale documenten bij afvaltransport.",
   "chapter": 0
  },
  {
   "start": 23.26,
   "end": 30.54,
   "text": "De Europese CO-twee-grensheffing kost Nederlandse importeurs honderdeenentwintig miljoen euro in een halfjaar.",
   "chapter": 0
  },
  {
   "start": 30.54,
   "end": 35.22,
   "text": "En twee op de drie bedrijven gooien papier en karton nog bij het restafval.",
   "chapter": 0
  },
  {
   "start": 37.56,
   "end": 45.0,
   "text": "Bedrijven die afval voor recycling over de grens vervoeren, krijgen meer tijd om over te stappen op digitale documenten.",
   "chapter": 1
  },
  {
   "start": 45.0,
   "end": 47.96,
   "text": "Dat meldt het Britse vakblad Letsrecycle.",
   "chapter": 1
  },
  {
   "start": 47.96,
   "end": 54.88,
   "text": "De Europese Commissie verschuift de verplichting van één januari naar één september tweeduizend zevenentwintig.",
   "chapter": 1
  },
  {
   "start": 54.88,
   "end": 58.92,
   "text": "Daarover is gisteren in een speciaal overleg overeenstemming bereikt.",
   "chapter": 1
  },
  {
   "start": 58.92,
   "end": 66.44,
   "text": "Het gaat om het formulier dat meereist met niet-gevaarlijk afval, zoals oud papier, metalen en de meeste kunststoffen.",
   "chapter": 1
  },
  {
   "start": 66.44,
   "end": 72.68,
   "text": "Dat formulier moet straks via Diwass lopen, het Europese digitale systeem voor afvaltransporten.",
   "chapter": 1
  },
  {
   "start": 72.68,
   "end": 77.08,
   "text": "Overheden en bedrijven betwijfelden of zij op tijd klaar zouden zijn.",
   "chapter": 1
  },
  {
   "start": 77.08,
   "end": 84.34,
   "text": "Voor transporten waarvoor vooraf toestemming nodig is, zoals gevaarlijk afval, is het systeem al sinds eenentwintig mei verplicht.",
   "chapter": 1
  },
  {
   "start": 86.67,
   "end": 95.63,
   "text": "De Europese CO-twee-grensheffing heeft Nederlandse bedrijven in de eerste helft van dit jaar naar schatting honderdeenentwintig miljoen euro gekost.",
   "chapter": 2
  },
  {
   "start": 95.63,
   "end": 101.55,
   "text": "Dat blijkt uit voorlopige cijfers van het CBS, in de nieuwe Internationaliseringsmonitor.",
   "chapter": 2
  },
  {
   "start": 101.55,
   "end": 103.95,
   "text": "De heffing geldt sinds één januari.",
   "chapter": 2
  },
  {
   "start": 103.95,
   "end": 110.43,
   "text": "Importeurs betalen voor de uitstoot die vrijkomt bij de productie van bepaalde goederen buiten de Europese Unie.",
   "chapter": 2
  },
  {
   "start": 110.43,
   "end": 115.87,
   "text": "Het grootste deel van de kosten komt van ijzer en staal: ruim drieënnegentig miljoen euro.",
   "chapter": 2
  },
  {
   "start": 115.87,
   "end": 119.07,
   "text": "Aluminium volgt met bijna tweeëntwintig miljoen.",
   "chapter": 2
  },
  {
   "start": 119.07,
   "end": 122.51,
   "text": "Ruim elfduizend bedrijven voerden zulke goederen in.",
   "chapter": 2
  },
  {
   "start": 122.51,
   "end": 128.43,
   "text": "De invoer daalde in gewicht met bijna zeventien procent, tot bijna één komma één miljoen ton.",
   "chapter": 2
  },
  {
   "start": 128.43,
   "end": 131.07,
   "text": "Er kwam vooral minder ijzer en staal binnen.",
   "chapter": 2
  },
  {
   "start": 131.07,
   "end": 133.05,
   "text": "De invoer van aluminium nam juist toe.",
   "chapter": 2
  },
  {
   "start": 135.39,
   "end": 142.27,
   "text": "Het Amerikaanse bedrijf Alterra wil een grote fabriek voor chemische recycling bouwen in het Amsterdamse havengebied.",
   "chapter": 3
  },
  {
   "start": 142.27,
   "end": 144.83,
   "text": "Dat meldt Duurzaam Ondernemen.",
   "chapter": 3
  },
  {
   "start": 144.83,
   "end": 149.07,
   "text": "Alterra onderzoekt daarnaast een tweede locatie in de regio Rotterdam.",
   "chapter": 3
  },
  {
   "start": 149.07,
   "end": 152.51,
   "text": "Een definitief besluit over de bouw is er nog niet.",
   "chapter": 3
  },
  {
   "start": 152.51,
   "end": 161.15,
   "text": "Voor de plannen neemt Alterra de ontwikkelactiviteiten over van het Nederlandse Pryme, met het team en de rechten op een fabriekslocatie in de haven.",
   "chapter": 3
  },
  {
   "start": 161.15,
   "end": 164.19,
   "text": "Pryme blijft als zelfstandig bedrijf bestaan.",
   "chapter": 3
  },
  {
   "start": 164.19,
   "end": 169.87,
   "text": "Alterra zet afgedankt plastic met hitte om in een vloeibare grondstof voor nieuw plastic.",
   "chapter": 3
  },
  {
   "start": 169.87,
   "end": 177.39,
   "text": "Die techniek draait volgens het bedrijf al ruim vijf jaar op commerciële schaal in Akron, in de Amerikaanse staat Ohio.",
   "chapter": 3
  },
  {
   "start": 177.39,
   "end": 184.64,
   "text": "Alterra wijst op de Europese verpakkingsverordening, die vanaf tweeduizend dertig een aandeel gerecycled plastic in verpakkingen eist.",
   "chapter": 3
  },
  {
   "start": 186.97,
   "end": 193.85,
   "text": "Bij twee op de drie bedrijfslocaties waar restafval wordt opgehaald, gaat papier en karton nog niet apart mee.",
   "chapter": 4
  },
  {
   "start": 193.85,
   "end": 198.81,
   "text": "Dat schrijft Recycling Magazine, op basis van onderzoek van Milieu Service Nederland.",
   "chapter": 4
  },
  {
   "start": 198.81,
   "end": 202.49,
   "text": "Het bedrijf bekeek zesendertigduizend locaties in Nederland.",
   "chapter": 4
  },
  {
   "start": 202.49,
   "end": 207.45,
   "text": "Op vijfentwintigduizend daarvan werd papier en karton niet gescheiden ingezameld.",
   "chapter": 4
  },
  {
   "start": 207.45,
   "end": 209.05,
   "text": "Het kost bedrijven geld.",
   "chapter": 4
  },
  {
   "start": 209.05,
   "end": 219.73,
   "text": "Een kantoor met een standaard restafvalcontainer van zeshonderdzestig liter bespaart volgens het onderzoek ongeveer achttien procent op de ledigingskosten als papier en karton eruit blijven.",
   "chapter": 4
  },
  {
   "start": 219.73,
   "end": 222.97,
   "text": "De verwerking van restafval wordt bovendien steeds duurder.",
   "chapter": 4
  },
  {
   "start": 222.97,
   "end": 228.69,
   "text": "Commercieel directeur Dennis Ostendorf noemt papier en karton een van de makkelijkste stromen om te scheiden.",
   "chapter": 4
  },
  {
   "start": 231.03,
   "end": 233.91,
   "text": "En wat betekent dit voor uw organisatie?",
   "chapter": 5
  },
  {
   "start": 233.91,
   "end": 238.55,
   "text": "Het eerste is dat kosten steeds vaker aan grondstoffen en uitstoot hangen.",
   "chapter": 5
  },
  {
   "start": 238.55,
   "end": 243.11,
   "text": "De grensheffing maakt de herkomst van staal en aluminium een financiële post.",
   "chapter": 5
  },
  {
   "start": 243.11,
   "end": 246.95,
   "text": "Vraag uw leveranciers daarom naar de uitstoot achter hun materiaal.",
   "chapter": 5
  },
  {
   "start": 246.95,
   "end": 249.03,
   "text": "Het tweede ligt dichter bij huis.",
   "chapter": 5
  },
  {
   "start": 249.03,
   "end": 253.35,
   "text": "Papier en karton scheiden is de eenvoudigste stap naar minder restafval.",
   "chapter": 5
  },
  {
   "start": 253.35,
   "end": 258.95,
   "text": "Bij De Graaf Groep zien we dat een aparte bak bij de printer en in het magazijn vaak al veel oplevert.",
   "chapter": 5
  },
  {
   "start": 258.95,
   "end": 264.57,
   "text": "Vervoert u zelf afval over de grens, gebruik dan de extra maanden om het digitale systeem te testen.",
   "chapter": 5
  },
  {
   "start": 265.02,
   "end": 268.46,
   "text": "Het cijfer van de dag is vijfentwintigduizend.",
   "chapter": 6
  },
  {
   "start": 268.46,
   "end": 277.18,
   "text": "Op zoveel bedrijfslocaties, van de zesendertigduizend die Milieu Service Nederland onderzocht, wordt papier en karton niet apart ingezameld.",
   "chapter": 6
  },
  {
   "start": 277.18,
   "end": 278.95,
   "text": "Dat is ruim twee op de drie.",
   "chapter": 6
  },
  {
   "start": 279.4,
   "end": 281.8,
   "text": "Dat was Grondstof voor vandaag.",
   "chapter": 7
  },
  {
   "start": 281.8,
   "end": 285.48,
   "text": "De bronnen bij elk bericht vindt u in de app en in de shownotes.",
   "chapter": 7
  },
  {
   "start": 285.48,
   "end": 287.8,
   "text": "Morgen om negen uur bent u weer bij.",
   "chapter": 7
  },
  {
   "start": 287.8,
   "end": 288.28,
   "text": "Tot dan.",
   "chapter": 7
  }
 ],
