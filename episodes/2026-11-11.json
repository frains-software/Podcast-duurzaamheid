 "transcript": [
  {
   "start": 5.5,
   "end": 6.38,
   "text": "Goedemorgen.",
   "chapter": 0
  },
  {
   "start": 6.38,
   "end": 8.42,
   "text": "Het is woensdag elf november.",
   "chapter": 0
  },
  {
   "start": 8.42,
   "end": 12.78,
   "text": "U luistert naar Grondstof, het circulaire nieuwsbulletin van De Graaf Groep.",
   "chapter": 0
  },
  {
   "start": 12.78,
   "end": 14.38,
   "text": "Ik ben Frans van den Berge.",
   "chapter": 0
  },
  {
   "start": 14.38,
   "end": 15.82,
   "text": "Dit zijn de koppen.",
   "chapter": 0
  },
  {
   "start": 15.82,
   "end": 22.06,
   "text": "Het Canadese afvalconcern G-F-L wijst alle overnamebiedingen af en blijft zelfstandig.",
   "chapter": 0
  },
  {
   "start": 22.06,
   "end": 26.66,
   "text": "De prijsdaling van gerecycled P-E-T lijkt tot stilstand te komen.",
   "chapter": 0
  },
  {
   "start": 26.66,
   "end": 31.95,
   "text": "En camera's op vuilniswagens laten zien hoeveel recyclebaar materiaal er in bedrijfsafval zit.",
   "chapter": 0
  },
  {
   "start": 34.29,
   "end": 40.13,
   "text": "Het Canadese afvalconcern G-F-L Environmental wijst alle overnamebiedingen af.",
   "chapter": 1
  },
  {
   "start": 40.13,
   "end": 43.41,
   "text": "Dat maakte het bedrijf dinsdag bekend, meldt Bloomberg.",
   "chapter": 1
  },
  {
   "start": 43.41,
   "end": 50.21,
   "text": "Een consortium van Blackstone, K-K-R en Energy Capital Partners bood tweeënvijftig dollar per aandeel.",
   "chapter": 1
  },
  {
   "start": 50.21,
   "end": 53.81,
   "text": "Dat waardeerde het bedrijf op meer dan tweeëntwintig miljard dollar.",
   "chapter": 1
  },
  {
   "start": 53.81,
   "end": 57.41,
   "text": "Ook Brookfield en I-F-M Investors toonden interesse.",
   "chapter": 1
  },
  {
   "start": 57.41,
   "end": 63.73,
   "text": "Een commissie van onafhankelijke bestuurders vond dat de biedingen de waarde van de eigen strategie niet weerspiegelen.",
   "chapter": 1
  },
  {
   "start": 63.73,
   "end": 67.97,
   "text": "Het bestuur wilde volgens berichten minstens achtenvijftig dollar per aandeel.",
   "chapter": 1
  },
  {
   "start": 67.97,
   "end": 71.33,
   "text": "Het aandeel daalde dinsdag ongeveer veertien procent.",
   "chapter": 1
  },
  {
   "start": 71.33,
   "end": 75.81,
   "text": "G-F-L verwacht de vrije kasstroom per aandeel in vijf jaar te verdubbelen.",
   "chapter": 1
  },
  {
   "start": 75.81,
   "end": 79.89,
   "text": "Dat moet ruimte geven voor overnames en de inkoop van eigen aandelen.",
   "chapter": 1
  },
  {
   "start": 79.89,
   "end": 84.39,
   "text": "De vraag hoeveel een grote afvalinzamelaar waard is, blijft dus onbeslist.",
   "chapter": 1
  },
  {
   "start": 86.73,
   "end": 91.53,
   "text": "De Duitse markt voor gerecycled P-E-T is in oktober gestabiliseerd.",
   "chapter": 2
  },
  {
   "start": 91.53,
   "end": 93.77,
   "text": "Dat meldt het vakblad Euwid.",
   "chapter": 2
  },
  {
   "start": 93.77,
   "end": 98.81,
   "text": "Heldere P-E-T-vlokken werden meestal twintig tot veertig euro per ton goedkoper.",
   "chapter": 2
  },
  {
   "start": 98.81,
   "end": 101.69,
   "text": "Dat is veel minder dan in de maanden ervoor.",
   "chapter": 2
  },
  {
   "start": 101.69,
   "end": 106.81,
   "text": "De prijs ligt nu meestal tussen tienhonderdtwintig en tienhonderdvijftig euro per ton.",
   "chapter": 2
  },
  {
   "start": 106.81,
   "end": 111.85,
   "text": "Nieuw P-E-T kost meestal dertienhonderd tot dertienhonderdvijftig euro per ton.",
   "chapter": 2
  },
  {
   "start": 111.85,
   "end": 116.09,
   "text": "Het verschil met gerecycled materiaal is daardoor groter geworden.",
   "chapter": 2
  },
  {
   "start": 116.09,
   "end": 121.05,
   "text": "Volgens Euwid vragen fles- en folieproducenten weer goed tot zeer goed af.",
   "chapter": 2
  },
  {
   "start": 121.05,
   "end": 125.69,
   "text": "Ook de vraag naar gekleurde vlokken uit de verpakkingsbandindustrie is gestegen.",
   "chapter": 2
  },
  {
   "start": 125.69,
   "end": 129.53,
   "text": "De prijsdaling sinds de zomer kan daardoor grotendeels stoppen.",
   "chapter": 2
  },
  {
   "start": 129.53,
   "end": 136.18,
   "text": "Voor inkopers van verpakkingen betekent dit dat gerecycled P-E-T voorlopig duidelijk goedkoper blijft dan nieuw materiaal.",
   "chapter": 2
  },
  {
   "start": 138.51,
   "end": 143.79,
   "text": "Het Belgische bedrijf Rematics maakt van vuilniswagens rijdende meetstations.",
   "chapter": 3
  },
  {
   "start": 143.79,
   "end": 146.51,
   "text": "Dat meldt vakmedium RecyclePro.",
   "chapter": 3
  },
  {
   "start": 146.51,
   "end": 153.55,
   "text": "Een camera met verlichting en kunstmatige intelligentie bekijkt elke lediging, met veertig beelden per seconde.",
   "chapter": 3
  },
  {
   "start": 153.55,
   "end": 160.11,
   "text": "Het systeem herkent meer dan veertig afvalsoorten, en ook gevaarlijke voorwerpen zoals gasflessen en batterijen.",
   "chapter": 3
  },
  {
   "start": 160.11,
   "end": 162.75,
   "text": "Ruim zeventig wagens gebruiken het al.",
   "chapter": 3
  },
  {
   "start": 162.75,
   "end": 168.75,
   "text": "Samen analyseren zij per jaar ongeveer honderdzevenenvijftigduizend vijfhonderd ton afval.",
   "chapter": 3
  },
  {
   "start": 168.75,
   "end": 173.95,
   "text": "In bedrijfsafval meet het systeem veertig tot vijftig procent recyclebaar materiaal.",
   "chapter": 3
  },
  {
   "start": 173.95,
   "end": 181.15,
   "text": "Uitgaande van de ondergrens gaat daardoor jaarlijks ongeveer drieënzestigduizend ton recyclebaar materiaal naar de verbranding.",
   "chapter": 3
  },
  {
   "start": 181.15,
   "end": 188.03,
   "text": "Na een investering van het Duitse M-O-B-A lopen er proeven in Duitsland, Spanje en het Verenigd Koninkrijk.",
   "chapter": 3
  },
  {
   "start": 188.03,
   "end": 191.23,
   "text": "Het systeem is genomineerd voor de Trends Impact Awards.",
   "chapter": 3
  },
  {
   "start": 193.57,
   "end": 199.01,
   "text": "In Amsterdam willen Renewi en partners meer goederen en afval over het water vervoeren.",
   "chapter": 4
  },
  {
   "start": 199.01,
   "end": 200.85,
   "text": "Dat meldt Afvalgids.",
   "chapter": 4
  },
  {
   "start": 200.85,
   "end": 206.69,
   "text": "De afspraken van de Innovatietafel Transport over Water zijn op vijf november vastgelegd.",
   "chapter": 4
  },
  {
   "start": 206.69,
   "end": 212.61,
   "text": "Partners zijn onder meer de gemeente Amsterdam, de Hogeschool van Amsterdam en enkele vaarbedrijven.",
   "chapter": 4
  },
  {
   "start": 212.61,
   "end": 216.29,
   "text": "Renewi haalt al jaren bedrijfsafval op via de grachten.",
   "chapter": 4
  },
  {
   "start": 216.29,
   "end": 219.49,
   "text": "De eerste proef gaat over linnengoed van een hotel.",
   "chapter": 4
  },
  {
   "start": 219.49,
   "end": 225.25,
   "text": "Schoon en vuil linnen gaat over het water naar een logistiek knooppunt in het Westelijk Havengebied.",
   "chapter": 4
  },
  {
   "start": 225.25,
   "end": 228.53,
   "text": "Studenten onderzoeken hoe betrouwbaar die keten is.",
   "chapter": 4
  },
  {
   "start": 228.53,
   "end": 232.77,
   "text": "Daarna kijkt Renewi of ook afvalstromen per boot terug kunnen.",
   "chapter": 4
  },
  {
   "start": 232.77,
   "end": 238.77,
   "text": "Wethouder Elise Moeskops zegt dat logistiek over het water meer ruimte op straat oplevert.",
   "chapter": 4
  },
  {
   "start": 238.77,
   "end": 241.61,
   "text": "Cijfers over vrachten of uitstoot zijn er nog niet.",
   "chapter": 4
  },
  {
   "start": 243.94,
   "end": 246.82,
   "text": "En wat betekent dit voor uw organisatie?",
   "chapter": 5
  },
  {
   "start": 246.82,
   "end": 249.3,
   "text": "De cijfers uit België zijn een spiegel.",
   "chapter": 5
  },
  {
   "start": 249.3,
   "end": 255.7,
   "text": "Als veertig tot vijftig procent van het bedrijfsafval recyclebaar is, dan zit er waarde in uw restcontainer.",
   "chapter": 5
  },
  {
   "start": 255.7,
   "end": 257.22,
   "text": "Dat geldt ook bij u.",
   "chapter": 5
  },
  {
   "start": 257.22,
   "end": 258.98,
   "text": "Begin daarom met meten.",
   "chapter": 5
  },
  {
   "start": 258.98,
   "end": 264.34,
   "text": "Vraag uw inzamelaar welke gegevens er per lediging zijn, en wat er in uw restafval zit.",
   "chapter": 5
  },
  {
   "start": 264.34,
   "end": 268.34,
   "text": "Bij De Graaf Groep zien wij dat scheiden aan de bron het meeste oplevert.",
   "chapter": 5
  },
  {
   "start": 268.34,
   "end": 275.18,
   "text": "Het voorbeeld uit Amsterdam laat zien dat het slim combineren van leveringen en afvalritten ruimte en ritten bespaart.",
   "chapter": 5
  },
  {
   "start": 275.18,
   "end": 280.46,
   "text": "En wie verpakkingen inkoopt, ziet dat gerecycled P-E-T voorlopig goedkoper blijft dan nieuw.",
   "chapter": 5
  },
  {
   "start": 280.91,
   "end": 284.39,
   "text": "Het cijfer van de dag is drieënzestigduizend.",
   "chapter": 6
  },
  {
   "start": 284.39,
   "end": 292.99,
   "text": "Zoveel ton recyclebaar materiaal belandt volgens RecyclePro jaarlijks in de verbranding, alleen al in het afval dat zijn camera's analyseren.",
   "chapter": 6
  },
  {
   "start": 292.99,
   "end": 294.63,
   "text": "Het gaat om een voorzichtige schatting.",
   "chapter": 6
  },
  {
   "start": 295.08,
   "end": 297.48,
   "text": "Dat was Grondstof voor vandaag.",
   "chapter": 7
  },
  {
   "start": 297.48,
   "end": 301.24,
   "text": "De bronnen bij elk bericht vindt u in de app en in de shownotes.",
   "chapter": 7
  },
  {
   "start": 301.24,
   "end": 303.56,
   "text": "Morgen om negen uur bent u weer bij.",
   "chapter": 7
  },
  {
   "start": 303.56,
   "end": 303.97,
   "text": "Tot dan.",
   "chapter": 7
  }
 ],
