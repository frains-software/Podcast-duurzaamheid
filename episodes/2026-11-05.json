 "transcript": [
  {
   "start": 5.5,
   "end": 6.46,
   "text": "Goedemorgen.",
   "chapter": 0
  },
  {
   "start": 6.46,
   "end": 8.62,
   "text": "Het is donderdag vijf november.",
   "chapter": 0
  },
  {
   "start": 8.62,
   "end": 13.1,
   "text": "U luistert naar Grondstof, het circulaire nieuwsbulletin van De Graaf Groep.",
   "chapter": 0
  },
  {
   "start": 13.1,
   "end": 14.58,
   "text": "Ik ben Frans van den Berge.",
   "chapter": 0
  },
  {
   "start": 14.58,
   "end": 16.14,
   "text": "Dit zijn de koppen.",
   "chapter": 0
  },
  {
   "start": 16.14,
   "end": 20.42,
   "text": "Het Circulair Materialenplan wordt aangepast en u kunt reageren.",
   "chapter": 0
  },
  {
   "start": 20.42,
   "end": 25.58,
   "text": "Brussel komt volgende week naar verwachting met een Europese wet voor de circulaire economie.",
   "chapter": 0
  },
  {
   "start": 25.58,
   "end": 30.08,
   "text": "En de plasticrecycler BlueAlp gaat zijn capaciteit fors uitbreiden.",
   "chapter": 0
  },
  {
   "start": 32.42,
   "end": 36.1,
   "text": "Het Circulair Materialenplan wordt voor het eerst gewijzigd.",
   "chapter": 1
  },
  {
   "start": 36.1,
   "end": 38.34,
   "text": "Dat meldt Platform Participatie.",
   "chapter": 1
  },
  {
   "start": 38.34,
   "end": 42.66,
   "text": "Het plan verving in december vorig jaar het Landelijk Afvalbeheerplan.",
   "chapter": 1
  },
  {
   "start": 42.66,
   "end": 47.78,
   "text": "Van dinsdag drie november tot en met maandag veertien december kan iedereen reageren.",
   "chapter": 1
  },
  {
   "start": 47.78,
   "end": 53.22,
   "text": "De wijziging gaat alleen over de toetsingskaders voor overheden die besluiten over afvalstoffen.",
   "chapter": 1
  },
  {
   "start": 53.22,
   "end": 59.38,
   "text": "Zo verschuift de oproep om geen algemene beperkingen te stellen aan secundaire bouwstoffen naar de toelichting.",
   "chapter": 1
  },
  {
   "start": 59.38,
   "end": 62.34,
   "text": "Ook worden overgangstermijnen met een jaar verlengd.",
   "chapter": 1
  },
  {
   "start": 62.34,
   "end": 72.34,
   "text": "De plicht om alle bodemas van afvalverbrandingsinstallaties te reinigen tot vrij toepasbare bouwstof geldt daardoor pas vanaf één januari tweeduizend negenentwintig.",
   "chapter": 1
  },
  {
   "start": 72.34,
   "end": 78.9,
   "text": "Het doet ertoe, omdat deze kaders bepalen hoe streng gemeenten en provincies omgaan met secundaire grondstoffen.",
   "chapter": 1
  },
  {
   "start": 78.9,
   "end": 81.99,
   "text": "Tegen het vastgestelde plan kan geen beroep worden ingesteld.",
   "chapter": 1
  },
  {
   "start": 84.32,
   "end": 92.15,
   "text": "De Europese Commissie presenteert volgens haar voorlopige tijdschema op elf november het voorstel voor de Circular Economy Act.",
   "chapter": 2
  },
  {
   "start": 92.15,
   "end": 94.47,
   "text": "Dat meldt vakblad Euwid.",
   "chapter": 2
  },
  {
   "start": 94.47,
   "end": 97.83,
   "text": "Het voorstel was oorspronkelijk gepland voor het derde kwartaal.",
   "chapter": 2
  },
  {
   "start": 97.83,
   "end": 103.51,
   "text": "Het werd uitgesteld, nadat de toetsingsraad van de Commissie kritiek had op de effectbeoordeling.",
   "chapter": 2
  },
  {
   "start": 103.51,
   "end": 108.79,
   "text": "Volgens commissaris Jessika Roswall was de vraagzijde onvoldoende uitgewerkt.",
   "chapter": 2
  },
  {
   "start": 108.79,
   "end": 116.71,
   "text": "Verwacht wordt dat het voorstel de regels voor uitgebreide producentenverantwoordelijkheid en de afvalclassificatie op elkaar afstemt.",
   "chapter": 2
  },
  {
   "start": 116.71,
   "end": 123.75,
   "text": "Ook gaat het om een echte Europese interne markt voor afval, met eenvoudiger grensoverschrijdend transport.",
   "chapter": 2
  },
  {
   "start": 123.75,
   "end": 125.59,
   "text": "De datum kan nog verschuiven.",
   "chapter": 2
  },
  {
   "start": 125.59,
   "end": 131.33,
   "text": "Het doet ertoe, omdat dit de spelregels voor inzameling en recycling in heel Europa kan veranderen.",
   "chapter": 2
  },
  {
   "start": 133.67,
   "end": 137.11,
   "text": "De markt voor oud papier in Europa trekt licht aan.",
   "chapter": 3
  },
  {
   "start": 137.11,
   "end": 142.95,
   "text": "Dat meldt logistiek bedrijf cvb ecoLogistics in zijn marktbericht van één november.",
   "chapter": 3
  },
  {
   "start": 142.95,
   "end": 149.43,
   "text": "De richtprijs voor gesorteerd, geperst oud papier ligt tussen negentig en honderdtien euro per ton.",
   "chapter": 3
  },
  {
   "start": 149.43,
   "end": 154.15,
   "text": "Exportprijzen voor kartonsoorten liggen in november hoger dan in oktober.",
   "chapter": 3
  },
  {
   "start": 154.15,
   "end": 159.67,
   "text": "Lokaal in Europa rekenen kopers op prijsverhogingen van vijf tot tien euro per ton.",
   "chapter": 3
  },
  {
   "start": 159.67,
   "end": 161.91,
   "text": "Of dat standhoudt, is onzeker.",
   "chapter": 3
  },
  {
   "start": 161.91,
   "end": 167.97,
   "text": "Het doet ertoe, omdat de papierprijs de opbrengst van gescheiden papierinzameling bepaalt, ook voor bedrijven.",
   "chapter": 3
  },
  {
   "start": 170.31,
   "end": 176.13,
   "text": "De Eindhovense plasticrecycler BlueAlp wil zijn capaciteit ruim vijf keer zo groot maken.",
   "chapter": 4
  },
  {
   "start": 176.13,
   "end": 178.05,
   "text": "Dat meldt Change Inc.",
   "chapter": 4
  },
  {
   "start": 178.05,
   "end": 184.45,
   "text": "Het bedrijf verhit plastic zonder zuurstof tot pyrolyse-olie, een vorm van chemische recycling.",
   "chapter": 4
  },
  {
   "start": 184.45,
   "end": 190.13,
   "text": "In Oostende wordt de bestaande capaciteit van vierentwintigduizend vijfhonderd ton verdubbeld.",
   "chapter": 4
  },
  {
   "start": 190.13,
   "end": 195.85,
   "text": "In Kampen komt een fabriek van vijftigduizend ton, gepland voor tweeduizend negenentwintig.",
   "chapter": 4
  },
  {
   "start": 195.85,
   "end": 201.49,
   "text": "Daarvoor is eenentwintig miljoen euro subsidie uit het Europese Innovatiefonds toegezegd.",
   "chapter": 4
  },
  {
   "start": 201.49,
   "end": 206.77,
   "text": "In Rotterdam volgt een fabriek van veertigduizend ton, samen met L-B-C Terminals.",
   "chapter": 4
  },
  {
   "start": 206.77,
   "end": 210.85,
   "text": "In totaal gaat het om ongeveer honderdveertigduizend ton per jaar.",
   "chapter": 4
  },
  {
   "start": 210.85,
   "end": 216.53,
   "text": "Volgens het bedrijf neemt de belangstelling van grote bedrijven toe door de Europese verpakkingsregels.",
   "chapter": 4
  },
  {
   "start": 216.53,
   "end": 220.93,
   "text": "Vanaf tweeduizend dertig geldt een minimumaandeel gerecycled plastic.",
   "chapter": 4
  },
  {
   "start": 220.93,
   "end": 225.29,
   "text": "Het doet ertoe, omdat wetgeving hier de vraag naar gerecycled plastic aanjaagt.",
   "chapter": 4
  },
  {
   "start": 227.62,
   "end": 230.5,
   "text": "En wat betekent dit voor uw organisatie?",
   "chapter": 5
  },
  {
   "start": 230.5,
   "end": 234.1,
   "text": "Het nieuws van vandaag draait om regels die nog worden vastgesteld.",
   "chapter": 5
  },
  {
   "start": 234.1,
   "end": 236.42,
   "text": "Dat biedt een kans om mee te denken.",
   "chapter": 5
  },
  {
   "start": 236.42,
   "end": 241.54,
   "text": "Kijk daarom of uw branchevereniging een reactie op het Circulair Materialenplan voorbereidt.",
   "chapter": 5
  },
  {
   "start": 241.54,
   "end": 249.78,
   "text": "Zet de elfde november in uw agenda, want een Europese wet over producentenverantwoordelijkheid kan ook uw afvalcontracten raken.",
   "chapter": 5
  },
  {
   "start": 249.78,
   "end": 253.54,
   "text": "Controleer ook wat uw contract zegt over de prijs van oud papier.",
   "chapter": 5
  },
  {
   "start": 253.54,
   "end": 256.42,
   "text": "Vaak werkt een marktprijs door in uw vergoeding.",
   "chapter": 5
  },
  {
   "start": 256.42,
   "end": 262.5,
   "text": "En vraag uw verpakkingsleverancier hoe die het aandeel gerecycled plastic na tweeduizend dertig wil halen.",
   "chapter": 5
  },
  {
   "start": 262.5,
   "end": 264.49,
   "text": "Zo bent u voorbereid op wat er komt.",
   "chapter": 5
  },
  {
   "start": 264.94,
   "end": 268.46,
   "text": "Het cijfer van de dag is honderdveertigduizend.",
   "chapter": 6
  },
  {
   "start": 268.46,
   "end": 274.22,
   "text": "Zoveel ton pyrolyse-olie per jaar wil BlueAlp over een paar jaar maken uit plastic afval.",
   "chapter": 6
  },
  {
   "start": 274.22,
   "end": 275.93,
   "text": "Nu is dat nog een fractie daarvan.",
   "chapter": 6
  },
  {
   "start": 276.38,
   "end": 278.78,
   "text": "Dat was Grondstof voor vandaag.",
   "chapter": 7
  },
  {
   "start": 278.78,
   "end": 282.46,
   "text": "De bronnen bij elk bericht vindt u in de app en in de shownotes.",
   "chapter": 7
  },
  {
   "start": 282.46,
   "end": 284.78,
   "text": "Morgen om negen uur bent u weer bij.",
   "chapter": 7
  },
  {
   "start": 284.78,
   "end": 285.26,
   "text": "Tot dan.",
   "chapter": 7
  }
 ],
