 "transcript": [
  {
   "start": 5.5,
   "end": 6.54,
   "text": "Goedemorgen.",
   "chapter": 0
  },
  {
   "start": 6.54,
   "end": 8.66,
   "text": "Het is woensdag vier november.",
   "chapter": 0
  },
  {
   "start": 8.66,
   "end": 13.1,
   "text": "U luistert naar Grondstof, het circulaire nieuwsbulletin van De Graaf Groep.",
   "chapter": 0
  },
  {
   "start": 13.1,
   "end": 14.74,
   "text": "Ik ben Frans van den Berge.",
   "chapter": 0
  },
  {
   "start": 14.74,
   "end": 16.1,
   "text": "Dit zijn de koppen.",
   "chapter": 0
  },
  {
   "start": 16.1,
   "end": 21.38,
   "text": "De minister wil de uitzondering voor het gescheiden inzamelen van gft-afval schrappen.",
   "chapter": 0
  },
  {
   "start": 21.38,
   "end": 25.22,
   "text": "De Tweede Kamer buigt zich over de heffingen op afvalverbranding.",
   "chapter": 0
  },
  {
   "start": 25.22,
   "end": 30.18,
   "text": "En lithiumbatterijen veroorzaken veel branden bij Nederlandse recyclingbedrijven.",
   "chapter": 0
  },
  {
   "start": 32.52,
   "end": 37.32,
   "text": "Het kabinet wil dat meer gemeenten gft-afval apart inzamelen.",
   "chapter": 1
  },
  {
   "start": 37.32,
   "end": 40.2,
   "text": "Dat meldt het Algemeen Nederlands Persbureau.",
   "chapter": 1
  },
  {
   "start": 40.2,
   "end": 45.96,
   "text": "Minister Van Veldhoven van Klimaat en Groene Groei schrijft dit in een brief aan de Tweede Kamer.",
   "chapter": 1
  },
  {
   "start": 45.96,
   "end": 48.44,
   "text": "Gescheiden inzamelen is al verplicht.",
   "chapter": 1
  },
  {
   "start": 48.44,
   "end": 54.84,
   "text": "Maar gemeenten mogen nu een uitzondering gebruiken als scheiden technisch niet kan of erg duur is.",
   "chapter": 1
  },
  {
   "start": 54.84,
   "end": 57.56,
   "text": "Die uitzondering wil de minister schrappen.",
   "chapter": 1
  },
  {
   "start": 57.56,
   "end": 62.2,
   "text": "Een landelijk verplicht tarief voor restafval overweegt zij pas daarna.",
   "chapter": 1
  },
  {
   "start": 62.2,
   "end": 65.88,
   "text": "Ook wil ze afvalscheiding op scholen mogelijk verplichten.",
   "chapter": 1
  },
  {
   "start": 65.88,
   "end": 71.88,
   "text": "Volgens de minister bestaat gemiddeld tachtig procent van het restafval nog uit recyclebare materialen.",
   "chapter": 1
  },
  {
   "start": 71.88,
   "end": 75.32,
   "text": "De komende maanden werkt het kabinet de plannen verder uit.",
   "chapter": 1
  },
  {
   "start": 75.32,
   "end": 80.2,
   "text": "Het doet ertoe, omdat ook bedrijven hun afvalstromen beter gescheiden moeten houden.",
   "chapter": 1
  },
  {
   "start": 80.2,
   "end": 81.9,
   "text": "Dat plan is nog niet concreet.",
   "chapter": 1
  },
  {
   "start": 84.23,
   "end": 89.19,
   "text": "De Tweede Kamer behandelt in week vijfenveertig het Belastingplan voor volgend jaar.",
   "chapter": 2
  },
  {
   "start": 89.19,
   "end": 92.87,
   "text": "Dat meldt de Nederlandse Vereniging van Reinigingsdiensten.",
   "chapter": 2
  },
  {
   "start": 92.87,
   "end": 98.31,
   "text": "In een eerder overleg bleven meerdere partijen kritisch op de heffingen voor afvalverbranding.",
   "chapter": 2
  },
  {
   "start": 98.31,
   "end": 106.43,
   "text": "De extra lasten voor de afvalsector zijn inmiddels verlaagd van vijfhonderdzevenenzestig naar vierhonderdachtennegentig miljoen euro.",
   "chapter": 2
  },
  {
   "start": 106.43,
   "end": 109.67,
   "text": "De vereniging vindt het probleem daarmee niet opgelost.",
   "chapter": 2
  },
  {
   "start": 109.67,
   "end": 113.51,
   "text": "De kosten komen vooral bij gemeenten en inwoners terecht.",
   "chapter": 2
  },
  {
   "start": 113.51,
   "end": 118.83,
   "text": "Zij wil de prijs bij de producent leggen, omdat die bepaalt welk materiaal wordt gebruikt.",
   "chapter": 2
  },
  {
   "start": 118.83,
   "end": 123.99,
   "text": "De Federatie Nederlandse Vakbeweging ziet intussen af van acties tegen de heffingen.",
   "chapter": 2
  },
  {
   "start": 123.99,
   "end": 129.85,
   "text": "Het doet ertoe, omdat de heffingen uiteindelijk doorwerken in de tarieven voor afvalverwerking, ook voor bedrijven.",
   "chapter": 2
  },
  {
   "start": 132.19,
   "end": 138.67,
   "text": "Chemiebedrijf LyondellBasell verwacht zijn tweede installatie voor chemische recycling in Europa te bouwen.",
   "chapter": 3
  },
  {
   "start": 138.67,
   "end": 140.51,
   "text": "Dat meldt Afvalgids.",
   "chapter": 3
  },
  {
   "start": 140.51,
   "end": 145.87,
   "text": "Topman Peter Vanacker zei dit bij de presentatie van de cijfers over het derde kwartaal.",
   "chapter": 3
  },
  {
   "start": 145.87,
   "end": 150.03,
   "text": "Het gaat om de eigen technologie van het bedrijf, die Moretek heet.",
   "chapter": 3
  },
  {
   "start": 150.03,
   "end": 153.23,
   "text": "De eerste installatie staat in het Duitse Wesseling.",
   "chapter": 3
  },
  {
   "start": 153.23,
   "end": 158.59,
   "text": "Volgens Vanacker ontbreekt in de Verenigde Staten voldoende regelgeving voor zo'n investering.",
   "chapter": 3
  },
  {
   "start": 158.59,
   "end": 163.55,
   "text": "Er is nog geen definitieve locatie en er is geen investeringsbesluit genomen.",
   "chapter": 3
  },
  {
   "start": 163.55,
   "end": 167.47,
   "text": "Over capaciteit, kosten en planning is niets bekend.",
   "chapter": 3
  },
  {
   "start": 167.47,
   "end": 173.55,
   "text": "Het doet ertoe, omdat het laat zien hoe regelgeving bepaalt waar recyclinginvesteringen terechtkomen.",
   "chapter": 3
  },
  {
   "start": 173.55,
   "end": 178.37,
   "text": "Heldere Europese regels trekken kapitaal aan, al is een besluit nog niet genomen.",
   "chapter": 3
  },
  {
   "start": 180.71,
   "end": 185.51,
   "text": "Bij Nederlandse recyclingbedrijven neemt het aantal branden en broeihaarden toe.",
   "chapter": 4
  },
  {
   "start": 185.51,
   "end": 191.59,
   "text": "Dat meldt Recycling Magazine Benelux, op basis van een analyse van beveiligingsbedrijf Kooi.",
   "chapter": 4
  },
  {
   "start": 191.59,
   "end": 198.23,
   "text": "Bij negenenveertig van de drieënvijftig onderzochte branden met een bekende oorzaak waren lithiumbatterijen betrokken.",
   "chapter": 4
  },
  {
   "start": 198.23,
   "end": 203.75,
   "text": "Zulke batterijen kunnen beschadigen bij inzameling, overslag, verwerking of opslag.",
   "chapter": 4
  },
  {
   "start": 203.75,
   "end": 207.59,
   "text": "Een interne kortsluiting leidt dan snel tot oplopende hitte.",
   "chapter": 4
  },
  {
   "start": 207.59,
   "end": 214.23,
   "text": "Volgens onderzoeken waarop het rapport zich beroept, komt maar ongeveer een kwart van deze batterijen via de bedoelde kanalen terecht.",
   "chapter": 4
  },
  {
   "start": 214.23,
   "end": 221.51,
   "text": "Een grote brand in een verwerkingshal van vierduizend vierkante meter kan zo drie komma vijf miljoen euro schade veroorzaken.",
   "chapter": 4
  },
  {
   "start": 221.51,
   "end": 226.57,
   "text": "Het doet ertoe, omdat brandveiligheid en verzekering direct raken aan de kosten van verwerking.",
   "chapter": 4
  },
  {
   "start": 228.91,
   "end": 231.79,
   "text": "En wat betekent dit voor uw organisatie?",
   "chapter": 5
  },
  {
   "start": 231.79,
   "end": 237.15,
   "text": "Het nieuws wijst één kant op: afval wordt strenger gescheiden en duurder om te verwerken.",
   "chapter": 5
  },
  {
   "start": 237.15,
   "end": 241.55,
   "text": "Bij De Graaf Groep zien we dat de kwaliteit van de scheiding aan de bron het verschil maakt.",
   "chapter": 5
  },
  {
   "start": 241.55,
   "end": 248.99,
   "text": "Controleer daarom of uw afvalstromen op de werkvloer echt gescheiden worden aangeboden, en of dat ook voor gft-afval geldt.",
   "chapter": 5
  },
  {
   "start": 248.99,
   "end": 250.59,
   "text": "Kijk ook naar batterijen.",
   "chapter": 5
  },
  {
   "start": 250.59,
   "end": 254.91,
   "text": "Een kapotte batterij in het restafval is een brandrisico voor de hele keten.",
   "chapter": 5
  },
  {
   "start": 254.91,
   "end": 258.51,
   "text": "Zorg voor een duidelijk inleverpunt en leg uit wat erin mag.",
   "chapter": 5
  },
  {
   "start": 258.51,
   "end": 263.15,
   "text": "Vraag uw afvalinzamelaar tot slot hoe de nieuwe heffingen doorwerken in uw tarieven.",
   "chapter": 5
  },
  {
   "start": 263.15,
   "end": 267.59,
   "text": "Dan voorkomt u een verrassing op de factuur, en kunt u tijdig uw afvalbeleid bijsturen.",
   "chapter": 5
  },
  {
   "start": 268.04,
   "end": 270.96,
   "text": "Het cijfer van de dag is negenenveertig.",
   "chapter": 6
  },
  {
   "start": 270.96,
   "end": 279.56,
   "text": "Zoveel van de drieënvijftig onderzochte branden bij Nederlandse recyclingbedrijven, met een bekende oorzaak, hadden te maken met lithiumbatterijen.",
   "chapter": 6
  },
  {
   "start": 279.56,
   "end": 281.8,
   "text": "Dat is ruim negen op de tien.",
   "chapter": 6
  },
  {
   "start": 281.8,
   "end": 287.69,
   "text": "Het laat zien hoe groot de rol van één afvalstroom is, en hoeveel winst er ligt in goede inzameling.",
   "chapter": 6
  },
  {
   "start": 288.14,
   "end": 290.3,
   "text": "Dat was Grondstof voor vandaag.",
   "chapter": 7
  },
  {
   "start": 290.3,
   "end": 293.98,
   "text": "De bronnen bij elk bericht vindt u in de app en in de shownotes.",
   "chapter": 7
  },
  {
   "start": 293.98,
   "end": 296.3,
   "text": "Morgen om negen uur bent u weer bij.",
   "chapter": 7
  },
  {
   "start": 296.3,
   "end": 296.73,
   "text": "Tot dan.",
   "chapter": 7
  }
 ],
