 "transcript": [
  {
   "start": 5.5,
   "end": 6.54,
   "text": "Goedemorgen.",
   "chapter": 0
  },
  {
   "start": 6.54,
   "end": 8.78,
   "text": "Het is zondag vijftien november.",
   "chapter": 0
  },
  {
   "start": 8.78,
   "end": 13.26,
   "text": "U luistert naar Grondstof, het circulaire nieuwsbulletin van De Graaf Groep.",
   "chapter": 0
  },
  {
   "start": 13.26,
   "end": 14.82,
   "text": "Ik ben Frans van den Berge.",
   "chapter": 0
  },
  {
   "start": 14.82,
   "end": 16.22,
   "text": "Dit zijn de koppen.",
   "chapter": 0
  },
  {
   "start": 16.22,
   "end": 22.78,
   "text": "Brussel werkt aan reparatie-eisen voor elektronica, kleine huishoudelijke apparaten en e-scooters.",
   "chapter": 0
  },
  {
   "start": 22.78,
   "end": 27.7,
   "text": "Op de grondstoffenmarkt gaat oud papier omhoog, terwijl schroot goedkoper wordt.",
   "chapter": 0
  },
  {
   "start": 27.7,
   "end": 34.31,
   "text": "En een bedrijf uit Hoofddorp wint een prijs met het terugwinnen van kritieke grondstoffen uit afgedankte elektronica.",
   "chapter": 0
  },
  {
   "start": 36.65,
   "end": 40.62,
   "text": "De Europese Commissie wil dat meer producten te repareren zijn.",
   "chapter": 1
  },
  {
   "start": 40.62,
   "end": 51.18,
   "text": "Ze heeft een openbare consultatie geopend over reparatie-eisen voor consumentenelektronica, kleine huishoudelijke apparaten en lichte vervoersmiddelen zoals e-scooters.",
   "chapter": 1
  },
  {
   "start": 51.18,
   "end": 53.66,
   "text": "Dat meldt het vakblad Euwid.",
   "chapter": 1
  },
  {
   "start": 53.66,
   "end": 59.74,
   "text": "De regels komen er als aanvulling op de Europese Ecodesign-verordening voor duurzame producten.",
   "chapter": 1
  },
  {
   "start": 59.74,
   "end": 62.94,
   "text": "Fabrikanten moeten hun producten repareerbaar maken.",
   "chapter": 1
  },
  {
   "start": 62.94,
   "end": 70.06,
   "text": "Consumenten en professionele reparateurs moeten toegang krijgen tot de informatie die nodig is voor een reparatie.",
   "chapter": 1
  },
  {
   "start": 70.06,
   "end": 77.82,
   "text": "De consultatie loopt tot negen februari en richt zich op burgers en vakmensen, ook uit de recycling- en afvalsector.",
   "chapter": 1
  },
  {
   "start": 77.82,
   "end": 81.26,
   "text": "Daarnaast komen er enquêtes en werkbijeenkomsten.",
   "chapter": 1
  },
  {
   "start": 81.26,
   "end": 86.3,
   "text": "De Commissie wil het ontwerp in het tweede kwartaal van tweeduizend zevenentwintig presenteren.",
   "chapter": 1
  },
  {
   "start": 86.3,
   "end": 89.48,
   "text": "Het doel is een langere levensduur en minder afval.",
   "chapter": 1
  },
  {
   "start": 91.81,
   "end": 96.05,
   "text": "Op de grondstoffenmarkt lopen papier en metaal deze maand uiteen.",
   "chapter": 2
  },
  {
   "start": 96.05,
   "end": 101.17,
   "text": "De prijzen voor oud papier in Duitsland stijgen in november verder, meldt Euwid.",
   "chapter": 2
  },
  {
   "start": 101.17,
   "end": 104.85,
   "text": "Wel zijn de stijgingen deels kleiner dan in de maanden ervoor.",
   "chapter": 2
  },
  {
   "start": 104.85,
   "end": 107.09,
   "text": "Bij schroot is het beeld omgekeerd.",
   "chapter": 2
  },
  {
   "start": 107.09,
   "end": 114.77,
   "text": "Volgens de Duitse brancheorganisatie bvse dalen de inkoopprijzen in Duitsland meestal met tien euro per ton.",
   "chapter": 2
  },
  {
   "start": 114.77,
   "end": 119.17,
   "text": "In Frankrijk, Oostenrijk, Zwitserland en Spanje gebeurt hetzelfde.",
   "chapter": 2
  },
  {
   "start": 119.17,
   "end": 122.77,
   "text": "In Italië ligt de daling tussen tien en vijftien euro.",
   "chapter": 2
  },
  {
   "start": 122.77,
   "end": 125.89,
   "text": "De oorzaak is de hoge prijs van stroom en gas.",
   "chapter": 2
  },
  {
   "start": 125.89,
   "end": 131.51,
   "text": "Staalfabrieken produceren daardoor minder, en een Noord-Duitse fabriek stopte zelfs helemaal met inkopen.",
   "chapter": 2
  },
  {
   "start": 133.85,
   "end": 139.45,
   "text": "Het bedrijf Critical uit Hoofddorp heeft de Share Award van de gemeente Haarlemmermeer gewonnen.",
   "chapter": 3
  },
  {
   "start": 139.45,
   "end": 141.69,
   "text": "Dat meldt HCnieuws.",
   "chapter": 3
  },
  {
   "start": 141.69,
   "end": 148.97,
   "text": "Het bedrijf bouwt fabrieken die waardevolle grondstoffen terugwinnen uit afgedankte elektronica en andere afvalstromen.",
   "chapter": 3
  },
  {
   "start": 148.97,
   "end": 155.61,
   "text": "Het combineert daarvoor verschillende technieken, zodat de kritieke grondstoffen weer geschikt zijn voor de industrie.",
   "chapter": 3
  },
  {
   "start": 155.61,
   "end": 162.33,
   "text": "Directeur Niels Wagemaker noemt Critical geen recyclingbedrijf, maar een grondstoffenproducent.",
   "chapter": 3
  },
  {
   "start": 162.33,
   "end": 168.01,
   "text": "Wij winnen grondstoffen terug die anders in de smelterij of op de stort verdwijnen, zegt hij.",
   "chapter": 3
  },
  {
   "start": 168.01,
   "end": 176.33,
   "text": "Het bedrijf ziet kansen in de regio, met elektronica van datacenters, kantoren, logistieke bedrijven en de luchthaven.",
   "chapter": 3
  },
  {
   "start": 176.33,
   "end": 184.41,
   "text": "De jury onder leiding van wethouder Marja Ruigrok waardeert vooral het terugwinnen van schaarse grondstoffen voor de energietransitie.",
   "chapter": 3
  },
  {
   "start": 184.41,
   "end": 188.28,
   "text": "Zo kan Europa minder afhankelijk worden van grondstoffen uit het buitenland.",
   "chapter": 3
  },
  {
   "start": 190.61,
   "end": 201.97,
   "text": "Op de klimaattop in het Turkse Antalya heeft secretaris-generaal António Guterres van de Verenigde Naties opgeroepen tot meer aandacht voor afvalpreventie en de circulaire economie.",
   "chapter": 4
  },
  {
   "start": 201.97,
   "end": 203.89,
   "text": "Dat meldt Euwid.",
   "chapter": 4
  },
  {
   "start": 203.89,
   "end": 211.81,
   "text": "Tijdens een rondetafelgesprek over nul afval en methaan pleitte hij voor betere afvalinzameling en meer compostering.",
   "chapter": 4
  },
  {
   "start": 211.81,
   "end": 216.53,
   "text": "Ook wil hij dat producenten meer verantwoordelijkheid dragen voor hun producten.",
   "chapter": 4
  },
  {
   "start": 216.53,
   "end": 221.33,
   "text": "Guterres benadrukte het voorkomen en hergebruiken van voedselafval.",
   "chapter": 4
  },
  {
   "start": 221.33,
   "end": 229.33,
   "text": "Voedselverlies en voedselverspilling zijn volgens hem goed voor acht tot tien procent van de wereldwijde uitstoot van broeikasgassen.",
   "chapter": 4
  },
  {
   "start": 229.33,
   "end": 234.45,
   "text": "Hij drong verder aan op een ambitieus wereldwijd verdrag tegen plasticvervuiling.",
   "chapter": 4
  },
  {
   "start": 234.45,
   "end": 240.45,
   "text": "Dat verdrag staat op zestien november op de agenda van een bijeenkomst van de Europese Unie op de top.",
   "chapter": 4
  },
  {
   "start": 240.45,
   "end": 243.29,
   "text": "De verwachtingen zijn volgens het vakblad terughoudend.",
   "chapter": 4
  },
  {
   "start": 245.63,
   "end": 248.51,
   "text": "En wat betekent dit voor uw organisatie?",
   "chapter": 5
  },
  {
   "start": 248.51,
   "end": 254.51,
   "text": "De prijzen van vandaag laten zien dat schone stromen waarde hebben, maar dat die waarde schommelt.",
   "chapter": 5
  },
  {
   "start": 254.51,
   "end": 259.07,
   "text": "Bij De Graaf Groep zien we dat goed gescheiden papier en karton nu meer opleveren.",
   "chapter": 5
  },
  {
   "start": 259.07,
   "end": 261.63,
   "text": "Metaal levert juist iets minder op.",
   "chapter": 5
  },
  {
   "start": 261.63,
   "end": 265.15,
   "text": "Houd daarom uw stromen apart en bekijk uw contracten.",
   "chapter": 5
  },
  {
   "start": 265.15,
   "end": 269.07,
   "text": "Weet u wat er in uw afval zit, dan kunt u meebewegen met de markt.",
   "chapter": 5
  },
  {
   "start": 269.07,
   "end": 270.83,
   "text": "Kijk ook naar uw apparaten.",
   "chapter": 5
  },
  {
   "start": 270.83,
   "end": 273.79,
   "text": "De Europese regels voor reparatie komen eraan.",
   "chapter": 5
  },
  {
   "start": 273.79,
   "end": 281.26,
   "text": "Neem repareerbaarheid nu al mee bij de inkoop van elektronica, en zorg dat afgedankte apparaten bij een erkende verwerker terechtkomen.",
   "chapter": 5
  },
  {
   "start": 281.71,
   "end": 284.51,
   "text": "Het cijfer van de dag is tien euro.",
   "chapter": 6
  },
  {
   "start": 284.51,
   "end": 293.23,
   "text": "Zoveel per ton dalen deze maand de inkoopprijzen voor schroot in grote delen van Duitsland, meldt de brancheorganisatie bvse.",
   "chapter": 6
  },
  {
   "start": 293.23,
   "end": 295.92,
   "text": "De hoge energieprijzen remmen de staalproductie.",
   "chapter": 6
  },
  {
   "start": 296.37,
   "end": 298.69,
   "text": "Dat was Grondstof voor vandaag.",
   "chapter": 7
  },
  {
   "start": 298.69,
   "end": 302.37,
   "text": "De bronnen bij elk bericht vindt u in de app en in de shownotes.",
   "chapter": 7
  },
  {
   "start": 302.37,
   "end": 304.61,
   "text": "Morgen om negen uur bent u weer bij.",
   "chapter": 7
  },
  {
   "start": 304.61,
   "end": 305.11,
   "text": "Tot dan.",
   "chapter": 7
  }
 ],
