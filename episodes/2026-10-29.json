 "transcript": [
  {
   "start": 5.5,
   "end": 6.54,
   "text": "Goedemorgen.",
   "chapter": 0
  },
  {
   "start": 6.54,
   "end": 9.02,
   "text": "Het is donderdag negenentwintig oktober.",
   "chapter": 0
  },
  {
   "start": 9.02,
   "end": 13.38,
   "text": "U luistert naar Grondstof, het circulaire nieuwsbulletin van De Graaf Groep.",
   "chapter": 0
  },
  {
   "start": 13.38,
   "end": 15.02,
   "text": "Ik ben Frans van den Berge.",
   "chapter": 0
  },
  {
   "start": 15.02,
   "end": 16.54,
   "text": "Dit zijn de koppen.",
   "chapter": 0
  },
  {
   "start": 16.54,
   "end": 21.9,
   "text": "De Europese lidstaten zijn verdeeld over afvalverbranding in het emissiehandelssysteem.",
   "chapter": 0
  },
  {
   "start": 21.9,
   "end": 27.1,
   "text": "Duitse recyclers houden de prijzen voor elektronisch afval stabiel dankzij metaal.",
   "chapter": 0
  },
  {
   "start": 27.1,
   "end": 30.46,
   "text": "En Amsterdam onderzoekt een verbod op wegwerpverpakkingen.",
   "chapter": 0
  },
  {
   "start": 32.8,
   "end": 41.09,
   "text": "De Europese lidstaten zijn verdeeld over een plan om de verbranding van huishoudelijk afval onder het Europese emissiehandelssysteem te brengen.",
   "chapter": 1
  },
  {
   "start": 41.09,
   "end": 44.53,
   "text": "Dat meldt het vakblad Euwid op achtentwintig oktober.",
   "chapter": 1
  },
  {
   "start": 44.53,
   "end": 50.85,
   "text": "De Europese Commissie stelt voor dat afvalverbrandingsinstallaties vanaf tweeduizend eenendertig meedoen.",
   "chapter": 1
  },
  {
   "start": 50.85,
   "end": 55.97,
   "text": "Lidstaten kunnen onder voorwaarden uitstel vragen tot tweeduizend vijfendertig.",
   "chapter": 1
  },
  {
   "start": 55.97,
   "end": 63.89,
   "text": "Op twaalf oktober bespraken de milieuministers in Luxemburg het voorstel, en ook toen liepen de meningen uiteen, meldt Agence Europe.",
   "chapter": 1
  },
  {
   "start": 63.89,
   "end": 67.41,
   "text": "Voorstanders zien een prikkel om minder afval te verbranden.",
   "chapter": 1
  },
  {
   "start": 67.41,
   "end": 75.49,
   "text": "Tegenstanders, zoals afvalbedrijf Suez, wijzen op hogere kosten voor gemeenten en huishoudens zonder bewezen milieuwinst.",
   "chapter": 1
  },
  {
   "start": 75.49,
   "end": 81.05,
   "text": "Het doet ertoe, omdat de kosten van verbranding rechtstreeks doorwerken in de tarieven voor bedrijfsafval.",
   "chapter": 1
  },
  {
   "start": 83.38,
   "end": 87.94,
   "text": "In Duitsland blijven de prijzen voor het verwerken van elektronisch afval stabiel.",
   "chapter": 2
  },
  {
   "start": 87.94,
   "end": 89.54,
   "text": "Dat meldt Euwid.",
   "chapter": 2
  },
  {
   "start": 89.54,
   "end": 94.58,
   "text": "De tarieven die recyclers rekenen of betalen zijn sinds juli niet veranderd.",
   "chapter": 2
  },
  {
   "start": 94.58,
   "end": 99.78,
   "text": "Dat is opvallend, want diesel, vrachtcapaciteit en personeel werden duurder.",
   "chapter": 2
  },
  {
   "start": 99.78,
   "end": 106.98,
   "text": "Volgens het vakblad helpen hoge koperprijzen en relatief stabiele schrootprijzen voor ijzer om die kosten op te vangen.",
   "chapter": 2
  },
  {
   "start": 106.98,
   "end": 110.5,
   "text": "De aanvoer van elektronisch afval is stabiel tot goed.",
   "chapter": 2
  },
  {
   "start": 110.5,
   "end": 113.78,
   "text": "Na een rustige zomer is de inname weer toegenomen.",
   "chapter": 2
  },
  {
   "start": 113.78,
   "end": 119.94,
   "text": "Voor het verwerken van oude koelapparatuur wordt in tweeduizend zevenentwintig een flinke prijsstijging verwacht.",
   "chapter": 2
  },
  {
   "start": 119.94,
   "end": 124.82,
   "text": "De les is dat de inkomsten uit metaal de verwerking van afval betaalbaar houden.",
   "chapter": 2
  },
  {
   "start": 124.82,
   "end": 128.69,
   "text": "Valt die opbrengst weg, dan komt de rekening bij de afvalproducent terecht.",
   "chapter": 2
  },
  {
   "start": 131.03,
   "end": 135.67,
   "text": "De gemeente Haarlem start met statiegeld op herbruikbare verzenddozen.",
   "chapter": 3
  },
  {
   "start": 135.67,
   "end": 138.95,
   "text": "Dat meldt Haarlem Updates op vierentwintig oktober.",
   "chapter": 3
  },
  {
   "start": 138.95,
   "end": 143.51,
   "text": "Het doel is dat er minder kartonnen dozen in de oudpapiercontainers belanden.",
   "chapter": 3
  },
  {
   "start": 143.51,
   "end": 147.67,
   "text": "Het aantal pakketten in Nederland is in tien jaar verdrievoudigd.",
   "chapter": 3
  },
  {
   "start": 147.67,
   "end": 154.39,
   "text": "Volgens de lokale zender leverde dat vorig jaar ongeveer zevenentachtig miljoen kilo verpakkingsafval op.",
   "chapter": 3
  },
  {
   "start": 154.39,
   "end": 157.99,
   "text": "Daarvan was vierentachtig miljoen kilo karton.",
   "chapter": 3
  },
  {
   "start": 157.99,
   "end": 162.79,
   "text": "De Europese verpakkingsverordening schrijft voor dat Nederland dit afval terugbrengt.",
   "chapter": 3
  },
  {
   "start": 162.79,
   "end": 169.11,
   "text": "In tweeduizend dertig moet het vijf procent lager zijn, in tweeduizend veertig vijftien procent.",
   "chapter": 3
  },
  {
   "start": 169.11,
   "end": 172.23,
   "text": "Over de uitwerking in Haarlem is nog weinig bekend.",
   "chapter": 3
  },
  {
   "start": 172.23,
   "end": 178.53,
   "text": "Voor bedrijven die veel pakketten versturen of ontvangen, laat het zien dat herbruikbare verpakking een gewone keuze wordt.",
   "chapter": 3
  },
  {
   "start": 180.86,
   "end": 186.7,
   "text": "Amsterdam onderzoekt een verbod op wegwerpverpakkingen, zoals koffiebekers en fastfoodbakjes.",
   "chapter": 4
  },
  {
   "start": 186.7,
   "end": 189.66,
   "text": "Dat meldt DutchNews op drieëntwintig oktober.",
   "chapter": 4
  },
  {
   "start": 189.66,
   "end": 194.78,
   "text": "Wethouder Lian Heinhuis, verantwoordelijk voor afval, maakte het plan bekend.",
   "chapter": 4
  },
  {
   "start": 194.78,
   "end": 199.74,
   "text": "Volgens de gemeente zijn deze verpakkingen dertig procent van het zwerfafval in de stad.",
   "chapter": 4
  },
  {
   "start": 199.74,
   "end": 202.94,
   "text": "De gemeente laat uitzoeken wat juridisch mogelijk is.",
   "chapter": 4
  },
  {
   "start": 202.94,
   "end": 208.14,
   "text": "Volgens CircuLaw kan een verbod pas komen als mildere maatregelen niets opleveren.",
   "chapter": 4
  },
  {
   "start": 208.14,
   "end": 214.38,
   "text": "Het werkt bovendien het best als er voldoende herbruikbare verpakkingen zijn en een werkend retoursysteem.",
   "chapter": 4
  },
  {
   "start": 214.38,
   "end": 220.94,
   "text": "Amsterdam overlegt met bedrijven en bewoners en kijkt naar Kopenhagen en Lissabon, waar al een verbod geldt.",
   "chapter": 4
  },
  {
   "start": 220.94,
   "end": 226.36,
   "text": "Voor horeca en facilitaire diensten is het een signaal om nu al over herbruikbaar na te denken.",
   "chapter": 4
  },
  {
   "start": 228.7,
   "end": 231.66,
   "text": "En wat betekent dit voor uw organisatie?",
   "chapter": 5
  },
  {
   "start": 231.66,
   "end": 238.62,
   "text": "De berichten van vandaag wijzen dezelfde kant op: weggooien wordt duurder en herbruikbaar wordt vanzelfsprekender.",
   "chapter": 5
  },
  {
   "start": 238.62,
   "end": 244.86,
   "text": "Bij De Graaf Groep zien wij dat de afvalkosten van bedrijven vooral afhangen van hoe goed afval gescheiden is.",
   "chapter": 5
  },
  {
   "start": 244.86,
   "end": 248.06,
   "text": "Schoon gescheiden metaal en papier leveren geld op.",
   "chapter": 5
  },
  {
   "start": 248.06,
   "end": 250.38,
   "text": "Gemengd bedrijfsafval kost geld.",
   "chapter": 5
  },
  {
   "start": 250.38,
   "end": 253.42,
   "text": "Neem daarom uw eigen afvalstromen onder de loep.",
   "chapter": 5
  },
  {
   "start": 253.42,
   "end": 255.78,
   "text": "Welk deel van uw restafval is verpakking?",
   "chapter": 5
  },
  {
   "start": 255.78,
   "end": 259.26,
   "text": "En kunt u daar herbruikbare dozen of bekers voor inzetten?",
   "chapter": 5
  },
  {
   "start": 259.26,
   "end": 265.23,
   "text": "Gemeenten als Amsterdam en Haarlem gaan voorop, maar ook zakelijke gebruikers worden straks aangesproken.",
   "chapter": 5
  },
  {
   "start": 265.23,
   "end": 268.99,
   "text": "Een afvalscan van een onafhankelijke afvalmanager kan helpen om te beginnen.",
   "chapter": 5
  },
  {
   "start": 269.44,
   "end": 272.72,
   "text": "Het cijfer van de dag is dertig procent.",
   "chapter": 6
  },
  {
   "start": 272.72,
   "end": 280.33,
   "text": "Zoveel van het zwerfafval in Amsterdam bestaat volgens de gemeente uit wegwerpverpakkingen, zoals koffiebekers en fastfoodbakjes.",
   "chapter": 6
  },
  {
   "start": 280.78,
   "end": 283.1,
   "text": "Dat was Grondstof voor vandaag.",
   "chapter": 7
  },
  {
   "start": 283.1,
   "end": 286.94,
   "text": "De bronnen bij elk bericht vindt u in de app en in de shownotes.",
   "chapter": 7
  },
  {
   "start": 286.94,
   "end": 289.34,
   "text": "Morgen om negen uur bent u weer bij.",
   "chapter": 7
  },
  {
   "start": 289.34,
   "end": 289.79,
   "text": "Tot dan.",
   "chapter": 7
  }
 ],
