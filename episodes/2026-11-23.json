 "transcript": [
  {
   "start": 5.5,
   "end": 6.54,
   "text": "Goedemorgen.",
   "chapter": 0
  },
  {
   "start": 6.54,
   "end": 9.1,
   "text": "Het is maandag drieëntwintig november.",
   "chapter": 0
  },
  {
   "start": 9.1,
   "end": 13.58,
   "text": "U luistert naar Grondstof, het circulaire nieuwsbulletin van De Graaf Groep.",
   "chapter": 0
  },
  {
   "start": 13.58,
   "end": 15.26,
   "text": "Ik ben Frans van den Berge.",
   "chapter": 0
  },
  {
   "start": 15.26,
   "end": 16.7,
   "text": "Dit zijn de koppen.",
   "chapter": 0
  },
  {
   "start": 16.7,
   "end": 23.02,
   "text": "De Europese verpakkingsketen komt met een manifest, vlak voor de nieuwe wet voor de circulaire economie.",
   "chapter": 0
  },
  {
   "start": 23.02,
   "end": 28.46,
   "text": "Duits staalschroot wordt opnieuw goedkoper, terwijl Frans oud papier duurder wordt.",
   "chapter": 0
  },
  {
   "start": 28.46,
   "end": 32.8,
   "text": "En circulaire bouwmaterialen geven niet meer straling af dan gewone.",
   "chapter": 0
  },
  {
   "start": 35.14,
   "end": 41.91,
   "text": "De Europese verpakkingskoepel Europen heeft met drie partners het platform Recycle Now opgericht.",
   "chapter": 1
  },
  {
   "start": 41.91,
   "end": 44.55,
   "text": "Dat meldt het vakblad Packaging Europe.",
   "chapter": 1
  },
  {
   "start": 44.55,
   "end": 54.55,
   "text": "De andere oprichters zijn het Circular Economy Network, de Poolse werkgeversorganisatie Lewiatan en een Kroatische ondernemersraad voor duurzame ontwikkeling.",
   "chapter": 1
  },
  {
   "start": 54.55,
   "end": 62.55,
   "text": "Het platform staat open voor bedrijven, brancheorganisaties, maatschappelijke organisaties, beleidsmakers en afvalbedrijven.",
   "chapter": 1
  },
  {
   "start": 62.55,
   "end": 69.51,
   "text": "In een manifest aan de Europese Commissie, het Europees Parlement en de lidstaten doen de oprichters vier oproepen.",
   "chapter": 1
  },
  {
   "start": 69.51,
   "end": 77.67,
   "text": "Ze willen de interne markt beschermen, stevige inzameling afdwingen en producentenverantwoordelijkheid inzetten om meer te recyclen.",
   "chapter": 1
  },
  {
   "start": 77.67,
   "end": 89.99,
   "text": "Volgens Europen staan versnipperde nationale systemen, belemmeringen voor afvaltransport over de grens en te weinig investeringen in sorteren een Europese markt voor secundaire grondstoffen in de weg.",
   "chapter": 1
  },
  {
   "start": 89.99,
   "end": 94.33,
   "text": "Het manifest verschijnt kort voor de Europese wet voor de circulaire economie.",
   "chapter": 1
  },
  {
   "start": 96.66,
   "end": 101.14,
   "text": "De prijzen van staalschroot in Duitsland zijn in november opnieuw gedaald.",
   "chapter": 2
  },
  {
   "start": 101.14,
   "end": 103.3,
   "text": "Dat meldt het vakblad Euwid.",
   "chapter": 2
  },
  {
   "start": 103.3,
   "end": 107.46,
   "text": "De vraag van staalfabrieken in Duitsland en de buurlanden bleef bescheiden.",
   "chapter": 2
  },
  {
   "start": 107.46,
   "end": 112.82,
   "text": "De fabrieken drongen aan op lagere prijzen en wezen daarbij op hun hoge energiekosten.",
   "chapter": 2
  },
  {
   "start": 112.82,
   "end": 116.66,
   "text": "Gemiddeld kwam de daling uit op ongeveer tien euro per ton.",
   "chapter": 2
  },
  {
   "start": 116.66,
   "end": 119.14,
   "text": "Bij oud papier gaat het de andere kant op.",
   "chapter": 2
  },
  {
   "start": 119.14,
   "end": 124.98,
   "text": "In Frankrijk werden de gewone soorten in november opnieuw duurder, meldde Euwid eerder vorige week.",
   "chapter": 2
  },
  {
   "start": 124.98,
   "end": 129.62,
   "text": "Dat komt door hoge exportprijzen, vooral naar Azië en ook naar Duitsland.",
   "chapter": 2
  },
  {
   "start": 129.62,
   "end": 133.78,
   "text": "Franse inzamelaars halen bovendien relatief weinig oud papier op.",
   "chapter": 2
  },
  {
   "start": 133.78,
   "end": 136.82,
   "text": "Zij wijten dat aan de zwakke consumentenbestedingen.",
   "chapter": 2
  },
  {
   "start": 136.82,
   "end": 140.85,
   "text": "Voor wie oud papier of metaal afvoert, lopen de opbrengsten dus uiteen.",
   "chapter": 2
  },
  {
   "start": 143.19,
   "end": 149.19,
   "text": "Circulaire bouwmaterialen zorgen in woningen niet voor meer straling dan traditionele materialen.",
   "chapter": 3
  },
  {
   "start": 149.19,
   "end": 154.47,
   "text": "Dat blijkt uit onderzoek van het nucleaire kennisinstituut in Petten, meldt Duurzaam Ondernemen.",
   "chapter": 3
  },
  {
   "start": 154.47,
   "end": 158.87,
   "text": "De Autoriteit Nucleaire Veiligheid en Stralingsbescherming gaf de opdracht.",
   "chapter": 3
  },
  {
   "start": 158.87,
   "end": 162.07,
   "text": "Het is voor het eerst dat dit effect in kaart is gebracht.",
   "chapter": 3
  },
  {
   "start": 162.07,
   "end": 168.55,
   "text": "De onderzoekers analyseerden tweehonderdachttien monsters van bouwmaterialen en grondstoffen uit de Nederlandse woningbouw.",
   "chapter": 3
  },
  {
   "start": 168.55,
   "end": 177.43,
   "text": "Naast beton, baksteen en kalkzandsteen ging het om gerecyclede granulaten, alternatieve cementsoorten en industriële reststoffen.",
   "chapter": 3
  },
  {
   "start": 177.43,
   "end": 184.39,
   "text": "De natuurlijke radioactiviteit in de circulaire materialen is laag en vergelijkbaar met die in traditionele materialen.",
   "chapter": 3
  },
  {
   "start": 184.39,
   "end": 187.83,
   "text": "De stralingsbelasting blijft ruim onder de geldende normen.",
   "chapter": 3
  },
  {
   "start": 187.83,
   "end": 192.69,
   "text": "Voor opdrachtgevers in de bouw neemt dat een mogelijke zorg over hergebruikte grondstoffen weg.",
   "chapter": 3
  },
  {
   "start": 195.02,
   "end": 200.38,
   "text": "Bedrijven en organisaties kunnen zich aanmelden voor de Circular Awards van volgend jaar.",
   "chapter": 4
  },
  {
   "start": 200.38,
   "end": 205.18,
   "text": "Dat meldt Duurzaam Ondernemen, op basis van de Week van de Circulaire Economie.",
   "chapter": 4
  },
  {
   "start": 205.18,
   "end": 206.86,
   "text": "Er zijn vier categorieën.",
   "chapter": 4
  },
  {
   "start": 206.86,
   "end": 212.14,
   "text": "Eén prijs is voor bedrijven en één voor publieke en semipublieke organisaties.",
   "chapter": 4
  },
  {
   "start": 212.14,
   "end": 219.9,
   "text": "Daarnaast is er een prijs voor samenwerkingen die een hele keten in beweging brengen, en een prijs voor een persoon met een bijzondere bijdrage.",
   "chapter": 4
  },
  {
   "start": 219.9,
   "end": 223.98,
   "text": "Aanmelden kan tot en met tien januari, via een online formulier.",
   "chapter": 4
  },
  {
   "start": 223.98,
   "end": 230.46,
   "text": "De winnaars worden op elf maart bekendgemaakt, tijdens de Nationale Conferentie Circulaire Economie in Rotterdam.",
   "chapter": 4
  },
  {
   "start": 230.46,
   "end": 237.1,
   "text": "De organisatie gebeurt in opdracht van het ministerie van Infrastructuur en Waterstaat, samen met Het Groene Brein.",
   "chapter": 4
  },
  {
   "start": 237.1,
   "end": 243.47,
   "text": "Een eerdere winnaar bij de bedrijven is Boxo, dat herbruikbare verzendverpakkingen met een retoursysteem ontwikkelde.",
   "chapter": 4
  },
  {
   "start": 245.81,
   "end": 248.77,
   "text": "En wat betekent dit voor uw organisatie?",
   "chapter": 5
  },
  {
   "start": 248.77,
   "end": 253.25,
   "text": "Het was een rustig nieuwsweekend, maar de berichten wijzen dezelfde kant op.",
   "chapter": 5
  },
  {
   "start": 253.25,
   "end": 260.93,
   "text": "Secundaire grondstoffen worden gewone handelswaar, met eigen prijzen, eigen regels en eigen bewijs van kwaliteit.",
   "chapter": 5
  },
  {
   "start": 260.93,
   "end": 267.09,
   "text": "Dat ziet u aan de uiteenlopende markten voor schroot en oud papier, en aan het onderzoek naar bouwmaterialen.",
   "chapter": 5
  },
  {
   "start": 267.09,
   "end": 271.41,
   "text": "Bij De Graaf Groep zien we dat de opbrengst van een stroom per maand kan verschillen.",
   "chapter": 5
  },
  {
   "start": 271.41,
   "end": 275.01,
   "text": "Kijk daarom in uw contract hoe prijsschommelingen worden verrekend.",
   "chapter": 5
  },
  {
   "start": 275.01,
   "end": 278.21,
   "text": "En vraag bij circulaire materialen naar de onderbouwing.",
   "chapter": 5
  },
  {
   "start": 278.21,
   "end": 279.42,
   "text": "Die is er steeds vaker.",
   "chapter": 5
  },
  {
   "start": 279.87,
   "end": 283.11,
   "text": "Het cijfer van de dag is tweehonderdachttien.",
   "chapter": 6
  },
  {
   "start": 283.11,
   "end": 290.83,
   "text": "Zoveel monsters van bouwmaterialen en grondstoffen zijn onderzocht op natuurlijke radioactiviteit, meldt Duurzaam Ondernemen.",
   "chapter": 6
  },
  {
   "start": 290.83,
   "end": 296.35,
   "text": "De uitkomst is dat ook gerecyclede en alternatieve materialen ruim onder de norm blijven.",
   "chapter": 6
  },
  {
   "start": 296.8,
   "end": 299.2,
   "text": "Dat was Grondstof voor vandaag.",
   "chapter": 7
  },
  {
   "start": 299.2,
   "end": 302.96,
   "text": "De bronnen bij elk bericht vindt u in de app en in de shownotes.",
   "chapter": 7
  },
  {
   "start": 302.96,
   "end": 305.2,
   "text": "Morgen om negen uur bent u weer bij.",
   "chapter": 7
  },
  {
   "start": 305.2,
   "end": 305.64,
   "text": "Tot dan.",
   "chapter": 7
  }
 ],
