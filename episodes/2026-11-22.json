 "transcript": [
  {
   "start": 5.5,
   "end": 6.62,
   "text": "Goedemorgen.",
   "chapter": 0
  },
  {
   "start": 6.62,
   "end": 8.94,
   "text": "Het is zondag tweeëntwintig november.",
   "chapter": 0
  },
  {
   "start": 8.94,
   "end": 13.3,
   "text": "U luistert naar Grondstof, het circulaire nieuwsbulletin van De Graaf Groep.",
   "chapter": 0
  },
  {
   "start": 13.3,
   "end": 14.82,
   "text": "Ik ben Frans van den Berge.",
   "chapter": 0
  },
  {
   "start": 14.82,
   "end": 16.22,
   "text": "Dit zijn de koppen.",
   "chapter": 0
  },
  {
   "start": 16.22,
   "end": 21.26,
   "text": "Europese onderzoekers stellen voor wanneer ingezameld textiel geen afval meer is.",
   "chapter": 0
  },
  {
   "start": 21.26,
   "end": 25.98,
   "text": "Het Italiaanse Itelyum neemt de Franse afvalolietak van Veolia over.",
   "chapter": 0
  },
  {
   "start": 25.98,
   "end": 33.02,
   "text": "En drie Nederlandse techbedrijven krijgen samen ruim achtentwintig miljoen euro uit Brussel, onder meer voor batterijrecycling.",
   "chapter": 0
  },
  {
   "start": 35.36,
   "end": 43.2,
   "text": "Het onderzoekscentrum van de Europese Commissie heeft voorstellen gedaan voor het moment waarop ingezameld textiel geen afval meer is.",
   "chapter": 1
  },
  {
   "start": 43.2,
   "end": 45.36,
   "text": "Dat meldt het vakblad Euwid.",
   "chapter": 1
  },
  {
   "start": 45.36,
   "end": 47.12,
   "text": "Het gaat om twee rapporten.",
   "chapter": 1
  },
  {
   "start": 47.12,
   "end": 54.16,
   "text": "Het ene gaat over kleding en schoenen die opnieuw gedragen kunnen worden, het andere over textiel dat wordt gerecycled.",
   "chapter": 1
  },
  {
   "start": 54.16,
   "end": 60.24,
   "text": "Herbruikbaar textiel verliest de afvalstatus na het sorteren, en zo nodig na verdere bewerking.",
   "chapter": 1
  },
  {
   "start": 60.24,
   "end": 62.8,
   "text": "De stukken moeten schoon en bruikbaar zijn.",
   "chapter": 1
  },
  {
   "start": 62.8,
   "end": 67.36,
   "text": "Kleine gebreken mogen, zolang ze de functie en de veiligheid niet aantasten.",
   "chapter": 1
  },
  {
   "start": 67.36,
   "end": 71.92,
   "text": "Belanghebbenden waarschuwden dat eisen aan het uiterlijk niet te streng moeten worden.",
   "chapter": 1
  },
  {
   "start": 71.92,
   "end": 79.72,
   "text": "Het doel is één set regels voor alle lidstaten, zodat de handel in tweedehands kleding en gerecyclede vezels eenvoudiger wordt.",
   "chapter": 1
  },
  {
   "start": 79.72,
   "end": 83.17,
   "text": "De Commissie zei eerder dat een wetsvoorstel dit kwartaal kan volgen.",
   "chapter": 1
  },
  {
   "start": 85.5,
   "end": 91.34,
   "text": "De Italiaanse recycler Itelyum neemt de Franse afvalolie-activiteiten van Veolia over.",
   "chapter": 2
  },
  {
   "start": 91.34,
   "end": 93.02,
   "text": "Dat meldt Euwid.",
   "chapter": 2
  },
  {
   "start": 93.02,
   "end": 99.5,
   "text": "Het gaat om de raffinaderij Osilub en om de inzamelbedrijven Sevia en Faure Collecte d'Huiles.",
   "chapter": 2
  },
  {
   "start": 99.5,
   "end": 103.58,
   "text": "Ook activiteiten in oude autobanden maken deel uit van de verkoop.",
   "chapter": 2
  },
  {
   "start": 103.58,
   "end": 108.38,
   "text": "Veolia kondigde in zijn kwartaalcijfers al aan dat het van deze tak af wilde.",
   "chapter": 2
  },
  {
   "start": 108.38,
   "end": 116.06,
   "text": "Itelyum heeft in Italië twee raffinaderijen die samen meer dan tweehonderdduizend ton afgewerkte olie per jaar verwerken.",
   "chapter": 2
  },
  {
   "start": 116.06,
   "end": 123.1,
   "text": "Na de overname wordt het bedrijf naar eigen zeggen de grootste Europese producent van geregenereerde basisolie.",
   "chapter": 2
  },
  {
   "start": 123.1,
   "end": 128.38,
   "text": "De vergunde capaciteit komt dan op ongeveer driehonderdvijfendertigduizend ton per jaar.",
   "chapter": 2
  },
  {
   "start": 128.38,
   "end": 133.42,
   "text": "Itelyum overweegt bovendien in Frankrijk hoogwaardige basisolie te gaan maken.",
   "chapter": 2
  },
  {
   "start": 133.42,
   "end": 137.88,
   "text": "De markt voor afgewerkte olie komt zo in handen van minder, maar grotere spelers.",
   "chapter": 2
  },
  {
   "start": 140.22,
   "end": 147.18,
   "text": "Drie Nederlandse techbedrijven krijgen samen achtentwintig komma vier miljoen euro van de Europese Innovatieraad.",
   "chapter": 3
  },
  {
   "start": 147.18,
   "end": 152.22,
   "text": "Dat meldt Duurzaam Ondernemen, op basis van de Rijksdienst voor Ondernemend Nederland.",
   "chapter": 3
  },
  {
   "start": 152.22,
   "end": 158.62,
   "text": "Back to Battery recyclet zwarte massa, het poeder dat overblijft als oude batterijen worden vermalen.",
   "chapter": 3
  },
  {
   "start": 158.62,
   "end": 163.26,
   "text": "Daarin zitten lithium, nikkel, kobalt, mangaan en grafiet.",
   "chapter": 3
  },
  {
   "start": 163.26,
   "end": 168.46,
   "text": "Het bedrijf wint die terug in een gesloten kringloop, met weinig energie en chemicaliën.",
   "chapter": 3
  },
  {
   "start": 168.46,
   "end": 175.42,
   "text": "Recell maakt van afvalwater industriële suikers, voor biobrandstof, bouwmaterialen en groene chemie.",
   "chapter": 3
  },
  {
   "start": 175.42,
   "end": 179.98,
   "text": "LeydenJar ontwikkelt een dunnere anode voor batterijen met meer energie.",
   "chapter": 3
  },
  {
   "start": 179.98,
   "end": 185.94,
   "text": "Volgens Euwid verbood India vorige week de export van zwarte massa, om de eigen recycling te versterken.",
   "chapter": 3
  },
  {
   "start": 188.27,
   "end": 194.75,
   "text": "De Routekaart Remanufacturing is uitgebreid met ervaringen van elf bedrijven uit de provincie Utrecht.",
   "chapter": 4
  },
  {
   "start": 194.75,
   "end": 200.19,
   "text": "Dat meldt Duurzaam Ondernemen, op basis van het programma Circulaire Maakindustrie.",
   "chapter": 4
  },
  {
   "start": 200.19,
   "end": 207.63,
   "text": "De routekaart helpt fabrikanten in zeven stappen om gebruikte producten terug te halen, te herstellen en opnieuw te verkopen.",
   "chapter": 4
  },
  {
   "start": 207.63,
   "end": 212.19,
   "text": "Eerder deden al bedrijven uit Overijssel, Gelderland en Zuid-Holland mee.",
   "chapter": 4
  },
  {
   "start": 212.19,
   "end": 218.35,
   "text": "De nieuwe verhalen komen onder meer van Van Straten Medical en Lekkerkerker Dairy and Food Equipment.",
   "chapter": 4
  },
  {
   "start": 218.35,
   "end": 224.75,
   "text": "Ze gaan over het opknappen van machines en onderdelen, over upgrades en over een langere levensduur.",
   "chapter": 4
  },
  {
   "start": 224.75,
   "end": 229.07,
   "text": "Sommige bedrijven verdienen er al geld mee, andere zijn nog aan het verkennen.",
   "chapter": 4
  },
  {
   "start": 229.07,
   "end": 234.91,
   "text": "Op donderdag tien december volgt een bijeenkomst in Lopik voor machinebouwers en toeleveranciers.",
   "chapter": 4
  },
  {
   "start": 234.91,
   "end": 238.55,
   "text": "Voor inkopers groeit zo het aanbod van gereviseerde apparatuur.",
   "chapter": 4
  },
  {
   "start": 240.89,
   "end": 243.93,
   "text": "En wat betekent dit voor uw organisatie?",
   "chapter": 5
  },
  {
   "start": 243.93,
   "end": 248.01,
   "text": "De rode draad van vandaag is de grens tussen afval en product.",
   "chapter": 5
  },
  {
   "start": 248.01,
   "end": 252.73,
   "text": "Die grens bepaalt wat u mag verhandelen, vervoeren en opnieuw inzetten.",
   "chapter": 5
  },
  {
   "start": 252.73,
   "end": 255.85,
   "text": "Voor textiel komt daar nu Europese duidelijkheid over.",
   "chapter": 5
  },
  {
   "start": 255.85,
   "end": 262.89,
   "text": "Voor olie, batterijen en machines laat de markt zien dat herstel en terugwinning volwassen bedrijfstakken worden.",
   "chapter": 5
  },
  {
   "start": 262.89,
   "end": 267.77,
   "text": "Bij De Graaf Groep zien we dat schone, goed gescheiden stromen daarbij het verschil maken.",
   "chapter": 5
  },
  {
   "start": 267.77,
   "end": 272.49,
   "text": "Kijk daarom welke afgedankte spullen in uw organisatie nog product kunnen zijn.",
   "chapter": 5
  },
  {
   "start": 272.49,
   "end": 275.43,
   "text": "En vraag uw leveranciers naar gereviseerde alternatieven.",
   "chapter": 5
  },
  {
   "start": 275.88,
   "end": 279.48,
   "text": "Het cijfer van de dag is bijna negentig procent.",
   "chapter": 6
  },
  {
   "start": 279.48,
   "end": 288.04,
   "text": "Zo groot is naar schatting het aandeel van China in de wereldwijde capaciteit om zwarte massa uit oude batterijen te raffineren, meldt Euwid.",
   "chapter": 6
  },
  {
   "start": 288.04,
   "end": 291.93,
   "text": "Het verklaart waarom Europa en India eigen recycling willen opbouwen.",
   "chapter": 6
  },
  {
   "start": 292.38,
   "end": 294.78,
   "text": "Dat was Grondstof voor vandaag.",
   "chapter": 7
  },
  {
   "start": 294.78,
   "end": 298.62,
   "text": "De bronnen bij elk bericht vindt u in de app en in de shownotes.",
   "chapter": 7
  },
  {
   "start": 298.62,
   "end": 300.94,
   "text": "Morgen om negen uur bent u weer bij.",
   "chapter": 7
  },
  {
   "start": 300.94,
   "end": 301.38,
   "text": "Tot dan.",
   "chapter": 7
  }
 ],
