 "transcript": [
  {
   "start": 5.5,
   "end": 6.54,
   "text": "Goedemorgen.",
   "chapter": 0
  },
  {
   "start": 6.54,
   "end": 8.7,
   "text": "Het is vrijdag dertien november.",
   "chapter": 0
  },
  {
   "start": 8.7,
   "end": 13.26,
   "text": "U luistert naar Grondstof, het circulaire nieuwsbulletin van De Graaf Groep.",
   "chapter": 0
  },
  {
   "start": 13.26,
   "end": 14.86,
   "text": "Ik ben Frans van den Berge.",
   "chapter": 0
  },
  {
   "start": 14.86,
   "end": 16.62,
   "text": "Dit zijn de koppen.",
   "chapter": 0
  },
  {
   "start": 16.62,
   "end": 24.06,
   "text": "Het kabinet past de Nederlandse wet voor duurzaamheidsverslagen aan: alleen de grootste bedrijven moeten nog rapporteren.",
   "chapter": 0
  },
  {
   "start": 24.06,
   "end": 30.62,
   "text": "Een heffing op nieuw fossiel materiaal kan honderden miljoenen opleveren voor circulaire alternatieven.",
   "chapter": 0
  },
  {
   "start": 30.62,
   "end": 36.22,
   "text": "En Europese bedrijven in hergebruik groeien en zoeken samen honderden nieuwe medewerkers.",
   "chapter": 0
  },
  {
   "start": 38.56,
   "end": 44.48,
   "text": "Het kabinet past de Nederlandse wet voor duurzaamheidsrapportage aan de Europese omnibus aan.",
   "chapter": 1
  },
  {
   "start": 44.48,
   "end": 50.0,
   "text": "Een gewijzigd wetsvoorstel ging woensdag naar de Tweede Kamer, meldt Duurzaam Ondernemen.",
   "chapter": 1
  },
  {
   "start": 50.0,
   "end": 57.6,
   "text": "Vanaf boekjaar tweeduizend zevenentwintig moeten alleen bedrijven rapporteren met meer dan vierhonderdvijftig miljoen euro omzet.",
   "chapter": 1
  },
  {
   "start": 57.6,
   "end": 61.44,
   "text": "Daarnaast moeten zij gemiddeld meer dan duizend werknemers hebben.",
   "chapter": 1
  },
  {
   "start": 61.44,
   "end": 66.08,
   "text": "Beide eisen gelden tegelijk, en een beursnotering maakt niet uit.",
   "chapter": 1
  },
  {
   "start": 66.08,
   "end": 72.16,
   "text": "Rapportageplichtige bedrijven moeten het verslag minstens één keer per jaar met de ondernemingsraad bespreken.",
   "chapter": 1
  },
  {
   "start": 72.16,
   "end": 76.0,
   "text": "Het bestuursverslag moet gratis op de eigen website staan.",
   "chapter": 1
  },
  {
   "start": 76.0,
   "end": 81.52,
   "text": "Ook wordt de keten beschermd tegen ongebreidelde informatieverzoeken van grote bedrijven.",
   "chapter": 1
  },
  {
   "start": 81.52,
   "end": 88.26,
   "text": "De lidstaten moeten de Europese wijziging uiterlijk negentien maart tweeduizend zevenentwintig in hun wetgeving hebben verwerkt.",
   "chapter": 1
  },
  {
   "start": 90.59,
   "end": 97.07,
   "text": "Een heffing op nieuw fossiel materiaal kan jaarlijks tot zevenhonderdtwee kiloton CO-twee besparen.",
   "chapter": 2
  },
  {
   "start": 97.07,
   "end": 102.43,
   "text": "Dat blijkt uit een impactstudie van onderzoeksbureau Trinomics, meldt Duurzaam Ondernemen.",
   "chapter": 2
  },
  {
   "start": 102.43,
   "end": 106.83,
   "text": "Het voorstel heet de circulaire hefboom en komt van Future Up.",
   "chapter": 2
  },
  {
   "start": 106.83,
   "end": 110.99,
   "text": "Bedrijven betalen dan een heffing op nieuw gebruikte fossiele materialen.",
   "chapter": 2
  },
  {
   "start": 110.99,
   "end": 116.43,
   "text": "De opbrengst gaat naar een fonds dat investeert in gerecyclede en biobased alternatieven.",
   "chapter": 2
  },
  {
   "start": 116.43,
   "end": 122.67,
   "text": "Het onderzoek kijkt naar textiel, meubels, matrassen, bouwmaterialen en elektrische apparaten.",
   "chapter": 2
  },
  {
   "start": 122.67,
   "end": 128.43,
   "text": "Het gebruik van nieuw fossiel plastic daalt volgens de studie met acht tot vijfendertig procent.",
   "chapter": 2
  },
  {
   "start": 128.43,
   "end": 133.39,
   "text": "Het fonds krijgt tussen de tweehonderdveertien en vierhonderdnegen miljoen euro per jaar.",
   "chapter": 2
  },
  {
   "start": 133.39,
   "end": 140.11,
   "text": "Dat is drie tot bijna zes keer het huidige budget voor circulaire economie van het ministerie van Economische Zaken.",
   "chapter": 2
  },
  {
   "start": 140.11,
   "end": 146.32,
   "text": "Het kabinet besluit in het voorjaar van tweeduizend zevenentwintig of de heffing er komt voor textiel en bouwmaterialen.",
   "chapter": 2
  },
  {
   "start": 148.66,
   "end": 152.74,
   "text": "De Europese markt voor herbruikbare verpakkingen wordt volwassener.",
   "chapter": 3
  },
  {
   "start": 152.74,
   "end": 159.14,
   "text": "Dat blijkt uit de derde Europese Hergebruikbarometer, die woensdag in Utrecht werd gepresenteerd.",
   "chapter": 3
  },
  {
   "start": 159.14,
   "end": 166.18,
   "text": "Het onderzoek is van de New European Reuse Alliance en Zero Waste Europe, met financiering van Verpact.",
   "chapter": 3
  },
  {
   "start": 166.18,
   "end": 169.74,
   "text": "Honderddertig hergebruik- en navulbedrijven deden mee.",
   "chapter": 3
  },
  {
   "start": 169.74,
   "end": 174.5,
   "text": "Zevenenzeventig procent zit in de opschaalfase of is al op de markt.",
   "chapter": 3
  },
  {
   "start": 174.5,
   "end": 181.58,
   "text": "In zakelijk transport melden acht van de elf bedrijven een retourpercentage van meer dan vijfennegentig procent.",
   "chapter": 3
  },
  {
   "start": 181.58,
   "end": 189.62,
   "text": "Vijfennegentig procent van de ondervraagde bedrijven wil binnen twee jaar personeel werven, samen ongeveer zeshonderdnegentig banen.",
   "chapter": 3
  },
  {
   "start": 189.62,
   "end": 191.98,
   "text": "Wel vragen de bedrijven om steun.",
   "chapter": 3
  },
  {
   "start": 191.98,
   "end": 197.14,
   "text": "Zeventig procent wil een belasting op wegwerpverpakkingen als er een herbruikbaar alternatief bestaat.",
   "chapter": 3
  },
  {
   "start": 199.48,
   "end": 207.16,
   "text": "De Europese Unie verspilde in tweeduizend vierentwintig ongeveer zevenenvijftig komma negen miljoen ton voedsel.",
   "chapter": 4
  },
  {
   "start": 207.16,
   "end": 211.56,
   "text": "Dat blijkt uit nieuwe cijfers van Eurostat, meldt het vakblad Euwid.",
   "chapter": 4
  },
  {
   "start": 211.56,
   "end": 215.64,
   "text": "Het is ongeveer vierhonderdduizend ton meer dan een jaar eerder.",
   "chapter": 4
  },
  {
   "start": 215.64,
   "end": 221.16,
   "text": "Het is ook de hoogste hoeveelheid sinds de jaarlijkse metingen in tweeduizend twintig begonnen.",
   "chapter": 4
  },
  {
   "start": 221.16,
   "end": 225.72,
   "text": "Cyprus en Denemarken hebben per inwoner de meeste voedselverspilling.",
   "chapter": 4
  },
  {
   "start": 225.72,
   "end": 229.24,
   "text": "De cijfers staan op gespannen voet met de Europese doelen.",
   "chapter": 4
  },
  {
   "start": 229.24,
   "end": 235.8,
   "text": "Volgens de herziene kaderrichtlijn afvalstoffen moet de verspilling in tweeduizend dertig fors lager zijn.",
   "chapter": 4
  },
  {
   "start": 235.8,
   "end": 239.32,
   "text": "Voor verwerking en productie gaat het om tien procent minder.",
   "chapter": 4
  },
  {
   "start": 239.32,
   "end": 244.04,
   "text": "Voor winkels, restaurants en huishoudens geldt dertig procent minder.",
   "chapter": 4
  },
  {
   "start": 244.04,
   "end": 250.02,
   "text": "Beide doelen gelden ten opzichte van het gemiddelde van tweeduizend eenentwintig tot en met tweeduizend drieëntwintig.",
   "chapter": 4
  },
  {
   "start": 252.35,
   "end": 255.23,
   "text": "En wat betekent dit voor uw organisatie?",
   "chapter": 5
  },
  {
   "start": 255.23,
   "end": 260.75,
   "text": "Ook als u straks niet meer onder de rapportageplicht valt, verdwijnt de vraag naar cijfers niet.",
   "chapter": 5
  },
  {
   "start": 260.75,
   "end": 268.59,
   "text": "Klanten, banken en aanbestedende diensten blijven vragen hoeveel afval u produceert en hoeveel daarvan wordt gerecycled.",
   "chapter": 5
  },
  {
   "start": 268.59,
   "end": 272.27,
   "text": "Zorg dus dat die gegevens per afvalstroom op orde zijn.",
   "chapter": 5
  },
  {
   "start": 272.27,
   "end": 275.23,
   "text": "Kijk daarnaast naar hergebruik op de werkvloer.",
   "chapter": 5
  },
  {
   "start": 275.23,
   "end": 280.11,
   "text": "De retourcijfers uit de barometer laten zien dat gesloten systemen goed werken.",
   "chapter": 5
  },
  {
   "start": 280.11,
   "end": 283.39,
   "text": "Denk aan herbruikbare bekers bij de koffieautomaat.",
   "chapter": 5
  },
  {
   "start": 283.39,
   "end": 289.49,
   "text": "En wie bedrijfsrestaurants of kantines heeft, kan het gft en de etensresten apart laten inzamelen.",
   "chapter": 5
  },
  {
   "start": 289.94,
   "end": 293.3,
   "text": "Het cijfer van de dag is vierhonderdvijftig.",
   "chapter": 6
  },
  {
   "start": 293.3,
   "end": 300.9,
   "text": "Zoveel miljoen euro omzet moet een bedrijf straks minstens hebben om onder de Nederlandse rapportageplicht voor duurzaamheid te vallen.",
   "chapter": 6
  },
  {
   "start": 300.9,
   "end": 303.89,
   "text": "Daarnaast moet het gemiddeld meer dan duizend werknemers hebben.",
   "chapter": 6
  },
  {
   "start": 304.34,
   "end": 306.66,
   "text": "Dat was Grondstof voor vandaag.",
   "chapter": 7
  },
  {
   "start": 306.66,
   "end": 310.34,
   "text": "De bronnen bij elk bericht vindt u in de app en in de shownotes.",
   "chapter": 7
  },
  {
   "start": 310.34,
   "end": 312.58,
   "text": "Morgen om negen uur bent u weer bij.",
   "chapter": 7
  },
  {
   "start": 312.58,
   "end": 314.19,
   "text": "Fijn weekend en tot dan.",
   "chapter": 7
  }
 ],
