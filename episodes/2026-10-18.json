 "transcript": [
  {
   "start": 5.5,
   "end": 6.54,
   "text": "Goedemorgen.",
   "chapter": 0
  },
  {
   "start": 6.54,
   "end": 8.78,
   "text": "Het is zondag achttien oktober.",
   "chapter": 0
  },
  {
   "start": 8.78,
   "end": 13.18,
   "text": "U luistert naar Grondstof, het circulaire nieuwsbulletin van De Graaf Groep.",
   "chapter": 0
  },
  {
   "start": 13.18,
   "end": 14.7,
   "text": "Ik ben Frans van den Berge.",
   "chapter": 0
  },
  {
   "start": 14.7,
   "end": 15.98,
   "text": "Dit zijn de koppen.",
   "chapter": 0
  },
  {
   "start": 15.98,
   "end": 19.9,
   "text": "Europa kiest zesenveertig strategische grondstofprojecten.",
   "chapter": 0
  },
  {
   "start": 19.9,
   "end": 22.3,
   "text": "Koperschroot volgt de beurs omhoog.",
   "chapter": 0
  },
  {
   "start": 22.3,
   "end": 28.44,
   "text": "En BioBTX krijgt twintig komma acht miljoen euro Europese steun voor een fabriek in Delfzijl.",
   "chapter": 0
  },
  {
   "start": 30.78,
   "end": 37.18,
   "text": "De Europese Commissie heeft vorige week de tweede selectie van strategische grondstofprojecten bekendgemaakt.",
   "chapter": 1
  },
  {
   "start": 37.18,
   "end": 39.5,
   "text": "Dat meldt het vakblad Euwid.",
   "chapter": 1
  },
  {
   "start": 39.5,
   "end": 43.26,
   "text": "Het gaat om zesenveertig projecten in zestien lidstaten.",
   "chapter": 1
  },
  {
   "start": 43.26,
   "end": 45.26,
   "text": "Duitsland levert er acht.",
   "chapter": 1
  },
  {
   "start": 45.26,
   "end": 49.26,
   "text": "Frankrijk, Italië en Finland leveren er elk vijf.",
   "chapter": 1
  },
  {
   "start": 49.26,
   "end": 52.78,
   "text": "Volgens Euwid ligt de nadruk nu meer op recycling.",
   "chapter": 1
  },
  {
   "start": 52.78,
   "end": 56.66,
   "text": "Er kwamen honderdtwee aanvragen binnen uit achttien lidstaten.",
   "chapter": 1
  },
  {
   "start": 56.66,
   "end": 59.26,
   "text": "Tweeënnegentig daarvan zijn beoordeeld.",
   "chapter": 1
  },
  {
   "start": 59.26,
   "end": 67.26,
   "text": "Samen vragen de projecten om een investering van ongeveer eenentwintig komma een miljard euro, uit publiek en privaat geld.",
   "chapter": 1
  },
  {
   "start": 67.26,
   "end": 72.22,
   "text": "Voor verwerking en recycling geldt een vergunningstermijn van maximaal vijftien maanden.",
   "chapter": 1
  },
  {
   "start": 72.22,
   "end": 75.34,
   "text": "Voor winning is dat zevenentwintig maanden.",
   "chapter": 1
  },
  {
   "start": 75.34,
   "end": 80.38,
   "text": "De Duitse grondstoffenorganisatie Dera noemt financiering de grootste horde.",
   "chapter": 1
  },
  {
   "start": 80.38,
   "end": 83.5,
   "text": "De uitvoering is volgens haar de echte test.",
   "chapter": 1
  },
  {
   "start": 83.5,
   "end": 86.38,
   "text": "De Commissie wil eind dit jaar een nieuwe oproep openen.",
   "chapter": 1
  },
  {
   "start": 88.71,
   "end": 95.5,
   "text": "De koperprijs op de metaalbeurs in Londen kwam begin vorige week boven veertienduizend zeshonderd dollar per ton.",
   "chapter": 2
  },
  {
   "start": 95.5,
   "end": 98.38,
   "text": "Dat is dicht bij het record van half september.",
   "chapter": 2
  },
  {
   "start": 98.38,
   "end": 100.7,
   "text": "Daarna verloor de prijs weer wat terrein.",
   "chapter": 2
  },
  {
   "start": 100.7,
   "end": 102.14,
   "text": "Dat meldt Euwid.",
   "chapter": 2
  },
  {
   "start": 102.14,
   "end": 111.82,
   "text": "Op de Duitse groothandelsmarkt steeg de inkoopprijs van koperschroot met vijfentwintig euro per honderd kilo ten opzichte van een week eerder, volgens een Duits persbureau.",
   "chapter": 2
  },
  {
   "start": 111.82,
   "end": 117.98,
   "text": "Ook messingschroot werd tien tot vijftien euro duurder per honderd kilo, afhankelijk van de kwaliteit.",
   "chapter": 2
  },
  {
   "start": 117.98,
   "end": 120.54,
   "text": "Roodmessing steeg met tien euro.",
   "chapter": 2
  },
  {
   "start": 120.54,
   "end": 123.82,
   "text": "Zinkschroot en aluminiumschroot werden juist goedkoper.",
   "chapter": 2
  },
  {
   "start": 123.82,
   "end": 127.98,
   "text": "Zink verloor vijf euro, aluminium vijf tot tien euro.",
   "chapter": 2
  },
  {
   "start": 127.98,
   "end": 131.5,
   "text": "Euwid wijt dat aan zwakkere signalen van de metaalbeurzen.",
   "chapter": 2
  },
  {
   "start": 131.5,
   "end": 133.65,
   "text": "Metaalschroot volgt de beurs dus dicht.",
   "chapter": 2
  },
  {
   "start": 135.99,
   "end": 142.87,
   "text": "Het Groningse bedrijf BioBTX krijgt twintig komma acht miljoen euro uit het Europese Innovatiefonds.",
   "chapter": 3
  },
  {
   "start": 142.87,
   "end": 144.79,
   "text": "Dat meldt Industrielinqs.",
   "chapter": 3
  },
  {
   "start": 144.79,
   "end": 149.75,
   "text": "De subsidieovereenkomst met het Europese uitvoeringsagentschap is al getekend.",
   "chapter": 3
  },
  {
   "start": 149.75,
   "end": 154.07,
   "text": "Het geld is bestemd voor de fabriek Petra op het Chemiepark in Delfzijl.",
   "chapter": 3
  },
  {
   "start": 154.07,
   "end": 158.23,
   "text": "BioBTX nam in juli het definitieve investeringsbesluit.",
   "chapter": 3
  },
  {
   "start": 158.23,
   "end": 164.39,
   "text": "Petra verwerkt jaarlijks ongeveer twintigduizend ton plastic afval dat niet mechanisch te recyclen is.",
   "chapter": 3
  },
  {
   "start": 164.39,
   "end": 170.07,
   "text": "Daaruit komt ongeveer tienduizend ton olie, rijk aan benzeen, tolueen en xyleen.",
   "chapter": 3
  },
  {
   "start": 170.07,
   "end": 173.75,
   "text": "Die stoffen dienen als grondstof voor kunststoffen en medicijnen.",
   "chapter": 3
  },
  {
   "start": 173.75,
   "end": 177.67,
   "text": "Nu komt meer dan negenennegentig procent ervan uit fossiele bronnen.",
   "chapter": 3
  },
  {
   "start": 177.67,
   "end": 180.79,
   "text": "De fabriek biedt werk aan ongeveer vijfendertig mensen.",
   "chapter": 3
  },
  {
   "start": 180.79,
   "end": 184.18,
   "text": "BioBTX wil de technologie later ook elders toepassen.",
   "chapter": 3
  },
  {
   "start": 186.51,
   "end": 190.35,
   "text": "Twee Europese afvalbedrijven krijgen nieuwe eigenaren.",
   "chapter": 4
  },
  {
   "start": 190.35,
   "end": 199.15,
   "text": "Het Canadese pensioenfonds Alberta Investment Management Corporation koopt samen met twee andere investeerders de helft van het Britse Viridor.",
   "chapter": 4
  },
  {
   "start": 199.15,
   "end": 204.59,
   "text": "De verkoper is investeerder Kohlberg Kravis Roberts, die de andere helft voorlopig houdt.",
   "chapter": 4
  },
  {
   "start": 204.59,
   "end": 206.51,
   "text": "De prijs is niet bekend.",
   "chapter": 4
  },
  {
   "start": 206.51,
   "end": 211.95,
   "text": "Viridor heeft volgens de koper twaalf afvalenergiecentrales, met twee in aanbouw.",
   "chapter": 4
  },
  {
   "start": 211.95,
   "end": 218.35,
   "text": "Ook Paprec uit Frankrijk koopt de Tsjechische en Slowaakse activiteiten van het Deense Marius Pedersen.",
   "chapter": 4
  },
  {
   "start": 218.35,
   "end": 224.35,
   "text": "Het gaat om negenenveertig dochterbedrijven en deelnemingen met ruim vierduizendvijfhonderd medewerkers.",
   "chapter": 4
  },
  {
   "start": 224.35,
   "end": 227.71,
   "text": "De overname moet nog langs de mededingingsautoriteiten.",
   "chapter": 4
  },
  {
   "start": 227.71,
   "end": 229.46,
   "text": "Beide berichten komen van Euwid.",
   "chapter": 4
  },
  {
   "start": 231.8,
   "end": 234.52,
   "text": "En wat betekent dit voor uw organisatie?",
   "chapter": 5
  },
  {
   "start": 234.52,
   "end": 235.48,
   "text": "Drie dingen.",
   "chapter": 5
  },
  {
   "start": 235.48,
   "end": 239.56,
   "text": "Ten eerste beweegt de prijs van metaalschroot mee met de beurs.",
   "chapter": 5
  },
  {
   "start": 239.56,
   "end": 244.12,
   "text": "Wie schroot verkoopt, kan daarom prijsafspraken met een korte looptijd overwegen.",
   "chapter": 5
  },
  {
   "start": 244.12,
   "end": 247.0,
   "text": "Ten tweede worden grondstoffen strategisch.",
   "chapter": 5
  },
  {
   "start": 247.0,
   "end": 251.16,
   "text": "Europa wil meer metalen uit eigen bodem en uit recycling halen.",
   "chapter": 5
  },
  {
   "start": 251.16,
   "end": 254.68,
   "text": "Dat maakt een zuivere scheiding van uw reststromen waardevoller.",
   "chapter": 5
  },
  {
   "start": 254.68,
   "end": 258.76,
   "text": "Ten derde komt chemische recycling van lastig plastic dichterbij.",
   "chapter": 5
  },
  {
   "start": 258.76,
   "end": 262.36,
   "text": "Vraag uw afvalpartner welke stromen daarvoor in aanmerking komen.",
   "chapter": 5
  },
  {
   "start": 262.36,
   "end": 266.16,
   "text": "Bij De Graaf Groep zien wij dat inzameling aan de bron de basis blijft.",
   "chapter": 5
  },
  {
   "start": 266.61,
   "end": 271.85,
   "text": "Het cijfer van de dag is meer dan vijfhonderdzeventienduizend ton CO-twee.",
   "chapter": 6
  },
  {
   "start": 271.85,
   "end": 277.49,
   "text": "Zoveel uitstoot kan de Petra-fabriek van BioBTX in Delfzijl in tien jaar vermijden.",
   "chapter": 6
  },
  {
   "start": 277.49,
   "end": 284.37,
   "text": "Dat is tweeënzeventig procent minder dan bij gangbare productie van deze grondstoffen en het verbranden van plastic afval.",
   "chapter": 6
  },
  {
   "start": 284.37,
   "end": 287.75,
   "text": "De berekening volgt de methode van het Europese Innovatiefonds.",
   "chapter": 6
  },
  {
   "start": 288.2,
   "end": 290.6,
   "text": "Dat was Grondstof voor vandaag.",
   "chapter": 7
  },
  {
   "start": 290.6,
   "end": 294.36,
   "text": "De bronnen bij elk bericht vindt u in de app en in de shownotes.",
   "chapter": 7
  },
  {
   "start": 294.36,
   "end": 296.68,
   "text": "Morgen om negen uur bent u weer bij.",
   "chapter": 7
  },
  {
   "start": 296.68,
   "end": 298.33,
   "text": "Een fijne zondag en tot dan.",
   "chapter": 7
  }
 ],
