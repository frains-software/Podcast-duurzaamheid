 "transcript": [
  {
   "start": 5.5,
   "end": 6.46,
   "text": "Goedemorgen.",
   "chapter": 0
  },
  {
   "start": 6.46,
   "end": 8.7,
   "text": "Het is zaterdag tien oktober.",
   "chapter": 0
  },
  {
   "start": 8.7,
   "end": 13.18,
   "text": "U luistert naar Grondstof, het circulaire nieuwsbulletin van De Graaf Groep.",
   "chapter": 0
  },
  {
   "start": 13.18,
   "end": 14.78,
   "text": "Ik ben Frans van den Berge.",
   "chapter": 0
  },
  {
   "start": 14.78,
   "end": 16.22,
   "text": "Dit zijn de koppen.",
   "chapter": 0
  },
  {
   "start": 16.22,
   "end": 22.3,
   "text": "Brussel wijst vier Nederlandse recyclingprojecten aan als strategisch voor kritieke grondstoffen.",
   "chapter": 0
  },
  {
   "start": 22.3,
   "end": 27.98,
   "text": "Fabrikanten van banken, bedden en keukenkasten moeten hun oude meubels gaan inzamelen.",
   "chapter": 0
  },
  {
   "start": 27.98,
   "end": 32.77,
   "text": "En een Nederlands bedrijf plant een grote fabriek voor chemische recycling van plastic.",
   "chapter": 0
  },
  {
   "start": 35.11,
   "end": 42.07,
   "text": "De Europese Commissie heeft vrijdag zesenveertig nieuwe strategische projecten voor kritieke grondstoffen aangewezen.",
   "chapter": 1
  },
  {
   "start": 42.07,
   "end": 44.83,
   "text": "Negentien projecten draaien om recycling.",
   "chapter": 1
  },
  {
   "start": 44.83,
   "end": 48.23,
   "text": "Vier projecten zijn Nederlands, meldt de Rijksoverheid.",
   "chapter": 1
  },
  {
   "start": 48.23,
   "end": 53.75,
   "text": "Myne Circular Metals maakt van laagwaardig schroot hoogwaardig aluminium en koper.",
   "chapter": 1
  },
  {
   "start": 53.75,
   "end": 59.99,
   "text": "Back to Battery haalt lithium, kobalt, nikkel, mangaan en grafiet uit afgedankte batterijen.",
   "chapter": 1
  },
  {
   "start": 59.99,
   "end": 63.19,
   "text": "Critical wint metalen terug uit oude printplaten.",
   "chapter": 1
  },
  {
   "start": 63.19,
   "end": 68.15,
   "text": "En Mitsubishi Materials wint koper en wolfraam terug uit elektronisch afval.",
   "chapter": 1
  },
  {
   "start": 68.15,
   "end": 73.03,
   "text": "Het label geeft hulp bij vergunningen en betere toegang tot Europese financiering.",
   "chapter": 1
  },
  {
   "start": 73.03,
   "end": 77.59,
   "text": "Minister Heleen Herbert van Economische Zaken en Klimaat noemt het goed nieuws.",
   "chapter": 1
  },
  {
   "start": 77.59,
   "end": 83.99,
   "text": "Volgens Eurocommissaris Stéphane Séjourné is het doel minder afhankelijkheid en meer productie in Europa.",
   "chapter": 1
  },
  {
   "start": 83.99,
   "end": 91.32,
   "text": "Volgens EUobserver blijkt wel uit cijfers van de Commissie zelf dat weinig Europees geld de projecten van vorig jaar heeft bereikt.",
   "chapter": 1
  },
  {
   "start": 93.65,
   "end": 99.97,
   "text": "Fabrikanten en importeurs van meubels worden verantwoordelijk voor het inzamelen en recyclen van hun producten.",
   "chapter": 2
  },
  {
   "start": 99.97,
   "end": 101.73,
   "text": "Dat meldt de NOS.",
   "chapter": 2
  },
  {
   "start": 101.73,
   "end": 105.73,
   "text": "Het gaat om producten als banken, keukenkasten en bedden.",
   "chapter": 2
  },
  {
   "start": 105.73,
   "end": 111.73,
   "text": "Uiterlijk in tweeduizend dertig moet dat geregeld zijn, net als nu al bij plastic flesjes en blikjes.",
   "chapter": 2
  },
  {
   "start": 111.73,
   "end": 115.17,
   "text": "Het kabinet verwacht dit najaar een eerste conceptplan.",
   "chapter": 2
  },
  {
   "start": 115.17,
   "end": 119.65,
   "text": "De reden: veel afgedankte meubels belanden nog in de verbrandingsoven.",
   "chapter": 2
  },
  {
   "start": 119.65,
   "end": 122.05,
   "text": "Dat is zonde, vindt het kabinet.",
   "chapter": 2
  },
  {
   "start": 122.05,
   "end": 127.17,
   "text": "Gemeenten en afvalbedrijven halen al meubels uit elkaar in zes demontagehallen.",
   "chapter": 2
  },
  {
   "start": 127.17,
   "end": 134.29,
   "text": "De vereniging van gemeentelijke afvalbedrijven wil duidelijke doelen, zoals een verplicht aandeel gerecycled materiaal.",
   "chapter": 2
  },
  {
   "start": 134.29,
   "end": 136.61,
   "text": "De meubelbranche steunt het principe.",
   "chapter": 2
  },
  {
   "start": 136.61,
   "end": 140.5,
   "text": "Zij wil wel eerst weten hoeveel meubels rendabel te recyclen zijn.",
   "chapter": 2
  },
  {
   "start": 142.84,
   "end": 149.4,
   "text": "Het Nederlandse bedrijf Helix Projects wil een grote fabriek bouwen voor chemische recycling van plastic.",
   "chapter": 3
  },
  {
   "start": 149.4,
   "end": 151.64,
   "text": "Dat meldt het vakblad Euwid.",
   "chapter": 3
  },
  {
   "start": 151.64,
   "end": 155.08,
   "text": "De fabriek moet in tweeduizend eenendertig in bedrijf gaan.",
   "chapter": 3
  },
  {
   "start": 155.08,
   "end": 161.88,
   "text": "Hij moet jaarlijks honderdnegentigduizend ton nafta leveren en twintigduizend ton vloeibaar petroleumgas.",
   "chapter": 3
  },
  {
   "start": 161.88,
   "end": 165.8,
   "text": "Nafta is de grondstof waarmee de chemie nieuwe plastics maakt.",
   "chapter": 3
  },
  {
   "start": 165.8,
   "end": 170.84,
   "text": "Helix wil moeilijk recyclebaar plastic eerst omzetten in pyrolyseolie.",
   "chapter": 3
  },
  {
   "start": 170.84,
   "end": 176.2,
   "text": "Die olie wordt op dezelfde plek opgewaardeerd, zodat hij direct in een stoomkraker kan.",
   "chapter": 3
  },
  {
   "start": 176.2,
   "end": 180.52,
   "text": "Volgens topman Mark Vester is die schaal nodig om concurrerend te zijn.",
   "chapter": 3
  },
  {
   "start": 180.52,
   "end": 183.0,
   "text": "De plannen komen in een lastige markt.",
   "chapter": 3
  },
  {
   "start": 183.0,
   "end": 188.05,
   "text": "Euwid meldt dat de Duitse markt voor kunststofrecyclaat na de zomer nauwelijks herstelt.",
   "chapter": 3
  },
  {
   "start": 190.38,
   "end": 194.46,
   "text": "In Zwolle gaat de afvalstoffenheffing volgend jaar flink omhoog.",
   "chapter": 4
  },
  {
   "start": 194.46,
   "end": 198.7,
   "text": "Het college stelt een stijging voor van eenentwintig komma zes procent.",
   "chapter": 4
  },
  {
   "start": 198.7,
   "end": 201.42,
   "text": "Dat meldt R-T-V Focus Zwolle.",
   "chapter": 4
  },
  {
   "start": 201.42,
   "end": 208.7,
   "text": "Een huishouden van meer personen betaalt dan ruim driehonderddertig euro per jaar, bijna negenenvijftig euro meer.",
   "chapter": 4
  },
  {
   "start": 208.7,
   "end": 217.1,
   "text": "De gemeente wijst op hogere kosten voor inzameling en verwerking, op belastingen en op tegenvallende opbrengsten van ingezamelde grondstoffen.",
   "chapter": 4
  },
  {
   "start": 217.1,
   "end": 220.7,
   "text": "Tegelijk groeit het probleem van afval naast de container.",
   "chapter": 4
  },
  {
   "start": 220.7,
   "end": 228.7,
   "text": "In het eerste halfjaar werden bijna twaalfduizend bijplaatsingen geregistreerd, tegen ruim achtduizend zevenhonderd een jaar eerder.",
   "chapter": 4
  },
  {
   "start": 228.7,
   "end": 232.22,
   "text": "Volgens de gemeente komt dat deels door betere registratie.",
   "chapter": 4
  },
  {
   "start": 232.22,
   "end": 234.44,
   "text": "De gemeenteraad beslist op dertien november.",
   "chapter": 4
  },
  {
   "start": 236.78,
   "end": 239.66,
   "text": "En wat betekent dit voor uw organisatie?",
   "chapter": 5
  },
  {
   "start": 239.66,
   "end": 242.14,
   "text": "De meubelregeling raakt ook kantoren.",
   "chapter": 5
  },
  {
   "start": 242.14,
   "end": 248.46,
   "text": "Wie meubilair inkoopt, doet er goed aan nu al te vragen naar demontage, reparatie en terugname.",
   "chapter": 5
  },
  {
   "start": 248.46,
   "end": 256.3,
   "text": "De Europese keuze voor metaal- en batterijrecycling laat zien dat afgedankte elektronica en batterijen strategische waarde hebben.",
   "chapter": 5
  },
  {
   "start": 256.3,
   "end": 262.22,
   "text": "Bij De Graaf Groep zien wij dat die waarde alleen terugkomt als u deze stromen apart houdt van het restafval.",
   "chapter": 5
  },
  {
   "start": 262.22,
   "end": 265.58,
   "text": "En Zwolle laat zien hoe snel de afvalkosten stijgen.",
   "chapter": 5
  },
  {
   "start": 265.58,
   "end": 269.18,
   "text": "Ook de verbrandingsbelasting blijft stijgen, meldt de NOS.",
   "chapter": 5
  },
  {
   "start": 269.18,
   "end": 272.1,
   "text": "Elke kilo die u goed scheidt, hoeft niet in de oven.",
   "chapter": 5
  },
  {
   "start": 272.55,
   "end": 275.83,
   "text": "Het cijfer van de dag is twee miljard.",
   "chapter": 6
  },
  {
   "start": 275.83,
   "end": 283.35,
   "text": "Zoveel kilo nieuwe meubels wordt er jaarlijks in Nederland verkocht, meldt de NOS op basis van onderzoek van Tauw en Rebel.",
   "chapter": 6
  },
  {
   "start": 283.35,
   "end": 288.21,
   "text": "Per jaar krijgt tweehonderdzestig miljoen kilo afgedankte meubels een tweede leven.",
   "chapter": 6
  },
  {
   "start": 288.66,
   "end": 290.98,
   "text": "Dat was Grondstof voor vandaag.",
   "chapter": 7
  },
  {
   "start": 290.98,
   "end": 294.74,
   "text": "De bronnen bij elk bericht vindt u in de app en in de shownotes.",
   "chapter": 7
  },
  {
   "start": 294.74,
   "end": 300.66,
   "text": "Grondstof wordt gemaakt door De Graaf Groep, Wastenet, Circular and Co en Product for Product.",
   "chapter": 7
  },
  {
   "start": 300.66,
   "end": 302.9,
   "text": "Morgen om negen uur bent u weer bij.",
   "chapter": 7
  },
  {
   "start": 302.9,
   "end": 303.35,
   "text": "Tot dan.",
   "chapter": 7
  }
 ],
