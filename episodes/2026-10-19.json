 "transcript": [
  {
   "start": 5.5,
   "end": 6.46,
   "text": "Goedemorgen.",
   "chapter": 0
  },
  {
   "start": 6.46,
   "end": 8.74,
   "text": "Het is maandag negentien oktober.",
   "chapter": 0
  },
  {
   "start": 8.74,
   "end": 13.26,
   "text": "U luistert naar Grondstof, het circulaire nieuwsbulletin van De Graaf Groep.",
   "chapter": 0
  },
  {
   "start": 13.26,
   "end": 14.78,
   "text": "Ik ben Frans van den Berge.",
   "chapter": 0
  },
  {
   "start": 14.78,
   "end": 16.1,
   "text": "Dit zijn de koppen.",
   "chapter": 0
  },
  {
   "start": 16.1,
   "end": 20.38,
   "text": "Een rechter oordeelt dat gerecycled schuim nog steeds afval kan zijn.",
   "chapter": 0
  },
  {
   "start": 20.38,
   "end": 24.7,
   "text": "Duitse branches vragen om één duidelijke regel voor oud papier.",
   "chapter": 0
  },
  {
   "start": 24.7,
   "end": 27.93,
   "text": "En Vlaanderen houdt minder restafval over dan ooit.",
   "chapter": 0
  },
  {
   "start": 30.27,
   "end": 37.23,
   "text": "Een Nederlands recyclingbedrijf exporteerde schuim uit afgedankte matrassen naar de Verenigde Arabische Emiraten.",
   "chapter": 1
  },
  {
   "start": 37.23,
   "end": 40.99,
   "text": "Volgens het gerechtshof Arnhem-Leeuwarden was dat schuim nog afval.",
   "chapter": 1
  },
  {
   "start": 40.99,
   "end": 42.91,
   "text": "Dat meldt Wonen drie zestig.",
   "chapter": 1
  },
  {
   "start": 42.91,
   "end": 49.23,
   "text": "Het bedrijf sneed het polyurethaanschuim in repen, keek of het hygiënisch was en perste het in balen.",
   "chapter": 1
  },
  {
   "start": 49.23,
   "end": 52.63,
   "text": "De afnemer wilde er vulling van banken en bedden van maken.",
   "chapter": 1
  },
  {
   "start": 52.63,
   "end": 58.51,
   "text": "Maar uit diens procesbeschrijving bleek dat het schuim eerst nog moest worden versnipperd en aan elkaar gelijmd.",
   "chapter": 1
  },
  {
   "start": 58.51,
   "end": 60.91,
   "text": "De terugwinning was dus niet afgerond.",
   "chapter": 1
  },
  {
   "start": 60.91,
   "end": 64.35,
   "text": "Bovendien was alleen visueel gecontroleerd op vervuiling.",
   "chapter": 1
  },
  {
   "start": 64.35,
   "end": 66.59,
   "text": "De uitvoer was daarom illegaal.",
   "chapter": 1
  },
  {
   "start": 66.59,
   "end": 70.35,
   "text": "De rechter legde een voorwaardelijke boete van tweeduizend euro op.",
   "chapter": 1
  },
  {
   "start": 70.35,
   "end": 73.95,
   "text": "De les voor handelaren in gerecyclede materialen is helder.",
   "chapter": 1
  },
  {
   "start": 73.95,
   "end": 78.29,
   "text": "Snijden, reinigen en persen beëindigt de afvalstatus niet vanzelf.",
   "chapter": 1
  },
  {
   "start": 80.62,
   "end": 86.94,
   "text": "In Duitsland vragen de afvalverenigingen en de papierindustrie om één duidelijke regel voor oud papier.",
   "chapter": 2
  },
  {
   "start": 86.94,
   "end": 89.02,
   "text": "Dat meldt vakblad Euwid.",
   "chapter": 2
  },
  {
   "start": 89.02,
   "end": 97.9,
   "text": "De organisaties willen dat de Duitse regering bindende, landelijke criteria vaststelt voor het moment waarop oud papier geen afval meer is.",
   "chapter": 2
  },
  {
   "start": 97.9,
   "end": 101.26,
   "text": "Op de lange termijn streven ze naar een Europese oplossing.",
   "chapter": 2
  },
  {
   "start": 101.26,
   "end": 103.58,
   "text": "Oostenrijkse verenigingen doen mee.",
   "chapter": 2
  },
  {
   "start": 103.58,
   "end": 109.18,
   "text": "Het doel is meer rechtszekerheid en een veilige grondstoffenvoorziening voor de papierindustrie.",
   "chapter": 2
  },
  {
   "start": 109.18,
   "end": 112.3,
   "text": "De organisaties zijn een nieuw proefproject gestart.",
   "chapter": 2
  },
  {
   "start": 112.3,
   "end": 120.3,
   "text": "Ook gaven ze een universiteit in Wenen opdracht om een praktische methode te ontwikkelen waarmee vervuiling in oud papier wordt vastgesteld.",
   "chapter": 2
  },
  {
   "start": 120.3,
   "end": 123.5,
   "text": "Voor inzamelaars en papierfabrieken is dat belangrijk.",
   "chapter": 2
  },
  {
   "start": 123.5,
   "end": 128.61,
   "text": "Wie weet wanneer een partij als grondstof telt, kan sneller en met minder administratie handelen.",
   "chapter": 2
  },
  {
   "start": 130.95,
   "end": 136.87,
   "text": "Het Belgische inzamelsysteem Recupel heeft een online register van herstellers gelanceerd.",
   "chapter": 3
  },
  {
   "start": 136.87,
   "end": 141.59,
   "text": "De lancering viel rond Internationale Repair Day op zeventien oktober.",
   "chapter": 3
  },
  {
   "start": 141.59,
   "end": 145.27,
   "text": "Consumenten vinden er professionele reparateurs in de buurt.",
   "chapter": 3
  },
  {
   "start": 145.27,
   "end": 148.63,
   "text": "Ze zien ook met welke merken een reparateur werkt.",
   "chapter": 3
  },
  {
   "start": 148.63,
   "end": 154.79,
   "text": "Om het register te vullen bracht Recupel professionele reparatiebedrijven in heel België in kaart.",
   "chapter": 3
  },
  {
   "start": 154.79,
   "end": 161.99,
   "text": "Daarna benaderde het bedrijven met mogelijke reparatieactiviteit, om hun gegevens te controleren of aan te vullen.",
   "chapter": 3
  },
  {
   "start": 161.99,
   "end": 167.27,
   "text": "Nederland kent sinds maart tweeduizend vijfentwintig het Nationaal Reparateursregister.",
   "chapter": 3
  },
  {
   "start": 167.27,
   "end": 172.31,
   "text": "Bij de start telde dat driehonderdveertien reparateurs, meldt de Rijksoverheid.",
   "chapter": 3
  },
  {
   "start": 172.31,
   "end": 175.43,
   "text": "Zo'n register maakt reparatie makkelijker vindbaar.",
   "chapter": 3
  },
  {
   "start": 175.43,
   "end": 179.85,
   "text": "En reparatie verlengt de levensduur van apparaten, ook op de werkvloer.",
   "chapter": 3
  },
  {
   "start": 182.18,
   "end": 188.22,
   "text": "In Vlaanderen daalde het restafval vorig jaar naar honderddrieëntwintig komma vier kilo per inwoner.",
   "chapter": 4
  },
  {
   "start": 188.22,
   "end": 193.62,
   "text": "Dat is twee komma twee kilo minder dan een jaar eerder, meldt de Vlaamse openbare omroep.",
   "chapter": 4
  },
  {
   "start": 193.62,
   "end": 198.5,
   "text": "Het is het laagste cijfer sinds de metingen in negentienhonderdeenennegentig begonnen.",
   "chapter": 4
  },
  {
   "start": 198.5,
   "end": 202.74,
   "text": "Dat blijkt uit cijfers van de Openbare Vlaamse Afvalstoffenmaatschappij.",
   "chapter": 4
  },
  {
   "start": 202.74,
   "end": 208.02,
   "text": "Ongeveer eenenzeventig procent van het huishoudelijk afval wordt nu apart ingezameld.",
   "chapter": 4
  },
  {
   "start": 208.02,
   "end": 212.82,
   "text": "Voor drieënzestig komma acht procent volgt na de verwerking een tweede leven.",
   "chapter": 4
  },
  {
   "start": 212.82,
   "end": 218.02,
   "text": "Het doel voor tweeduizend dertig is maximaal honderd kilo restafval per inwoner.",
   "chapter": 4
  },
  {
   "start": 218.02,
   "end": 222.5,
   "text": "Een Vlaams parlementslid waarschuwt dat de makkelijke winst al is geboekt.",
   "chapter": 4
  },
  {
   "start": 222.5,
   "end": 230.41,
   "text": "Minister Jo Brouns wijst erop dat minder restafval per inwoner niet automatisch minder afval betekent, omdat de bevolking groeit.",
   "chapter": 4
  },
  {
   "start": 232.75,
   "end": 235.63,
   "text": "En wat betekent dit voor uw organisatie?",
   "chapter": 5
  },
  {
   "start": 235.63,
   "end": 238.27,
   "text": "Twee berichten van vandaag hebben één kern.",
   "chapter": 5
  },
  {
   "start": 238.27,
   "end": 242.75,
   "text": "Of een materiaal afval is of grondstof, bepaalt wat u ermee mag.",
   "chapter": 5
  },
  {
   "start": 242.75,
   "end": 244.91,
   "text": "Dat staat niet op het etiket.",
   "chapter": 5
  },
  {
   "start": 244.91,
   "end": 251.47,
   "text": "Wie gerecyclede materialen koopt of verkoopt, doet er goed aan te vragen wat er na levering nog mee gebeurt.",
   "chapter": 5
  },
  {
   "start": 251.47,
   "end": 254.43,
   "text": "En welke kwaliteitsdocumenten erbij horen.",
   "chapter": 5
  },
  {
   "start": 254.43,
   "end": 258.91,
   "text": "Bij De Graaf Groep zien we dat schone, goed gescheiden stromen hun waarde houden.",
   "chapter": 5
  },
  {
   "start": 258.91,
   "end": 264.67,
   "text": "Vlaanderen laat zien dat scheiden aan de bron werkt, maar ook dat de laatste kilo's het moeilijkst zijn.",
   "chapter": 5
  },
  {
   "start": 264.67,
   "end": 266.91,
   "text": "Kijk dus naar uw eigen afvalstromen.",
   "chapter": 5
  },
  {
   "start": 266.91,
   "end": 269.35,
   "text": "Welke zijn schoon genoeg om als grondstof te gaan?",
   "chapter": 5
  },
  {
   "start": 269.8,
   "end": 273.76,
   "text": "Het cijfer van de dag is honderddrieëntwintig komma vier.",
   "chapter": 6
  },
  {
   "start": 273.76,
   "end": 278.12,
   "text": "Zoveel kilo restafval hield een Vlaming vorig jaar gemiddeld over.",
   "chapter": 6
  },
  {
   "start": 278.12,
   "end": 281.64,
   "text": "Zo weinig was het nog nooit sinds de metingen begonnen.",
   "chapter": 6
  },
  {
   "start": 281.64,
   "end": 284.44,
   "text": "Het doel voor tweeduizend dertig ligt op honderd kilo.",
   "chapter": 6
  },
  {
   "start": 284.89,
   "end": 287.21,
   "text": "Dat was Grondstof voor vandaag.",
   "chapter": 7
  },
  {
   "start": 287.21,
   "end": 291.05,
   "text": "De bronnen bij elk bericht vindt u in de app en in de shownotes.",
   "chapter": 7
  },
  {
   "start": 291.05,
   "end": 293.37,
   "text": "Morgen om negen uur bent u weer bij.",
   "chapter": 7
  },
  {
   "start": 293.37,
   "end": 293.81,
   "text": "Tot dan.",
   "chapter": 7
  }
 ],
