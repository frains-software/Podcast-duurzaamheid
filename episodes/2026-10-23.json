 "transcript": [
  {
   "start": 5.5,
   "end": 6.46,
   "text": "Goedemorgen.",
   "chapter": 0
  },
  {
   "start": 6.46,
   "end": 8.9,
   "text": "Het is vrijdag drieëntwintig oktober.",
   "chapter": 0
  },
  {
   "start": 8.9,
   "end": 13.42,
   "text": "U luistert naar Grondstof, het circulaire nieuwsbulletin van De Graaf Groep.",
   "chapter": 0
  },
  {
   "start": 13.42,
   "end": 14.9,
   "text": "Ik ben Frans van den Berge.",
   "chapter": 0
  },
  {
   "start": 14.9,
   "end": 16.3,
   "text": "Dit zijn de koppen.",
   "chapter": 0
  },
  {
   "start": 16.3,
   "end": 21.06,
   "text": "Het kabinet wil chemiegrondstoffen deels uit afval uit het buitenland maken.",
   "chapter": 0
  },
  {
   "start": 21.06,
   "end": 23.82,
   "text": "Oud papier en koper worden duurder.",
   "chapter": 0
  },
  {
   "start": 23.82,
   "end": 27.8,
   "text": "En fossiel plastic blijft goedkoper dan gerecycled plastic.",
   "chapter": 0
  },
  {
   "start": 30.14,
   "end": 36.62,
   "text": "Het kabinet wil dat Nederland brandstoffen en chemiegrondstoffen deels maakt van afval uit het buitenland.",
   "chapter": 1
  },
  {
   "start": 36.62,
   "end": 38.78,
   "text": "Dat meldt Nieuwsblad Transport.",
   "chapter": 1
  },
  {
   "start": 38.78,
   "end": 41.9,
   "text": "Het gaat ook om geïmporteerd plasticafval.",
   "chapter": 1
  },
  {
   "start": 41.9,
   "end": 48.14,
   "text": "Volgens een nieuwe toekomstvisie is het Nederlandse restafval niet genoeg om de grondstofbehoefte te dekken.",
   "chapter": 1
  },
  {
   "start": 48.14,
   "end": 53.9,
   "text": "Het kabinet kiest daarom voor een productiemodel waarin ook afval uit andere landen wordt verwerkt.",
   "chapter": 1
  },
  {
   "start": 53.9,
   "end": 59.98,
   "text": "Het bericht noemt geen hoeveelheden of kosten, en het volledige artikel is alleen voor abonnees te lezen.",
   "chapter": 1
  },
  {
   "start": 59.98,
   "end": 62.78,
   "text": "Details over de visie zijn dus nog beperkt.",
   "chapter": 1
  },
  {
   "start": 62.78,
   "end": 67.1,
   "text": "Het is een signaal over de richting, geen uitgewerkt besluit.",
   "chapter": 1
  },
  {
   "start": 67.1,
   "end": 70.22,
   "text": "Voor inzamelaars en recyclers is dit relevant.",
   "chapter": 1
  },
  {
   "start": 70.22,
   "end": 75.05,
   "text": "Het raakt de vraag welke afvalstromen in Nederland blijven en welke over de grens komen.",
   "chapter": 1
  },
  {
   "start": 77.38,
   "end": 80.58,
   "text": "De markt voor oud papier en metaal trekt aan.",
   "chapter": 2
  },
  {
   "start": 80.58,
   "end": 86.02,
   "text": "Volgens vakblad Euwid stegen de prijzen voor oud papier in Duitsland in oktober verder.",
   "chapter": 2
  },
  {
   "start": 86.02,
   "end": 92.82,
   "text": "De sterkste stijgingen zijn er bij gemengd papier en karton, bij supermarktkarton en bij sorten voor deinking.",
   "chapter": 2
  },
  {
   "start": 92.82,
   "end": 102.02,
   "text": "Koper kostte op de Londense metaalbeurs op zeventien oktober meer dan veertienduizend zeshonderd dollar per ton, net onder het record van half september.",
   "chapter": 2
  },
  {
   "start": 102.02,
   "end": 111.46,
   "text": "Bij kunststof meldt Resource Recycling dat gesorteerd polypropyleen in Amerika in oktober duurder werd, terwijl het plastic voor drankflessen licht daalde.",
   "chapter": 2
  },
  {
   "start": 111.46,
   "end": 114.9,
   "text": "Dat is een Amerikaanse prijsindex, geen Europese.",
   "chapter": 2
  },
  {
   "start": 114.9,
   "end": 121.94,
   "text": "Voor kunststof meldt Euwid voor Duitsland slechts een lichte stijging van de activiteit in september, zonder breed herstel.",
   "chapter": 2
  },
  {
   "start": 121.94,
   "end": 126.13,
   "text": "Voor inkopers van gerecyclede materialen verschilt de richting dus per stof.",
   "chapter": 2
  },
  {
   "start": 128.46,
   "end": 132.86,
   "text": "Goed scheiden en recyclen is niet genoeg voor een circulaire economie.",
   "chapter": 3
  },
  {
   "start": 132.86,
   "end": 141.42,
   "text": "Dat stelt de Nederlandse Vereniging voor Afval- en Reinigingsmanagement in een reactie op een uitzending van Stand van Nederland over plasticrecycling.",
   "chapter": 3
  },
  {
   "start": 141.42,
   "end": 147.82,
   "text": "Zolang nieuw, fossiel plastic goedkoper is dan gerecycled plastic, kiezen producenten voor fossiel.",
   "chapter": 3
  },
  {
   "start": 147.82,
   "end": 153.34,
   "text": "De vereniging wil dat het kabinet aan het begin van de keten sterkere financiële prikkels geeft.",
   "chapter": 3
  },
  {
   "start": 153.34,
   "end": 160.54,
   "text": "Nieuwe fossiele grondstoffen moeten worden ontmoedigd, en gerecycled plastic moet worden gestimuleerd, met duidelijke eisen.",
   "chapter": 3
  },
  {
   "start": 160.54,
   "end": 164.78,
   "text": "Ook moet er minder materiaal worden gebruikt en meer worden hergebruikt.",
   "chapter": 3
  },
  {
   "start": 164.78,
   "end": 170.78,
   "text": "Producentenorganisatie Verpact stuurt met verschillende tarieven op beter recyclebare verpakkingen.",
   "chapter": 3
  },
  {
   "start": 170.78,
   "end": 174.72,
   "text": "De vereniging noemt dat een goede stap, maar de prikkel is nog te zwak.",
   "chapter": 3
  },
  {
   "start": 177.06,
   "end": 182.5,
   "text": "Europeanen veroorzaken meer plastic verpakkingsafval, maar recyclen ook meer.",
   "chapter": 4
  },
  {
   "start": 182.5,
   "end": 189.22,
   "text": "Dat blijkt uit cijfers van Eurostat over tweeduizend vierentwintig, gepubliceerd op tweeëntwintig oktober.",
   "chapter": 4
  },
  {
   "start": 189.22,
   "end": 196.98,
   "text": "Per inwoner kwam vijfendertig komma negen kilo plastic verpakkingsafval vrij, nul komma zes kilo meer dan een jaar eerder.",
   "chapter": 4
  },
  {
   "start": 196.98,
   "end": 200.34,
   "text": "Daarvan werd vijftien komma drie kilo gerecycled.",
   "chapter": 4
  },
  {
   "start": 200.34,
   "end": 206.66,
   "text": "Het recyclingpercentage steeg van eenenveertig komma zes naar tweeënveertig komma vier procent.",
   "chapter": 4
  },
  {
   "start": 206.66,
   "end": 210.46,
   "text": "Letland recyclet het meest, met eenenzeventig procent.",
   "chapter": 4
  },
  {
   "start": 210.46,
   "end": 214.38,
   "text": "Denemarken sluit de rij met tweeëntwintig komma vijf procent.",
   "chapter": 4
  },
  {
   "start": 214.38,
   "end": 219.67,
   "text": "Papier en karton vormen met veertig komma acht procent het grootste deel van alle verpakkingsafval.",
   "chapter": 4
  },
  {
   "start": 222.01,
   "end": 224.89,
   "text": "En wat betekent dit voor uw organisatie?",
   "chapter": 5
  },
  {
   "start": 224.89,
   "end": 225.85,
   "text": "Drie dingen.",
   "chapter": 5
  },
  {
   "start": 225.85,
   "end": 230.33,
   "text": "Eén: prijzen van secundaire grondstoffen bewegen per stroom verschillend.",
   "chapter": 5
  },
  {
   "start": 230.33,
   "end": 235.05,
   "text": "Kijk bij uw afvalcontract dus naar de afzonderlijke vergoedingen, niet naar een gemiddelde.",
   "chapter": 5
  },
  {
   "start": 235.05,
   "end": 240.81,
   "text": "Twee: zolang fossiel plastic goedkoper is, blijft de vraag naar gerecycled materiaal wankel.",
   "chapter": 5
  },
  {
   "start": 240.81,
   "end": 245.53,
   "text": "Vraag leveranciers daarom concreet naar het aandeel recyclaat in wat u inkoopt.",
   "chapter": 5
  },
  {
   "start": 245.53,
   "end": 249.29,
   "text": "Drie: volg welke afvalstromen straks de grens over gaan.",
   "chapter": 5
  },
  {
   "start": 249.29,
   "end": 252.49,
   "text": "Dat kan invloed hebben op verwerkingstarieven in uw regio.",
   "chapter": 5
  },
  {
   "start": 252.49,
   "end": 255.82,
   "text": "Bespreek dit met uw afvalpartner, voordat uw contract wordt verlengd.",
   "chapter": 5
  },
  {
   "start": 256.27,
   "end": 260.27,
   "text": "Het cijfer van de dag is tweeënveertig komma vier procent.",
   "chapter": 6
  },
  {
   "start": 260.27,
   "end": 266.43,
   "text": "Zoveel van het plastic verpakkingsafval in de Europese Unie werd in tweeduizend vierentwintig gerecycled.",
   "chapter": 6
  },
  {
   "start": 266.43,
   "end": 269.91,
   "text": "Een jaar eerder was dat eenenveertig komma zes procent.",
   "chapter": 6
  },
  {
   "start": 269.91,
   "end": 274.21,
   "text": "Meer dan de helft van het plastic verpakkingsafval wordt dus nog niet gerecycled.",
   "chapter": 6
  },
  {
   "start": 274.66,
   "end": 276.98,
   "text": "Dat was Grondstof voor vandaag.",
   "chapter": 7
  },
  {
   "start": 276.98,
   "end": 280.66,
   "text": "De bronnen bij elk bericht vindt u in de app en in de shownotes.",
   "chapter": 7
  },
  {
   "start": 280.66,
   "end": 283.14,
   "text": "Morgen om negen uur bent u weer bij ons.",
   "chapter": 7
  },
  {
   "start": 283.14,
   "end": 283.58,
   "text": "Tot dan.",
   "chapter": 7
  }
 ],
