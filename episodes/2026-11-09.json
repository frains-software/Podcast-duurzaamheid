 "transcript": [
  {
   "start": 5.5,
   "end": 6.54,
   "text": "Goedemorgen.",
   "chapter": 0
  },
  {
   "start": 6.54,
   "end": 8.62,
   "text": "Het is maandag negen november.",
   "chapter": 0
  },
  {
   "start": 8.62,
   "end": 12.98,
   "text": "U luistert naar Grondstof, het circulaire nieuwsbulletin van De Graaf Groep.",
   "chapter": 0
  },
  {
   "start": 12.98,
   "end": 14.59,
   "text": "Ik ben Frans van den Berge.",
   "chapter": 0
  },
  {
   "start": 14.59,
   "end": 16.02,
   "text": "Dit zijn de koppen.",
   "chapter": 0
  },
  {
   "start": 16.02,
   "end": 22.22,
   "text": "Over twaalf dagen mag plasticafval de Europese Unie niet meer uit richting niet-O-E-C-D-landen.",
   "chapter": 0
  },
  {
   "start": 22.22,
   "end": 26.14,
   "text": "Veolia wil zijn Nederlandse plasticrecycling verkopen.",
   "chapter": 0
  },
  {
   "start": 26.14,
   "end": 30.0,
   "text": "En de biedtermijn voor afvalconcern G-F-L loopt vandaag af.",
   "chapter": 0
  },
  {
   "start": 32.34,
   "end": 39.94,
   "text": "Op eenentwintig november gaat een Europees verbod in op de uitvoer van plasticafval naar landen buiten de O-E-C-D.",
   "chapter": 1
  },
  {
   "start": 39.94,
   "end": 42.82,
   "text": "Dat staat op de website van de Europese Commissie.",
   "chapter": 1
  },
  {
   "start": 42.82,
   "end": 47.54,
   "text": "Het verbod geldt minstens tot eenentwintig mei tweeduizend negenentwintig.",
   "chapter": 1
  },
  {
   "start": 47.54,
   "end": 53.74,
   "text": "Het gaat om schoon, niet-gevaarlijk plasticafval dat tot nu toe onder voorwaarden mocht worden uitgevoerd.",
   "chapter": 1
  },
  {
   "start": 53.74,
   "end": 59.78,
   "text": "Gevaarlijk plasticafval en plastic dat moeilijk te recyclen is, mocht al niet naar deze landen.",
   "chapter": 1
  },
  {
   "start": 59.78,
   "end": 64.7,
   "text": "Na de verbodsperiode kunnen landen buiten de O-E-C-D zich bij de Commissie melden.",
   "chapter": 1
  },
  {
   "start": 64.7,
   "end": 69.54,
   "text": "Zij moeten dan aantonen dat zij het afval milieuverantwoord kunnen verwerken.",
   "chapter": 1
  },
  {
   "start": 69.54,
   "end": 75.3,
   "text": "Voor Europese bedrijven betekent dit dat plasticafval vaker binnen Europa verwerkt moet worden.",
   "chapter": 1
  },
  {
   "start": 75.3,
   "end": 80.57,
   "text": "Dat vraagt om voldoende recyclingcapaciteit in eigen regio, en die staat onder druk.",
   "chapter": 1
  },
  {
   "start": 82.9,
   "end": 88.02,
   "text": "Het Franse concern Veolia wil zijn Nederlandse plasticrecyclingtak verkopen.",
   "chapter": 2
  },
  {
   "start": 88.02,
   "end": 92.9,
   "text": "Dat meldt het Financieele Dagblad, zo blijkt uit een bericht van Change Inc van vandaag.",
   "chapter": 2
  },
  {
   "start": 92.9,
   "end": 98.58,
   "text": "Het gaat om het Twentse bedrijf Aufderhaar Kunststof Recycling en om Veolia Polymers.",
   "chapter": 2
  },
  {
   "start": 98.58,
   "end": 104.34,
   "text": "Veolia Polymers kan per jaar vijfenveertigduizend ton gerecycled polypropyleen maken.",
   "chapter": 2
  },
  {
   "start": 104.34,
   "end": 109.62,
   "text": "Veolia wil voor twee miljard euro aan bezittingen verkopen om zijn schuldenlast te beheersen.",
   "chapter": 2
  },
  {
   "start": 109.62,
   "end": 115.94,
   "text": "Volgens het bericht groeien deze activiteiten beperkt en horen ze niet bij de drie grootste spelers in hun markt.",
   "chapter": 2
  },
  {
   "start": 115.94,
   "end": 118.26,
   "text": "Tegelijk zijn er hoopvolle signalen.",
   "chapter": 2
  },
  {
   "start": 118.26,
   "end": 127.06,
   "text": "Nieuwe Europese verpakkingsregels verplichten vanaf tweeduizend dertig minimaal tien procent gerecycled plastic, en de vraag lijkt al te stijgen.",
   "chapter": 2
  },
  {
   "start": 127.06,
   "end": 128.87,
   "text": "Wie koper wordt, is nog niet bekend.",
   "chapter": 2
  },
  {
   "start": 131.21,
   "end": 139.05,
   "text": "Voor het Canadese afvalconcern G-F-L Environmental loopt vandaag de termijn af voor definitieve overnamebiedingen.",
   "chapter": 3
  },
  {
   "start": 139.05,
   "end": 145.77,
   "text": "Dat maakte het bedrijf bekend bij de kwartaalcijfers van achtentwintig oktober, meldt vakmedium Waste Dive.",
   "chapter": 3
  },
  {
   "start": 145.77,
   "end": 152.01,
   "text": "Een commissie van onafhankelijke bestuurders beoordeelt de biedingen en adviseert daarna over de vervolgstappen.",
   "chapter": 3
  },
  {
   "start": 152.01,
   "end": 155.61,
   "text": "Namen van bieders en bedragen noemt het bedrijf niet.",
   "chapter": 3
  },
  {
   "start": 155.61,
   "end": 160.73,
   "text": "Volgens berichten zijn er twee consortia van durfkapitaalinvesteerders in beeld.",
   "chapter": 3
  },
  {
   "start": 160.73,
   "end": 167.85,
   "text": "In het derde kwartaal steeg de omzet met zevenentwintig procent naar twee komma één zes miljard Canadese dollar.",
   "chapter": 3
  },
  {
   "start": 167.85,
   "end": 172.25,
   "text": "Het bedrijf verwacht dit jaar meer dan acht miljard Canadese dollar omzet.",
   "chapter": 3
  },
  {
   "start": 172.25,
   "end": 175.05,
   "text": "Een overname is dus niet gegarandeerd.",
   "chapter": 3
  },
  {
   "start": 175.05,
   "end": 178.8,
   "text": "Een eventueel akkoord moet bovendien door de aandeelhouders worden goedgekeurd.",
   "chapter": 3
  },
  {
   "start": 181.13,
   "end": 186.33,
   "text": "De gemeente Woerden wil dat basisscholen hun afval gaan scheiden, net als huishoudens.",
   "chapter": 4
  },
  {
   "start": 186.33,
   "end": 189.29,
   "text": "Dat meldt de regionale omroep Midden-Holland.",
   "chapter": 4
  },
  {
   "start": 189.29,
   "end": 194.25,
   "text": "De gemeenteraad bespreekt het voorstel donderdag twaalf november als hamerstuk.",
   "chapter": 4
  },
  {
   "start": 194.25,
   "end": 199.21,
   "text": "Schoolafval geldt als bedrijfsafval en wordt door commerciële bedrijven opgehaald.",
   "chapter": 4
  },
  {
   "start": 199.21,
   "end": 206.73,
   "text": "Dat is duur, dus scholen mengen groente-, fruit- en tuinafval vaak met plastic, metaal en drankkartons.",
   "chapter": 4
  },
  {
   "start": 206.73,
   "end": 212.65,
   "text": "De gemeente mocht schoolafval niet ophalen, omdat dat de concurrentie met bedrijven kon verstoren.",
   "chapter": 4
  },
  {
   "start": 212.65,
   "end": 218.25,
   "text": "Door gescheiden inzameling aan te wijzen als activiteit van algemeen belang kan dat wel.",
   "chapter": 4
  },
  {
   "start": 218.25,
   "end": 222.33,
   "text": "Deelname is vrijwillig en geldt voor ongeveer vijfentwintig scholen.",
   "chapter": 4
  },
  {
   "start": 222.33,
   "end": 225.85,
   "text": "Restafval blijft via commerciële ophalers lopen.",
   "chapter": 4
  },
  {
   "start": 225.85,
   "end": 233.67,
   "text": "Volgens de gemeente is de inzameling van plastic, metaal en drankkartons vrijwel kostenneutraal en levert oud papier inkomsten op.",
   "chapter": 4
  },
  {
   "start": 236.01,
   "end": 238.73,
   "text": "En wat betekent dit voor uw organisatie?",
   "chapter": 5
  },
  {
   "start": 238.73,
   "end": 243.53,
   "text": "Het nieuws van vandaag draait om één vraag: waar blijft uw materiaal?",
   "chapter": 5
  },
  {
   "start": 243.53,
   "end": 248.17,
   "text": "Als plasticafval Europa niet meer uit kan, moet het hier een bestemming vinden.",
   "chapter": 5
  },
  {
   "start": 248.17,
   "end": 254.09,
   "text": "Vraag uw inzamelaar daarom waar uw plastic stromen terechtkomen en of dat binnen Europa gebeurt.",
   "chapter": 5
  },
  {
   "start": 254.09,
   "end": 258.97,
   "text": "Het verhaal uit Woerden laat zien dat scheiden vooral een kwestie van organisatie is.",
   "chapter": 5
  },
  {
   "start": 258.97,
   "end": 264.33,
   "text": "Wie bedrijfsafval gescheiden aanbiedt, houdt materiaal bruikbaar en kosten beheersbaar.",
   "chapter": 5
  },
  {
   "start": 264.33,
   "end": 270.25,
   "text": "Bij De Graaf Groep zien wij dat schone, gescheiden stromen de beste kans op hoogwaardig hergebruik hebben.",
   "chapter": 5
  },
  {
   "start": 270.25,
   "end": 276.41,
   "text": "En als overnames de markt van inzamelaars en recyclers veranderen, loont het om uw contracten te lezen.",
   "chapter": 5
  },
  {
   "start": 276.41,
   "end": 280.36,
   "text": "Kijk naar looptijd, tarieven en wat er gebeurt bij een nieuwe eigenaar.",
   "chapter": 5
  },
  {
   "start": 280.81,
   "end": 284.21,
   "text": "Het cijfer van de dag is vijfenveertigduizend.",
   "chapter": 6
  },
  {
   "start": 284.21,
   "end": 290.09,
   "text": "Zoveel ton gerecycled polypropyleen kan Veolia Polymers in Nederland per jaar maken.",
   "chapter": 6
  },
  {
   "start": 290.09,
   "end": 297.42,
   "text": "Het bedrijf staat nu te koop, terwijl Europa vanaf tweeduizend dertig minimaal tien procent gerecycled plastic in verpakkingen eist.",
   "chapter": 6
  },
  {
   "start": 297.87,
   "end": 300.27,
   "text": "Dat was Grondstof voor vandaag.",
   "chapter": 7
  },
  {
   "start": 300.27,
   "end": 304.03,
   "text": "De bronnen bij elk bericht vindt u in de app en in de shownotes.",
   "chapter": 7
  },
  {
   "start": 304.03,
   "end": 306.27,
   "text": "Morgen om negen uur bent u weer bij.",
   "chapter": 7
  },
  {
   "start": 306.27,
   "end": 306.72,
   "text": "Tot dan.",
   "chapter": 7
  }
 ],
