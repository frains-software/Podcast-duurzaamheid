 "transcript": [
  {
   "start": 5.5,
   "end": 6.54,
   "text": "Goedemorgen.",
   "chapter": 0
  },
  {
   "start": 6.54,
   "end": 8.62,
   "text": "Het is zondag één november.",
   "chapter": 0
  },
  {
   "start": 8.62,
   "end": 13.1,
   "text": "U luistert naar Grondstof, het circulaire nieuwsbulletin van De Graaf Groep.",
   "chapter": 0
  },
  {
   "start": 13.1,
   "end": 14.7,
   "text": "Ik ben Frans van den Berge.",
   "chapter": 0
  },
  {
   "start": 14.7,
   "end": 16.14,
   "text": "Dit zijn de koppen.",
   "chapter": 0
  },
  {
   "start": 16.14,
   "end": 22.14,
   "text": "Over drie weken geldt een Europees exportverbod voor kunststofafval naar veel landen buiten Europa.",
   "chapter": 0
  },
  {
   "start": 22.14,
   "end": 25.74,
   "text": "De rechter noemt gecomposteerd bermmaaisel afval.",
   "chapter": 0
  },
  {
   "start": 25.74,
   "end": 30.35,
   "text": "En de Consumentenbond mist openheid over pfas in producten.",
   "chapter": 0
  },
  {
   "start": 32.69,
   "end": 41.29,
   "text": "Op eenentwintig november gaat in de Europese Unie een exportverbod in voor kunststofafval met afvalcode B drie nul één één.",
   "chapter": 1
  },
  {
   "start": 41.29,
   "end": 48.05,
   "text": "Het verbod geldt voor uitvoer naar landen die geen lid zijn van de Organisatie voor Economische Samenwerking en Ontwikkeling.",
   "chapter": 1
  },
  {
   "start": 48.05,
   "end": 51.97,
   "text": "Dat meldt de Inspectie Leefomgeving en Transport op haar website.",
   "chapter": 1
  },
  {
   "start": 51.97,
   "end": 56.93,
   "text": "De regel volgt uit de herziene Europese verordening voor het vervoer van afvalstoffen.",
   "chapter": 1
  },
  {
   "start": 56.93,
   "end": 64.93,
   "text": "Sinds eenentwintig mei van dit jaar moet al iedere uitvoer van dit afval worden gemeld, ook naar de landen die wel lid zijn van die organisatie.",
   "chapter": 1
  },
  {
   "start": 64.93,
   "end": 71.65,
   "text": "Het gaat om kunststofafval dat niet als gevaarlijk geldt en dat veel bedrijven gemengd of gesorteerd laten ophalen.",
   "chapter": 1
  },
  {
   "start": 71.65,
   "end": 76.93,
   "text": "Wie afval inzamelt of verhandelt, moet dus kijken waar de partijen uiteindelijk terechtkomen.",
   "chapter": 1
  },
  {
   "start": 76.93,
   "end": 80.61,
   "text": "Het doet ertoe, omdat meer kunststof binnen Europa verwerkt moet worden.",
   "chapter": 1
  },
  {
   "start": 82.94,
   "end": 88.46,
   "text": "De rechtbank Noord-Nederland oordeelt dat gecomposteerd bermmaaisel een afvalstof is.",
   "chapter": 2
  },
  {
   "start": 88.46,
   "end": 91.58,
   "text": "Dat meldt Afvalgids op achtentwintig oktober.",
   "chapter": 2
  },
  {
   "start": 91.58,
   "end": 94.3,
   "text": "De uitspraak is van drieëntwintig oktober.",
   "chapter": 2
  },
  {
   "start": 94.3,
   "end": 100.54,
   "text": "Het ging om vier zaken over boeren in Friesland, die bermmaaisel composteren en het op hun land gebruiken.",
   "chapter": 2
  },
  {
   "start": 100.54,
   "end": 107.42,
   "text": "De Branchevereniging Organische Reststoffen vroeg de gemeenten om te handhaven en stapte naar de rechter toen zij weigerden.",
   "chapter": 2
  },
  {
   "start": 107.42,
   "end": 110.62,
   "text": "De gemeenten vonden dat het om voortgezet gebruik ging.",
   "chapter": 2
  },
  {
   "start": 110.62,
   "end": 112.54,
   "text": "De rechtbank volgt dat niet.",
   "chapter": 2
  },
  {
   "start": 112.54,
   "end": 117.98,
   "text": "Het maaisel komt vrij bij onderhoud van de berm en gemeenten betalen om er vanaf te komen.",
   "chapter": 2
  },
  {
   "start": 117.98,
   "end": 121.1,
   "text": "Daaruit blijkt volgens de rechter dat zij het afdanken.",
   "chapter": 2
  },
  {
   "start": 121.1,
   "end": 124.88,
   "text": "Het doet ertoe, omdat voor alle verwerkers dezelfde regels moeten gelden.",
   "chapter": 2
  },
  {
   "start": 127.22,
   "end": 132.8,
   "text": "De Consumentenbond vindt dat fabrikanten te weinig vertellen over pfas in hun producten.",
   "chapter": 3
  },
  {
   "start": 132.8,
   "end": 136.08,
   "text": "Dat meldt Duurzaam Ondernemen op dertig oktober.",
   "chapter": 3
  },
  {
   "start": 136.08,
   "end": 142.72,
   "text": "De bond onderzocht de websites, de klantenservice en de antwoorden van vierendertig fabrikanten en verkopers.",
   "chapter": 3
  },
  {
   "start": 142.72,
   "end": 147.52,
   "text": "Op bijna alle sites vond de bond weinig of geen bruikbare informatie.",
   "chapter": 3
  },
  {
   "start": 147.52,
   "end": 152.4,
   "text": "Alleen Hema geeft een overzicht van pannen en bakproducten zonder pfas.",
   "chapter": 3
  },
  {
   "start": 152.4,
   "end": 156.48,
   "text": "Geen enkel bedrijf noemt producten die wel pfas bevatten.",
   "chapter": 3
  },
  {
   "start": 156.48,
   "end": 160.88,
   "text": "Pfas zitten onder meer in pannen, bakpapier en sporttape.",
   "chapter": 3
  },
  {
   "start": 160.88,
   "end": 165.92,
   "text": "Volgens de bond bestaat voor elk product met pfas een goed alternatief.",
   "chapter": 3
  },
  {
   "start": 165.92,
   "end": 172.47,
   "text": "Het doet ertoe voor inkopers, omdat zonder gegevens van leveranciers niet te kiezen valt voor pfas-vrije producten.",
   "chapter": 3
  },
  {
   "start": 174.8,
   "end": 180.88,
   "text": "Batterijrecycler Back to Battery heeft de jaarlijkse award van Auto Recycling Nederland gewonnen.",
   "chapter": 4
  },
  {
   "start": 180.88,
   "end": 184.32,
   "text": "Dat meldt Recycling Magazine op negenentwintig oktober.",
   "chapter": 4
  },
  {
   "start": 184.32,
   "end": 188.0,
   "text": "De organisatie reikte de prijs uit tijdens haar relatiedag.",
   "chapter": 4
  },
  {
   "start": 188.0,
   "end": 194.8,
   "text": "Het bedrijf wint lithium, kobalt, nikkel, mangaan en grafiet terug uit gebruikte lithium-ionbatterijen.",
   "chapter": 4
  },
  {
   "start": 194.8,
   "end": 200.16,
   "text": "De jury prijst dat het bedrijf technische vernieuwing koppelt aan een grote maatschappelijke opgave.",
   "chapter": 4
  },
  {
   "start": 200.16,
   "end": 204.96,
   "text": "Zij noemt afgedankte batterijen een stedelijke mijn met waardevolle grondstoffen.",
   "chapter": 4
  },
  {
   "start": 204.96,
   "end": 213.36,
   "text": "De Europese batterijverordening vraagt dat batterijen de komende jaren veilig worden ingezameld en dat hun materialen zo veel mogelijk worden hergebruikt.",
   "chapter": 4
  },
  {
   "start": 213.36,
   "end": 219.42,
   "text": "Het doet ertoe, omdat die metalen vaak van ver komen en recycling de afhankelijkheid van import kan verkleinen.",
   "chapter": 4
  },
  {
   "start": 221.76,
   "end": 224.56,
   "text": "En wat betekent dit voor uw organisatie?",
   "chapter": 5
  },
  {
   "start": 224.56,
   "end": 225.52,
   "text": "Drie dingen.",
   "chapter": 5
  },
  {
   "start": 225.52,
   "end": 227.92,
   "text": "Ten eerste het exportverbod.",
   "chapter": 5
  },
  {
   "start": 227.92,
   "end": 232.32,
   "text": "Vraag uw afvalpartner waar uw kunststof naartoe gaat en hoe zij dat vastleggen.",
   "chapter": 5
  },
  {
   "start": 232.32,
   "end": 235.28,
   "text": "Ten tweede de uitspraak over bermmaaisel.",
   "chapter": 5
  },
  {
   "start": 235.28,
   "end": 241.44,
   "text": "Heeft u groenafval, bijvoorbeeld uit tuinonderhoud, kijk dan na of de verwerker de afvalregels volgt.",
   "chapter": 5
  },
  {
   "start": 241.44,
   "end": 244.0,
   "text": "Ten derde pfas.",
   "chapter": 5
  },
  {
   "start": 244.0,
   "end": 250.4,
   "text": "Neem vragen over gevaarlijke stoffen op in uw inkoopvoorwaarden en vraag leveranciers om een schriftelijk antwoord.",
   "chapter": 5
  },
  {
   "start": 250.4,
   "end": 256.78,
   "text": "Bij De Graaf Groep zien wij dat duidelijke afspraken over herkomst en bestemming van materiaal veel gedoe achteraf voorkomen.",
   "chapter": 5
  },
  {
   "start": 257.23,
   "end": 260.15,
   "text": "Het cijfer van de dag is vierendertig.",
   "chapter": 6
  },
  {
   "start": 260.15,
   "end": 266.51,
   "text": "Zoveel fabrikanten en verkopers onderzocht de Consumentenbond op openheid over pfas.",
   "chapter": 6
  },
  {
   "start": 266.51,
   "end": 270.11,
   "text": "Slechts vier bedrijven beantwoordden de vragenlijst volledig.",
   "chapter": 6
  },
  {
   "start": 270.11,
   "end": 271.88,
   "text": "Acht reageerden helemaal niet.",
   "chapter": 6
  },
  {
   "start": 272.33,
   "end": 274.65,
   "text": "Dat was Grondstof voor vandaag.",
   "chapter": 7
  },
  {
   "start": 274.65,
   "end": 278.41,
   "text": "De bronnen bij elk bericht vindt u in de app en in de shownotes.",
   "chapter": 7
  },
  {
   "start": 278.41,
   "end": 280.65,
   "text": "Morgen om negen uur bent u weer bij.",
   "chapter": 7
  },
  {
   "start": 280.65,
   "end": 281.11,
   "text": "Tot dan.",
   "chapter": 7
  }
 ],
