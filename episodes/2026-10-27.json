 "transcript": [
  {
   "start": 5.5,
   "end": 6.54,
   "text": "Goedemorgen.",
   "chapter": 0
  },
  {
   "start": 6.54,
   "end": 9.3,
   "text": "Het is dinsdag zevenentwintig oktober.",
   "chapter": 0
  },
  {
   "start": 9.3,
   "end": 13.66,
   "text": "U luistert naar Grondstof, het circulaire nieuwsbulletin van De Graaf Groep.",
   "chapter": 0
  },
  {
   "start": 13.66,
   "end": 15.26,
   "text": "Ik ben Frans van den Berge.",
   "chapter": 0
  },
  {
   "start": 15.26,
   "end": 16.94,
   "text": "Dit zijn de koppen.",
   "chapter": 0
  },
  {
   "start": 16.94,
   "end": 22.3,
   "text": "Een rapport waarschuwt dat verschillen in afvalbelastingen de Europese markt verstoren.",
   "chapter": 0
  },
  {
   "start": 22.3,
   "end": 27.18,
   "text": "Chemisch recycler Pryme wil zijn locatie in de Amsterdamse haven verkopen.",
   "chapter": 0
  },
  {
   "start": 27.18,
   "end": 31.95,
   "text": "En Ekoplaza verkoopt voortaan herbruikbare wijnflessen in heel Nederland.",
   "chapter": 0
  },
  {
   "start": 34.29,
   "end": 38.45,
   "text": "Verschillen in afvalbelastingen verstoren de Europese afvalmarkt.",
   "chapter": 1
  },
  {
   "start": 38.45,
   "end": 45.01,
   "text": "Dat stelt de R D F Industry Group, een brancheorganisatie voor brandstof uit afval, in een nieuw rapport.",
   "chapter": 1
  },
  {
   "start": 45.01,
   "end": 47.25,
   "text": "Dat meldt vakblad Circular.",
   "chapter": 1
  },
  {
   "start": 47.25,
   "end": 50.81,
   "text": "De organisatie vergeleek achtendertig Europese landen.",
   "chapter": 1
  },
  {
   "start": 50.81,
   "end": 57.97,
   "text": "Vierentwintig daarvan kennen een stortbelasting, met tarieven van ongeveer elf tot honderdvierenvijftig euro per ton.",
   "chapter": 1
  },
  {
   "start": 57.97,
   "end": 64.13,
   "text": "Dertien landen heffen belasting op verbranding, van ongeveer acht tot achtennegentig euro per ton.",
   "chapter": 1
  },
  {
   "start": 64.13,
   "end": 69.17,
   "text": "Volgens het rapport hangt het dus van de locatie af hoe aantrekkelijk een installatie is.",
   "chapter": 1
  },
  {
   "start": 69.17,
   "end": 73.57,
   "text": "Ook waarschuwt de organisatie voor het Europese emissiehandelssysteem.",
   "chapter": 1
  },
  {
   "start": 73.57,
   "end": 79.17,
   "text": "Zonder bijsturing kan storten in meer dan tien landen lichter belast worden dan verbranden.",
   "chapter": 1
  },
  {
   "start": 79.17,
   "end": 83.65,
   "text": "Let op: dit is een rapport van een brancheorganisatie met een eigen belang.",
   "chapter": 1
  },
  {
   "start": 83.65,
   "end": 87.66,
   "text": "Het laat zien dat afvalbeleid in Europa nog altijd een lappendeken is.",
   "chapter": 1
  },
  {
   "start": 89.99,
   "end": 96.39,
   "text": "Chemisch recycler Pryme wil de rest van zijn activiteiten verkopen aan het Amerikaanse Alterra Energy.",
   "chapter": 2
  },
  {
   "start": 96.39,
   "end": 101.19,
   "text": "Dat meldt Afvalgids, op basis van Industrielinqs, op tweeëntwintig oktober.",
   "chapter": 2
  },
  {
   "start": 101.19,
   "end": 107.03,
   "text": "Kern van de deal is het erfpachtrecht op een locatie voor chemische recycling in de Amsterdamse haven.",
   "chapter": 2
  },
  {
   "start": 107.03,
   "end": 112.15,
   "text": "Komt de verkoop er niet, dan acht het bestuur ontbinding of een faillissement waarschijnlijk.",
   "chapter": 2
  },
  {
   "start": 112.15,
   "end": 116.63,
   "text": "Volgens AfvalOnline hebben de aandeelhouders inmiddels ingestemd met de verkoop.",
   "chapter": 2
  },
  {
   "start": 116.63,
   "end": 118.71,
   "text": "Bedragen noemen de bronnen niet.",
   "chapter": 2
  },
  {
   "start": 118.71,
   "end": 121.91,
   "text": "Pryme sloot eerder al zijn installatie in Rotterdam.",
   "chapter": 2
  },
  {
   "start": 121.91,
   "end": 127.19,
   "text": "Het bericht laat zien dat chemische recycling van kunststof nog moeilijk rendabel te maken is.",
   "chapter": 2
  },
  {
   "start": 127.19,
   "end": 133.43,
   "text": "Voor afnemers van gerecycled materiaal is het een reden om de continuïteit van leveranciers goed in de gaten te houden.",
   "chapter": 2
  },
  {
   "start": 135.77,
   "end": 140.25,
   "text": "Ekoplaza start de landelijke verkoop van een herbruikbare wijnfles.",
   "chapter": 3
  },
  {
   "start": 140.25,
   "end": 142.09,
   "text": "Dat meldt Afvalgids.",
   "chapter": 3
  },
  {
   "start": 142.09,
   "end": 148.33,
   "text": "De fles is in drie jaar ontwikkeld door Ekoplaza, Enviu, Pakt en Walraven Sax.",
   "chapter": 3
  },
  {
   "start": 148.33,
   "end": 151.05,
   "text": "Voorlopig zijn er twee wijnen in verkrijgbaar.",
   "chapter": 3
  },
  {
   "start": 151.05,
   "end": 154.25,
   "text": "Op de fles zit vijfentwintig cent statiegeld.",
   "chapter": 3
  },
  {
   "start": 154.25,
   "end": 157.45,
   "text": "Klanten leveren de lege fles in bij Ekoplaza.",
   "chapter": 3
  },
  {
   "start": 157.45,
   "end": 161.77,
   "text": "Pakt reinigt de flessen, waarna producenten ze opnieuw kunnen vullen.",
   "chapter": 3
  },
  {
   "start": 161.77,
   "end": 166.01,
   "text": "Eerder liep een proef bij een klein aantal Jumbo-winkels en in de horeca.",
   "chapter": 3
  },
  {
   "start": 166.01,
   "end": 171.93,
   "text": "De initiatiefnemers verwachten dat over tien jaar tachtig procent van de wijnflessen herbruikbaar kan zijn.",
   "chapter": 3
  },
  {
   "start": 171.93,
   "end": 174.49,
   "text": "Dat is een ambitie, geen uitkomst.",
   "chapter": 3
  },
  {
   "start": 174.49,
   "end": 179.09,
   "text": "Het laat wel zien dat een gedeeld statiegeldsysteem voor glas nu echt de winkel in gaat.",
   "chapter": 3
  },
  {
   "start": 181.42,
   "end": 184.7,
   "text": "Nederlanders kopen meubels nog steeds vooral nieuw.",
   "chapter": 4
  },
  {
   "start": 184.7,
   "end": 192.14,
   "text": "Dat blijkt uit onderzoek van Kenniscentrum Duurzaam Leven, het vroegere Milieu Centraal, meldt nul zeven nul Online.",
   "chapter": 4
  },
  {
   "start": 192.14,
   "end": 195.74,
   "text": "Achtenzestig procent kocht het afgelopen jaar een nieuw meubel.",
   "chapter": 4
  },
  {
   "start": 195.74,
   "end": 198.94,
   "text": "Meer dan de helft van hen kocht er twee of meer.",
   "chapter": 4
  },
  {
   "start": 198.94,
   "end": 205.34,
   "text": "Slechts vierendertig procent van die kopers overwoog serieus om tweedehands te kopen of probeerde dat.",
   "chapter": 4
  },
  {
   "start": 205.34,
   "end": 209.66,
   "text": "Reparatie kwam nog minder vaak in beeld: zestien procent.",
   "chapter": 4
  },
  {
   "start": 209.66,
   "end": 216.7,
   "text": "Ook bleek dat eenenvijftig procent van de mensen die een meubel wegdeed, dat niet deed omdat het kapot of versleten was.",
   "chapter": 4
  },
  {
   "start": 216.7,
   "end": 222.94,
   "text": "Het kenniscentrum start een campagne om tweedehands, reparatie en opknappen onder de aandacht te brengen.",
   "chapter": 4
  },
  {
   "start": 222.94,
   "end": 226.2,
   "text": "Voor organisaties die kantoren inrichten, ligt hier een kans.",
   "chapter": 4
  },
  {
   "start": 228.54,
   "end": 231.42,
   "text": "En wat betekent dit voor uw organisatie?",
   "chapter": 5
  },
  {
   "start": 231.42,
   "end": 232.38,
   "text": "Drie dingen.",
   "chapter": 5
  },
  {
   "start": 232.38,
   "end": 237.1,
   "text": "Eén: kijk naar de kosten van uw restafval over de grens van één land heen.",
   "chapter": 5
  },
  {
   "start": 237.1,
   "end": 240.62,
   "text": "Verschillen in heffingen sturen afval naar andere installaties.",
   "chapter": 5
  },
  {
   "start": 240.62,
   "end": 244.91,
   "text": "Vraag uw afvalverwerker waar uw stromen terechtkomen en wat dat kost.",
   "chapter": 5
  },
  {
   "start": 244.91,
   "end": 248.78,
   "text": "Twee: let bij hergebruik op de infrastructuur eromheen.",
   "chapter": 5
  },
  {
   "start": 248.78,
   "end": 252.94,
   "text": "De wijnfles werkt omdat er een retourstroom en een wasstraat achter zit.",
   "chapter": 5
  },
  {
   "start": 252.94,
   "end": 256.06,
   "text": "Dat geldt ook voor herbruikbare bekers op de werkvloer.",
   "chapter": 5
  },
  {
   "start": 256.06,
   "end": 260.7,
   "text": "Drie: kijk bij een verbouwing eerst naar tweedehands en gerepareerd meubilair.",
   "chapter": 5
  },
  {
   "start": 260.7,
   "end": 264.22,
   "text": "Het onderzoek laat zien dat de meeste kopers die vraag niet stellen.",
   "chapter": 5
  },
  {
   "start": 264.22,
   "end": 267.39,
   "text": "Wie hem wel stelt, bespaart vaak grondstoffen en geld.",
   "chapter": 5
  },
  {
   "start": 267.84,
   "end": 271.44,
   "text": "Het cijfer van de dag is achtenzestig procent.",
   "chapter": 6
  },
  {
   "start": 271.44,
   "end": 277.44,
   "text": "Zoveel Nederlanders kochten het afgelopen jaar een nieuw meubel, volgens Kenniscentrum Duurzaam Leven.",
   "chapter": 6
  },
  {
   "start": 277.44,
   "end": 281.85,
   "text": "Slechts zestien procent van de kopers overwoog of probeerde reparatie.",
   "chapter": 6
  },
  {
   "start": 282.3,
   "end": 284.7,
   "text": "Dat was Grondstof voor vandaag.",
   "chapter": 7
  },
  {
   "start": 284.7,
   "end": 288.54,
   "text": "De bronnen bij elk bericht vindt u in de app en in de shownotes.",
   "chapter": 7
  },
  {
   "start": 288.54,
   "end": 290.86,
   "text": "Morgen om negen uur bent u weer bij.",
   "chapter": 7
  },
  {
   "start": 290.86,
   "end": 291.27,
   "text": "Tot dan.",
   "chapter": 7
  }
 ],
