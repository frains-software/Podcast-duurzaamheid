 "transcript": [
  {
   "start": 5.5,
   "end": 6.54,
   "text": "Goedemorgen.",
   "chapter": 0
  },
  {
   "start": 6.54,
   "end": 8.86,
   "text": "Het is zaterdag veertien november.",
   "chapter": 0
  },
  {
   "start": 8.86,
   "end": 13.34,
   "text": "U luistert naar Grondstof, het circulaire nieuwsbulletin van De Graaf Groep.",
   "chapter": 0
  },
  {
   "start": 13.34,
   "end": 15.02,
   "text": "Ik ben Frans van den Berge.",
   "chapter": 0
  },
  {
   "start": 15.02,
   "end": 16.54,
   "text": "Dit zijn de koppen.",
   "chapter": 0
  },
  {
   "start": 16.54,
   "end": 22.38,
   "text": "Amstelveen stelt het besluit uit over het stoppen met de gescheiden inzameling van plastic verpakkingen.",
   "chapter": 0
  },
  {
   "start": 22.38,
   "end": 30.54,
   "text": "Een nieuwe databank laat zien dat in de Europese Unie ongeveer vijfendertig procent van het plastic verpakkingsafval echt wordt gerecycled.",
   "chapter": 0
  },
  {
   "start": 30.54,
   "end": 36.39,
   "text": "En het Internationaal Energieagentschap rekent voor wat beter recyclen het klimaat oplevert.",
   "chapter": 0
  },
  {
   "start": 38.73,
   "end": 46.65,
   "text": "De gemeenteraad van Amstelveen heeft het besluit over het nieuwe Grondstoffenplan met twee weken uitgesteld, tot vijfentwintig november.",
   "chapter": 1
  },
  {
   "start": 46.65,
   "end": 48.97,
   "text": "Dat meldt het Amstelveens Nieuwsblad.",
   "chapter": 1
  },
  {
   "start": 48.97,
   "end": 56.65,
   "text": "Het college wil vanaf tweeduizend achtentwintig stoppen met het apart inzamelen van plastic, metalen verpakkingen en drinkpakken.",
   "chapter": 1
  },
  {
   "start": 56.65,
   "end": 62.25,
   "text": "Inwoners gooien dat afval dan bij het restafval, waarna installaties het er later uithalen.",
   "chapter": 1
  },
  {
   "start": 62.25,
   "end": 68.33,
   "text": "De reden is dat het materiaal uit ondergrondse containers te vervuild is voor hoogwaardige recycling.",
   "chapter": 1
  },
  {
   "start": 68.33,
   "end": 73.29,
   "text": "Een amendement van vier fracties wil bij laagbouw de scheiding aan de bron behouden.",
   "chapter": 1
  },
  {
   "start": 73.29,
   "end": 80.17,
   "text": "Dat voorstel kost ruim drie komma twee miljoen euro, zo'n één komma zeven miljoen meer dan het plan van de gemeente.",
   "chapter": 1
  },
  {
   "start": 80.17,
   "end": 82.81,
   "text": "Die meerkosten waren eerder niet bekend.",
   "chapter": 1
  },
  {
   "start": 82.81,
   "end": 89.13,
   "text": "Het debat raakt een vraag die veel gemeenten in Noord-Holland bezighoudt: zelf scheiden of achteraf laten scheiden.",
   "chapter": 1
  },
  {
   "start": 91.46,
   "end": 95.7,
   "text": "Het Franse recyclingconcern Paprec breidt uit in Zwitserland.",
   "chapter": 2
  },
  {
   "start": 95.7,
   "end": 101.7,
   "text": "Dochterbedrijf Paprec Metabader neemt de familiegroep Barec over, meldt het vakblad Euwid.",
   "chapter": 2
  },
  {
   "start": 101.7,
   "end": 108.5,
   "text": "Barec heeft zijn hoofdkantoor in Ecublens, bij Lausanne, en telt ongeveer driehonderd medewerkers op acht locaties.",
   "chapter": 2
  },
  {
   "start": 108.5,
   "end": 114.98,
   "text": "Bij de overname horen ook Papirec en Datarec, gespecialiseerd in oud papier en documentvernietiging.",
   "chapter": 2
  },
  {
   "start": 114.98,
   "end": 121.78,
   "text": "Ook het recyclingbedrijf Thévenaz-Leduc gaat mee, actief in elektrische apparaten, autowrakken en schroot.",
   "chapter": 2
  },
  {
   "start": 121.78,
   "end": 129.06,
   "text": "Na de integratie telt Paprec Metabader volgens eigen opgave eenenveertig locaties en zo'n dertienhonderd medewerkers.",
   "chapter": 2
  },
  {
   "start": 129.06,
   "end": 131.3,
   "text": "De koopprijs is niet bekendgemaakt.",
   "chapter": 2
  },
  {
   "start": 131.3,
   "end": 134.97,
   "text": "Het is een volgende stap in de consolidatie van de Europese afvalmarkt.",
   "chapter": 2
  },
  {
   "start": 137.31,
   "end": 142.75,
   "text": "Op een verpakkingscongres in Utrecht is deze week de Packaging Data Hub gelanceerd.",
   "chapter": 3
  },
  {
   "start": 142.75,
   "end": 149.31,
   "text": "Het is een databank van adviesbureau Systemiq en onderzoeksbureau Earth Action, meldt Packaging Europe.",
   "chapter": 3
  },
  {
   "start": 149.31,
   "end": 155.31,
   "text": "De databank vergelijkt recyclingcijfers van vijftig landen en twaalf soorten plastic verpakkingen.",
   "chapter": 3
  },
  {
   "start": 155.31,
   "end": 160.99,
   "text": "Die landen zijn samen goed voor ongeveer tachtig procent van het plastic verpakkingsafval wereldwijd.",
   "chapter": 3
  },
  {
   "start": 160.99,
   "end": 164.75,
   "text": "Daarvan wordt in de praktijk achttien procent gerecycled.",
   "chapter": 3
  },
  {
   "start": 164.75,
   "end": 170.59,
   "text": "In de Europese Unie is dat ongeveer vijfendertig procent, lager dan de officiële cijfers.",
   "chapter": 3
  },
  {
   "start": 170.59,
   "end": 175.43,
   "text": "De Europese doelstelling voor tweeduizend dertig is vijfenvijftig procent.",
   "chapter": 3
  },
  {
   "start": 175.43,
   "end": 183.31,
   "text": "Folies, zakjes en wikkels vormen zo'n veertig procent van het afval, maar slechts ongeveer tien procent daarvan wordt gerecycled.",
   "chapter": 3
  },
  {
   "start": 183.31,
   "end": 187.76,
   "text": "Voor bedrijven die over verpakkingen rapporteren komt er zo een gedeelde rekenbasis.",
   "chapter": 3
  },
  {
   "start": 190.09,
   "end": 197.45,
   "text": "Het Internationaal Energieagentschap heeft op de klimaattop in het Turkse Antalya een rapport over afval gepresenteerd.",
   "chapter": 4
  },
  {
   "start": 197.45,
   "end": 206.65,
   "text": "Volgens het agentschap kan de wereldwijde uitstoot tegen tweeduizend vijfendertig met ruim anderhalf miljard ton CO-twee-equivalent per jaar dalen.",
   "chapter": 4
  },
  {
   "start": 206.65,
   "end": 213.93,
   "text": "Dat vraagt om afvalpreventie, zuiniger materiaalgebruik, meer recycling en energie uit restafval.",
   "chapter": 4
  },
  {
   "start": 213.93,
   "end": 221.37,
   "text": "Betere inzameling, sortering en recycling alleen levert al minstens vierhonderd miljoen ton op, meldt Euwid.",
   "chapter": 4
  },
  {
   "start": 221.37,
   "end": 226.49,
   "text": "Volgens het agentschap kan de recycling van plastic daarmee wereldwijd verdubbelen.",
   "chapter": 4
  },
  {
   "start": 226.49,
   "end": 234.49,
   "text": "Afval is nu goed voor ongeveer vier procent van de wereldwijde uitstoot en voor bijna een vijfde van de methaanuitstoot door mensen.",
   "chapter": 4
  },
  {
   "start": 234.49,
   "end": 240.2,
   "text": "Directeur Fatih Birol zegt dat overheden en bedrijven de macht hebben om de overgang te versnellen.",
   "chapter": 4
  },
  {
   "start": 242.53,
   "end": 245.41,
   "text": "En wat betekent dit voor uw organisatie?",
   "chapter": 5
  },
  {
   "start": 245.41,
   "end": 249.17,
   "text": "Het nieuws van vandaag gaat over de kwaliteit van wat u weggooit.",
   "chapter": 5
  },
  {
   "start": 249.17,
   "end": 255.33,
   "text": "Vervuild plastic is lastig te recyclen, dat ziet Amstelveen en dat bevestigen de nieuwe cijfers.",
   "chapter": 5
  },
  {
   "start": 255.33,
   "end": 260.93,
   "text": "Bij De Graaf Groep merken we dat een schone, aparte stroom op de werkvloer de meeste waarde houdt.",
   "chapter": 5
  },
  {
   "start": 260.93,
   "end": 263.33,
   "text": "Kijk daarom kritisch naar uw verpakkingen.",
   "chapter": 5
  },
  {
   "start": 263.33,
   "end": 266.29,
   "text": "Folies en gemengde materialen scoren slecht.",
   "chapter": 5
  },
  {
   "start": 266.29,
   "end": 271.57,
   "text": "Vraag leveranciers naar verpakkingen van één materiaal of naar herbruikbare alternatieven.",
   "chapter": 5
  },
  {
   "start": 271.57,
   "end": 273.81,
   "text": "En houd uw eigen cijfers bij.",
   "chapter": 5
  },
  {
   "start": 273.81,
   "end": 279.23,
   "text": "Wie zijn afvalstromen kent, kan straks beter rapporteren en zit minder snel vast aan stijgende kosten.",
   "chapter": 5
  },
  {
   "start": 279.68,
   "end": 283.36,
   "text": "Het cijfer van de dag is vijfendertig procent.",
   "chapter": 6
  },
  {
   "start": 283.36,
   "end": 290.88,
   "text": "Zoveel plastic verpakkingsafval wordt in de Europese Unie in de praktijk gerecycled, volgens de nieuwe Packaging Data Hub.",
   "chapter": 6
  },
  {
   "start": 290.88,
   "end": 294.97,
   "text": "Het Europese doel voor tweeduizend dertig ligt op vijfenvijftig procent.",
   "chapter": 6
  },
  {
   "start": 295.42,
   "end": 297.74,
   "text": "Dat was Grondstof voor vandaag.",
   "chapter": 7
  },
  {
   "start": 297.74,
   "end": 301.42,
   "text": "De bronnen bij elk bericht vindt u in de app en in de shownotes.",
   "chapter": 7
  },
  {
   "start": 301.42,
   "end": 303.74,
   "text": "Morgen om negen uur bent u weer bij.",
   "chapter": 7
  },
  {
   "start": 303.74,
   "end": 304.14,
   "text": "Tot dan.",
   "chapter": 7
  }
 ],
