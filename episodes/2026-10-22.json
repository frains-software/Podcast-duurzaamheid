 "transcript": [
  {
   "start": 5.5,
   "end": 6.54,
   "text": "Goedemorgen.",
   "chapter": 0
  },
  {
   "start": 6.54,
   "end": 8.98,
   "text": "Het is donderdag tweeëntwintig oktober.",
   "chapter": 0
  },
  {
   "start": 8.98,
   "end": 13.26,
   "text": "U luistert naar Grondstof, het circulaire nieuwsbulletin van De Graaf Groep.",
   "chapter": 0
  },
  {
   "start": 13.26,
   "end": 14.91,
   "text": "Ik ben Frans van den Berge.",
   "chapter": 0
  },
  {
   "start": 14.91,
   "end": 16.1,
   "text": "Dit zijn de koppen.",
   "chapter": 0
  },
  {
   "start": 16.1,
   "end": 19.94,
   "text": "De Duitse plasticbelasting loopt vast in de regeringscoalitie.",
   "chapter": 0
  },
  {
   "start": 19.94,
   "end": 24.1,
   "text": "In Nederland stijgt de afvalstoffenbelasting minder snel dan gepland.",
   "chapter": 0
  },
  {
   "start": 24.1,
   "end": 28.18,
   "text": "En het Europees Parlement neemt twee besluiten over afvalregels.",
   "chapter": 0
  },
  {
   "start": 30.52,
   "end": 37.48,
   "text": "De Duitse regering wil een belasting op plastic verpakkingen invoeren, maar de coalitie is het er niet over eens.",
   "chapter": 1
  },
  {
   "start": 37.48,
   "end": 39.88,
   "text": "Dat meldt vakblad Packaging Europe.",
   "chapter": 1
  },
  {
   "start": 39.88,
   "end": 44.44,
   "text": "Het voorstel is om vijfhonderdvijftig euro per ton kunststof te heffen.",
   "chapter": 1
  },
  {
   "start": 44.44,
   "end": 47.96,
   "text": "Het gaat om verpakkingen met meer dan vijf procent kunststof.",
   "chapter": 1
  },
  {
   "start": 47.96,
   "end": 53.64,
   "text": "Gerecycled plastic kan mogelijk worden vrijgesteld, maar die vrijstelling moet worden aangevraagd.",
   "chapter": 1
  },
  {
   "start": 53.64,
   "end": 57.16,
   "text": "De heffing moet in juli tweeduizend zevenentwintig ingaan.",
   "chapter": 1
  },
  {
   "start": 57.16,
   "end": 64.76,
   "text": "Fractievoorzitter Thorsten Frei van de christendemocraten zegt dat het wetsvoorstel in deze vorm niet klaar is voor goedkeuring.",
   "chapter": 1
  },
  {
   "start": 64.76,
   "end": 70.28,
   "text": "Volgens Packaging Europe zouden vierentwintig parlementsleden van de christendemocraten tegen zijn.",
   "chapter": 1
  },
  {
   "start": 70.28,
   "end": 72.76,
   "text": "Ook brancheorganisaties verzetten zich.",
   "chapter": 1
  },
  {
   "start": 72.76,
   "end": 76.04,
   "text": "Of de datum in juli haalbaar is, staat dus open.",
   "chapter": 1
  },
  {
   "start": 76.04,
   "end": 79.66,
   "text": "Voor bedrijven die plastic verpakkingen gebruiken, blijft het dus afwachten.",
   "chapter": 1
  },
  {
   "start": 81.99,
   "end": 86.79,
   "text": "De Nederlandse afvalstoffenbelasting stijgt minder snel dan eerder was bedoeld.",
   "chapter": 2
  },
  {
   "start": 86.79,
   "end": 92.63,
   "text": "Dat blijkt uit het Belastingplan tweeduizend zevenentwintig, schrijft belastingportaal TaxLive.",
   "chapter": 2
  },
  {
   "start": 92.63,
   "end": 97.43,
   "text": "In tweeduizend dertig komt het tarief structureel op eenentachtig euro per ton.",
   "chapter": 2
  },
  {
   "start": 97.43,
   "end": 100.95,
   "text": "Eerder was dat honderdzeventien euro en tien cent.",
   "chapter": 2
  },
  {
   "start": 100.95,
   "end": 106.87,
   "text": "Ook de verzwaring van de CO-twee-heffing voor afvalverbrandingsinstallaties verloopt geleidelijker.",
   "chapter": 2
  },
  {
   "start": 106.87,
   "end": 112.71,
   "text": "Beide maatregelen maken een deel van de lastenverzwaring uit het Belastingplan van dit jaar ongedaan.",
   "chapter": 2
  },
  {
   "start": 112.71,
   "end": 115.11,
   "text": "De Tweede Kamer behandelt het pakket nu.",
   "chapter": 2
  },
  {
   "start": 115.11,
   "end": 118.79,
   "text": "Het moet op één januari tweeduizend zevenentwintig ingaan.",
   "chapter": 2
  },
  {
   "start": 118.79,
   "end": 122.95,
   "text": "De Eerste Kamer volgt in december, dus er kan nog iets veranderen.",
   "chapter": 2
  },
  {
   "start": 122.95,
   "end": 126.56,
   "text": "Voor afvalverwerkers en hun klanten gaat het om voorspelbare kosten.",
   "chapter": 2
  },
  {
   "start": 128.9,
   "end": 137.86,
   "text": "Het Europees Parlement heeft gisteren in de plenaire vergadering gestemd over de plicht om in andere lidstaten een gemachtigde vertegenwoordiger aan te wijzen.",
   "chapter": 3
  },
  {
   "start": 137.86,
   "end": 139.94,
   "text": "Dat meldt vakblad Euwid.",
   "chapter": 3
  },
  {
   "start": 139.94,
   "end": 144.74,
   "text": "Het Parlement beperkt de opschorting van die plicht tot micro- en kleine bedrijven.",
   "chapter": 3
  },
  {
   "start": 144.74,
   "end": 149.62,
   "text": "Het gaat om producenten uit de Europese Unie met minder dan vijftig medewerkers.",
   "chapter": 3
  },
  {
   "start": 149.62,
   "end": 154.5,
   "text": "Hun jaaromzet of balanstotaal mag niet boven tien miljoen euro liggen.",
   "chapter": 3
  },
  {
   "start": 154.5,
   "end": 161.22,
   "text": "De regels gelden onder meer voor verpakkingen, batterijen, textiel, schoeisel en elektrische apparaten.",
   "chapter": 3
  },
  {
   "start": 161.22,
   "end": 164.1,
   "text": "Het Parlement heeft nu zijn standpunt vastgesteld.",
   "chapter": 3
  },
  {
   "start": 164.1,
   "end": 166.8,
   "text": "Of de lidstaten hiermee instemmen, meldt de bron niet.",
   "chapter": 3
  },
  {
   "start": 169.13,
   "end": 177.53,
   "text": "Het Europees Parlement wil dat de Commissie de export van schroot van permanente magneten naar landen buiten de Europese Unie kan beperken.",
   "chapter": 4
  },
  {
   "start": 177.53,
   "end": 179.37,
   "text": "Dat meldt Euwid.",
   "chapter": 4
  },
  {
   "start": 179.37,
   "end": 184.41,
   "text": "Het Parlement stemde hierover bij een wijziging van de verordening voor kritieke grondstoffen.",
   "chapter": 4
  },
  {
   "start": 184.41,
   "end": 187.05,
   "text": "Het doel is leveringszekerheid.",
   "chapter": 4
  },
  {
   "start": 187.05,
   "end": 190.41,
   "text": "Recyclebaar materiaal moet binnen de Unie blijven.",
   "chapter": 4
  },
  {
   "start": 190.41,
   "end": 197.13,
   "text": "Ook wil het Parlement dat afvalstromen met kritieke grondstoffen makkelijker over de grens binnen de Unie gaan.",
   "chapter": 4
  },
  {
   "start": 197.13,
   "end": 205.61,
   "text": "Het noemt de inzameling en recycling van producten met kritieke grondstoffen, vooral magneten, een grotendeels onbenutte bron.",
   "chapter": 4
  },
  {
   "start": 205.61,
   "end": 209.77,
   "text": "Het Parlement steunt ook een Europees centrum voor kritieke grondstoffen.",
   "chapter": 4
  },
  {
   "start": 209.77,
   "end": 211.26,
   "text": "Aantallen noemt de bron niet.",
   "chapter": 4
  },
  {
   "start": 213.6,
   "end": 216.48,
   "text": "En wat betekent dit voor uw organisatie?",
   "chapter": 5
  },
  {
   "start": 216.48,
   "end": 217.44,
   "text": "Twee dingen.",
   "chapter": 5
  },
  {
   "start": 217.44,
   "end": 223.12,
   "text": "Ten eerste: belastingen en heffingen op afval en verpakkingen zijn politiek nog niet af.",
   "chapter": 5
  },
  {
   "start": 223.12,
   "end": 227.12,
   "text": "Zowel in Duitsland als in Nederland kan het voorstel nog veranderen.",
   "chapter": 5
  },
  {
   "start": 227.12,
   "end": 232.32,
   "text": "Rekent u met kostenontwikkeling, houd dan een bandbreedte aan en leg uw aannames vast.",
   "chapter": 5
  },
  {
   "start": 232.32,
   "end": 239.52,
   "text": "Ten tweede: wie verpakkingen verkoopt in meerdere landen, moet nu al weten wie in die landen als vertegenwoordiger optreedt.",
   "chapter": 5
  },
  {
   "start": 239.52,
   "end": 243.44,
   "text": "De uitzondering voor kleine producenten is nog niet definitief.",
   "chapter": 5
  },
  {
   "start": 243.44,
   "end": 246.48,
   "text": "Breng daarom in kaart waar uw producten terechtkomen.",
   "chapter": 5
  },
  {
   "start": 246.48,
   "end": 253.7,
   "text": "Bij De Graaf Groep zien we dat organisaties die hun afvalstromen en leveranciers goed kennen, wijzigingen in regels het snelst opvangen.",
   "chapter": 5
  },
  {
   "start": 254.15,
   "end": 257.43,
   "text": "Het cijfer van vandaag is eenentachtig euro.",
   "chapter": 6
  },
  {
   "start": 257.43,
   "end": 266.91,
   "text": "Dat is het tarief per ton waarop de Nederlandse afvalstoffenbelasting in tweeduizend dertig structureel uitkomt, volgens het Belastingplan tweeduizend zevenentwintig.",
   "chapter": 6
  },
  {
   "start": 266.91,
   "end": 271.35,
   "text": "Eerder was uitgegaan van honderdzeventien euro en tien cent per ton.",
   "chapter": 6
  },
  {
   "start": 271.35,
   "end": 274.22,
   "text": "Het verschil is dus ruim zesendertig euro per ton.",
   "chapter": 6
  },
  {
   "start": 274.67,
   "end": 276.91,
   "text": "Dat was Grondstof voor vandaag.",
   "chapter": 7
  },
  {
   "start": 276.91,
   "end": 280.59,
   "text": "De bronnen bij elk bericht vindt u in de app en in de shownotes.",
   "chapter": 7
  },
  {
   "start": 280.59,
   "end": 282.83,
   "text": "Morgen om negen uur bent u weer bij.",
   "chapter": 7
  },
  {
   "start": 282.83,
   "end": 283.29,
   "text": "Tot dan.",
   "chapter": 7
  }
 ],
