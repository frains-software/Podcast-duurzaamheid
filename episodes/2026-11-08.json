 "transcript": [
  {
   "start": 5.5,
   "end": 6.62,
   "text": "Goedemorgen.",
   "chapter": 0
  },
  {
   "start": 6.62,
   "end": 8.78,
   "text": "Het is zondag acht november.",
   "chapter": 0
  },
  {
   "start": 8.78,
   "end": 13.26,
   "text": "U luistert naar Grondstof, het circulaire nieuwsbulletin van De Graaf Groep.",
   "chapter": 0
  },
  {
   "start": 13.26,
   "end": 14.86,
   "text": "Ik ben Frans van den Berge.",
   "chapter": 0
  },
  {
   "start": 14.86,
   "end": 16.38,
   "text": "Dit zijn de koppen.",
   "chapter": 0
  },
  {
   "start": 16.38,
   "end": 21.1,
   "text": "Europese lidstaten stemmen voor gelijke regels voor gerecycled plastic.",
   "chapter": 0
  },
  {
   "start": 21.1,
   "end": 24.82,
   "text": "Biffa neemt de recyclingactiviteiten van Enva over.",
   "chapter": 0
  },
  {
   "start": 24.82,
   "end": 29.42,
   "text": "En de Zwitserse flessenbranche begrenst het gebruik van gerecycled P-E-T.",
   "chapter": 0
  },
  {
   "start": 31.76,
   "end": 38.4,
   "text": "Europese lidstaten hebben gestemd voor geharmoniseerde einde-afvalcriteria voor gerecycled plastic.",
   "chapter": 1
  },
  {
   "start": 38.4,
   "end": 42.24,
   "text": "Dat meldt vakmedium Packaging Insights op zes november.",
   "chapter": 1
  },
  {
   "start": 42.24,
   "end": 46.72,
   "text": "De stemming vond de week ervoor plaats in een comité van de Europese Commissie.",
   "chapter": 1
  },
  {
   "start": 46.72,
   "end": 50.8,
   "text": "Met deze criteria houdt gerecycled plastic op afval te zijn.",
   "chapter": 1
  },
  {
   "start": 50.8,
   "end": 53.6,
   "text": "Het kan dan als grondstof worden verhandeld.",
   "chapter": 1
  },
  {
   "start": 53.6,
   "end": 57.44,
   "text": "De criteria moeten nog formeel worden vastgesteld en gepubliceerd.",
   "chapter": 1
  },
  {
   "start": 57.44,
   "end": 60.56,
   "text": "Ze treden normaal twintig dagen later in werking.",
   "chapter": 1
  },
  {
   "start": 60.56,
   "end": 64.52,
   "text": "Naar verwachting gelden ze rond medio tweeduizend zevenentwintig.",
   "chapter": 1
  },
  {
   "start": 64.52,
   "end": 74.64,
   "text": "De Europese afvalfederatie F-E-A-D stelt dat het ontbreken van deze regels Europese plasticrecyclers jaarlijks honderdtwintig miljoen euro kost.",
   "chapter": 1
  },
  {
   "start": 74.64,
   "end": 79.48,
   "text": "Het doet ertoe, omdat afzet van recyclaat nu in elk land anders wordt beoordeeld.",
   "chapter": 1
  },
  {
   "start": 81.81,
   "end": 88.85,
   "text": "De Britse afvalgroep Biffa neemt de algemene recyclingactiviteiten van Enva over in Engeland en Schotland.",
   "chapter": 2
  },
  {
   "start": 88.85,
   "end": 92.13,
   "text": "Dat meldt vakblad Letsrecycle op drie november.",
   "chapter": 2
  },
  {
   "start": 92.13,
   "end": 97.09,
   "text": "De overname omvat acht locaties en de bijbehorende inzameling en transport.",
   "chapter": 2
  },
  {
   "start": 97.09,
   "end": 101.25,
   "text": "De bedrijven verwerken ongeveer achthonderdduizend ton materiaal per jaar.",
   "chapter": 2
  },
  {
   "start": 101.25,
   "end": 105.57,
   "text": "Er werken ruim zeshonderd mensen en er rijden ruim honderdvijftig voertuigen.",
   "chapter": 2
  },
  {
   "start": 105.57,
   "end": 107.25,
   "text": "De contracten zijn getekend.",
   "chapter": 2
  },
  {
   "start": 107.25,
   "end": 110.05,
   "text": "De overname moet in december worden afgerond.",
   "chapter": 2
  },
  {
   "start": 110.05,
   "end": 113.77,
   "text": "Biffa wil zijn positie in de bouw- en sloopsector versterken.",
   "chapter": 2
  },
  {
   "start": 113.77,
   "end": 117.89,
   "text": "Enva behoudt andere activiteiten in het Verenigd Koninkrijk en Ierland.",
   "chapter": 2
  },
  {
   "start": 117.89,
   "end": 120.45,
   "text": "Over de prijs is in de bron niets vermeld.",
   "chapter": 2
  },
  {
   "start": 120.45,
   "end": 123.28,
   "text": "Het doet ertoe, omdat de sector verder consolideert.",
   "chapter": 2
  },
  {
   "start": 125.62,
   "end": 131.38,
   "text": "De Zwitserse P-E-T-branche begrenst het aandeel gerecycled P-E-T in drankflessen.",
   "chapter": 3
  },
  {
   "start": 131.38,
   "end": 133.94,
   "text": "Dat meldt Euwid op vijf november.",
   "chapter": 3
  },
  {
   "start": 133.94,
   "end": 137.62,
   "text": "Het gemiddelde mag maximaal vijfenzeventig procent zijn.",
   "chapter": 3
  },
  {
   "start": 137.62,
   "end": 143.14,
   "text": "Dat wordt vastgelegd in een branchevereenkomst van P-E-T-Recycling Schweiz en haar leden.",
   "chapter": 3
  },
  {
   "start": 143.14,
   "end": 148.82,
   "text": "De regeling geldt vanaf tweeduizend zevenentwintig en is definitief in tweeduizend achtentwintig.",
   "chapter": 3
  },
  {
   "start": 148.82,
   "end": 150.74,
   "text": "De reden is kwaliteit.",
   "chapter": 3
  },
  {
   "start": 150.74,
   "end": 155.06,
   "text": "Bij herhaald mechanisch recyclen stapelen verontreinigingen zich op.",
   "chapter": 3
  },
  {
   "start": 155.06,
   "end": 158.5,
   "text": "Die zijn met de huidige technieken niet volledig te verwijderen.",
   "chapter": 3
  },
  {
   "start": 158.5,
   "end": 161.06,
   "text": "Daarom is nieuw P-E-T nodig.",
   "chapter": 3
  },
  {
   "start": 161.06,
   "end": 165.86,
   "text": "Afzonderlijke productlijnen mogen nog wel volledig uit gerecycled materiaal bestaan.",
   "chapter": 3
  },
  {
   "start": 165.86,
   "end": 170.2,
   "text": "Het doet ertoe, omdat het laat zien dat meer recyclaat niet altijd beter is.",
   "chapter": 3
  },
  {
   "start": 172.53,
   "end": 179.96,
   "text": "De Europese afvalfederatie F-E-A-D wil dat btw-regels recycling gaan belonen.",
   "chapter": 4
  },
  {
   "start": 179.96,
   "end": 183.8,
   "text": "Dat blijkt uit een bericht op Afvalgids van zes november.",
   "chapter": 4
  },
  {
   "start": 183.8,
   "end": 190.36,
   "text": "De Europese Commissie heeft voorgesteld de btw-regels te moderniseren voor de circulaire economie.",
   "chapter": 4
  },
  {
   "start": 190.36,
   "end": 193.16,
   "text": "F-E-A-D is blij met het initiatief.",
   "chapter": 4
  },
  {
   "start": 193.16,
   "end": 196.68,
   "text": "Maar de federatie vindt de afbakening te beperkt.",
   "chapter": 4
  },
  {
   "start": 196.68,
   "end": 201.32,
   "text": "Zij pleit voor gelijke, lagere btw-tarieven voor afvalbeheer.",
   "chapter": 4
  },
  {
   "start": 201.32,
   "end": 205.64,
   "text": "Ook wil zij lagere tarieven voor producten met gerecycled materiaal.",
   "chapter": 4
  },
  {
   "start": 205.64,
   "end": 208.76,
   "text": "Hetzelfde geldt voor compost en digestaat.",
   "chapter": 4
  },
  {
   "start": 208.76,
   "end": 211.96,
   "text": "In de bron staan geen bedragen of percentages.",
   "chapter": 4
  },
  {
   "start": 211.96,
   "end": 218.9,
   "text": "Het doet ertoe, omdat de btw nu vaak de prijs van gerecyclede grondstoffen ten opzichte van nieuwe grondstoffen beïnvloedt.",
   "chapter": 4
  },
  {
   "start": 221.24,
   "end": 224.2,
   "text": "En wat betekent dit voor uw organisatie?",
   "chapter": 5
  },
  {
   "start": 224.2,
   "end": 231.0,
   "text": "Gelijke Europese regels voor gerecycled plastic maken het makkelijker om recyclaat te kopen en te verkopen.",
   "chapter": 5
  },
  {
   "start": 231.0,
   "end": 237.4,
   "text": "Vraag uw leveranciers daarom nu welke aandelen gerecycled materiaal zij leveren en hoe zij dat aantonen.",
   "chapter": 5
  },
  {
   "start": 237.4,
   "end": 243.0,
   "text": "Het Zwitserse voorbeeld laat zien dat kwaliteit zwaarder weegt dan een zo hoog mogelijk percentage.",
   "chapter": 5
  },
  {
   "start": 243.0,
   "end": 246.68,
   "text": "Stel eisen aan de kwaliteit, niet alleen aan het aandeel.",
   "chapter": 5
  },
  {
   "start": 246.68,
   "end": 251.88,
   "text": "Bij De Graaf Groep merken we dat zuivere, gescheiden stromen de beste grondstof opleveren.",
   "chapter": 5
  },
  {
   "start": 251.88,
   "end": 254.2,
   "text": "Begin dus bij de scheiding aan de bron.",
   "chapter": 5
  },
  {
   "start": 254.2,
   "end": 258.6,
   "text": "De overname van Enva laat tot slot zien dat de sector verder samengaat.",
   "chapter": 5
  },
  {
   "start": 258.6,
   "end": 262.01,
   "text": "Controleer daarom uw afvalcontracten op looptijd en voorwaarden.",
   "chapter": 5
  },
  {
   "start": 262.46,
   "end": 264.92,
   "text": "Honderdtwintig miljoen euro.",
   "chapter": 6
  },
  {
   "start": 264.92,
   "end": 274.12,
   "text": "Zoveel kost het ontbreken van Europese einde-afvalcriteria de plasticrecyclers jaarlijks, volgens de Europese afvalfederatie F-E-A-D.",
   "chapter": 6
  },
  {
   "start": 274.12,
   "end": 277.96,
   "text": "Het is een schatting van de sector zelf en geen officieel cijfer.",
   "chapter": 6
  },
  {
   "start": 277.96,
   "end": 280.4,
   "text": "Maar het toont wat versnipperde regels kosten.",
   "chapter": 6
  },
  {
   "start": 280.85,
   "end": 283.17,
   "text": "Dat was Grondstof voor vandaag.",
   "chapter": 7
  },
  {
   "start": 283.17,
   "end": 286.85,
   "text": "De bronnen bij elk bericht vindt u in de app en in de shownotes.",
   "chapter": 7
  },
  {
   "start": 286.85,
   "end": 289.25,
   "text": "Morgen om negen uur bent u weer bij.",
   "chapter": 7
  },
  {
   "start": 289.25,
   "end": 289.71,
   "text": "Tot dan.",
   "chapter": 7
  }
 ],
