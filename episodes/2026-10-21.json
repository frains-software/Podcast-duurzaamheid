 "transcript": [
  {
   "start": 5.5,
   "end": 6.54,
   "text": "Goedemorgen.",
   "chapter": 0
  },
  {
   "start": 6.54,
   "end": 9.02,
   "text": "Het is woensdag eenentwintig oktober.",
   "chapter": 0
  },
  {
   "start": 9.02,
   "end": 13.58,
   "text": "U luistert naar Grondstof, het circulaire nieuwsbulletin van De Graaf Groep.",
   "chapter": 0
  },
  {
   "start": 13.58,
   "end": 15.18,
   "text": "Ik ben Frans van den Berge.",
   "chapter": 0
  },
  {
   "start": 15.18,
   "end": 16.62,
   "text": "Dit zijn de koppen.",
   "chapter": 0
  },
  {
   "start": 16.62,
   "end": 21.34,
   "text": "De Europese Wet voor een circulaire economie is opnieuw uitgesteld.",
   "chapter": 0
  },
  {
   "start": 21.34,
   "end": 26.38,
   "text": "Het Europees Parlement wil kleine bedrijven ontzien bij de verpakkingsverordening.",
   "chapter": 0
  },
  {
   "start": 26.38,
   "end": 30.03,
   "text": "En de Duitse schrootmarkt zit vast door een laag waterpeil.",
   "chapter": 0
  },
  {
   "start": 32.37,
   "end": 38.69,
   "text": "De Europese Commissie publiceert haar voorstellen voor de Wet voor een circulaire economie later dan gepland.",
   "chapter": 1
  },
  {
   "start": 38.69,
   "end": 40.77,
   "text": "Dat meldt vakblad Euwid.",
   "chapter": 1
  },
  {
   "start": 40.77,
   "end": 44.13,
   "text": "De voorstellen komen nu voorlopig op achttien november.",
   "chapter": 1
  },
  {
   "start": 44.13,
   "end": 49.33,
   "text": "Eerder was elf november genoemd, en oorspronkelijk zou het al in september gebeuren.",
   "chapter": 1
  },
  {
   "start": 49.33,
   "end": 55.33,
   "text": "Reden is dat de onafhankelijke toetsingsraad van de Commissie zorgen had over de effectbeoordeling.",
   "chapter": 1
  },
  {
   "start": 55.33,
   "end": 60.05,
   "text": "De wet moet onder meer de richtlijn voor elektrisch en elektronisch afval herzien.",
   "chapter": 1
  },
  {
   "start": 60.05,
   "end": 68.29,
   "text": "Ook moeten de regels voor uitgebreide producentenverantwoordelijkheid en de afvalclassificaties van de lidstaten dichter bij elkaar komen.",
   "chapter": 1
  },
  {
   "start": 68.29,
   "end": 74.13,
   "text": "Commissaris Jessika Roswall noemt een echte eengemaakte markt voor afval een prioriteit.",
   "chapter": 1
  },
  {
   "start": 74.13,
   "end": 78.11,
   "text": "Voor bedrijven betekent dit nog even wachten op duidelijkheid over hun verplichtingen.",
   "chapter": 1
  },
  {
   "start": 80.44,
   "end": 85.94,
   "text": "Het Europees Parlement wil kleine bedrijven vrijstellen van een plicht uit de verpakkingsverordening.",
   "chapter": 2
  },
  {
   "start": 85.94,
   "end": 88.9,
   "text": "Dat meldt het Duitse vakblad Textilwirtschaft.",
   "chapter": 2
  },
  {
   "start": 88.9,
   "end": 93.86,
   "text": "Het gaat om de plicht om in andere lidstaten een bevoegde vertegenwoordiger aan te wijzen.",
   "chapter": 2
  },
  {
   "start": 93.86,
   "end": 97.3,
   "text": "Die geldt sinds augustus voor wie in meerdere landen verkoopt.",
   "chapter": 2
  },
  {
   "start": 97.3,
   "end": 105.46,
   "text": "De opschorting zou gelden voor Europese bedrijven met minder dan vijftig medewerkers en een omzet of balanstotaal onder tien miljoen euro.",
   "chapter": 2
  },
  {
   "start": 105.46,
   "end": 108.82,
   "text": "Bedrijven van buiten de Europese Unie blijven verplicht.",
   "chapter": 2
  },
  {
   "start": 108.82,
   "end": 113.06,
   "text": "De Commissie had in december vorig jaar een bredere opschorting voorgesteld.",
   "chapter": 2
  },
  {
   "start": 113.06,
   "end": 118.02,
   "text": "De opschorting loopt af zodra de nieuwe regels voor de circulaire economie van kracht worden.",
   "chapter": 2
  },
  {
   "start": 118.02,
   "end": 122.19,
   "text": "Parlement en lidstaten moeten het nog eens worden, dus het kan nog veranderen.",
   "chapter": 2
  },
  {
   "start": 124.53,
   "end": 128.53,
   "text": "De Duitse markt voor ferroschroot zit vast door logistieke problemen.",
   "chapter": 3
  },
  {
   "start": 128.53,
   "end": 130.05,
   "text": "Dat meldt Euwid.",
   "chapter": 3
  },
  {
   "start": 130.05,
   "end": 133.73,
   "text": "Het waterpeil op de Duitse rivieren is uitzonderlijk laag.",
   "chapter": 3
  },
  {
   "start": 133.73,
   "end": 138.53,
   "text": "Op de Rijn lag de meetpaal bij Kaub eind september tijdelijk onder het nulpunt.",
   "chapter": 3
  },
  {
   "start": 138.53,
   "end": 143.41,
   "text": "Op andere rivieren is binnenvaart vaak niet meer rendabel door gestegen vrachttarieven.",
   "chapter": 3
  },
  {
   "start": 143.41,
   "end": 147.49,
   "text": "Voor transport per spoor of over de weg is geen extra capaciteit.",
   "chapter": 3
  },
  {
   "start": 147.49,
   "end": 151.81,
   "text": "Schroot hoopt zich daardoor op, terwijl de vraag naar nieuw staal laag blijft.",
   "chapter": 3
  },
  {
   "start": 151.81,
   "end": 156.85,
   "text": "Staalbedrijven lieten de schrootprijzen in oktober ongewijzigd op het niveau van september.",
   "chapter": 3
  },
  {
   "start": 156.85,
   "end": 161.81,
   "text": "Alleen contracten die vroeg in de maand zijn gesloten, kregen een verhoging van enkele euro's.",
   "chapter": 3
  },
  {
   "start": 161.81,
   "end": 164.96,
   "text": "Recyclers verwachten pas na het einde van het jaar herstel.",
   "chapter": 3
  },
  {
   "start": 167.29,
   "end": 171.61,
   "text": "Een rustige nieuwsdag, dus een praktijkvoorbeeld van vorige week.",
   "chapter": 4
  },
  {
   "start": 171.61,
   "end": 176.81,
   "text": "De gemeente Hengelo stopt met de derde inzamelronde van verpakkingsafval bij hoogbouw.",
   "chapter": 4
  },
  {
   "start": 176.81,
   "end": 180.33,
   "text": "Dat meldt de Afvalgids, op basis van het Algemeen Dagblad.",
   "chapter": 4
  },
  {
   "start": 180.33,
   "end": 184.25,
   "text": "De extra ronde was een proef, die met drie maanden was verlengd.",
   "chapter": 4
  },
  {
   "start": 184.25,
   "end": 187.77,
   "text": "Ook na die verlenging leverde de ronde geen verbetering op.",
   "chapter": 4
  },
  {
   "start": 187.77,
   "end": 190.49,
   "text": "De tweede inzamelronde blijft bestaan.",
   "chapter": 4
  },
  {
   "start": 190.49,
   "end": 195.21,
   "text": "Het bericht laat zien dat vaker ophalen niet vanzelf tot beter scheiden leidt.",
   "chapter": 4
  },
  {
   "start": 195.21,
   "end": 199.29,
   "text": "Gemeenten moeten ook letten op de hoeveelheid zakken en op gedrag.",
   "chapter": 4
  },
  {
   "start": 199.29,
   "end": 201.28,
   "text": "Cijfers over de proef noemt de bron niet.",
   "chapter": 4
  },
  {
   "start": 203.62,
   "end": 206.58,
   "text": "En wat betekent dit voor uw organisatie?",
   "chapter": 5
  },
  {
   "start": 206.58,
   "end": 207.54,
   "text": "Twee dingen.",
   "chapter": 5
  },
  {
   "start": 207.54,
   "end": 210.74,
   "text": "Ten eerste: de regels blijven in beweging.",
   "chapter": 5
  },
  {
   "start": 210.74,
   "end": 217.7,
   "text": "De verpakkingsverordening geldt al, maar de Wet voor een circulaire economie schuift op en uitzonderingen zijn nog niet vast.",
   "chapter": 5
  },
  {
   "start": 217.7,
   "end": 220.18,
   "text": "Wacht daarom niet op de definitieve tekst.",
   "chapter": 5
  },
  {
   "start": 220.18,
   "end": 226.34,
   "text": "Breng nu in kaart welke verpakkingen u op de markt brengt en wie bij u verantwoordelijk is voor de gegevens.",
   "chapter": 5
  },
  {
   "start": 226.34,
   "end": 230.1,
   "text": "Ten tweede: afvalstromen zijn afhankelijk van logistiek.",
   "chapter": 5
  },
  {
   "start": 230.1,
   "end": 234.66,
   "text": "Het Duitse schroot laat zien dat een laag waterpeil de hele keten kan vertragen.",
   "chapter": 5
  },
  {
   "start": 234.66,
   "end": 239.62,
   "text": "Afspraken met uw inzamelaar over opslag en ophaalmomenten voorkomen verrassingen.",
   "chapter": 5
  },
  {
   "start": 239.62,
   "end": 245.91,
   "text": "Bij De Graaf Groep zien we dat organisaties met overzicht over hun afvalstromen het rustigst door zulke periodes komen.",
   "chapter": 5
  },
  {
   "start": 246.36,
   "end": 249.48,
   "text": "Het cijfer van vandaag is achttien november.",
   "chapter": 6
  },
  {
   "start": 249.48,
   "end": 256.56,
   "text": "Dat is de nieuwe datum waarop de Europese Commissie haar voorstellen voor de Wet voor een circulaire economie wil publiceren.",
   "chapter": 6
  },
  {
   "start": 256.56,
   "end": 260.0,
   "text": "Oorspronkelijk stond die publicatie voor september gepland.",
   "chapter": 6
  },
  {
   "start": 260.0,
   "end": 262.58,
   "text": "Het is dus al de tweede keer dat de datum verschuift.",
   "chapter": 6
  },
  {
   "start": 263.03,
   "end": 265.35,
   "text": "Dat was Grondstof voor vandaag.",
   "chapter": 7
  },
  {
   "start": 265.35,
   "end": 269.11,
   "text": "De bronnen bij elk bericht vindt u in de app en in de shownotes.",
   "chapter": 7
  },
  {
   "start": 269.11,
   "end": 271.27,
   "text": "Morgen om negen uur bent u weer bij.",
   "chapter": 7
  },
  {
   "start": 271.27,
   "end": 271.72,
   "text": "Tot dan.",
   "chapter": 7
  }
 ],
