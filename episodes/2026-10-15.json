 "transcript": [
  {
   "start": 5.5,
   "end": 6.46,
   "text": "Goedemorgen.",
   "chapter": 0
  },
  {
   "start": 6.46,
   "end": 8.78,
   "text": "Het is donderdag vijftien oktober.",
   "chapter": 0
  },
  {
   "start": 8.78,
   "end": 13.18,
   "text": "U luistert naar Grondstof, het circulaire nieuwsbulletin van De Graaf Groep.",
   "chapter": 0
  },
  {
   "start": 13.18,
   "end": 14.86,
   "text": "Ik ben Frans van den Berge.",
   "chapter": 0
  },
  {
   "start": 14.86,
   "end": 16.78,
   "text": "Dit zijn de koppen.",
   "chapter": 0
  },
  {
   "start": 16.78,
   "end": 22.06,
   "text": "Europa verkoopt steeds meer elektronica, maar zamelt er veel minder van in.",
   "chapter": 0
  },
  {
   "start": 22.06,
   "end": 27.9,
   "text": "De Europese Commissie wil de wet voor de circulaire economie op elf november presenteren.",
   "chapter": 0
  },
  {
   "start": 27.9,
   "end": 31.08,
   "text": "En in Duitsland wordt oud papier opnieuw duurder.",
   "chapter": 0
  },
  {
   "start": 33.42,
   "end": 36.86,
   "text": "Europa zamelt te weinig elektronisch afval in.",
   "chapter": 1
  },
  {
   "start": 36.86,
   "end": 42.46,
   "text": "Dat zeggen milieuorganisaties woensdag, op de Internationale dag van elektronisch afval.",
   "chapter": 1
  },
  {
   "start": 42.46,
   "end": 47.58,
   "text": "Zij baseren zich op nieuwe cijfers van Eurostat over tweeduizend vierentwintig.",
   "chapter": 1
  },
  {
   "start": 47.58,
   "end": 55.1,
   "text": "In dat jaar werd in de Europese Unie veertien komma zes miljoen ton aan elektrische en elektronische apparatuur verkocht.",
   "chapter": 1
  },
  {
   "start": 55.1,
   "end": 58.98,
   "text": "Dat is eenennegentig procent meer dan in tweeduizend twaalf.",
   "chapter": 1
  },
  {
   "start": 58.98,
   "end": 65.42,
   "text": "Er werd vijf komma vijf miljoen ton ingezameld, ongeveer zes procent meer dan een jaar eerder.",
   "chapter": 1
  },
  {
   "start": 65.42,
   "end": 72.14,
   "text": "Nederland hoort bij de landen met het hoogste verbruik per inwoner, tussen vijfendertig en achtendertig kilo.",
   "chapter": 1
  },
  {
   "start": 72.14,
   "end": 78.86,
   "text": "Het Europees Milieubureau en andere organisaties vragen om bindende doelen voor preventie en hergebruik.",
   "chapter": 1
  },
  {
   "start": 78.86,
   "end": 84.5,
   "text": "Volgens de organisatie Rreuse blijft het hergebruik van afgedankte apparaten onder de twee procent.",
   "chapter": 1
  },
  {
   "start": 86.83,
   "end": 92.35,
   "text": "De Europese Commissie wil de wet voor de circulaire economie op elf november presenteren.",
   "chapter": 2
  },
  {
   "start": 92.35,
   "end": 96.91,
   "text": "Dat meldt het vakmedium Euwid, op basis van het voorlopige tijdschema.",
   "chapter": 2
  },
  {
   "start": 96.91,
   "end": 100.51,
   "text": "Oorspronkelijk stond het voorstel gepland voor het derde kwartaal.",
   "chapter": 2
  },
  {
   "start": 100.51,
   "end": 105.95,
   "text": "Het liep vertraging op, nadat de toetsingsraad van de Commissie kritiek had op de effectbeoordeling.",
   "chapter": 2
  },
  {
   "start": 105.95,
   "end": 112.19,
   "text": "Commissaris Jessika Roswall zegt dat de raad vooral miste dat de vraagzijde onvoldoende was uitgewerkt.",
   "chapter": 2
  },
  {
   "start": 112.19,
   "end": 122.03,
   "text": "Naar verwachting gaat het voorstel over geharmoniseerde producentenverantwoordelijkheid, eenduidige definities van afval en een echte Europese markt voor afval.",
   "chapter": 2
  },
  {
   "start": 122.03,
   "end": 126.19,
   "text": "Ook moeten gerecyclede grondstoffen beter kunnen concurreren met nieuwe.",
   "chapter": 2
  },
  {
   "start": 126.19,
   "end": 130.59,
   "text": "Het voorstel zou ook de Europese richtlijn voor elektronisch afval herzien.",
   "chapter": 2
  },
  {
   "start": 130.59,
   "end": 132.1,
   "text": "De datum is nog voorlopig.",
   "chapter": 2
  },
  {
   "start": 134.44,
   "end": 140.52,
   "text": "Statiegeldoverlast kost de gemeente Utrecht ongeveer één komma drie miljoen euro per jaar.",
   "chapter": 3
  },
  {
   "start": 140.52,
   "end": 147.48,
   "text": "Dat meldt de regionale omroep van Utrecht, op basis van antwoorden van het stadsbestuur op vragen van de gemeenteraad.",
   "chapter": 3
  },
  {
   "start": 147.48,
   "end": 154.6,
   "text": "Het bedrag gaat over schade aan prullenbakken en straatmeubilair en over extra schoonmaak, alleen in het centrum.",
   "chapter": 3
  },
  {
   "start": 154.6,
   "end": 158.52,
   "text": "Het komt uit een onderzoek in opdracht van de vier grootste steden.",
   "chapter": 3
  },
  {
   "start": 158.52,
   "end": 164.44,
   "text": "De overlast nam toe nadat sinds april tweeduizend drieëntwintig ook op blikjes statiegeld zit.",
   "chapter": 3
  },
  {
   "start": 164.44,
   "end": 167.8,
   "text": "Eén nieuwe prullenbak kost driehonderdvijftig euro.",
   "chapter": 3
  },
  {
   "start": 167.8,
   "end": 171.48,
   "text": "Tegelijk worden er minder statiegeldflesjes op straat gevonden.",
   "chapter": 3
  },
  {
   "start": 171.48,
   "end": 174.52,
   "text": "Utrecht vraagt het Rijk om een plan van aanpak.",
   "chapter": 3
  },
  {
   "start": 174.52,
   "end": 181.28,
   "text": "Verpact, de uitvoerder van het systeem, moet volgens de gemeente zorgen voor een fijnmazig netwerk van inleverpunten.",
   "chapter": 3
  },
  {
   "start": 183.61,
   "end": 187.13,
   "text": "De prijzen voor oud papier in Duitsland stijgen verder.",
   "chapter": 4
  },
  {
   "start": 187.13,
   "end": 189.29,
   "text": "Dat meldt Euwid woensdag.",
   "chapter": 4
  },
  {
   "start": 189.29,
   "end": 193.69,
   "text": "Na een stijging in september gaan de prijzen in oktober opnieuw omhoog.",
   "chapter": 4
  },
  {
   "start": 193.69,
   "end": 201.45,
   "text": "De stijging is scherp voor gemengd papier en karton, voor supermarktkarton en voor soorten die geschikt zijn voor het ontinkten.",
   "chapter": 4
  },
  {
   "start": 201.45,
   "end": 206.81,
   "text": "Voor middelhoge en hoogwaardige soorten blijven de prijzen stabiel tot iets hoger.",
   "chapter": 4
  },
  {
   "start": 206.81,
   "end": 212.81,
   "text": "De papierfabrieken blijven veel afnemen en zoeken vooral meer supermarktkarton en gemengd papier.",
   "chapter": 4
  },
  {
   "start": 212.81,
   "end": 218.01,
   "text": "Het aanbod is zwak, want de inzameling is sinds de zomer hooguit licht gestegen.",
   "chapter": 4
  },
  {
   "start": 218.01,
   "end": 220.05,
   "text": "Het bericht noemt geen bedragen per ton.",
   "chapter": 4
  },
  {
   "start": 222.39,
   "end": 225.43,
   "text": "En wat betekent dit voor uw organisatie?",
   "chapter": 5
  },
  {
   "start": 225.43,
   "end": 226.47,
   "text": "Drie dingen.",
   "chapter": 5
  },
  {
   "start": 226.47,
   "end": 229.43,
   "text": "Ten eerste de markt voor oud papier.",
   "chapter": 5
  },
  {
   "start": 229.43,
   "end": 235.91,
   "text": "Als de vraag aantrekt en het aanbod achterblijft, loont het om papier en karton goed gescheiden te houden.",
   "chapter": 5
  },
  {
   "start": 235.91,
   "end": 239.19,
   "text": "Schone stromen zijn meer waard dan gemengd afval.",
   "chapter": 5
  },
  {
   "start": 239.19,
   "end": 241.35,
   "text": "Ten tweede elektronica.",
   "chapter": 5
  },
  {
   "start": 241.35,
   "end": 246.79,
   "text": "Wie apparatuur aanschaft, kan vragen naar reparatie, een lange gebruiksduur en terugname.",
   "chapter": 5
  },
  {
   "start": 246.79,
   "end": 249.91,
   "text": "Dat scheelt later in afvoer en in vervangingskosten.",
   "chapter": 5
  },
  {
   "start": 249.91,
   "end": 253.51,
   "text": "Ten derde de Europese wet voor de circulaire economie.",
   "chapter": 5
  },
  {
   "start": 253.51,
   "end": 255.59,
   "text": "Die komt waarschijnlijk over een maand.",
   "chapter": 5
  },
  {
   "start": 255.59,
   "end": 259.91,
   "text": "Maak nu inzichtelijk welke afvalstromen u heeft en wie ze afvoert.",
   "chapter": 5
  },
  {
   "start": 259.91,
   "end": 262.92,
   "text": "Wie dat in beeld heeft, kan nieuwe regels rustig inpassen.",
   "chapter": 5
  },
  {
   "start": 263.37,
   "end": 267.17,
   "text": "Het cijfer van de dag is veertien komma zes miljoen.",
   "chapter": 6
  },
  {
   "start": 267.17,
   "end": 274.21,
   "text": "Zoveel ton aan elektrische en elektronische apparatuur werd in tweeduizend vierentwintig in de Europese Unie verkocht.",
   "chapter": 6
  },
  {
   "start": 274.21,
   "end": 278.38,
   "text": "Er werd vijf komma vijf miljoen ton aan elektronisch afval ingezameld.",
   "chapter": 6
  },
  {
   "start": 278.83,
   "end": 281.15,
   "text": "Dat was Grondstof voor vandaag.",
   "chapter": 7
  },
  {
   "start": 281.15,
   "end": 284.83,
   "text": "De bronnen bij elk bericht vindt u in de app en in de shownotes.",
   "chapter": 7
  },
  {
   "start": 284.83,
   "end": 287.23,
   "text": "Morgen om negen uur bent u weer bij.",
   "chapter": 7
  },
  {
   "start": 287.23,
   "end": 287.67,
   "text": "Tot dan.",
   "chapter": 7
  }
 ],
