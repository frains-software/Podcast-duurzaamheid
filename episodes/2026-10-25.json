 "transcript": [
  {
   "start": 5.5,
   "end": 6.5,
   "text": "Goedemorgen.",
   "chapter": 0
  },
  {
   "start": 6.5,
   "end": 8.82,
   "text": "Het is zondag vijfentwintig oktober.",
   "chapter": 0
  },
  {
   "start": 8.82,
   "end": 13.18,
   "text": "U luistert naar Grondstof, het circulaire nieuwsbulletin van De Graaf Groep.",
   "chapter": 0
  },
  {
   "start": 13.18,
   "end": 14.78,
   "text": "Ik ben Frans van den Berge.",
   "chapter": 0
  },
  {
   "start": 14.78,
   "end": 16.34,
   "text": "Dit zijn de koppen.",
   "chapter": 0
  },
  {
   "start": 16.34,
   "end": 20.94,
   "text": "Zeven lidstaten vragen Brussel om een steunpakket voor plasticrecycling.",
   "chapter": 0
  },
  {
   "start": 20.94,
   "end": 25.3,
   "text": "A-V-R rekent de extra kosten van bodemas door aan klanten.",
   "chapter": 0
  },
  {
   "start": 25.3,
   "end": 29.47,
   "text": "En Amstelveen wil stoppen met het gescheiden inzamelen van verpakkingsafval.",
   "chapter": 0
  },
  {
   "start": 31.81,
   "end": 37.17,
   "text": "Zeven Europese lidstaten willen dat Brussel de plasticrecycling te hulp schiet.",
   "chapter": 1
  },
  {
   "start": 37.17,
   "end": 39.17,
   "text": "Dat meldt vakblad Euwid.",
   "chapter": 1
  },
  {
   "start": 39.17,
   "end": 46.37,
   "text": "Italië nam het initiatief, samen met Portugal, Nederland, Frankrijk, Spanje, België en Letland.",
   "chapter": 1
  },
  {
   "start": 46.37,
   "end": 49.81,
   "text": "Het onderwerp kwam vorige week aan bod in de Milieuraad.",
   "chapter": 1
  },
  {
   "start": 49.81,
   "end": 57.65,
   "text": "De landen vragen om strengere controles op import, meer vraag naar gerecycled plastic en financiële steun voor recyclers.",
   "chapter": 1
  },
  {
   "start": 57.65,
   "end": 65.09,
   "text": "Volgens Italië groeit de Europese recyclingcapaciteit niet meer en staat zij op ongeveer dertien komma twee miljoen ton.",
   "chapter": 1
  },
  {
   "start": 65.09,
   "end": 69.81,
   "text": "Nederland meldde dat veertien recyclefabrieken binnen twee jaar zijn gesloten.",
   "chapter": 1
  },
  {
   "start": 69.81,
   "end": 76.61,
   "text": "Italië noemt hoge energiekosten, lage prijzen voor nieuw plastic en goedkope import als oorzaak.",
   "chapter": 1
  },
  {
   "start": 76.61,
   "end": 84.77,
   "text": "Commissaris Jessika Roswall kondigde geen directe steun aan, maar wees op komende maatregelen, onder meer rond douanecontroles.",
   "chapter": 1
  },
  {
   "start": 84.77,
   "end": 88.87,
   "text": "Voor wie gerecycled plastic inkoopt, is het aanbod dus niet vanzelfsprekend.",
   "chapter": 1
  },
  {
   "start": 91.2,
   "end": 95.68,
   "text": "A-V-R voert een aparte toeslag in voor de verwerking van bodemas.",
   "chapter": 2
  },
  {
   "start": 95.68,
   "end": 100.48,
   "text": "Dat meldde Afvalgids donderdag, op basis van informatie van A-V-R zelf.",
   "chapter": 2
  },
  {
   "start": 100.48,
   "end": 105.84,
   "text": "Bodemas is wat overblijft na het verbranden van afval in een afvalverbrandingsinstallatie.",
   "chapter": 2
  },
  {
   "start": 105.84,
   "end": 111.84,
   "text": "Sinds dertig december tweeduizend vijfentwintig gelden strengere eisen uit het Circulair Materialenplan.",
   "chapter": 2
  },
  {
   "start": 111.84,
   "end": 114.32,
   "text": "De as moet intensiever worden verwerkt.",
   "chapter": 2
  },
  {
   "start": 114.32,
   "end": 122.16,
   "text": "Er worden meer metalen uitgehaald, de as wordt uitgebreider gewassen en er zijn extra analyses en kwaliteitscontroles nodig.",
   "chapter": 2
  },
  {
   "start": 122.16,
   "end": 125.2,
   "text": "Ook het waswater en het slib moeten worden behandeld.",
   "chapter": 2
  },
  {
   "start": 125.2,
   "end": 130.96,
   "text": "A-V-R rekent de aantoonbare meerkosten apart door en verwerkt ze niet in het gewone tarief.",
   "chapter": 2
  },
  {
   "start": 130.96,
   "end": 133.68,
   "text": "Een bedrag noemt het bedrijf niet op zijn website.",
   "chapter": 2
  },
  {
   "start": 133.68,
   "end": 137.12,
   "text": "De toeslag kan wijzigen als regels of kosten veranderen.",
   "chapter": 2
  },
  {
   "start": 137.12,
   "end": 141.48,
   "text": "Strengere eisen aan hergebruik komen zo terecht in de tarieven voor afvalverwerking.",
   "chapter": 2
  },
  {
   "start": 143.82,
   "end": 149.58,
   "text": "In Modena in Italië is een nieuwe fabriek geopend voor het recyclen van harde kunststoffen.",
   "chapter": 3
  },
  {
   "start": 149.58,
   "end": 151.18,
   "text": "Dat meldt Euwid.",
   "chapter": 3
  },
  {
   "start": 151.18,
   "end": 156.38,
   "text": "De fabriek is van Aliplast, een dochter van het energie- en afvalbedrijf Hera.",
   "chapter": 3
  },
  {
   "start": 156.38,
   "end": 160.54,
   "text": "Zij kan per jaar tot dertigduizend ton afvalplastic verwerken.",
   "chapter": 3
  },
  {
   "start": 160.54,
   "end": 168.86,
   "text": "De investering bedraagt achtenveertig komma acht miljoen euro, waarvan zeven komma zeven miljoen euro uit het Italiaanse herstelfonds komt.",
   "chapter": 3
  },
  {
   "start": 168.86,
   "end": 172.7,
   "text": "De technologie komt van Nextchem, een dochter van Maire.",
   "chapter": 3
  },
  {
   "start": 172.7,
   "end": 179.58,
   "text": "Stroom en gezuiverd water levert Hera vanuit de naastgelegen afvalenergiecentrale en waterzuivering.",
   "chapter": 3
  },
  {
   "start": 179.58,
   "end": 184.3,
   "text": "Minister Gilberto Pichetto Fratin opende de fabriek afgelopen dinsdag.",
   "chapter": 3
  },
  {
   "start": 184.3,
   "end": 191.42,
   "text": "Hij noemde haar een voorbeeld van hoe Italië kan inspelen op nieuwe Europese regels, zoals de verpakkingsverordening.",
   "chapter": 3
  },
  {
   "start": 191.42,
   "end": 195.9,
   "text": "Italië zet zo tegelijk in op eigen fabrieken en op steun uit Brussel.",
   "chapter": 3
  },
  {
   "start": 198.23,
   "end": 204.31,
   "text": "Amstelveen wil stoppen met het gescheiden inzamelen van plastic, metalen verpakkingen en drinkpakken.",
   "chapter": 4
  },
  {
   "start": 204.31,
   "end": 208.11,
   "text": "Dat meldt Afvalgids, op basis van het Amstelveens Nieuwsblad.",
   "chapter": 4
  },
  {
   "start": 208.11,
   "end": 214.31,
   "text": "De gemeente is van plan om per één januari tweeduizend achtentwintig over te stappen op nascheiding.",
   "chapter": 4
  },
  {
   "start": 214.31,
   "end": 219.78,
   "text": "Inwoners hoeven die verpakkingen dan niet meer apart aan te bieden en kunnen ze bij het restafval doen.",
   "chapter": 4
  },
  {
   "start": 219.78,
   "end": 223.03,
   "text": "Een installatie haalt ze er na de inzameling uit.",
   "chapter": 4
  },
  {
   "start": 223.03,
   "end": 226.91,
   "text": "Of de gemeenteraad het plan al heeft vastgesteld, werd niet gemeld.",
   "chapter": 4
  },
  {
   "start": 226.91,
   "end": 233.89,
   "text": "Voor gemeenten is het een afweging tussen gemak voor inwoners en de kwaliteit van het materiaal dat de recycler ontvangt.",
   "chapter": 4
  },
  {
   "start": 233.89,
   "end": 238.03,
   "text": "Ook voor bedrijven in de regio is het de moeite waard om te volgen hoe dit uitpakt.",
   "chapter": 4
  },
  {
   "start": 240.37,
   "end": 243.17,
   "text": "En wat betekent dit voor uw organisatie?",
   "chapter": 5
  },
  {
   "start": 243.17,
   "end": 244.13,
   "text": "Drie dingen.",
   "chapter": 5
  },
  {
   "start": 244.13,
   "end": 247.73,
   "text": "Ten eerste: kijk in uw afvalcontract naar toeslagen.",
   "chapter": 5
  },
  {
   "start": 247.73,
   "end": 253.81,
   "text": "Strengere eisen aan hergebruik worden vaker apart doorberekend, zoals A-V-R nu doet met bodemas.",
   "chapter": 5
  },
  {
   "start": 253.81,
   "end": 258.77,
   "text": "Ten tweede: vraag leveranciers van gerecycled materiaal waar het vandaan komt.",
   "chapter": 5
  },
  {
   "start": 258.77,
   "end": 263.17,
   "text": "Als Europese recyclers onder druk staan, wordt herkomst een inkoopvraag.",
   "chapter": 5
  },
  {
   "start": 263.17,
   "end": 268.69,
   "text": "Ten derde: scheid uw eigen stromen goed, ongeacht welke keuze uw gemeente maakt.",
   "chapter": 5
  },
  {
   "start": 268.69,
   "end": 273.01,
   "text": "Schoon gescheiden materiaal houdt zijn waarde, ook als de markt krap is.",
   "chapter": 5
  },
  {
   "start": 273.01,
   "end": 277.42,
   "text": "Het is nuchter werk, maar het is het verschil tussen een kostenpost en een grondstof.",
   "chapter": 5
  },
  {
   "start": 277.87,
   "end": 280.55,
   "text": "Het cijfer van de dag is veertien.",
   "chapter": 6
  },
  {
   "start": 280.55,
   "end": 285.83,
   "text": "Zoveel recyclefabrieken in Nederland sloten volgens Euwid binnen twee jaar hun deuren.",
   "chapter": 6
  },
  {
   "start": 285.83,
   "end": 291.13,
   "text": "Nederland noemde dat getal in de Milieuraad, als bewijs dat de plasticrecycling onder druk staat.",
   "chapter": 6
  },
  {
   "start": 291.58,
   "end": 293.9,
   "text": "Dat was Grondstof voor vandaag.",
   "chapter": 7
  },
  {
   "start": 293.9,
   "end": 297.66,
   "text": "De bronnen bij elk bericht vindt u in de app en in de shownotes.",
   "chapter": 7
  },
  {
   "start": 297.66,
   "end": 299.9,
   "text": "Morgen om negen uur bent u weer bij.",
   "chapter": 7
  },
  {
   "start": 299.9,
   "end": 300.34,
   "text": "Tot dan.",
   "chapter": 7
  }
 ],
