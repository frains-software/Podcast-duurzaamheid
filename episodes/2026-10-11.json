 "transcript": [
  {
   "start": 5.5,
   "end": 6.54,
   "text": "Goedemorgen.",
   "chapter": 0
  },
  {
   "start": 6.54,
   "end": 8.62,
   "text": "Het is zondag elf oktober.",
   "chapter": 0
  },
  {
   "start": 8.62,
   "end": 13.02,
   "text": "U luistert naar Grondstof, het circulaire nieuwsbulletin van De Graaf Groep.",
   "chapter": 0
  },
  {
   "start": 13.02,
   "end": 15.02,
   "text": "Ik ben Frans van den Berge.",
   "chapter": 0
  },
  {
   "start": 15.02,
   "end": 18.22,
   "text": "Gisteren was het de landelijke Dag van de Duurzaamheid.",
   "chapter": 0
  },
  {
   "start": 18.22,
   "end": 19.66,
   "text": "Dit zijn de koppen.",
   "chapter": 0
  },
  {
   "start": 19.66,
   "end": 23.74,
   "text": "De Europese lidstaten zoeken verlichting voor kleine verpakkers.",
   "chapter": 0
  },
  {
   "start": 23.74,
   "end": 27.9,
   "text": "Duitsland en Oostenrijk testen kwaliteitsregels voor oud papier.",
   "chapter": 0
  },
  {
   "start": 27.9,
   "end": 31.08,
   "text": "En in Purmerend scheiden inwoners minder afval.",
   "chapter": 0
  },
  {
   "start": 33.42,
   "end": 38.38,
   "text": "De Europese lidstaten praten weer over de verpakkingsregels voor kleine bedrijven.",
   "chapter": 1
  },
  {
   "start": 38.38,
   "end": 40.54,
   "text": "Dat meldt het vakblad Euwid.",
   "chapter": 1
  },
  {
   "start": 40.54,
   "end": 46.06,
   "text": "De onderhandelingen over de uitgebreide producentenverantwoordelijkheid lagen voor de zomer stil.",
   "chapter": 1
  },
  {
   "start": 46.06,
   "end": 47.66,
   "text": "Nu zijn ze hervat.",
   "chapter": 1
  },
  {
   "start": 47.66,
   "end": 55.9,
   "text": "De lidstaten willen een gerichte oplossing onderzoeken voor kleine producenten van verpakkingen, voor wie de lasten onevenredig zwaar kunnen zijn.",
   "chapter": 1
  },
  {
   "start": 55.9,
   "end": 62.42,
   "text": "De Europese Commissie stelde aanpassingen voor als onderdeel van haar pakket om milieuwetgeving te vereenvoudigen.",
   "chapter": 1
  },
  {
   "start": 62.42,
   "end": 66.42,
   "text": "De Europese verpakkingsverordening geldt sinds twaalf augustus.",
   "chapter": 1
  },
  {
   "start": 66.42,
   "end": 74.82,
   "text": "Eerder deze week steunde een commissie van het Europees Parlement een tijdelijke opschorting van de plicht om een gemachtigde vertegenwoordiger aan te stellen.",
   "chapter": 1
  },
  {
   "start": 74.82,
   "end": 78.8,
   "text": "Zij wil die opschorting wel beperken tot een kleinere groep bedrijven.",
   "chapter": 1
  },
  {
   "start": 78.8,
   "end": 81.17,
   "text": "Hoe de uitkomst eruitziet, is nog niet duidelijk.",
   "chapter": 1
  },
  {
   "start": 83.5,
   "end": 88.22,
   "text": "De Duitse markt voor kunststofrecyclaat herstelt na de zomer maar mondjesmaat.",
   "chapter": 2
  },
  {
   "start": 88.22,
   "end": 89.82,
   "text": "Dat meldt Euwid.",
   "chapter": 2
  },
  {
   "start": 89.82,
   "end": 95.26,
   "text": "In september nam de activiteit licht toe, maar van een breed herstel is geen sprake.",
   "chapter": 2
  },
  {
   "start": 95.26,
   "end": 99.9,
   "text": "Sommige recyclers kregen een kleine prijsverhoging voor bepaalde soorten maalgoed.",
   "chapter": 2
  },
  {
   "start": 99.9,
   "end": 102.14,
   "text": "Andere prijzen bleven gelijk.",
   "chapter": 2
  },
  {
   "start": 102.14,
   "end": 105.26,
   "text": "De verwachtingen voor het laatste kwartaal zijn gematigd.",
   "chapter": 2
  },
  {
   "start": 105.26,
   "end": 109.5,
   "text": "De eindmarkten zijn zwak en veel verwerkers hebben hoge voorraden.",
   "chapter": 2
  },
  {
   "start": 109.5,
   "end": 113.58,
   "text": "Ook de markt voor gerecycled plastic flessenmateriaal staat onder druk.",
   "chapter": 2
  },
  {
   "start": 113.58,
   "end": 119.02,
   "text": "Het aanbod van flessen bleef ruim, terwijl de vraag naar vlokken en regranulaat afnam.",
   "chapter": 2
  },
  {
   "start": 119.02,
   "end": 122.14,
   "text": "Heldere vlokken deden het beter dan gekleurde.",
   "chapter": 2
  },
  {
   "start": 122.14,
   "end": 127.9,
   "text": "Zo'n zwakke markt maakt het voor recyclers lastiger om de kosten van inzamelen en sorteren terug te verdienen.",
   "chapter": 2
  },
  {
   "start": 130.24,
   "end": 135.76,
   "text": "Duitsland en Oostenrijk starten deze maand een proef met kwaliteitsborging voor oud papier.",
   "chapter": 3
  },
  {
   "start": 135.76,
   "end": 137.52,
   "text": "Dat meldt Euwid.",
   "chapter": 3
  },
  {
   "start": 137.52,
   "end": 142.08,
   "text": "Het doel is dat oud papier op termijn de status van einde afval krijgt.",
   "chapter": 3
  },
  {
   "start": 142.08,
   "end": 145.68,
   "text": "Dan geldt het niet meer als afval, maar als grondstof.",
   "chapter": 3
  },
  {
   "start": 145.68,
   "end": 151.84,
   "text": "De papierindustrie en de afvalsector in beide landen ontwikkelen samen een praktisch kwaliteitssysteem.",
   "chapter": 3
  },
  {
   "start": 151.84,
   "end": 158.8,
   "text": "De Europese norm zeshonderddrieënveertig, de kwaliteitsnorm voor oud papier, is daarbij de maatstaf.",
   "chapter": 3
  },
  {
   "start": 158.8,
   "end": 166.48,
   "text": "Martin Drews van de Duitse papierindustrie kondigde het initiatief eind september aan op een vakconferentie in Rüsselsheim.",
   "chapter": 3
  },
  {
   "start": 166.48,
   "end": 170.24,
   "text": "Het systeem kan later dienen als basis voor verdere regels.",
   "chapter": 3
  },
  {
   "start": 170.24,
   "end": 176.38,
   "text": "Dat is belangrijk, want de status van einde afval bepaalt of een materiaal onder de strenge afvalregels valt.",
   "chapter": 3
  },
  {
   "start": 178.71,
   "end": 181.99,
   "text": "In Purmerend scheiden inwoners iets minder afval.",
   "chapter": 4
  },
  {
   "start": 181.99,
   "end": 188.15,
   "text": "Dat blijkt uit de Afvalmonitor over tweeduizend vijfentwintig, meldt Groot Waterland namens de gemeente.",
   "chapter": 4
  },
  {
   "start": 188.15,
   "end": 193.03,
   "text": "Het scheidingspercentage daalde van zesenvijftig naar vijfenvijftig procent.",
   "chapter": 4
  },
  {
   "start": 193.03,
   "end": 198.23,
   "text": "Het percentage hergebruik zakte van negenenveertig naar zesenveertig procent.",
   "chapter": 4
  },
  {
   "start": 198.23,
   "end": 204.23,
   "text": "Het restafval per inwoner steeg van honderdvierennegentig naar tweehonderdnegen kilo per jaar.",
   "chapter": 4
  },
  {
   "start": 204.23,
   "end": 210.47,
   "text": "Uit de analyse van het restafval blijkt dat slechts tweeënveertig kilo per inwoner echt restafval is.",
   "chapter": 4
  },
  {
   "start": 210.47,
   "end": 215.91,
   "text": "De rest is grotendeels recyclebaar, vooral groente-, fruit- en tuinafval.",
   "chapter": 4
  },
  {
   "start": 215.91,
   "end": 220.63,
   "text": "De gemeente start een campagne en test een mobiele milieustraat op weekmarkten.",
   "chapter": 4
  },
  {
   "start": 220.63,
   "end": 226.99,
   "text": "De uitkomsten gaan naar het nieuwe grondstoffenplan voor tweeduizend zevenentwintig tot en met tweeduizend eenendertig.",
   "chapter": 4
  },
  {
   "start": 226.99,
   "end": 230.47,
   "text": "Wethouder Mark Intres zegt dat het in Purmerend veel beter kan.",
   "chapter": 4
  },
  {
   "start": 232.81,
   "end": 235.53,
   "text": "En wat betekent dit voor uw organisatie?",
   "chapter": 5
  },
  {
   "start": 235.53,
   "end": 236.57,
   "text": "Drie dingen.",
   "chapter": 5
  },
  {
   "start": 236.57,
   "end": 239.29,
   "text": "Eén: volg de verpakkingsregels.",
   "chapter": 5
  },
  {
   "start": 239.29,
   "end": 246.73,
   "text": "Verkoopt u verpakte producten in andere Europese landen, dan kan de plicht om een gemachtigde vertegenwoordiger aan te stellen u raken.",
   "chapter": 5
  },
  {
   "start": 246.73,
   "end": 249.77,
   "text": "Twee: de markt voor recyclaat is zwak.",
   "chapter": 5
  },
  {
   "start": 249.77,
   "end": 257.61,
   "text": "Wie gerecycled materiaal inkoopt, heeft nu een goede onderhandelingspositie, maar leg kwaliteitseisen dan wel vast in het contract.",
   "chapter": 5
  },
  {
   "start": 257.61,
   "end": 261.85,
   "text": "Drie: Purmerend laat zien dat scheiden geen vanzelfsprekendheid is.",
   "chapter": 5
  },
  {
   "start": 261.85,
   "end": 263.77,
   "text": "Dat geldt ook op de werkvloer.",
   "chapter": 5
  },
  {
   "start": 263.77,
   "end": 267.85,
   "text": "Een schone, gescheiden stroom is meer waard dan gemengd afval.",
   "chapter": 5
  },
  {
   "start": 267.85,
   "end": 270.33,
   "text": "Duidelijke instructies bij de bakken helpen daarbij.",
   "chapter": 5
  },
  {
   "start": 270.78,
   "end": 274.06,
   "text": "Het cijfer van de dag is vijf miljard.",
   "chapter": 6
  },
  {
   "start": 274.06,
   "end": 281.66,
   "text": "Zoveel flessen en blikjes met statiegeld zijn volgens Euwid in het eerste jaar van het Poolse statiegeldsysteem teruggebracht.",
   "chapter": 6
  },
  {
   "start": 281.66,
   "end": 285.74,
   "text": "Dat systeem startte op één oktober tweeduizend vijfentwintig.",
   "chapter": 6
  },
  {
   "start": 285.74,
   "end": 293.25,
   "text": "In Nederland wil het kabinet statiegeld per één januari tweeduizend achtentwintig uitbreiden naar alle plastic flessen tot en met drie liter.",
   "chapter": 6
  },
  {
   "start": 293.7,
   "end": 296.1,
   "text": "Dat was Grondstof voor vandaag.",
   "chapter": 7
  },
  {
   "start": 296.1,
   "end": 299.86,
   "text": "De bronnen bij elk bericht vindt u in de app en in de shownotes.",
   "chapter": 7
  },
  {
   "start": 299.86,
   "end": 305.94,
   "text": "Grondstof wordt gemaakt door De Graaf Groep, Wastenet, Circular and Co en Product for Product.",
   "chapter": 7
  },
  {
   "start": 305.94,
   "end": 308.18,
   "text": "Morgen om negen uur bent u weer bij.",
   "chapter": 7
  },
  {
   "start": 308.18,
   "end": 308.59,
   "text": "Tot dan.",
   "chapter": 7
  }
 ],
