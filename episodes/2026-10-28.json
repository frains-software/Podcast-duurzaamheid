 "transcript": [
  {
   "start": 5.5,
   "end": 6.54,
   "text": "Goedemorgen.",
   "chapter": 0
  },
  {
   "start": 6.54,
   "end": 8.94,
   "text": "Het is woensdag achtentwintig oktober.",
   "chapter": 0
  },
  {
   "start": 8.94,
   "end": 13.34,
   "text": "U luistert naar Grondstof, het circulaire nieuwsbulletin van De Graaf Groep.",
   "chapter": 0
  },
  {
   "start": 13.34,
   "end": 14.86,
   "text": "Ik ben Frans van den Berge.",
   "chapter": 0
  },
  {
   "start": 14.86,
   "end": 16.14,
   "text": "Dit zijn de koppen.",
   "chapter": 0
  },
  {
   "start": 16.14,
   "end": 21.98,
   "text": "De regeling voor matrassenrecycling geldt vanaf volgende week ook voor hotels en zorginstellingen.",
   "chapter": 0
  },
  {
   "start": 21.98,
   "end": 26.7,
   "text": "De Europese Commissie vraagt reacties op biobased plastic in verpakkingen.",
   "chapter": 0
  },
  {
   "start": 26.7,
   "end": 30.36,
   "text": "En een gerechtshof vernietigt een afvalcontract van drie gemeenten.",
   "chapter": 0
  },
  {
   "start": 32.7,
   "end": 36.14,
   "text": "De vernieuwde matrassenregeling gaat op één november in.",
   "chapter": 1
  },
  {
   "start": 36.14,
   "end": 38.62,
   "text": "Dat meldt Wonen driehonderdzestig.",
   "chapter": 1
  },
  {
   "start": 38.62,
   "end": 45.18,
   "text": "Ook zakelijke matrassen vallen er dan onder, zoals die van hotels, vakantieparken en zorginstellingen.",
   "chapter": 1
  },
  {
   "start": 45.18,
   "end": 50.78,
   "text": "De minister van Klimaat en Groene Groei heeft de regeling voor vijf jaar algemeen verbindend verklaard.",
   "chapter": 1
  },
  {
   "start": 50.78,
   "end": 54.7,
   "text": "Ze loopt tot eenendertig oktober tweeduizend eenendertig.",
   "chapter": 1
  },
  {
   "start": 54.7,
   "end": 56.62,
   "text": "De doelen worden strenger.",
   "chapter": 1
  },
  {
   "start": 56.62,
   "end": 65.66,
   "text": "In tweeduizend achtentwintig moet minstens vijfenzeventig procent van de afgedankte matrassen worden ingezameld, in tweeduizend dertig tachtig procent.",
   "chapter": 1
  },
  {
   "start": 65.66,
   "end": 71.38,
   "text": "Het aantal inzamelpunten groeit van driehonderdzesentachtig naar minstens zevenhonderd.",
   "chapter": 1
  },
  {
   "start": 71.38,
   "end": 77.48,
   "text": "Producenten en importeurs die tot tweehonderd matrassen per jaar leveren, vallen niet langer buiten de bijdrageplicht.",
   "chapter": 1
  },
  {
   "start": 79.81,
   "end": 86.34,
   "text": "De Europese Commissie heeft een openbare consultatie geopend over biobased plastic in verpakkingen.",
   "chapter": 2
  },
  {
   "start": 86.34,
   "end": 89.22,
   "text": "Dat meldt vakblad Packaging Insights.",
   "chapter": 2
  },
  {
   "start": 89.22,
   "end": 94.42,
   "text": "Het gaat om plastic dat gemaakt is van plantaardige grondstoffen in plaats van aardolie.",
   "chapter": 2
  },
  {
   "start": 94.42,
   "end": 99.06,
   "text": "De consultatie hoort bij een evaluatie van de Europese verpakkingsverordening.",
   "chapter": 2
  },
  {
   "start": 99.06,
   "end": 105.22,
   "text": "De Commissie wil weten of maatregelen nodig zijn om de vraag naar biobased grondstof te vergroten.",
   "chapter": 2
  },
  {
   "start": 105.22,
   "end": 109.62,
   "text": "Dat kan met doelen, gekoppeld aan duurzaamheidseisen voor die grondstof.",
   "chapter": 2
  },
  {
   "start": 109.62,
   "end": 113.46,
   "text": "Op basis van de reacties kan de Commissie een wetsvoorstel doen.",
   "chapter": 2
  },
  {
   "start": 113.46,
   "end": 121.7,
   "text": "Verpakkers, producenten, recyclers en grondstofleveranciers kunnen tot dertien januari tweeduizend zevenentwintig reageren.",
   "chapter": 2
  },
  {
   "start": 121.7,
   "end": 126.66,
   "text": "De Commissie vraagt om onderbouwde cijfers over prestaties en milieueffecten.",
   "chapter": 2
  },
  {
   "start": 126.66,
   "end": 131.72,
   "text": "Het artikel noemt hogere kosten en een tekort aan recyclingcapaciteit als obstakels.",
   "chapter": 2
  },
  {
   "start": 134.06,
   "end": 140.06,
   "text": "Het gerechtshof in Den Haag heeft een overeenkomst over de verwerking van huishoudelijk restafval vernietigd.",
   "chapter": 3
  },
  {
   "start": 140.06,
   "end": 143.66,
   "text": "Dat meldt Afvalgids, op basis van het Ridderkerks Dagblad.",
   "chapter": 3
  },
  {
   "start": 143.66,
   "end": 150.7,
   "text": "Volgens het advocatenkantoor C M S oordeelde het hof dat de uitzondering voor inbesteding niet van toepassing was.",
   "chapter": 3
  },
  {
   "start": 150.7,
   "end": 156.06,
   "text": "De opdracht was niet aanbesteed, maar via Irado ondergebracht bij Afvalsturing Friesland.",
   "chapter": 3
  },
  {
   "start": 156.06,
   "end": 159.74,
   "text": "De procedure was gestart door afvalverwerker A V R.",
   "chapter": 3
  },
  {
   "start": 159.74,
   "end": 165.34,
   "text": "Als gevolg van de uitspraak wil B A R Afvalbeheer zijn aandelen in Irado verkopen.",
   "chapter": 3
  },
  {
   "start": 165.34,
   "end": 169.5,
   "text": "Voor inwoners van Barendrecht verandert er voorlopig niets aan de inzameling.",
   "chapter": 3
  },
  {
   "start": 169.5,
   "end": 172.94,
   "text": "Let op: dit is een uitspraak over aanbestedingsrecht.",
   "chapter": 3
  },
  {
   "start": 172.94,
   "end": 179.59,
   "text": "Gemeenten die afval onderling uitbesteden, kijken nu scherper naar de vraag of zij mogen inbesteden of moeten aanbesteden.",
   "chapter": 3
  },
  {
   "start": 181.92,
   "end": 189.68,
   "text": "In het Engelse Worksop beslist een gemeentelijke commissie op drie november over een fabriek voor chemische recycling van plastic.",
   "chapter": 4
  },
  {
   "start": 189.68,
   "end": 191.68,
   "text": "Dat meldt Polyester Time.",
   "chapter": 4
  },
  {
   "start": 191.68,
   "end": 196.72,
   "text": "Ambtenaren van het graafschap Nottinghamshire adviseren de commissie de vergunning te verlenen.",
   "chapter": 4
  },
  {
   "start": 196.72,
   "end": 202.88,
   "text": "Het bedrijf Envale wil jaarlijks maximaal twintigduizend ton niet-recyclebaar plastic verwerken.",
   "chapter": 4
  },
  {
   "start": 202.88,
   "end": 206.48,
   "text": "Dat gebeurt met pyrolyse bij ongeveer vijfhonderd graden.",
   "chapter": 4
  },
  {
   "start": 206.48,
   "end": 211.36,
   "text": "Het levert naar schatting veertienduizend ton vloeistoffen en gassen op voor de petrochemie.",
   "chapter": 4
  },
  {
   "start": 211.36,
   "end": 215.84,
   "text": "Daarnaast komt er een installatie die restafval omzet in elektriciteit.",
   "chapter": 4
  },
  {
   "start": 215.84,
   "end": 223.6,
   "text": "Tegenstanders, onder wie natuurorganisaties en een bestuur uit de buurt, wijzen op de ligging op ongeveer zes meter van tuinen.",
   "chapter": 4
  },
  {
   "start": 223.6,
   "end": 226.8,
   "text": "Een petitie telt meer dan twaalfhonderd handtekeningen.",
   "chapter": 4
  },
  {
   "start": 226.8,
   "end": 232.15,
   "text": "Chemische recycling blijft dus omstreden, ook waar ze op papier past in de afvalhiërarchie.",
   "chapter": 4
  },
  {
   "start": 234.49,
   "end": 237.21,
   "text": "En wat betekent dit voor uw organisatie?",
   "chapter": 5
  },
  {
   "start": 237.21,
   "end": 243.69,
   "text": "Heeft u een hotel, zorginstelling of kantoor met slaapruimtes, dan komt de matrassenregeling dichterbij.",
   "chapter": 5
  },
  {
   "start": 243.69,
   "end": 249.21,
   "text": "Vraag uw leverancier of die is aangesloten bij de regeling en wat de bijdrage per matras wordt.",
   "chapter": 5
  },
  {
   "start": 249.21,
   "end": 252.73,
   "text": "Zorg ook dat afgedankte matrassen apart worden aangeboden.",
   "chapter": 5
  },
  {
   "start": 252.73,
   "end": 256.41,
   "text": "Zo komen ze terecht bij recycling en niet bij restafval.",
   "chapter": 5
  },
  {
   "start": 256.41,
   "end": 262.09,
   "text": "De uitspraak over Irado laat zien dat ook publieke afvalcontracten juridisch onder druk kunnen staan.",
   "chapter": 5
  },
  {
   "start": 262.09,
   "end": 269.37,
   "text": "Voor bedrijven geldt iets vergelijkbaars: leg afspraken met afvalinzamelaars goed vast en weet wanneer ze aflopen.",
   "chapter": 5
  },
  {
   "start": 269.37,
   "end": 276.33,
   "text": "En de Europese consultatie over biobased plastic is een kans om als gebruiker van verpakkingen uw ervaring in te brengen.",
   "chapter": 5
  },
  {
   "start": 276.33,
   "end": 278.99,
   "text": "Dat kan rechtstreeks, of via uw branchevereniging.",
   "chapter": 5
  },
  {
   "start": 279.44,
   "end": 282.48,
   "text": "Het cijfer van de dag is zevenhonderd.",
   "chapter": 6
  },
  {
   "start": 282.48,
   "end": 286.64,
   "text": "Zoveel inzamelpunten voor oude matrassen moeten er minstens komen.",
   "chapter": 6
  },
  {
   "start": 286.64,
   "end": 291.12,
   "text": "Nu zijn het er nog driehonderdzesentachtig, schrijft Wonen driehonderdzestig.",
   "chapter": 6
  },
  {
   "start": 291.12,
   "end": 293.36,
   "text": "Het aantal bijna verdubbelt dus.",
   "chapter": 6
  },
  {
   "start": 293.36,
   "end": 297.18,
   "text": "Wie een matras wegbrengt, hoeft daardoor in de toekomst minder ver te reizen.",
   "chapter": 6
  },
  {
   "start": 297.63,
   "end": 300.03,
   "text": "Dat was Grondstof voor vandaag.",
   "chapter": 7
  },
  {
   "start": 300.03,
   "end": 303.79,
   "text": "De bronnen bij elk bericht vindt u in de app en in de shownotes.",
   "chapter": 7
  },
  {
   "start": 303.79,
   "end": 306.03,
   "text": "Morgen om negen uur bent u weer bij.",
   "chapter": 7
  },
  {
   "start": 306.03,
   "end": 306.47,
   "text": "Tot dan.",
   "chapter": 7
  }
 ],
