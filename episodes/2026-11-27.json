 "transcript": [
  {
   "start": 5.5,
   "end": 6.54,
   "text": "Goedemorgen.",
   "chapter": 0
  },
  {
   "start": 6.54,
   "end": 9.14,
   "text": "Het is vrijdag zevenentwintig november.",
   "chapter": 0
  },
  {
   "start": 9.14,
   "end": 13.66,
   "text": "U luistert naar Grondstof, het circulaire nieuwsbulletin van De Graaf Groep.",
   "chapter": 0
  },
  {
   "start": 13.66,
   "end": 15.26,
   "text": "Ik ben Frans van den Berge.",
   "chapter": 0
  },
  {
   "start": 15.26,
   "end": 16.78,
   "text": "Dit zijn de koppen.",
   "chapter": 0
  },
  {
   "start": 16.78,
   "end": 23.62,
   "text": "Europa komt bijna twee miljoen ton gerecycled plastic tekort voor de verpakkingsdoelen van tweeduizend dertig.",
   "chapter": 0
  },
  {
   "start": 23.62,
   "end": 28.7,
   "text": "Grote producenten maken toiletpapier en handdoekjes per één januari duurder.",
   "chapter": 0
  },
  {
   "start": 28.7,
   "end": 35.2,
   "text": "En Amstelveen stopt in tweeduizend achtentwintig met de aparte inzameling van plastic, blik en drinkpakken.",
   "chapter": 0
  },
  {
   "start": 37.54,
   "end": 43.46,
   "text": "Europa dreigt te weinig gerecycled plastic te hebben voor de eisen uit de Europese verpakkingsverordening.",
   "chapter": 1
  },
  {
   "start": 43.46,
   "end": 47.78,
   "text": "Dat stelt marktanalist Icis in een analyse die gisteren verscheen.",
   "chapter": 1
  },
  {
   "start": 47.78,
   "end": 53.78,
   "text": "De verordening verplicht vanaf tweeduizend dertig een aandeel gerecycled materiaal in plastic verpakkingen.",
   "chapter": 1
  },
  {
   "start": 53.78,
   "end": 62.02,
   "text": "Voor verpakkingen die in de Europese Unie worden gemaakt, is volgens Icis ongeveer drie komma vier miljoen ton gerecyclede polyolefinen nodig.",
   "chapter": 1
  },
  {
   "start": 62.02,
   "end": 65.78,
   "text": "Dat zijn de kunststoffen polyetheen en polypropeen.",
   "chapter": 1
  },
  {
   "start": 65.78,
   "end": 73.46,
   "text": "Zonder een forse versnelling van investeringen blijft het Europese aanbod van geschikte kwaliteit daar bijna twee miljoen ton onder.",
   "chapter": 1
  },
  {
   "start": 73.46,
   "end": 76.02,
   "text": "De schaarste is al zichtbaar in de prijs.",
   "chapter": 1
  },
  {
   "start": 76.02,
   "end": 84.1,
   "text": "Gerecyclede korrels voor flessen en flacons kostten de afgelopen jaren vierhonderd tot elfhonderd euro per ton meer dan nieuw plastic.",
   "chapter": 1
  },
  {
   "start": 84.1,
   "end": 88.03,
   "text": "Voor inkopers van verpakkingen wordt beschikbaarheid daarmee een risico.",
   "chapter": 1
  },
  {
   "start": 90.37,
   "end": 95.49,
   "text": "Toiletpapier, keukenrollen en papieren handdoekjes worden in het nieuwe jaar duurder.",
   "chapter": 2
  },
  {
   "start": 95.49,
   "end": 97.33,
   "text": "Dat meldt vakblad Euwid.",
   "chapter": 2
  },
  {
   "start": 97.33,
   "end": 106.29,
   "text": "Het Italiaanse Sofidel, de op één na grootste tissueproducent van Europa, verhoogt per één januari de prijzen in al zijn Europese markten.",
   "chapter": 2
  },
  {
   "start": 106.29,
   "end": 111.81,
   "text": "Het gaat om verhogingen van tien procent of meer, afhankelijk van markt, product en contract.",
   "chapter": 2
  },
  {
   "start": 111.81,
   "end": 117.25,
   "text": "Het Portugese Navigator rekent vanaf dezelfde datum acht tot twaalf procent meer.",
   "chapter": 2
  },
  {
   "start": 117.25,
   "end": 122.69,
   "text": "Beide bedrijven wijzen op aanhoudend hoge kosten voor energie, grondstoffen en transport.",
   "chapter": 2
  },
  {
   "start": 122.69,
   "end": 126.05,
   "text": "Sofidel zegt die kosten niet langer zelf te kunnen opvangen.",
   "chapter": 2
  },
  {
   "start": 126.05,
   "end": 128.05,
   "text": "Ook kantoorpapier beweegt mee.",
   "chapter": 2
  },
  {
   "start": 128.05,
   "end": 133.73,
   "text": "De Italiaanse Burgo Group vraagt vanaf vier januari tot tien procent meer voor grafisch papier.",
   "chapter": 2
  },
  {
   "start": 133.73,
   "end": 138.24,
   "text": "Wie hygiënepapier of drukwerk inkoopt, krijgt dus te maken met hogere offertes.",
   "chapter": 2
  },
  {
   "start": 140.57,
   "end": 147.93,
   "text": "Slibverwerking Noord-Brabant in Moerdijk wil een fabriek bouwen die stikstof terugwint en er kunstmest van maakt.",
   "chapter": 3
  },
  {
   "start": 147.93,
   "end": 154.65,
   "text": "Het bedrijf heeft daarvoor een overeenkomst gesloten met technologiebedrijf Colsen, meldt vakblad Europoort Kringen.",
   "chapter": 3
  },
  {
   "start": 154.65,
   "end": 158.41,
   "text": "De installatie moet eind tweeduizend negenentwintig draaien.",
   "chapter": 3
  },
  {
   "start": 158.41,
   "end": 161.53,
   "text": "Het bedrijf verwerkt zuiveringsslib van waterschappen.",
   "chapter": 3
  },
  {
   "start": 161.53,
   "end": 164.81,
   "text": "Die maken steeds vaker eerst biogas uit het slib.",
   "chapter": 3
  },
  {
   "start": 164.81,
   "end": 172.41,
   "text": "Daardoor bevat het afvalwater dat bij het drogen vrijkomt meer stikstof, en raakt de huidige waterzuivering overbelast.",
   "chapter": 3
  },
  {
   "start": 172.41,
   "end": 177.69,
   "text": "In de nieuwe opzet wordt de ammoniak uit dat water gehaald en gebonden met fosforzuur.",
   "chapter": 3
  },
  {
   "start": 177.69,
   "end": 183.05,
   "text": "Zo ontstaat een meststof met stikstof en fosfaat, die tot korrels wordt verwerkt.",
   "chapter": 3
  },
  {
   "start": 183.05,
   "end": 188.53,
   "text": "Colsen verwacht per jaar ongeveer vijfhonderdzestig ton stikstof terug te brengen in de meststoffenketen.",
   "chapter": 3
  },
  {
   "start": 190.87,
   "end": 197.39,
   "text": "De gemeenteraad van Amstelveen heeft woensdag ingestemd met het Grondstoffenplan tot en met tweeduizend dertig.",
   "chapter": 4
  },
  {
   "start": 197.39,
   "end": 206.31,
   "text": "Daarin staat dat de gemeente vanaf januari tweeduizend achtentwintig plastic, blik en drinkpakken achteraf uit het restafval laat sorteren.",
   "chapter": 4
  },
  {
   "start": 206.31,
   "end": 209.07,
   "text": "Dat blijkt uit de besluitenlijst van de gemeente.",
   "chapter": 4
  },
  {
   "start": 209.07,
   "end": 213.24,
   "text": "De raad vraagt het college om een voorlichtingscampagne over de overstap.",
   "chapter": 4
  },
  {
   "start": 213.24,
   "end": 219.51,
   "text": "Tegelijk plaatst de brancheorganisatie voor gemeentelijk afvalbeheer een kanttekening bij de landelijke cijfers.",
   "chapter": 4
  },
  {
   "start": 219.51,
   "end": 225.11,
   "text": "Het CBS meldde vorige week dat bijna zestig procent van de gemeenten aan nascheiding doet.",
   "chapter": 4
  },
  {
   "start": 225.11,
   "end": 230.91,
   "text": "Volgens de brancheorganisatie telt het CBS daarbij ook grof afval en verbouwingsafval mee.",
   "chapter": 4
  },
  {
   "start": 230.91,
   "end": 239.57,
   "text": "In tweeëntachtig procent van de gemeenten scheiden inwoners plastic, blik en drinkpakken nog geheel of gedeeltelijk zelf, blijkt uit cijfers van Verpact.",
   "chapter": 4
  },
  {
   "start": 241.91,
   "end": 244.79,
   "text": "En wat betekent dit voor uw organisatie?",
   "chapter": 5
  },
  {
   "start": 244.79,
   "end": 247.43,
   "text": "De rode draad vandaag is inkoop.",
   "chapter": 5
  },
  {
   "start": 247.43,
   "end": 251.51,
   "text": "Gerecycled plastic wordt schaars en hygiënepapier wordt duurder.",
   "chapter": 5
  },
  {
   "start": 251.51,
   "end": 259.83,
   "text": "Wie contracten voor verpakkingen of papier in januari verlengt, doet er goed aan nu al met leveranciers te praten over prijs en leverzekerheid.",
   "chapter": 5
  },
  {
   "start": 259.83,
   "end": 261.83,
   "text": "Kijk ook naar het verbruik zelf.",
   "chapter": 5
  },
  {
   "start": 261.83,
   "end": 268.31,
   "text": "Minder papieren handdoekjes en minder verpakkingen leveren direct iets op, in de inkoop en in de afvalbak.",
   "chapter": 5
  },
  {
   "start": 268.31,
   "end": 272.47,
   "text": "Bij De Graaf Groep zien we dat die twee kanten steeds vaker samen worden bekeken.",
   "chapter": 5
  },
  {
   "start": 272.47,
   "end": 274.31,
   "text": "En let op bij nascheiding.",
   "chapter": 5
  },
  {
   "start": 274.31,
   "end": 276.47,
   "text": "Die regels gelden voor huishoudens.",
   "chapter": 5
  },
  {
   "start": 276.47,
   "end": 279.3,
   "text": "Voor bedrijven blijft gescheiden aanbieden gewoon de norm.",
   "chapter": 5
  },
  {
   "start": 279.75,
   "end": 283.55,
   "text": "Het cijfer van de dag is drie komma vier miljoen ton.",
   "chapter": 6
  },
  {
   "start": 283.55,
   "end": 291.07,
   "text": "Zoveel gerecycled polyetheen en polypropeen heeft Europa volgens Icis in tweeduizend dertig nodig voor verpakkingen.",
   "chapter": 6
  },
  {
   "start": 291.07,
   "end": 293.98,
   "text": "Het aanbod blijft daar bijna twee miljoen ton onder.",
   "chapter": 6
  },
  {
   "start": 294.43,
   "end": 296.75,
   "text": "Dat was Grondstof voor vandaag.",
   "chapter": 7
  },
  {
   "start": 296.75,
   "end": 300.51,
   "text": "De bronnen bij elk bericht vindt u in de app en in de shownotes.",
   "chapter": 7
  },
  {
   "start": 300.51,
   "end": 302.91,
   "text": "Morgen om negen uur bent u weer bij.",
   "chapter": 7
  },
  {
   "start": 302.91,
   "end": 303.35,
   "text": "Tot dan.",
   "chapter": 7
  }
 ],
