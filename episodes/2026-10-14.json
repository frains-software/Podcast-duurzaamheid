 "transcript": [
  {
   "start": 5.5,
   "end": 6.54,
   "text": "Goedemorgen.",
   "chapter": 0
  },
  {
   "start": 6.54,
   "end": 8.74,
   "text": "Het is woensdag veertien oktober.",
   "chapter": 0
  },
  {
   "start": 8.74,
   "end": 13.5,
   "text": "U luistert naar Grondstof, het circulaire nieuwsbulletin van De Graaf Groep.",
   "chapter": 0
  },
  {
   "start": 13.5,
   "end": 15.18,
   "text": "Ik ben Frans van den Berge.",
   "chapter": 0
  },
  {
   "start": 15.18,
   "end": 16.62,
   "text": "Dit zijn de koppen.",
   "chapter": 0
  },
  {
   "start": 16.62,
   "end": 21.5,
   "text": "Brussel wil de verpakkingsregel voor webshops nog voor Black Friday versoepelen.",
   "chapter": 0
  },
  {
   "start": 21.5,
   "end": 25.82,
   "text": "Griekenland en Cyprus gaan naar het Europese Hof vanwege afvalbeheer.",
   "chapter": 0
  },
  {
   "start": 25.82,
   "end": 29.85,
   "text": "En in Rotterdam wil VPR Energy een pyrolysefabriek bouwen.",
   "chapter": 0
  },
  {
   "start": 32.19,
   "end": 38.67,
   "text": "Milieucommissaris Jessika Roswall wil de Europese verpakkingsverordening nog voor Black Friday versoepelen.",
   "chapter": 1
  },
  {
   "start": 38.67,
   "end": 40.59,
   "text": "Dat meldt Logimerce.",
   "chapter": 1
  },
  {
   "start": 40.59,
   "end": 45.79,
   "text": "Het gaat om de plicht voor webshops om in andere lidstaten een vertegenwoordiger aan te wijzen.",
   "chapter": 1
  },
  {
   "start": 45.79,
   "end": 48.59,
   "text": "Die plicht geldt sinds twaalf augustus.",
   "chapter": 1
  },
  {
   "start": 48.59,
   "end": 52.99,
   "text": "Roswall riep de lidstaten maandag op om snel een oplossing te vinden.",
   "chapter": 1
  },
  {
   "start": 52.99,
   "end": 57.95,
   "text": "De milieucommissie van het Europees Parlement stemde op vijf oktober voor versoepeling.",
   "chapter": 1
  },
  {
   "start": 57.95,
   "end": 61.79,
   "text": "De plenaire stemming staat gepland voor negentien oktober.",
   "chapter": 1
  },
  {
   "start": 61.79,
   "end": 67.95,
   "text": "Oostenrijk vraagt, gesteund door Tsjechië en Estland, om lichtere regels voor kleine producenten.",
   "chapter": 1
  },
  {
   "start": 67.95,
   "end": 73.55,
   "text": "Thuiswinkel punt org vreest dat kleine webwinkels stoppen met grensoverschrijdend verkopen.",
   "chapter": 1
  },
  {
   "start": 73.55,
   "end": 77.95,
   "text": "Een vrijstelling betekent overigens niet dat de overige verplichtingen vervallen.",
   "chapter": 1
  },
  {
   "start": 77.95,
   "end": 80.91,
   "text": "Registratie en rapportage blijven gewoon bestaan.",
   "chapter": 1
  },
  {
   "start": 83.24,
   "end": 87.72,
   "text": "De Europese Commissie brengt Griekenland en Cyprus voor het Hof van Justitie.",
   "chapter": 2
  },
  {
   "start": 87.72,
   "end": 89.88,
   "text": "Dat meldt het vakblad Euwid.",
   "chapter": 2
  },
  {
   "start": 89.88,
   "end": 96.36,
   "text": "Volgens de Commissie voldoen beide landen niet aan de eisen voor de behandeling van afval voordat het wordt gestort.",
   "chapter": 2
  },
  {
   "start": 96.36,
   "end": 99.64,
   "text": "Zij hebben geen toereikende voorzieningen opgezet.",
   "chapter": 2
  },
  {
   "start": 99.64,
   "end": 105.88,
   "text": "De Commissie wijst op schending van de Europese stortplaatsenrichtlijn en de kaderrichtlijn afvalstoffen.",
   "chapter": 2
  },
  {
   "start": 105.88,
   "end": 109.8,
   "text": "De inbreukprocedures lopen al sinds tweeduizend eenentwintig.",
   "chapter": 2
  },
  {
   "start": 109.8,
   "end": 114.2,
   "text": "Na ruim vijf jaar is de situatie dus nog niet voldoende verbeterd.",
   "chapter": 2
  },
  {
   "start": 114.2,
   "end": 120.76,
   "text": "Het bericht laat zien dat Brussel de afvalregels blijft handhaven, ook wanneer een procedure jaren duurt.",
   "chapter": 2
  },
  {
   "start": 120.76,
   "end": 123.32,
   "text": "Voor Nederlandse bedrijven verandert er niets.",
   "chapter": 2
  },
  {
   "start": 123.32,
   "end": 126.98,
   "text": "Het is wel een signaal over de hardheid van de Europese afvalregels.",
   "chapter": 2
  },
  {
   "start": 129.32,
   "end": 133.24,
   "text": "De Duitse sector voor afgedankt textiel zit in zwaar weer.",
   "chapter": 3
  },
  {
   "start": 133.24,
   "end": 134.84,
   "text": "Dat meldt Euwid.",
   "chapter": 3
  },
  {
   "start": 134.84,
   "end": 139.08,
   "text": "Volgens het blad hebben twee sorteerbedrijven faillissement aangevraagd.",
   "chapter": 3
  },
  {
   "start": 139.08,
   "end": 142.76,
   "text": "Daardoor dreigt de sorteercapaciteit verder te krimpen.",
   "chapter": 3
  },
  {
   "start": 142.76,
   "end": 147.64,
   "text": "Een sorteerbedrijf waarschuwt dat het niet houdbaar is om op reserves te blijven leunen.",
   "chapter": 3
  },
  {
   "start": 147.64,
   "end": 151.24,
   "text": "De magazijnen zitten vol met ingezameld materiaal.",
   "chapter": 3
  },
  {
   "start": 151.24,
   "end": 159.64,
   "text": "Als oorzaken noemt het blad illegale dumping bij containers, veel textiel van slechte kwaliteit en een tekort aan personeel.",
   "chapter": 3
  },
  {
   "start": 159.64,
   "end": 165.08,
   "text": "De sector wacht op het ontwerp van de Duitse textielwet, dat binnen enkele weken wordt verwacht.",
   "chapter": 3
  },
  {
   "start": 165.08,
   "end": 170.76,
   "text": "Brancheorganisaties willen dat gemeenten niet wachten en nu al de inzameling veiligstellen.",
   "chapter": 3
  },
  {
   "start": 170.76,
   "end": 173.95,
   "text": "Ook in Nederland is textiel een van de lastige afvalstromen.",
   "chapter": 3
  },
  {
   "start": 176.28,
   "end": 182.12,
   "text": "VPR Energy vraagt een omgevingsvergunning aan voor een pyrolysefabriek in Rotterdam.",
   "chapter": 4
  },
  {
   "start": 182.12,
   "end": 185.8,
   "text": "Dat meldt Afvalgids, op basis van Industrielinqs.",
   "chapter": 4
  },
  {
   "start": 185.8,
   "end": 188.68,
   "text": "De fabriek komt op het terrein van een raffinaderij.",
   "chapter": 4
  },
  {
   "start": 188.68,
   "end": 191.56,
   "text": "De naam van die raffinaderij wordt niet genoemd.",
   "chapter": 4
  },
  {
   "start": 191.56,
   "end": 197.16,
   "text": "Zij moet per jaar maximaal tachtig kiloton plastic afval omzetten in pyrolyse-olie.",
   "chapter": 4
  },
  {
   "start": 197.16,
   "end": 199.48,
   "text": "Dat is tachtigduizend ton.",
   "chapter": 4
  },
  {
   "start": 199.48,
   "end": 204.6,
   "text": "Volgens het bedrijf kan de fabriek volgend jaar in bedrijf komen, als de planning wordt gehaald.",
   "chapter": 4
  },
  {
   "start": 204.6,
   "end": 207.32,
   "text": "Over de investering is niets bekend.",
   "chapter": 4
  },
  {
   "start": 207.32,
   "end": 210.44,
   "text": "Pyrolyse is een vorm van chemische recycling.",
   "chapter": 4
  },
  {
   "start": 210.44,
   "end": 213.48,
   "text": "Plastic wordt daarbij verhit zonder zuurstof.",
   "chapter": 4
  },
  {
   "start": 213.48,
   "end": 216.36,
   "text": "Er ontstaat een olie die als grondstof kan dienen.",
   "chapter": 4
  },
  {
   "start": 216.36,
   "end": 218.11,
   "text": "De vergunning moet nog worden verleend.",
   "chapter": 4
  },
  {
   "start": 220.45,
   "end": 223.41,
   "text": "En wat betekent dit voor uw organisatie?",
   "chapter": 5
  },
  {
   "start": 223.41,
   "end": 224.37,
   "text": "Drie dingen.",
   "chapter": 5
  },
  {
   "start": 224.37,
   "end": 229.57,
   "text": "Ten eerste: regels voor verpakkingen worden nog bijgesteld, terwijl ze al gelden.",
   "chapter": 5
  },
  {
   "start": 229.57,
   "end": 236.45,
   "text": "Wie producten aan klanten in andere landen verstuurt, doet er goed aan nu vast te leggen welke verpakkingen naar welk land gaan.",
   "chapter": 5
  },
  {
   "start": 236.45,
   "end": 240.29,
   "text": "Dan kunt u snel handelen zodra de definitieve regel er ligt.",
   "chapter": 5
  },
  {
   "start": 240.29,
   "end": 248.29,
   "text": "Ten tweede laat de Duitse textielsector zien hoe kwetsbaar een inzamelketen is, als de kwaliteit slecht is en de afzet stokt.",
   "chapter": 5
  },
  {
   "start": 248.29,
   "end": 253.01,
   "text": "Bij De Graaf Groep zien wij hoe belangrijk schone, goed gescheiden stromen zijn.",
   "chapter": 5
  },
  {
   "start": 253.01,
   "end": 259.33,
   "text": "Ten derde: chemische recycling krijgt langzaam vorm in Nederland, maar de vergunning is nog niet verleend.",
   "chapter": 5
  },
  {
   "start": 259.33,
   "end": 261.45,
   "text": "Reken er dus nog niet op in uw inkoop.",
   "chapter": 5
  },
  {
   "start": 261.9,
   "end": 265.1,
   "text": "Het cijfer van de dag is tachtigduizend.",
   "chapter": 6
  },
  {
   "start": 265.1,
   "end": 271.82,
   "text": "Zoveel ton plastic afval per jaar wil VPR Energy in Rotterdam omzetten in pyrolyse-olie.",
   "chapter": 6
  },
  {
   "start": 271.82,
   "end": 276.67,
   "text": "Het bedrijf verwacht dat de fabriek volgend jaar draait, maar de vergunning is nog niet verleend.",
   "chapter": 6
  },
  {
   "start": 277.12,
   "end": 279.6,
   "text": "Dat was Grondstof voor vandaag.",
   "chapter": 7
  },
  {
   "start": 279.6,
   "end": 283.28,
   "text": "De bronnen bij elk bericht vindt u in de app en in de shownotes.",
   "chapter": 7
  },
  {
   "start": 283.28,
   "end": 285.68,
   "text": "Morgen om negen uur bent u weer bij.",
   "chapter": 7
  },
  {
   "start": 285.68,
   "end": 286.14,
   "text": "Tot dan.",
   "chapter": 7
  }
 ],
