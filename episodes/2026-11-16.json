 "transcript": [
  {
   "start": 5.5,
   "end": 6.54,
   "text": "Goedemorgen.",
   "chapter": 0
  },
  {
   "start": 6.54,
   "end": 8.78,
   "text": "Het is maandag zestien november.",
   "chapter": 0
  },
  {
   "start": 8.78,
   "end": 13.26,
   "text": "U luistert naar Grondstof, het circulaire nieuwsbulletin van De Graaf Groep.",
   "chapter": 0
  },
  {
   "start": 13.26,
   "end": 14.86,
   "text": "Ik ben Frans van den Berge.",
   "chapter": 0
  },
  {
   "start": 14.86,
   "end": 16.7,
   "text": "Dit zijn de koppen.",
   "chapter": 0
  },
  {
   "start": 16.7,
   "end": 22.54,
   "text": "Brussel wil de nieuwe Europese wet voor de circulaire economie op twee december presenteren.",
   "chapter": 0
  },
  {
   "start": 22.54,
   "end": 30.14,
   "text": "Koperschroot wordt weer iets duurder, en Umicore investeert fors in zijn edelmetaalraffinage in Hoboken.",
   "chapter": 0
  },
  {
   "start": 30.14,
   "end": 34.86,
   "text": "En een slimme camera op de vuilniswagen wint een innovatieprijs in Gorinchem.",
   "chapter": 0
  },
  {
   "start": 37.2,
   "end": 43.2,
   "text": "De Europese Commissie wil haar nieuwe wet voor de circulaire economie op twee december presenteren.",
   "chapter": 1
  },
  {
   "start": 43.2,
   "end": 48.48,
   "text": "Dat blijkt uit de vergaderplanning van de Commissie, meldt het Duitse vakblad Packaging Journal.",
   "chapter": 1
  },
  {
   "start": 48.48,
   "end": 52.88,
   "text": "De eurocommissarissen Ribera en Séjourné zijn verantwoordelijk.",
   "chapter": 1
  },
  {
   "start": 52.88,
   "end": 56.4,
   "text": "De Commissie benadrukt wel dat de planning indicatief is.",
   "chapter": 1
  },
  {
   "start": 56.4,
   "end": 59.12,
   "text": "Over de inhoud is nog weinig bekend.",
   "chapter": 1
  },
  {
   "start": 59.12,
   "end": 66.16,
   "text": "Het doel is dat circulaire producten, secundaire grondstoffen en afval vrijer door Europa kunnen bewegen.",
   "chapter": 1
  },
  {
   "start": 66.16,
   "end": 70.64,
   "text": "Ook moet er meer hoogwaardig recyclaat komen, en meer vraag ernaar.",
   "chapter": 1
  },
  {
   "start": 70.64,
   "end": 75.92,
   "text": "Dat moet de economische veiligheid en de concurrentiekracht van de Europese Unie versterken.",
   "chapter": 1
  },
  {
   "start": 75.92,
   "end": 80.32,
   "text": "Op de consultatie kwamen negenhonderdtweeënzestig reacties binnen.",
   "chapter": 1
  },
  {
   "start": 80.32,
   "end": 85.4,
   "text": "Of de wet ook de producentenverantwoordelijkheid voor verpakkingen raakt, is nog onduidelijk.",
   "chapter": 1
  },
  {
   "start": 85.4,
   "end": 89.64,
   "text": "De verplichtingen uit de Europese verpakkingsverordening blijven intussen gewoon gelden.",
   "chapter": 1
  },
  {
   "start": 91.97,
   "end": 96.77,
   "text": "Koperschroot is na een duidelijke daling begin deze maand weer iets duurder geworden.",
   "chapter": 2
  },
  {
   "start": 96.77,
   "end": 100.93,
   "text": "Dat meldt het vakblad Euwid op basis van Duitse groothandelsprijzen.",
   "chapter": 2
  },
  {
   "start": 100.93,
   "end": 105.25,
   "text": "Zware en lichte koperschroot stegen met tien euro per honderd kilo.",
   "chapter": 2
  },
  {
   "start": 105.25,
   "end": 107.81,
   "text": "Messing en zink werden vijf euro duurder.",
   "chapter": 2
  },
  {
   "start": 107.81,
   "end": 109.97,
   "text": "Aluminiumschroot bleef gelijk.",
   "chapter": 2
  },
  {
   "start": 109.97,
   "end": 112.05,
   "text": "Het herstel staat wel onder druk.",
   "chapter": 2
  },
  {
   "start": 112.05,
   "end": 118.37,
   "text": "De koperprijs op de Londense metaalbeurs zakte vorige week donderdag naar het laagste niveau sinds eind juli.",
   "chapter": 2
  },
  {
   "start": 118.37,
   "end": 125.49,
   "text": "Intussen investeert het Belgische Umicore vierhonderdvijftig miljoen euro in zijn edelmetaalraffinage in Hoboken.",
   "chapter": 2
  },
  {
   "start": 125.49,
   "end": 131.97,
   "text": "Het geld gaat tussen tweeduizend zevenentwintig en tweeduizend dertig naar de uitbreiding van de metallurgische procesketen.",
   "chapter": 2
  },
  {
   "start": 131.97,
   "end": 135.05,
   "text": "De ingebruikname staat gepland voor tweeduizend dertig.",
   "chapter": 2
  },
  {
   "start": 135.05,
   "end": 137.71,
   "text": "Er zijn daarvoor nog wel vergunningen van de overheid nodig.",
   "chapter": 2
  },
  {
   "start": 140.05,
   "end": 149.49,
   "text": "Op de vakbeurs Afvalmanagement en Recycling in Gorinchem is de juryprijs van de Innovatie Awards naar AMCS Vision AI gegaan.",
   "chapter": 3
  },
  {
   "start": 149.49,
   "end": 151.33,
   "text": "Dat meldt Afvalgids.",
   "chapter": 3
  },
  {
   "start": 151.33,
   "end": 154.13,
   "text": "Het gaat om een camera op de inzamelwagen.",
   "chapter": 3
  },
  {
   "start": 154.13,
   "end": 157.89,
   "text": "Die start automatisch zodra een container wordt opgetild.",
   "chapter": 3
  },
  {
   "start": 157.89,
   "end": 161.41,
   "text": "Kunstmatige intelligentie beoordeelt daarna de inhoud.",
   "chapter": 3
  },
  {
   "start": 161.41,
   "end": 167.73,
   "text": "Het systeem herkent vervuiling, overvolle containers en gevaarlijke voorwerpen zoals gasflessen.",
   "chapter": 3
  },
  {
   "start": 167.73,
   "end": 170.05,
   "text": "De chauffeur hoeft daar niets voor te doen.",
   "chapter": 3
  },
  {
   "start": 170.05,
   "end": 173.89,
   "text": "De bevindingen worden gekoppeld aan de container en de klant.",
   "chapter": 3
  },
  {
   "start": 173.89,
   "end": 181.49,
   "text": "Volgens de brancheverenigingen van afvalbedrijven is op bedrijfsroutes meestal tien tot twintig procent van de containers overvol.",
   "chapter": 3
  },
  {
   "start": 181.49,
   "end": 190.57,
   "text": "Het bedrijf schat dat gevaarlijke voorwerpen in het restafval, zoals lachgasflessen, afvalbedrijven gemiddeld negentig miljoen euro per jaar kosten.",
   "chapter": 3
  },
  {
   "start": 190.57,
   "end": 192.5,
   "text": "Elf innovaties waren genomineerd.",
   "chapter": 3
  },
  {
   "start": 194.83,
   "end": 200.03,
   "text": "Ruim tachtig procent van de Nederlanders vindt het belangrijk dat kleding wordt gerecycled.",
   "chapter": 4
  },
  {
   "start": 200.03,
   "end": 205.79,
   "text": "Maar minder dan de helft gelooft dat ingezamelde kleding echt een tweede leven krijgt.",
   "chapter": 4
  },
  {
   "start": 205.79,
   "end": 212.99,
   "text": "Dat blijkt uit onderzoek van Multiscope onder ruim duizend Nederlanders, deze week gepubliceerd door Duurzaam Ondernemen.",
   "chapter": 4
  },
  {
   "start": 212.99,
   "end": 216.19,
   "text": "Het bedrijf Reju presenteerde de uitkomsten.",
   "chapter": 4
  },
  {
   "start": 216.19,
   "end": 221.39,
   "text": "Reju verwerkt polyester textiel en P-E-T-afval tot nieuwe grondstof.",
   "chapter": 4
  },
  {
   "start": 221.39,
   "end": 226.51,
   "text": "Ruim vijfenzeventig procent geeft oude kleding waarschijnlijk aan een kledinginzameling.",
   "chapter": 4
  },
  {
   "start": 226.51,
   "end": 230.67,
   "text": "Ruim vijftien procent verkoopt kleding via tweedehandsplatforms.",
   "chapter": 4
  },
  {
   "start": 230.67,
   "end": 233.79,
   "text": "Bijna twaalf procent gooit kleding bij het afval.",
   "chapter": 4
  },
  {
   "start": 233.79,
   "end": 238.91,
   "text": "Bijna de helft zou meer kleding recyclen als het vertrouwen in het systeem groeit.",
   "chapter": 4
  },
  {
   "start": 238.91,
   "end": 244.19,
   "text": "Topman Patrik Frisk van Reju noemt transparantie en vertrouwen daarom cruciaal.",
   "chapter": 4
  },
  {
   "start": 244.19,
   "end": 248.81,
   "text": "Zijn punt: mensen moeten kunnen zien dat kleding echt opnieuw grondstof wordt.",
   "chapter": 4
  },
  {
   "start": 251.15,
   "end": 254.19,
   "text": "En wat betekent dit voor uw organisatie?",
   "chapter": 5
  },
  {
   "start": 254.19,
   "end": 257.71,
   "text": "Het nieuws van vandaag draait om vertrouwen en bewijs.",
   "chapter": 5
  },
  {
   "start": 257.71,
   "end": 261.95,
   "text": "Wie wil dat afval grondstof wordt, moet kunnen laten zien wat er gebeurt.",
   "chapter": 5
  },
  {
   "start": 261.95,
   "end": 268.35,
   "text": "Bij De Graaf Groep zien we dat schone, gescheiden stromen de meeste waarde houden, ook als metaalprijzen schommelen.",
   "chapter": 5
  },
  {
   "start": 268.35,
   "end": 273.15,
   "text": "Camera's op inzamelwagens maken vervuiling en overvolle containers zichtbaar.",
   "chapter": 5
  },
  {
   "start": 273.15,
   "end": 276.43,
   "text": "Dat kan leiden tot extra kosten of nieuwe afspraken.",
   "chapter": 5
  },
  {
   "start": 276.43,
   "end": 279.39,
   "text": "Kijk dus kritisch naar de vulgraad van uw containers.",
   "chapter": 5
  },
  {
   "start": 279.39,
   "end": 283.34,
   "text": "En vraag uw inzamelaar om rapportage over wat er met uw stromen gebeurt.",
   "chapter": 5
  },
  {
   "start": 283.79,
   "end": 288.11,
   "text": "Het cijfer van de dag is vierhonderdvijftig miljoen euro.",
   "chapter": 6
  },
  {
   "start": 288.11,
   "end": 295.83,
   "text": "Zoveel investeert Umicore tot tweeduizend dertig in de uitbreiding van zijn edelmetaalraffinage in Hoboken, meldt Euwid.",
   "chapter": 6
  },
  {
   "start": 295.83,
   "end": 298.09,
   "text": "Er zijn nog wel vergunningen van de overheid nodig.",
   "chapter": 6
  },
  {
   "start": 298.54,
   "end": 300.86,
   "text": "Dat was Grondstof voor vandaag.",
   "chapter": 7
  },
  {
   "start": 300.86,
   "end": 304.7,
   "text": "De bronnen bij elk bericht vindt u in de app en in de shownotes.",
   "chapter": 7
  },
  {
   "start": 304.7,
   "end": 307.1,
   "text": "Morgen om negen uur bent u weer bij.",
   "chapter": 7
  },
  {
   "start": 307.1,
   "end": 307.68,
   "text": "Tot dan.",
   "chapter": 7
  }
 ],
