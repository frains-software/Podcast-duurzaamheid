 "transcript": [
  {
   "start": 5.5,
   "end": 6.54,
   "text": "Goedemorgen.",
   "chapter": 0
  },
  {
   "start": 6.54,
   "end": 8.86,
   "text": "Het is vrijdag zestien oktober.",
   "chapter": 0
  },
  {
   "start": 8.86,
   "end": 13.34,
   "text": "U luistert naar Grondstof, het circulaire nieuwsbulletin van De Graaf Groep.",
   "chapter": 0
  },
  {
   "start": 13.34,
   "end": 14.9,
   "text": "Ik ben Frans van den Berge.",
   "chapter": 0
  },
  {
   "start": 14.9,
   "end": 16.18,
   "text": "Dit zijn de koppen.",
   "chapter": 0
  },
  {
   "start": 16.18,
   "end": 19.74,
   "text": "De Tweede Kamer buigt zich over hogere afvalheffingen.",
   "chapter": 0
  },
  {
   "start": 19.74,
   "end": 24.98,
   "text": "In Duitsland zijn branden door accu's in recyclingbedrijven bijna verdrievoudigd.",
   "chapter": 0
  },
  {
   "start": 24.98,
   "end": 29.92,
   "text": "En politie en inspectie waarschuwen voor illegale handel in elektronisch afval.",
   "chapter": 0
  },
  {
   "start": 32.26,
   "end": 38.3,
   "text": "De Tweede Kamer heeft maandag twaalf oktober gesproken over de gevolgen van hogere afvalheffingen.",
   "chapter": 1
  },
  {
   "start": 38.3,
   "end": 45.34,
   "text": "Dat gebeurde tijdens het wetgevingsoverleg over het Belastingplan tweeduizend zevenentwintig, meldt Afvalgids.",
   "chapter": 1
  },
  {
   "start": 45.34,
   "end": 49.66,
   "text": "Fracties vroegen naar de CO-twee-heffing en de afvalstoffenbelasting.",
   "chapter": 1
  },
  {
   "start": 49.66,
   "end": 58.38,
   "text": "Ze vroegen ook naar de gevolgen voor burgers en bedrijven, het risico van afvalexport en investeringen in recycling en CO-twee-afvang.",
   "chapter": 1
  },
  {
   "start": 58.38,
   "end": 64.38,
   "text": "Het kabinet wil dat de CO-twee-heffing voor afvalverbrandingsinstallaties geleidelijker stijgt.",
   "chapter": 1
  },
  {
   "start": 64.38,
   "end": 72.18,
   "text": "Volgens de Rijksoverheid is het voorstel voor tweeduizend zevenentwintig ruim honderdvijfentwintig euro per ton CO-twee.",
   "chapter": 1
  },
  {
   "start": 72.18,
   "end": 76.54,
   "text": "In de huidige afspraken is dat ongeveer honderdvierenvijftig euro.",
   "chapter": 1
  },
  {
   "start": 76.54,
   "end": 83.42,
   "text": "Voor tweeduizend dertig is dat ongeveer honderdtweeënnegentig euro, in plaats van ongeveer driehonderd en vier.",
   "chapter": 1
  },
  {
   "start": 83.42,
   "end": 88.34,
   "text": "Het eindniveau wordt in beide gevallen pas in tweeduizend vijfendertig bereikt.",
   "chapter": 1
  },
  {
   "start": 88.34,
   "end": 93.54,
   "text": "Voor bedrijven die afval laten verwerken blijft de richting gelijk: verbranden wordt duurder.",
   "chapter": 1
  },
  {
   "start": 95.87,
   "end": 99.63,
   "text": "In Duitsland nemen branden in afvalbedrijven snel toe.",
   "chapter": 2
  },
  {
   "start": 99.63,
   "end": 106.35,
   "text": "Dat blijkt uit de studie Brandereignisse in der Entsorgungswirtschaft, die woensdag veertien oktober verscheen.",
   "chapter": 2
  },
  {
   "start": 106.35,
   "end": 113.47,
   "text": "Vijf Duitse brancheverbanden gaven de studie in opdracht, onder meer voor de afvalsector en de gemeentelijke bedrijven.",
   "chapter": 2
  },
  {
   "start": 113.47,
   "end": 116.59,
   "text": "Onderzocht zijn honderdeenentachtig installaties.",
   "chapter": 2
  },
  {
   "start": 116.59,
   "end": 125.79,
   "text": "Het aantal geregistreerde branden steeg van zevenhonderdnegenentwintig in tweeduizend eenentwintig naar tweeduizend achtentwintig in tweeduizend vijfentwintig.",
   "chapter": 2
  },
  {
   "start": 125.79,
   "end": 133.79,
   "text": "Bij de branden met een bekende oorzaak lag het aandeel van lithium-ionbatterijen in tweeduizend vijfentwintig op drieënzeventig procent.",
   "chapter": 2
  },
  {
   "start": 133.79,
   "end": 141.23,
   "text": "De brandschade over vijf jaar schatten de onderzoekers op tweehonderdvierenvijftig tot driehonderdvijfennegentig miljoen euro.",
   "chapter": 2
  },
  {
   "start": 141.23,
   "end": 144.43,
   "text": "Schade aan milieu en personen telt daar niet in mee.",
   "chapter": 2
  },
  {
   "start": 144.43,
   "end": 146.49,
   "text": "Nederlandse cijfers noemt de studie niet.",
   "chapter": 2
  },
  {
   "start": 148.83,
   "end": 156.03,
   "text": "Het bedrijf Borouge International investeert in meer capaciteit voor mechanische recycling van kunststof in Europa.",
   "chapter": 3
  },
  {
   "start": 156.03,
   "end": 157.95,
   "text": "Dat meldt Packaging Europe.",
   "chapter": 3
  },
  {
   "start": 157.95,
   "end": 159.79,
   "text": "Het gaat om twee vestigingen.",
   "chapter": 3
  },
  {
   "start": 159.79,
   "end": 167.15,
   "text": "In Niedergebra in Duitsland wordt gemengd kunststofafval van consumenten omgezet in recyclaat voor stijve toepassingen.",
   "chapter": 3
  },
  {
   "start": 167.15,
   "end": 174.35,
   "text": "De jaarlijkse productie stijgt daar met bijna negen kiloton, naar verwachting vanaf het eerste kwartaal van tweeduizend zevenentwintig.",
   "chapter": 3
  },
  {
   "start": 174.35,
   "end": 179.31,
   "text": "In Wildon in Oostenrijk komt er tot vijf kiloton gerecycled polyetheen bij.",
   "chapter": 3
  },
  {
   "start": 179.31,
   "end": 183.15,
   "text": "Dat staat gepland voor het vierde kwartaal van tweeduizend zevenentwintig.",
   "chapter": 3
  },
  {
   "start": 183.15,
   "end": 186.91,
   "text": "Samen gaat het om ongeveer veertien kiloton extra per jaar.",
   "chapter": 3
  },
  {
   "start": 186.91,
   "end": 193.39,
   "text": "Volgens het bedrijf moet dit klanten helpen om aan wettelijke eisen te voldoen, waaronder de Europese verpakkingsverordening.",
   "chapter": 3
  },
  {
   "start": 193.39,
   "end": 195.37,
   "text": "Het bericht verscheen op zeven oktober.",
   "chapter": 3
  },
  {
   "start": 197.7,
   "end": 203.54,
   "text": "Politie en Meld Misdaad Anoniem waarschuwen voor illegale verwerking van elektronisch afval.",
   "chapter": 4
  },
  {
   "start": 203.54,
   "end": 205.78,
   "text": "Dat meldt Recycling Magazine.",
   "chapter": 4
  },
  {
   "start": 205.78,
   "end": 211.54,
   "text": "De campagne startte woensdag veertien oktober, tijdens de Internationale dag van elektronisch afval.",
   "chapter": 4
  },
  {
   "start": 211.54,
   "end": 217.46,
   "text": "Een deel van de waardevolle grondstoffen uit e-schroot wordt volgens hen illegaal verwerkt en afgevoerd.",
   "chapter": 4
  },
  {
   "start": 217.46,
   "end": 220.42,
   "text": "Eerlijke recyclers betalen daarvoor de prijs.",
   "chapter": 4
  },
  {
   "start": 220.42,
   "end": 225.46,
   "text": "In Nederland wordt jaarlijks ongeveer vierhonderd miljoen kilo elektronisch afval verwerkt.",
   "chapter": 4
  },
  {
   "start": 225.46,
   "end": 232.1,
   "text": "Politie en de opsporingsdienst van de Inspectie Leefomgeving en Transport zien steeds meer malafide verwerkers.",
   "chapter": 4
  },
  {
   "start": 232.1,
   "end": 235.38,
   "text": "De campagne richt zich op de afval- en transportbranche.",
   "chapter": 4
  },
  {
   "start": 235.38,
   "end": 239.22,
   "text": "Er komen een toolkit, flyers en online advertenties.",
   "chapter": 4
  },
  {
   "start": 239.22,
   "end": 243.19,
   "text": "Brancheorganisaties, onder wie Stichting Open, ondersteunen de actie.",
   "chapter": 4
  },
  {
   "start": 245.53,
   "end": 248.33,
   "text": "En wat betekent dit voor uw organisatie?",
   "chapter": 5
  },
  {
   "start": 248.33,
   "end": 249.37,
   "text": "Drie dingen.",
   "chapter": 5
  },
  {
   "start": 249.37,
   "end": 253.29,
   "text": "Eén: verwerking van restafval wordt structureel duurder.",
   "chapter": 5
  },
  {
   "start": 253.29,
   "end": 257.05,
   "text": "Het kabinet kiest een langzamer pad, maar de richting blijft gelijk.",
   "chapter": 5
  },
  {
   "start": 257.05,
   "end": 260.81,
   "text": "Wie nu minder restafval maakt, bespaart straks meer.",
   "chapter": 5
  },
  {
   "start": 260.81,
   "end": 265.13,
   "text": "Twee: batterijen horen niet in het restafval of bij het papier.",
   "chapter": 5
  },
  {
   "start": 265.13,
   "end": 268.49,
   "text": "Een kapotte accu in een container kan een brand veroorzaken.",
   "chapter": 5
  },
  {
   "start": 268.49,
   "end": 272.49,
   "text": "Bij De Graaf Groep zien wij dat een goede scheiding aan de bron het verschil maakt.",
   "chapter": 5
  },
  {
   "start": 272.49,
   "end": 278.29,
   "text": "Laat batterijen en kleine elektronica apart inzamelen en vraag uw inzamelaar hoe dat gebeurt.",
   "chapter": 5
  },
  {
   "start": 278.29,
   "end": 283.53,
   "text": "Drie: kies voor elektronisch afval een verwerker die kan aantonen waar de stromen blijven.",
   "chapter": 5
  },
  {
   "start": 283.53,
   "end": 286.65,
   "text": "Vraag naar certificaten en naar een verwerkingsverklaring.",
   "chapter": 5
  },
  {
   "start": 286.65,
   "end": 289.97,
   "text": "Dan weet u dat uw apparaten niet in een illegale keten belanden.",
   "chapter": 5
  },
  {
   "start": 290.42,
   "end": 293.94,
   "text": "Het cijfer van de dag is tweeduizend achtentwintig.",
   "chapter": 6
  },
  {
   "start": 293.94,
   "end": 301.06,
   "text": "Zoveel branden telde de Duitse studie in tweeduizend vijfentwintig in honderdeenentachtig onderzochte installaties.",
   "chapter": 6
  },
  {
   "start": 301.06,
   "end": 305.14,
   "text": "In tweeduizend eenentwintig waren dat er zevenhonderdnegenentwintig.",
   "chapter": 6
  },
  {
   "start": 305.14,
   "end": 308.31,
   "text": "Het aantal is dus bijna verdrievoudigd in vier jaar.",
   "chapter": 6
  },
  {
   "start": 308.76,
   "end": 311.0,
   "text": "Dat was Grondstof voor vandaag.",
   "chapter": 7
  },
  {
   "start": 311.0,
   "end": 314.92,
   "text": "De bronnen bij elk bericht vindt u in de app en in de shownotes.",
   "chapter": 7
  },
  {
   "start": 314.92,
   "end": 317.16,
   "text": "Morgen om negen uur bent u weer bij.",
   "chapter": 7
  },
  {
   "start": 317.16,
   "end": 317.58,
   "text": "Tot dan.",
   "chapter": 7
  }
 ],
