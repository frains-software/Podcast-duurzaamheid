 "transcript": [
  {
   "start": 5.5,
   "end": 6.54,
   "text": "Goedemorgen.",
   "chapter": 0
  },
  {
   "start": 6.54,
   "end": 8.94,
   "text": "Het is dinsdag zeventien november.",
   "chapter": 0
  },
  {
   "start": 8.94,
   "end": 13.42,
   "text": "U luistert naar Grondstof, het circulaire nieuwsbulletin van De Graaf Groep.",
   "chapter": 0
  },
  {
   "start": 13.42,
   "end": 14.98,
   "text": "Ik ben Frans van den Berge.",
   "chapter": 0
  },
  {
   "start": 14.98,
   "end": 16.38,
   "text": "Dit zijn de koppen.",
   "chapter": 0
  },
  {
   "start": 16.38,
   "end": 20.46,
   "text": "De Tweede Kamer wil geen belastingkorting voor afval uit het buitenland.",
   "chapter": 0
  },
  {
   "start": 20.46,
   "end": 25.94,
   "text": "Het Duitse kartelbureau beboet drie leveranciers van afdichtingsfolie voor stortplaatsen.",
   "chapter": 0
  },
  {
   "start": 25.94,
   "end": 30.08,
   "text": "En in Engeland opent een van de grootste plasticrecyclers van het land.",
   "chapter": 0
  },
  {
   "start": 32.42,
   "end": 37.77,
   "text": "Afval uit het buitenland krijgt geen vrijstelling van de Nederlandse afvalstoffenbelasting.",
   "chapter": 1
  },
  {
   "start": 37.77,
   "end": 43.77,
   "text": "De Tweede Kamer heeft een amendement met die strekking verworpen, meldt het vakplatform Afvalgids.",
   "chapter": 1
  },
  {
   "start": 43.77,
   "end": 49.45,
   "text": "Het voorstel kwam van de Kamerleden Van den Berg en Hoogeveen van JA eenentwintig.",
   "chapter": 1
  },
  {
   "start": 49.45,
   "end": 55.77,
   "text": "Zij wilden buitenlands afval dat vanaf tweeduizend achtentwintig wordt aangevoerd, vrijstellen van de belasting.",
   "chapter": 1
  },
  {
   "start": 55.77,
   "end": 58.57,
   "text": "Het kabinet ontraadde het amendement.",
   "chapter": 1
  },
  {
   "start": 58.57,
   "end": 63.53,
   "text": "Volgens het kabinet maakt een vrijstelling het verbranden van afval juist aantrekkelijker.",
   "chapter": 1
  },
  {
   "start": 63.53,
   "end": 68.01,
   "text": "Bovendien zou buitenlands afval dan Nederlands afval kunnen verdringen.",
   "chapter": 1
  },
  {
   "start": 68.01,
   "end": 73.97,
   "text": "Voor bedrijven betekent de uitslag dat de huidige koers rond de afvalstoffenbelasting voorlopig overeind blijft.",
   "chapter": 1
  },
  {
   "start": 76.3,
   "end": 82.38,
   "text": "Het Duitse kartelbureau heeft drie leveranciers van afdichtingsfolie voor stortplaatsen beboet.",
   "chapter": 2
  },
  {
   "start": 82.38,
   "end": 86.14,
   "text": "Samen moeten ze ongeveer vijf komma vijf miljoen euro betalen.",
   "chapter": 2
  },
  {
   "start": 86.14,
   "end": 88.3,
   "text": "Dat meldt het vakblad Euwid.",
   "chapter": 2
  },
  {
   "start": 88.3,
   "end": 95.18,
   "text": "Het gaat om G quadrat uit Krefeld, Naue Sealing uit Espelkamp en Kat uit Wiesmoor.",
   "chapter": 2
  },
  {
   "start": 95.18,
   "end": 99.74,
   "text": "Kat deed volgens het kartelbureau mee aan een afspraak over één project.",
   "chapter": 2
  },
  {
   "start": 99.74,
   "end": 105.58,
   "text": "Volgens het kartelbureau verdeelden de bedrijven sinds uiterlijk tweeduizend zeven de opdrachten onderling.",
   "chapter": 2
  },
  {
   "start": 105.58,
   "end": 112.86,
   "text": "Solmax kreeg ongeveer veertig procent, Naue Sealing vijfendertig procent en G quadrat ongeveer een kwart.",
   "chapter": 2
  },
  {
   "start": 112.86,
   "end": 116.54,
   "text": "Solmax ontloopt een boete, omdat het de zaak zelf meldde.",
   "chapter": 2
  },
  {
   "start": 116.54,
   "end": 122.62,
   "text": "Een inval in een vergaderhotel maakte in september tweeduizend drieëntwintig een einde aan het kartel.",
   "chapter": 2
  },
  {
   "start": 122.62,
   "end": 127.42,
   "text": "In Duitsland verkopen maar vier bedrijven toegelaten folie voor stortplaatsen.",
   "chapter": 2
  },
  {
   "start": 127.42,
   "end": 134.39,
   "text": "President Andreas Mundt van het kartelbureau waarschuwt dat zo'n kartel kan leiden tot te hoge prijzen voor opdrachtgevers.",
   "chapter": 2
  },
  {
   "start": 136.73,
   "end": 142.25,
   "text": "Het Britse Reconomy heeft in Corby een nieuwe fabriek voor plasticrecycling geopend.",
   "chapter": 3
  },
  {
   "start": 142.25,
   "end": 146.73,
   "text": "Dat melden onder meer East Midlands Business Link en Recycling Today.",
   "chapter": 3
  },
  {
   "start": 146.73,
   "end": 149.69,
   "text": "De investering bedraagt twintig miljoen pond.",
   "chapter": 3
  },
  {
   "start": 149.69,
   "end": 156.49,
   "text": "De fabriek kan jaarlijks tot achtendertigduizend ton plastic verwerken en levert meer dan dertig vaste banen op.",
   "chapter": 3
  },
  {
   "start": 156.49,
   "end": 163.21,
   "text": "Het gaat om plastic verpakkingen van supermarkten en andere winkels, die in een gesloten kringloop worden gerecycled.",
   "chapter": 3
  },
  {
   "start": 163.21,
   "end": 169.13,
   "text": "Reconomy spreekt van een belangrijke mijlpaal voor het bedrijf en voor de Britse plasticrecycling.",
   "chapter": 3
  },
  {
   "start": 169.13,
   "end": 171.85,
   "text": "De opening valt op in een moeilijke markt.",
   "chapter": 3
  },
  {
   "start": 171.85,
   "end": 178.01,
   "text": "Sinds tweeduizend drieëntwintig sloten in het Verenigd Koninkrijk negentien plasticrecyclers hun deuren.",
   "chapter": 3
  },
  {
   "start": 178.01,
   "end": 182.89,
   "text": "Hoge energiekosten en goedkoop nieuw plastic speelden daarbij een grote rol.",
   "chapter": 3
  },
  {
   "start": 182.89,
   "end": 188.02,
   "text": "Daardoor wordt het voor bedrijven lastiger om meer gerecycled materiaal in hun verpakkingen te gebruiken.",
   "chapter": 3
  },
  {
   "start": 190.36,
   "end": 198.6,
   "text": "Het Delftse bedrijf Plastilose heeft de categorie circulaire economie gewonnen van de Innovatie Top honderd van de Kamer van Koophandel.",
   "chapter": 4
  },
  {
   "start": 198.6,
   "end": 200.92,
   "text": "Dat meldt Duurzaam Ondernemen.",
   "chapter": 4
  },
  {
   "start": 200.92,
   "end": 205.48,
   "text": "Plastilose ontwikkelt biologisch afbreekbare medicijnbekertjes.",
   "chapter": 4
  },
  {
   "start": 205.48,
   "end": 211.72,
   "text": "Die moeten de plastic wegwerpproducten vervangen die de zorg jaarlijks in miljoenen exemplaren gebruikt.",
   "chapter": 4
  },
  {
   "start": 211.72,
   "end": 217.64,
   "text": "De prijs voor veelbelovende jonge bedrijven in dezelfde categorie ging naar NewBin uit Amsterdam.",
   "chapter": 4
  },
  {
   "start": 217.64,
   "end": 224.52,
   "text": "De hoofdprijs was voor QT Sense uit Groningen, met een quantummicroscoop voor onderzoek naar levende cellen.",
   "chapter": 4
  },
  {
   "start": 224.52,
   "end": 227.24,
   "text": "Het was de eenentwintigste editie van de verkiezing.",
   "chapter": 4
  },
  {
   "start": 227.24,
   "end": 230.36,
   "text": "Het publiek bracht bijna tienduizend stemmen uit.",
   "chapter": 4
  },
  {
   "start": 230.36,
   "end": 236.44,
   "text": "Bij de categoriewinnaars telde de vakjury voor tachtig procent mee en het publiek voor twintig procent.",
   "chapter": 4
  },
  {
   "start": 236.44,
   "end": 238.36,
   "text": "Er hoort geen geldprijs bij.",
   "chapter": 4
  },
  {
   "start": 238.36,
   "end": 242.02,
   "text": "De waarde zit volgens de organisatie in zichtbaarheid en erkenning.",
   "chapter": 4
  },
  {
   "start": 244.35,
   "end": 247.39,
   "text": "En wat betekent dit voor uw organisatie?",
   "chapter": 5
  },
  {
   "start": 247.39,
   "end": 251.87,
   "text": "Het nieuws van vandaag laat zien dat afval geen vrijblijvende kostenpost is.",
   "chapter": 5
  },
  {
   "start": 251.87,
   "end": 255.63,
   "text": "De afvalstoffenbelasting blijft een prikkel om minder te verbranden.",
   "chapter": 5
  },
  {
   "start": 255.63,
   "end": 259.55,
   "text": "Bij De Graaf Groep zien we dat scheiden aan de bron dan direct geld scheelt.",
   "chapter": 5
  },
  {
   "start": 259.55,
   "end": 264.91,
   "text": "Het Engelse voorbeeld leert ook dat recycling alleen werkt als er vraag is naar het materiaal.",
   "chapter": 5
  },
  {
   "start": 264.91,
   "end": 270.35,
   "text": "Kiest u bij inkoop bewust voor gerecycled plastic, dan helpt u die markt overeind te houden.",
   "chapter": 5
  },
  {
   "start": 270.35,
   "end": 274.11,
   "text": "En de Duitse kartelzaak is een herinnering voor iedere inkoper.",
   "chapter": 5
  },
  {
   "start": 274.11,
   "end": 278.36,
   "text": "Vergelijk aanbiedingen kritisch, juist in markten met weinig leveranciers.",
   "chapter": 5
  },
  {
   "start": 278.81,
   "end": 281.69,
   "text": "Het cijfer van de dag is negentien.",
   "chapter": 6
  },
  {
   "start": 281.69,
   "end": 287.93,
   "text": "Zoveel plasticrecyclers in het Verenigd Koninkrijk sloten sinds tweeduizend drieëntwintig hun deuren.",
   "chapter": 6
  },
  {
   "start": 287.93,
   "end": 292.41,
   "text": "Samen verwerkten ze ongeveer vierhonderdduizend ton gebruikt plastic.",
   "chapter": 6
  },
  {
   "start": 292.41,
   "end": 296.8,
   "text": "Hoge energiekosten en goedkoop nieuw plastic waren de belangrijkste oorzaken.",
   "chapter": 6
  },
  {
   "start": 297.25,
   "end": 299.57,
   "text": "Dat was Grondstof voor vandaag.",
   "chapter": 7
  },
  {
   "start": 299.57,
   "end": 303.25,
   "text": "De bronnen bij elk bericht vindt u in de app en in de shownotes.",
   "chapter": 7
  },
  {
   "start": 303.25,
   "end": 305.57,
   "text": "Morgen om negen uur bent u weer bij.",
   "chapter": 7
  },
  {
   "start": 305.57,
   "end": 306.01,
   "text": "Tot dan.",
   "chapter": 7
  }
 ],
