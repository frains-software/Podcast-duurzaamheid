 "transcript": [
  {
   "start": 5.5,
   "end": 6.54,
   "text": "Goedemorgen.",
   "chapter": 0
  },
  {
   "start": 6.54,
   "end": 9.1,
   "text": "Het is zaterdag vierentwintig oktober.",
   "chapter": 0
  },
  {
   "start": 9.1,
   "end": 13.58,
   "text": "U luistert naar Grondstof, het circulaire nieuwsbulletin van De Graaf Groep.",
   "chapter": 0
  },
  {
   "start": 13.58,
   "end": 15.15,
   "text": "Ik ben Frans van den Berge.",
   "chapter": 0
  },
  {
   "start": 15.15,
   "end": 16.7,
   "text": "Dit zijn de koppen.",
   "chapter": 0
  },
  {
   "start": 16.7,
   "end": 21.7,
   "text": "De Europese lidstaten willen een verpakkingsplicht voor kleine volumes opschorten.",
   "chapter": 0
  },
  {
   "start": 21.7,
   "end": 25.26,
   "text": "Veolia zoekt een koper voor zijn Belgische afvalbedrijf.",
   "chapter": 0
  },
  {
   "start": 25.26,
   "end": 29.17,
   "text": "En Kalifornië publiceert voor het eerst concrete verpakkingsheffingen.",
   "chapter": 0
  },
  {
   "start": 31.51,
   "end": 35.99,
   "text": "De lidstaten van de Europese Unie willen de verpakkingsverordening versoepelen.",
   "chapter": 1
  },
  {
   "start": 35.99,
   "end": 38.15,
   "text": "Dat meldt vakblad Euwid.",
   "chapter": 1
  },
  {
   "start": 38.15,
   "end": 41.51,
   "text": "De Raad stelde afgelopen woensdag zijn standpunt vast.",
   "chapter": 1
  },
  {
   "start": 41.51,
   "end": 45.59,
   "text": "Het gaat om de plicht om in een ander land een gemachtigde aan te wijzen.",
   "chapter": 1
  },
  {
   "start": 45.59,
   "end": 52.07,
   "text": "Die plicht zou vervallen voor bedrijven die minder dan één ton verpakking per jaar in een lidstaat op de markt brengen.",
   "chapter": 1
  },
  {
   "start": 52.07,
   "end": 54.07,
   "text": "De grens geldt per land.",
   "chapter": 1
  },
  {
   "start": 54.07,
   "end": 60.31,
   "text": "De bedrijfsgrootte speelt volgens de Raad geen rol, dus ook grote bedrijven kunnen onder de vrijstelling vallen.",
   "chapter": 1
  },
  {
   "start": 60.31,
   "end": 65.59,
   "text": "Het Europees Parlement kiest een ander criterium, namelijk de omvang van het bedrijf.",
   "chapter": 1
  },
  {
   "start": 65.59,
   "end": 69.67,
   "text": "Ook over de looptijd en over batterijen verschillen de standpunten.",
   "chapter": 1
  },
  {
   "start": 69.67,
   "end": 73.67,
   "text": "Nu volgen onderhandelingen tussen Raad, Parlement en Commissie.",
   "chapter": 1
  },
  {
   "start": 73.67,
   "end": 77.66,
   "text": "Webwinkels met grensoverschrijdende verkoop houden dit dossier dus in de gaten.",
   "chapter": 1
  },
  {
   "start": 79.99,
   "end": 85.35,
   "text": "Het Franse milieuconcern Veolia wil zijn afvalactiviteiten in België verkopen.",
   "chapter": 2
  },
  {
   "start": 85.35,
   "end": 89.35,
   "text": "Dat meldt de Belgische krant La Libre, op basis van Bloomberg.",
   "chapter": 2
  },
  {
   "start": 89.35,
   "end": 94.39,
   "text": "Volgens de bronnen kan de opbrengst tussen achthonderd miljoen en één miljard euro liggen.",
   "chapter": 2
  },
  {
   "start": 94.39,
   "end": 97.11,
   "text": "Er is al een financieel adviseur aangesteld.",
   "chapter": 2
  },
  {
   "start": 97.11,
   "end": 101.51,
   "text": "De transactie zou begin tweeduizend zevenentwintig kunnen zijn afgerond.",
   "chapter": 2
  },
  {
   "start": 101.51,
   "end": 108.55,
   "text": "De Belgische dochter heeft volgens haar eigen website vierduizend driehonderd medewerkers op ongeveer zeventig locaties.",
   "chapter": 2
  },
  {
   "start": 108.55,
   "end": 110.87,
   "text": "Veolia maakt geen commentaar.",
   "chapter": 2
  },
  {
   "start": 110.87,
   "end": 116.55,
   "text": "Het bedrijf wil schulden verlagen en minstens twee miljard euro aan activiteiten afstoten.",
   "chapter": 2
  },
  {
   "start": 116.55,
   "end": 121.43,
   "text": "Eerder dit jaar kocht Veolia het Amerikaanse Clean Earth voor drie miljard dollar.",
   "chapter": 2
  },
  {
   "start": 121.43,
   "end": 123.47,
   "text": "Het gaat om nog niet bevestigde berichten.",
   "chapter": 2
  },
  {
   "start": 125.81,
   "end": 131.09,
   "text": "Kalifornië laat fabrikanten betalen voor de inzameling en recycling van hun verpakkingen.",
   "chapter": 3
  },
  {
   "start": 131.09,
   "end": 132.77,
   "text": "Dat meldt Euwid.",
   "chapter": 3
  },
  {
   "start": 132.77,
   "end": 138.29,
   "text": "De organisatie Circular Action Alliance publiceerde voor het eerst concrete tarieven.",
   "chapter": 3
  },
  {
   "start": 138.29,
   "end": 141.25,
   "text": "De heffingen gaan in tweeduizend zevenentwintig in.",
   "chapter": 3
  },
  {
   "start": 141.25,
   "end": 145.97,
   "text": "Het budget voor dat jaar is ongeveer één komma één miljard Amerikaanse dollar.",
   "chapter": 3
  },
  {
   "start": 145.97,
   "end": 149.01,
   "text": "Dat is duidelijk lager dan eerdere schattingen.",
   "chapter": 3
  },
  {
   "start": 149.01,
   "end": 154.13,
   "text": "Transparante flessen van P-E-T kosten ongeveer negenhonderd dollar per ton.",
   "chapter": 3
  },
  {
   "start": 154.13,
   "end": 160.13,
   "text": "Kunststoffolie van polypropyleen komt uit op ongeveer twaalfhonderdvijfendertig dollar per ton.",
   "chapter": 3
  },
  {
   "start": 160.13,
   "end": 166.13,
   "text": "Glas kost ongeveer vierenveertig dollar per ton en golfkarton zesenzestig dollar.",
   "chapter": 3
  },
  {
   "start": 166.13,
   "end": 169.41,
   "text": "Moeilijk recyclebaar plastic betaalt dus het meest.",
   "chapter": 3
  },
  {
   "start": 169.41,
   "end": 173.36,
   "text": "Het is een voorbeeld van sturing via de prijs, zoals ook Nederland die kent.",
   "chapter": 3
  },
  {
   "start": 175.69,
   "end": 180.41,
   "text": "Gemeenten en provincies hebben te weinig structureel geld voor milieutaken.",
   "chapter": 4
  },
  {
   "start": 180.41,
   "end": 185.65,
   "text": "Dat melden de Vereniging van Nederlandse Gemeenten en het Interprovinciaal Overleg donderdag.",
   "chapter": 4
  },
  {
   "start": 185.65,
   "end": 188.33,
   "text": "Zij lieten een financiële studie uitvoeren.",
   "chapter": 4
  },
  {
   "start": 188.33,
   "end": 191.93,
   "text": "Het gaat om vergunningverlening, toezicht en handhaving.",
   "chapter": 4
  },
  {
   "start": 191.93,
   "end": 194.97,
   "text": "Omgevingsdiensten voeren veel van die taken uit.",
   "chapter": 4
  },
  {
   "start": 194.97,
   "end": 199.01,
   "text": "Het structurele tekort bedraagt honderd miljoen euro per jaar.",
   "chapter": 4
  },
  {
   "start": 199.01,
   "end": 206.57,
   "text": "Nieuwe opgaven drukken extra op het stelsel, zoals de energietransitie, de circulaire economie en de waterkwaliteit.",
   "chapter": 4
  },
  {
   "start": 206.57,
   "end": 210.85,
   "text": "De overheden vragen het Rijk om ambities en middelen in balans te brengen.",
   "chapter": 4
  },
  {
   "start": 210.85,
   "end": 213.85,
   "text": "Ze willen daarover praten in het bestuurlijk overleg.",
   "chapter": 4
  },
  {
   "start": 213.85,
   "end": 218.84,
   "text": "Voor bedrijven is dit relevant, omdat toezicht op afvalstromen en vergunningen hiervan afhangt.",
   "chapter": 4
  },
  {
   "start": 221.18,
   "end": 224.06,
   "text": "En wat betekent dit voor uw organisatie?",
   "chapter": 5
  },
  {
   "start": 224.06,
   "end": 225.02,
   "text": "Drie dingen.",
   "chapter": 5
  },
  {
   "start": 225.02,
   "end": 228.94,
   "text": "Ten eerste: de regels voor verpakkingen blijven in beweging.",
   "chapter": 5
  },
  {
   "start": 228.94,
   "end": 234.3,
   "text": "Of u wel of geen gemachtigde nodig heeft, hangt straks af van volume of bedrijfsgrootte.",
   "chapter": 5
  },
  {
   "start": 234.3,
   "end": 238.22,
   "text": "Breng nu in kaart hoeveel verpakking u per land op de markt brengt.",
   "chapter": 5
  },
  {
   "start": 238.22,
   "end": 241.66,
   "text": "Ten tweede: de afvalbranche verandert van eigenaar.",
   "chapter": 5
  },
  {
   "start": 241.66,
   "end": 247.82,
   "text": "Als uw inzamelaar of verwerker wordt verkocht, kunnen contracten, tarieven en contactpersonen veranderen.",
   "chapter": 5
  },
  {
   "start": 247.82,
   "end": 250.54,
   "text": "Lees uw contract op overnameclausules.",
   "chapter": 5
  },
  {
   "start": 250.54,
   "end": 256.14,
   "text": "Ten derde: het Californische voorbeeld laat zien dat moeilijk recyclebaar plastic duurder wordt.",
   "chapter": 5
  },
  {
   "start": 256.14,
   "end": 257.85,
   "text": "Dat zien wij ook in Nederland.",
   "chapter": 5
  },
  {
   "start": 257.85,
   "end": 263.13,
   "text": "Bij De Graaf Groep merken we dat organisaties met goed gescheiden stromen daar het meeste profijt van hebben.",
   "chapter": 5
  },
  {
   "start": 263.58,
   "end": 267.26,
   "text": "Het cijfer van de dag is drieënzeventig procent.",
   "chapter": 6
  },
  {
   "start": 267.26,
   "end": 275.9,
   "text": "Zoveel van de matrassen in Nederland werd in de eerste helft van dit jaar ingezameld voor recycling, volgens Stichting Matras Recycling Nederland.",
   "chapter": 6
  },
  {
   "start": 275.9,
   "end": 277.9,
   "text": "Het cijfer is voorlopig.",
   "chapter": 6
  },
  {
   "start": 277.9,
   "end": 281.66,
   "text": "In tweeduizend tweeëntwintig was het nog tweeënveertig procent.",
   "chapter": 6
  },
  {
   "start": 281.66,
   "end": 285.63,
   "text": "De doelstelling voor tweeduizend achtentwintig is vijfenzeventig procent.",
   "chapter": 6
  },
  {
   "start": 286.08,
   "end": 288.4,
   "text": "Dat was Grondstof voor vandaag.",
   "chapter": 7
  },
  {
   "start": 288.4,
   "end": 292.08,
   "text": "De bronnen bij elk bericht vindt u in de app en in de shownotes.",
   "chapter": 7
  },
  {
   "start": 292.08,
   "end": 294.48,
   "text": "Morgen om negen uur bent u weer bij ons.",
   "chapter": 7
  },
  {
   "start": 294.48,
   "end": 294.9,
   "text": "Tot dan.",
   "chapter": 7
  }
 ],
