 "transcript": [
  {
   "start": 5.5,
   "end": 6.54,
   "text": "Goedemorgen.",
   "chapter": 0
  },
  {
   "start": 6.54,
   "end": 9.06,
   "text": "Het is zaterdag eenentwintig november.",
   "chapter": 0
  },
  {
   "start": 9.06,
   "end": 13.5,
   "text": "U luistert naar Grondstof, het circulaire nieuwsbulletin van De Graaf Groep.",
   "chapter": 0
  },
  {
   "start": 13.5,
   "end": 15.06,
   "text": "Ik ben Frans van den Berge.",
   "chapter": 0
  },
  {
   "start": 15.06,
   "end": 16.62,
   "text": "Dit zijn de koppen.",
   "chapter": 0
  },
  {
   "start": 16.62,
   "end": 22.06,
   "text": "Het kabinet onderzoekt een gerichte heffing op nieuw plastic in textiel en bouwproducten.",
   "chapter": 0
  },
  {
   "start": 22.06,
   "end": 27.5,
   "text": "Afvalbedrijf PreZero overweegt de verkoop van al zijn Nederlandse activiteiten.",
   "chapter": 0
  },
  {
   "start": 27.5,
   "end": 32.74,
   "text": "En Nederlandse huishoudens gooien minder restafval weg dan ooit sinds het begin van de metingen.",
   "chapter": 0
  },
  {
   "start": 35.08,
   "end": 39.56,
   "text": "Het kabinet laat een heffing op nieuw, fossiel plastic verder uitwerken.",
   "chapter": 1
  },
  {
   "start": 39.56,
   "end": 42.04,
   "text": "Dat meldt het Duitse vakblad Euwid.",
   "chapter": 1
  },
  {
   "start": 42.04,
   "end": 45.24,
   "text": "Het voorstel heet de circulaire hefboom.",
   "chapter": 1
  },
  {
   "start": 45.24,
   "end": 49.88,
   "text": "De heffing zou gelden voor plastic in textiel en in bepaalde bouwproducten.",
   "chapter": 1
  },
  {
   "start": 49.88,
   "end": 56.6,
   "text": "Het doel is dat producenten nieuw fossiel plastic vervangen door gerecycled of biobased materiaal.",
   "chapter": 1
  },
  {
   "start": 56.6,
   "end": 59.96,
   "text": "Een eerste effectbeoordeling laat een gemengd beeld zien.",
   "chapter": 1
  },
  {
   "start": 59.96,
   "end": 64.36,
   "text": "Voor sommige productgroepen werkt de heffing, voor andere nauwelijks.",
   "chapter": 1
  },
  {
   "start": 64.36,
   "end": 70.52,
   "text": "Het idee komt van de Plastictafel, een overleg met partijen uit de keten dat vorig jaar bijeenkwam.",
   "chapter": 1
  },
  {
   "start": 70.52,
   "end": 75.64,
   "text": "Dat gebeurde nadat het kabinet een algemene belasting op nieuw plastic had laten vallen.",
   "chapter": 1
  },
  {
   "start": 75.64,
   "end": 80.4,
   "text": "Een principebesluit volgt na het eerste kwartaal van tweeduizend zevenentwintig.",
   "chapter": 1
  },
  {
   "start": 80.4,
   "end": 85.12,
   "text": "Voor producenten en inkopers blijft de prijs van nieuw plastic dus een politiek dossier.",
   "chapter": 1
  },
  {
   "start": 87.45,
   "end": 92.65,
   "text": "Het Duitse afvalconcern PreZero overweegt zich terug te trekken uit Nederland.",
   "chapter": 2
  },
  {
   "start": 92.65,
   "end": 98.73,
   "text": "Eerder deze week meldde Euwid dat het bedrijf de verkoop van al zijn Nederlandse activiteiten onderzoekt.",
   "chapter": 2
  },
  {
   "start": 98.73,
   "end": 103.61,
   "text": "PreZero heeft dat inmiddels bevestigd tegenover de Duitse Lebensmittel Zeitung.",
   "chapter": 2
  },
  {
   "start": 103.61,
   "end": 108.65,
   "text": "Een woordvoerster zegt dat het bedrijf strategische opties voor de Nederlandse tak bekijkt.",
   "chapter": 2
  },
  {
   "start": 108.65,
   "end": 116.01,
   "text": "Volgens het vakblad Packreport zijn in Nederland investeringen in technologie nodig, maar dat is niet officieel bevestigd.",
   "chapter": 2
  },
  {
   "start": 116.01,
   "end": 123.53,
   "text": "PreZero kreeg zijn sterke positie in Nederland in tweeduizend eenentwintig, met de overname van de afvalactiviteiten van Suez.",
   "chapter": 2
  },
  {
   "start": 123.53,
   "end": 127.37,
   "text": "Er is nog geen besluit, geen koper en geen tijdpad.",
   "chapter": 2
  },
  {
   "start": 127.37,
   "end": 133.47,
   "text": "Een verkoop kan de verhoudingen op de Nederlandse afvalmarkt flink veranderen, voor gemeenten en voor bedrijven.",
   "chapter": 2
  },
  {
   "start": 135.81,
   "end": 141.65,
   "text": "Het Britse National Wealth Fund investeert negentien komma zes miljoen pond in Pulpex.",
   "chapter": 3
  },
  {
   "start": 141.65,
   "end": 144.29,
   "text": "Dat is ruim drieëntwintig miljoen euro.",
   "chapter": 3
  },
  {
   "start": 144.29,
   "end": 147.01,
   "text": "Dat meldt het vakblad Packaging Europe.",
   "chapter": 3
  },
  {
   "start": 147.01,
   "end": 152.05,
   "text": "Pulpex maakt flessen van houtpulp, als alternatief voor plastic en glas.",
   "chapter": 3
  },
  {
   "start": 152.05,
   "end": 155.97,
   "text": "Na gebruik kunnen ze mee met het gewone oud papier en karton.",
   "chapter": 3
  },
  {
   "start": 155.97,
   "end": 160.37,
   "text": "Het geld gaat naar een nieuwe fabriek in Glasgow, die in oktober openging.",
   "chapter": 3
  },
  {
   "start": 160.37,
   "end": 164.53,
   "text": "Die kan in eerste instantie veertig miljoen flessen per jaar maken.",
   "chapter": 3
  },
  {
   "start": 164.53,
   "end": 169.89,
   "text": "Een eerste toepassing is een flesje voor vloeibaar wasmiddel, samen met het merk Smol.",
   "chapter": 3
  },
  {
   "start": 169.89,
   "end": 174.77,
   "text": "Directeur Scott Winston wil wereldwijd groeien naar een miljard flessen per jaar.",
   "chapter": 3
  },
  {
   "start": 174.77,
   "end": 179.6,
   "text": "Het laat zien dat papieren verpakkingen voor vloeistoffen de stap van proef naar fabriek zetten.",
   "chapter": 3
  },
  {
   "start": 181.93,
   "end": 186.09,
   "text": "Gemeenten laten hun restafval steeds vaker achteraf sorteren.",
   "chapter": 4
  },
  {
   "start": 186.09,
   "end": 189.93,
   "text": "Dat blijkt uit nieuwe cijfers van het CBS over vorig jaar.",
   "chapter": 4
  },
  {
   "start": 189.93,
   "end": 194.81,
   "text": "Bijna zestig procent van de gemeenten koos geheel of gedeeltelijk voor nascheiding.",
   "chapter": 4
  },
  {
   "start": 194.81,
   "end": 197.45,
   "text": "Dat zijn honderdvijfennegentig gemeenten.",
   "chapter": 4
  },
  {
   "start": 197.45,
   "end": 200.49,
   "text": "Twee jaar eerder was dat nog ongeveer een kwart.",
   "chapter": 4
  },
  {
   "start": 200.49,
   "end": 206.53,
   "text": "Rotterdam laat het grootste deel van het restafval nascheiden, drieënzeventig komma vijf procent.",
   "chapter": 4
  },
  {
   "start": 206.53,
   "end": 211.61,
   "text": "Tegelijk daalt de gescheiden inzameling van plastic, metaal en drankkartons.",
   "chapter": 4
  },
  {
   "start": 211.61,
   "end": 218.57,
   "text": "Huishoudens leverden gemiddeld twintig kilo per inwoner in, drie procent minder dan in tweeduizend drieëntwintig.",
   "chapter": 4
  },
  {
   "start": 218.57,
   "end": 225.01,
   "text": "Het aantal gemeenten zonder aparte inzameling van die stroom steeg van vijfenveertig naar drieënvijftig.",
   "chapter": 4
  },
  {
   "start": 225.01,
   "end": 228.79,
   "text": "Voor gemeenten verschuift het sorteren zo van de keukenla naar de fabriek.",
   "chapter": 4
  },
  {
   "start": 231.13,
   "end": 234.09,
   "text": "En wat betekent dit voor uw organisatie?",
   "chapter": 5
  },
  {
   "start": 234.09,
   "end": 237.77,
   "text": "De rode draad van vandaag is beweging in de keten.",
   "chapter": 5
  },
  {
   "start": 237.77,
   "end": 241.37,
   "text": "Overheden zoeken nieuwe prikkels om nieuw plastic te ontmoedigen.",
   "chapter": 5
  },
  {
   "start": 241.37,
   "end": 243.61,
   "text": "Verpakkingen veranderen van materiaal.",
   "chapter": 5
  },
  {
   "start": 243.61,
   "end": 248.01,
   "text": "En de afvalmarkt zelf verschuift, met mogelijke wisselingen van eigenaar.",
   "chapter": 5
  },
  {
   "start": 248.01,
   "end": 251.93,
   "text": "Bij De Graaf Groep zien we dat zekerheid dan begint bij inzicht.",
   "chapter": 5
  },
  {
   "start": 251.93,
   "end": 256.41,
   "text": "Weet welke stromen u heeft, hoeveel het er zijn en wie ze verwerkt.",
   "chapter": 5
  },
  {
   "start": 256.41,
   "end": 262.43,
   "text": "En kijk bij inkoop naar materiaal en recyclebaarheid, want dat bepaalt steeds vaker de kosten van morgen.",
   "chapter": 5
  },
  {
   "start": 262.88,
   "end": 266.6,
   "text": "Het cijfer van de dag is honderdzesenzeventig kilo.",
   "chapter": 6
  },
  {
   "start": 266.6,
   "end": 271.76,
   "text": "Zoveel restafval zetten Nederlanders vorig jaar gemiddeld per persoon aan de straat.",
   "chapter": 6
  },
  {
   "start": 271.76,
   "end": 277.16,
   "text": "Dat is het laagste niveau sinds het CBS in negentienhonderd drieënnegentig begon met meten.",
   "chapter": 6
  },
  {
   "start": 277.16,
   "end": 281.18,
   "text": "Toch is het nog altijd bijna veertig procent van al het huishoudelijk afval.",
   "chapter": 6
  },
  {
   "start": 281.63,
   "end": 283.95,
   "text": "Dat was Grondstof voor vandaag.",
   "chapter": 7
  },
  {
   "start": 283.95,
   "end": 287.71,
   "text": "De bronnen bij elk bericht vindt u in de app en in de shownotes.",
   "chapter": 7
  },
  {
   "start": 287.71,
   "end": 290.03,
   "text": "Morgen om negen uur bent u weer bij.",
   "chapter": 7
  },
  {
   "start": 290.03,
   "end": 290.48,
   "text": "Tot dan.",
   "chapter": 7
  }
 ],
