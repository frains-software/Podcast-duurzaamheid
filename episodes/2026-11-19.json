 "transcript": [
  {
   "start": 5.5,
   "end": 6.5,
   "text": "Goedemorgen.",
   "chapter": 0
  },
  {
   "start": 6.5,
   "end": 8.86,
   "text": "Het is donderdag negentien november.",
   "chapter": 0
  },
  {
   "start": 8.86,
   "end": 13.18,
   "text": "U luistert naar Grondstof, het circulaire nieuwsbulletin van De Graaf Groep.",
   "chapter": 0
  },
  {
   "start": 13.18,
   "end": 14.74,
   "text": "Ik ben Frans van den Berge.",
   "chapter": 0
  },
  {
   "start": 14.74,
   "end": 15.98,
   "text": "Dit zijn de koppen.",
   "chapter": 0
  },
  {
   "start": 15.98,
   "end": 21.98,
   "text": "Europese lidstaten steunen regels waardoor gerecycled plastic eerder geen afval meer is.",
   "chapter": 0
  },
  {
   "start": 21.98,
   "end": 25.74,
   "text": "Stena Recycling koopt een Pools bedrijf in oud papier.",
   "chapter": 0
  },
  {
   "start": 25.74,
   "end": 30.9,
   "text": "En Veolia opent in Frankrijk een fabriek die metalen uit oude batterijen terugwint.",
   "chapter": 0
  },
  {
   "start": 33.24,
   "end": 40.03,
   "text": "Gerecycled plastic geldt straks in de hele Europese Unie eerder als product en niet langer als afval.",
   "chapter": 1
  },
  {
   "start": 40.03,
   "end": 47.71,
   "text": "Vertegenwoordigers van de lidstaten hebben begin november ingestemd met een voorstel van de Europese Commissie, meldt het vakblad Euwid.",
   "chapter": 1
  },
  {
   "start": 47.71,
   "end": 54.11,
   "text": "Het gaat om vaste regels die bepalen wanneer plastic afval na recycling zijn afvalstatus verliest.",
   "chapter": 1
  },
  {
   "start": 54.11,
   "end": 58.83,
   "text": "Ze gelden voor plastic dat mechanisch of met oplosmiddelen wordt gerecycled.",
   "chapter": 1
  },
  {
   "start": 58.83,
   "end": 65.87,
   "text": "Het materiaal moet dan een vorm hebben die vergelijkbaar is met nieuw plastic, zoals vlokken, poeder of korrels.",
   "chapter": 1
  },
  {
   "start": 65.87,
   "end": 70.83,
   "text": "De Commissie en haar onderzoekscentrum werkten ongeveer vier jaar aan deze criteria.",
   "chapter": 1
  },
  {
   "start": 70.83,
   "end": 74.83,
   "text": "Het doel is minder papierwerk voor recyclers en verwerkers.",
   "chapter": 1
  },
  {
   "start": 74.83,
   "end": 79.47,
   "text": "Ook moet het vervoer van gerecycled plastic tussen lidstaten eenvoudiger worden.",
   "chapter": 1
  },
  {
   "start": 79.47,
   "end": 82.55,
   "text": "Dat kan de vraag naar gerecycled materiaal een duw geven.",
   "chapter": 1
  },
  {
   "start": 84.88,
   "end": 90.4,
   "text": "Het Zweedse Stena Recycling heeft het Poolse oudpapierbedrijf Surimet overgenomen.",
   "chapter": 2
  },
  {
   "start": 90.4,
   "end": 92.08,
   "text": "Dat meldt Euwid.",
   "chapter": 2
  },
  {
   "start": 92.08,
   "end": 94.88,
   "text": "De overname werd op dertig oktober afgerond.",
   "chapter": 2
  },
  {
   "start": 94.88,
   "end": 100.72,
   "text": "Surimet heeft vestigingen in Grudziądz en Koszalin en telt ongeveer veertig medewerkers.",
   "chapter": 2
  },
  {
   "start": 100.72,
   "end": 104.56,
   "text": "Stena Recycling heeft daarmee zeventien locaties in Polen.",
   "chapter": 2
  },
  {
   "start": 104.56,
   "end": 109.28,
   "text": "Volgens topman Lars Ibsen is de Poolse tak klaar voor meer overnames.",
   "chapter": 2
  },
  {
   "start": 109.28,
   "end": 113.44,
   "text": "Het bedrijf wil een actieve rol spelen in de consolidatie van de markt.",
   "chapter": 2
  },
  {
   "start": 113.44,
   "end": 121.04,
   "text": "Moederbedrijf Stena Metall zag het bedrijfsresultaat vóór afschrijvingen in het afgelopen boekjaar met bijna tien procent stijgen.",
   "chapter": 2
  },
  {
   "start": 121.04,
   "end": 123.6,
   "text": "Dat boekjaar liep tot eind augustus.",
   "chapter": 2
  },
  {
   "start": 123.6,
   "end": 131.36,
   "text": "Het concern noemt hogere grondstofprijzen, een gunstige mix van materialen en hogere inkomsten uit diensten als oorzaak.",
   "chapter": 2
  },
  {
   "start": 131.36,
   "end": 136.21,
   "text": "De overname past in een bredere trend van schaalvergroting in de Europese recyclingsector.",
   "chapter": 2
  },
  {
   "start": 138.55,
   "end": 145.27,
   "text": "Veolia heeft in de Franse regio Grand Est een fabriek geopend die metalen terugwint uit oude batterijen.",
   "chapter": 3
  },
  {
   "start": 145.27,
   "end": 147.99,
   "text": "Dat meldt het Britse vakblad Letsrecycle.",
   "chapter": 3
  },
  {
   "start": 147.99,
   "end": 152.07,
   "text": "De fabriek verwerkt jaarlijks bijna zevenduizend ton zwarte massa.",
   "chapter": 3
  },
  {
   "start": 152.07,
   "end": 156.31,
   "text": "Dat is het fijne poeder dat overblijft na het ontmantelen van batterijen.",
   "chapter": 3
  },
  {
   "start": 156.31,
   "end": 160.87,
   "text": "Volgens Veolia komt dat overeen met ongeveer twintigduizend ton batterijen.",
   "chapter": 3
  },
  {
   "start": 160.87,
   "end": 164.63,
   "text": "Uit het poeder haalt de fabriek kobalt, nikkel en koper.",
   "chapter": 3
  },
  {
   "start": 164.63,
   "end": 169.75,
   "text": "Die metalen gaan naar Europese afnemers in de auto-industrie, de bouw en defensie.",
   "chapter": 3
  },
  {
   "start": 169.75,
   "end": 174.15,
   "text": "Het materiaal komt nu uit Frankrijk, het Verenigd Koninkrijk en Zwitserland.",
   "chapter": 3
  },
  {
   "start": 174.15,
   "end": 180.63,
   "text": "Veolia verwacht dat er binnen vijf jaar bijna zevenhonderdduizend ton batterijen in Europa wordt gerecycled.",
   "chapter": 3
  },
  {
   "start": 180.63,
   "end": 184.55,
   "text": "Volgens het bedrijf gaat het om meer dan een miljard euro aan metalen.",
   "chapter": 3
  },
  {
   "start": 184.55,
   "end": 190.69,
   "text": "Veolia waarschuwt dat de export van zwarte massa naar Azië waardevolle grondstoffen uit Europa wegtrekt.",
   "chapter": 3
  },
  {
   "start": 193.02,
   "end": 199.26,
   "text": "Zes op de tien Nederlanders vinden dat ongebruikte elektrische apparaten een tweede leven moeten krijgen.",
   "chapter": 4
  },
  {
   "start": 199.26,
   "end": 203.82,
   "text": "Toch kiest tweeënzestig procent bij vervanging liever voor een nieuw apparaat.",
   "chapter": 4
  },
  {
   "start": 203.82,
   "end": 209.74,
   "text": "Dat blijkt uit onderzoek van Motivaction in opdracht van Stichting Open, meldt Duurzaam Ondernemen.",
   "chapter": 4
  },
  {
   "start": 209.74,
   "end": 212.18,
   "text": "Ruim duizend Nederlanders deden mee.",
   "chapter": 4
  },
  {
   "start": 212.18,
   "end": 216.1,
   "text": "Achtenvijftig procent heeft weleens een apparaat vervangen dat nog werkte.",
   "chapter": 4
  },
  {
   "start": 216.1,
   "end": 220.82,
   "text": "Vierendertig procent heeft een werkend maar ongebruikt apparaat in huis liggen.",
   "chapter": 4
  },
  {
   "start": 220.82,
   "end": 224.3,
   "text": "Bijna de helft staat open voor gereviseerde apparaten.",
   "chapter": 4
  },
  {
   "start": 224.3,
   "end": 228.89,
   "text": "Twijfel over de kwaliteit en een te klein prijsverschil houden mensen tegen.",
   "chapter": 4
  },
  {
   "start": 228.89,
   "end": 233.42,
   "text": "Een lagere prijs, keuring door een vakman en garantie zouden helpen.",
   "chapter": 4
  },
  {
   "start": 233.42,
   "end": 239.79,
   "text": "Volgens directeur Jan Vlak moet een gereviseerd product vooral een goede aankoop zijn, niet alleen een duurzame keuze.",
   "chapter": 4
  },
  {
   "start": 242.13,
   "end": 245.17,
   "text": "En wat betekent dit voor uw organisatie?",
   "chapter": 5
  },
  {
   "start": 245.17,
   "end": 248.53,
   "text": "Grondstoffen uit afval worden steeds meer een handelswaar.",
   "chapter": 5
  },
  {
   "start": 248.53,
   "end": 252.77,
   "text": "Europese regels maken gerecycled plastic makkelijker te verhandelen.",
   "chapter": 5
  },
  {
   "start": 252.77,
   "end": 257.25,
   "text": "Grote recyclers kopen bedrijven op om meer materiaal in handen te krijgen.",
   "chapter": 5
  },
  {
   "start": 257.25,
   "end": 261.89,
   "text": "Bij De Graaf Groep zien we dat de waarde van een stroom vooral afhangt van de zuiverheid.",
   "chapter": 5
  },
  {
   "start": 261.89,
   "end": 267.09,
   "text": "Goed gescheiden papier, metaal en plastic levert meer op dan een gemengde container.",
   "chapter": 5
  },
  {
   "start": 267.09,
   "end": 269.57,
   "text": "Dat geldt ook voor apparaten en batterijen.",
   "chapter": 5
  },
  {
   "start": 269.57,
   "end": 275.52,
   "text": "Lever die apart in, zodat bruikbare apparaten een tweede leven krijgen en metalen worden teruggewonnen.",
   "chapter": 5
  },
  {
   "start": 275.97,
   "end": 279.97,
   "text": "Het cijfer van de dag is honderddrieënveertig miljoen.",
   "chapter": 6
  },
  {
   "start": 279.97,
   "end": 286.21,
   "text": "Zoveel kilo elektrische apparaten krijgt in Nederland elk jaar een tweede leven, meldt Stichting Open.",
   "chapter": 6
  },
  {
   "start": 286.21,
   "end": 289.81,
   "text": "Dat is ruim een derde van alle apparaten die jaarlijks vrijkomen.",
   "chapter": 6
  },
  {
   "start": 290.26,
   "end": 292.66,
   "text": "Dat was Grondstof voor vandaag.",
   "chapter": 7
  },
  {
   "start": 292.66,
   "end": 296.34,
   "text": "De bronnen bij elk bericht vindt u in de app en in de shownotes.",
   "chapter": 7
  },
  {
   "start": 296.34,
   "end": 298.58,
   "text": "Morgen om negen uur bent u weer bij.",
   "chapter": 7
  },
  {
   "start": 298.58,
   "end": 299.03,
   "text": "Tot dan.",
   "chapter": 7
  }
 ],
