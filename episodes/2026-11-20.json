 "transcript": [
  {
   "start": 5.5,
   "end": 6.54,
   "text": "Goedemorgen.",
   "chapter": 0
  },
  {
   "start": 6.54,
   "end": 8.78,
   "text": "Het is vrijdag twintig november.",
   "chapter": 0
  },
  {
   "start": 8.78,
   "end": 13.26,
   "text": "U luistert naar Grondstof, het circulaire nieuwsbulletin van De Graaf Groep.",
   "chapter": 0
  },
  {
   "start": 13.26,
   "end": 14.86,
   "text": "Ik ben Frans van den Berge.",
   "chapter": 0
  },
  {
   "start": 14.86,
   "end": 16.3,
   "text": "Dit zijn de koppen.",
   "chapter": 0
  },
  {
   "start": 16.3,
   "end": 21.42,
   "text": "De Europese Commissie laat zien hoe het nieuwe ecodesignlabel eruit kan zien.",
   "chapter": 0
  },
  {
   "start": 21.42,
   "end": 26.22,
   "text": "In Groot-Brittannië worden slecht recyclebare verpakkingen sneller duurder.",
   "chapter": 0
  },
  {
   "start": 26.22,
   "end": 32.18,
   "text": "En de gemeente Rheden verwacht dat de kosten voor restafval tot tweeduizend dertig verdrievoudigen.",
   "chapter": 0
  },
  {
   "start": 34.52,
   "end": 39.93,
   "text": "De Europese Commissie heeft een prototype gepresenteerd voor het nieuwe ecodesignlabel.",
   "chapter": 1
  },
  {
   "start": 39.93,
   "end": 42.57,
   "text": "Dat meldt het vakblad Packaging Europe.",
   "chapter": 1
  },
  {
   "start": 42.57,
   "end": 47.49,
   "text": "Het label hoort bij de Europese ecodesignverordening voor duurzame producten.",
   "chapter": 1
  },
  {
   "start": 47.49,
   "end": 51.29,
   "text": "Bovenaan staan de Europese vlag en het woord ecodesign.",
   "chapter": 1
  },
  {
   "start": 51.29,
   "end": 54.49,
   "text": "Daaronder volgt een totaalscore voor duurzaamheid.",
   "chapter": 1
  },
  {
   "start": 54.49,
   "end": 59.05,
   "text": "Die score is opgebouwd uit kenmerken die per productgroep worden vastgesteld.",
   "chapter": 1
  },
  {
   "start": 59.05,
   "end": 64.81,
   "text": "Elk kenmerk krijgt een eigen schaal van A tot en met G, met pictogrammen in plaats van tekst.",
   "chapter": 1
  },
  {
   "start": 64.81,
   "end": 69.29,
   "text": "Meer informatie komt via een scancode en het digitaal productpaspoort.",
   "chapter": 1
  },
  {
   "start": 69.29,
   "end": 74.37,
   "text": "De Commissie testte het ontwerp onder meer met ruim zesduizend consumenten in vijf landen.",
   "chapter": 1
  },
  {
   "start": 74.37,
   "end": 81.02,
   "text": "Toch bleven er misverstanden bestaan, bijvoorbeeld over hoe de totaalscore zich verhoudt tot de afzonderlijke kenmerken.",
   "chapter": 1
  },
  {
   "start": 81.02,
   "end": 84.99,
   "text": "Voor fabrikanten en inkopers wordt het label straks een vergelijkingsinstrument.",
   "chapter": 1
  },
  {
   "start": 87.32,
   "end": 93.64,
   "text": "In Groot-Brittannië moeten producenten van slecht recyclebare verpakkingen sneller meer gaan betalen.",
   "chapter": 2
  },
  {
   "start": 93.64,
   "end": 100.36,
   "text": "Dat stelt PackUK voor, de organisatie die de Britse producentenverantwoordelijkheid voor verpakkingen uitvoert.",
   "chapter": 2
  },
  {
   "start": 100.36,
   "end": 103.52,
   "text": "Het Britse vakblad Letsrecycle meldt het.",
   "chapter": 2
  },
  {
   "start": 103.52,
   "end": 108.25,
   "text": "Verpakkingen in de zogenoemde rode categorie krijgen een hogere toeslag.",
   "chapter": 2
  },
  {
   "start": 108.25,
   "end": 116.2,
   "text": "Voor het tariefjaar dat in tweeduizend zevenentwintig begint, wordt die toeslag twee keer het basistarief, in plaats van één komma zes keer.",
   "chapter": 2
  },
  {
   "start": 116.2,
   "end": 119.72,
   "text": "Een jaar later stijgt de factor naar twee komma vier.",
   "chapter": 2
  },
  {
   "start": 119.72,
   "end": 122.6,
   "text": "Het voorstel ging op achttien november naar de sector.",
   "chapter": 2
  },
  {
   "start": 122.6,
   "end": 125.56,
   "text": "Reageren kan tot zeventien december.",
   "chapter": 2
  },
  {
   "start": 125.56,
   "end": 129.48,
   "text": "Producenten van verpakkingen op basis van vezels zijn kritisch.",
   "chapter": 2
  },
  {
   "start": 129.48,
   "end": 136.28,
   "text": "Volgens hen verdubbelen de kosten voor duurzame verpakkingen bijna, door gebrekkige beoordelingen van recyclebaarheid.",
   "chapter": 2
  },
  {
   "start": 136.28,
   "end": 140.97,
   "text": "Het voorbeeld laat zien hoe het ontwerp van een verpakking direct in de kostprijs terechtkomt.",
   "chapter": 2
  },
  {
   "start": 143.31,
   "end": 151.15,
   "text": "Het Noord-Hollandse afvalbedrijf GP Groot introduceert een funderingsmateriaal voor wegen en terreinen zonder staalslakken.",
   "chapter": 3
  },
  {
   "start": 151.15,
   "end": 152.99,
   "text": "Dat meldt Afvalgids.",
   "chapter": 3
  },
  {
   "start": 152.99,
   "end": 157.63,
   "text": "Het gaat om gebonden menggranulaat, gemaakt van gerecycled puin.",
   "chapter": 3
  },
  {
   "start": 157.63,
   "end": 162.67,
   "text": "Tot nu toe gebruikt de sector daarvoor vaak een bindmiddel op basis van staalslakken.",
   "chapter": 3
  },
  {
   "start": 162.67,
   "end": 169.39,
   "text": "Door de landelijke discussie over staalslakken ontstaat onzekerheid bij projecten, aanbestedingen en vergunningen.",
   "chapter": 3
  },
  {
   "start": 169.39,
   "end": 173.55,
   "text": "GP Groot gebruikt daarom een fijne fractie uit betonrecycling.",
   "chapter": 3
  },
  {
   "start": 173.55,
   "end": 177.23,
   "text": "Daarin zitten nog cementdeeltjes die vanzelf binden.",
   "chapter": 3
  },
  {
   "start": 177.23,
   "end": 181.79,
   "text": "Ingenieursbureau Mol testte de sterkte en stabiliteit onafhankelijk.",
   "chapter": 3
  },
  {
   "start": 181.79,
   "end": 185.07,
   "text": "Volgens het bedrijf haalt het materiaal de normen ruim.",
   "chapter": 3
  },
  {
   "start": 185.07,
   "end": 188.03,
   "text": "Ook dochterbedrijf Sortiva werkte eraan mee.",
   "chapter": 3
  },
  {
   "start": 188.03,
   "end": 192.08,
   "text": "Commercieel manager Daniëlle Groen zegt dat de markt vraagt om zekerheid.",
   "chapter": 3
  },
  {
   "start": 194.41,
   "end": 198.65,
   "text": "De gemeente Rheden in Gelderland moet haar afvalbeleid herzien.",
   "chapter": 4
  },
  {
   "start": 198.65,
   "end": 205.69,
   "text": "Het college verwacht dat de kosten voor het verwerken van fijn restafval tot tweeduizend dertig verdrievoudigen.",
   "chapter": 4
  },
  {
   "start": 205.69,
   "end": 212.17,
   "text": "Dat kan jaarlijks tot zeshonderdduizend euro extra kosten, meldt de lokale omroep Studio Rheden.",
   "chapter": 4
  },
  {
   "start": 212.17,
   "end": 216.97,
   "text": "Inwoners van Rheden scheiden hun afval minder goed dan in vergelijkbare gemeenten.",
   "chapter": 4
  },
  {
   "start": 216.97,
   "end": 220.57,
   "text": "Ook houden zij relatief veel restafval over.",
   "chapter": 4
  },
  {
   "start": 220.57,
   "end": 226.01,
   "text": "Sinds één januari zamelt Circulus het afval in, als opvolger van PreZero.",
   "chapter": 4
  },
  {
   "start": 226.01,
   "end": 232.09,
   "text": "Na een moeizame start met routes en meldingen is de dienstverlening volgens het college stabieler.",
   "chapter": 4
  },
  {
   "start": 232.09,
   "end": 236.57,
   "text": "In tweeduizend zevenentwintig begint de gemeente aan een nieuw grondstoffenplan.",
   "chapter": 4
  },
  {
   "start": 236.57,
   "end": 240.73,
   "text": "Wat dat betekent voor de afvalstoffenheffing, is nog niet duidelijk.",
   "chapter": 4
  },
  {
   "start": 240.73,
   "end": 242.41,
   "text": "Rheden staat niet alleen.",
   "chapter": 4
  },
  {
   "start": 242.41,
   "end": 245.7,
   "text": "Veel gemeenten zien de verwerkingskosten van restafval stijgen.",
   "chapter": 4
  },
  {
   "start": 248.04,
   "end": 251.08,
   "text": "En wat betekent dit voor uw organisatie?",
   "chapter": 5
  },
  {
   "start": 251.08,
   "end": 253.88,
   "text": "Het nieuws van vandaag heeft één rode draad.",
   "chapter": 5
  },
  {
   "start": 253.88,
   "end": 258.36,
   "text": "Het ontwerp en de verwerking van een product bepalen steeds vaker de prijs.",
   "chapter": 5
  },
  {
   "start": 258.36,
   "end": 261.08,
   "text": "Een label maakt duurzaamheid vergelijkbaar.",
   "chapter": 5
  },
  {
   "start": 261.08,
   "end": 264.36,
   "text": "Een verpakkingsheffing beloont wat goed te recyclen is.",
   "chapter": 5
  },
  {
   "start": 264.36,
   "end": 267.24,
   "text": "En restafval wordt elk jaar duurder.",
   "chapter": 5
  },
  {
   "start": 267.24,
   "end": 271.32,
   "text": "Bij De Graaf Groep zien we dat organisaties hier zelf veel invloed op hebben.",
   "chapter": 5
  },
  {
   "start": 271.32,
   "end": 276.52,
   "text": "Kijk bij inkoop naar recyclebaarheid en hergebruik, niet alleen naar de aanschafprijs.",
   "chapter": 5
  },
  {
   "start": 276.52,
   "end": 279.0,
   "text": "En meet wat er in uw restcontainer belandt.",
   "chapter": 5
  },
  {
   "start": 279.0,
   "end": 283.27,
   "text": "Vaak zit daar nog papier, plastic of metaal in dat apart veel minder kost.",
   "chapter": 5
  },
  {
   "start": 283.72,
   "end": 287.16,
   "text": "Het cijfer van de dag is vierenveertig procent.",
   "chapter": 6
  },
  {
   "start": 287.16,
   "end": 293.24,
   "text": "Zoveel jongeren tussen zestien en negenentwintig jaar leveren hun lege blikje onderweg niet in.",
   "chapter": 6
  },
  {
   "start": 293.24,
   "end": 297.32,
   "text": "Thuis lukt dat wel: bijna acht op de tien leveren hun blikjes in.",
   "chapter": 6
  },
  {
   "start": 297.32,
   "end": 301.56,
   "text": "Dat blijkt uit onderzoek van Every Can Counts, meldt Recycling Magazine.",
   "chapter": 6
  },
  {
   "start": 302.01,
   "end": 304.41,
   "text": "Dat was Grondstof voor vandaag.",
   "chapter": 7
  },
  {
   "start": 304.41,
   "end": 308.17,
   "text": "De bronnen bij elk bericht vindt u in de app en in de shownotes.",
   "chapter": 7
  },
  {
   "start": 308.17,
   "end": 310.49,
   "text": "Morgen om negen uur bent u weer bij.",
   "chapter": 7
  },
  {
   "start": 310.49,
   "end": 310.93,
   "text": "Tot dan.",
   "chapter": 7
  }
 ],
