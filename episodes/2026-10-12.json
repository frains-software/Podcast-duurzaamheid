 "transcript": [
  {
   "start": 5.5,
   "end": 6.54,
   "text": "Goedemorgen.",
   "chapter": 0
  },
  {
   "start": 6.54,
   "end": 8.7,
   "text": "Het is maandag twaalf oktober.",
   "chapter": 0
  },
  {
   "start": 8.7,
   "end": 13.02,
   "text": "U luistert naar Grondstof, het circulaire nieuwsbulletin van De Graaf Groep.",
   "chapter": 0
  },
  {
   "start": 13.02,
   "end": 14.62,
   "text": "Ik ben Frans van den Berge.",
   "chapter": 0
  },
  {
   "start": 14.62,
   "end": 16.22,
   "text": "Dit zijn de koppen.",
   "chapter": 0
  },
  {
   "start": 16.22,
   "end": 18.94,
   "text": "Koperschroot houdt zijn hoge prijs.",
   "chapter": 0
  },
  {
   "start": 18.94,
   "end": 24.3,
   "text": "Amstelveen wil af van het apart inzamelen van plastic, metaal en drankenkartons.",
   "chapter": 0
  },
  {
   "start": 24.3,
   "end": 27.91,
   "text": "En de recyclebijdrage voor vlakglas gaat omhoog.",
   "chapter": 0
  },
  {
   "start": 30.25,
   "end": 33.85,
   "text": "De prijs van koper is op een hoog niveau gestabiliseerd.",
   "chapter": 1
  },
  {
   "start": 33.85,
   "end": 36.09,
   "text": "Dat meldt het vakblad Euwid.",
   "chapter": 1
  },
  {
   "start": 36.09,
   "end": 44.01,
   "text": "In de week die begon op vijf oktober hing de driemaandsprijs op de metaalbeurs van Londen rond veertienduizend vierhonderd dollar per ton.",
   "chapter": 1
  },
  {
   "start": 44.01,
   "end": 47.29,
   "text": "Er was geen duidelijke beweging omhoog of omlaag.",
   "chapter": 1
  },
  {
   "start": 47.29,
   "end": 51.77,
   "text": "Duitse handelaren in non-ferroschroot meldden ongewijzigde prijzen.",
   "chapter": 1
  },
  {
   "start": 51.77,
   "end": 59.61,
   "text": "Een week eerder stegen de prijzen voor de meeste soorten non-ferroschroot in Duitsland nog, ondanks een lichte daling van de beursprijs.",
   "chapter": 1
  },
  {
   "start": 59.61,
   "end": 65.21,
   "text": "Voor inkopers en inzamelaars betekent dit dat metaalschroot een waardevolle stroom blijft.",
   "chapter": 1
  },
  {
   "start": 65.21,
   "end": 69.14,
   "text": "Hoe hoog de schrootprijzen precies zijn, meldt Euwid alleen aan abonnees.",
   "chapter": 1
  },
  {
   "start": 71.48,
   "end": 78.84,
   "text": "Amstelveen wil vanaf tweeduizend achtentwintig plastic, metaal en drankenkartons niet meer apart laten inzamelen.",
   "chapter": 2
  },
  {
   "start": 78.84,
   "end": 80.76,
   "text": "Dat meldt Amstelveenz.",
   "chapter": 2
  },
  {
   "start": 80.76,
   "end": 83.64,
   "text": "Het college wil overstappen op nascheiding.",
   "chapter": 2
  },
  {
   "start": 83.64,
   "end": 86.92,
   "text": "Inwoners gooien die verpakkingen dan bij het restafval.",
   "chapter": 2
  },
  {
   "start": 86.92,
   "end": 89.64,
   "text": "Na de inzameling worden ze gescheiden.",
   "chapter": 2
  },
  {
   "start": 89.64,
   "end": 98.68,
   "text": "De gemeente ontvangt nu geen vergoeding meer voor verpakkingen uit ondergrondse containers, omdat de kwaliteit door strengere landelijke eisen te laag is.",
   "chapter": 2
  },
  {
   "start": 98.68,
   "end": 101.56,
   "text": "Ook veroorzaken lachgascilinders problemen.",
   "chapter": 2
  },
  {
   "start": 101.56,
   "end": 107.64,
   "text": "Afvalverwerkers nemen restafval daarmee niet aan, omdat ze in een verbrandingsoven kunnen ontploffen.",
   "chapter": 2
  },
  {
   "start": 107.64,
   "end": 112.28,
   "text": "Het laten versnipperen kost ongeveer zeshonderdvijftigduizend euro per jaar.",
   "chapter": 2
  },
  {
   "start": 112.28,
   "end": 117.88,
   "text": "De overstap kost ruim anderhalf miljoen euro en moet structurele besparingen opleveren.",
   "chapter": 2
  },
  {
   "start": 117.88,
   "end": 119.81,
   "text": "De gemeenteraad beslist in november.",
   "chapter": 2
  },
  {
   "start": 122.14,
   "end": 126.54,
   "text": "Frankrijk blijft producenten belonen die gerecycled plastic gebruiken.",
   "chapter": 3
  },
  {
   "start": 126.54,
   "end": 128.06,
   "text": "Dat meldt Euwid.",
   "chapter": 3
  },
  {
   "start": 128.06,
   "end": 133.18,
   "text": "De Franse Raad van State liet de regels van afgelopen september grotendeels intact.",
   "chapter": 3
  },
  {
   "start": 133.18,
   "end": 141.26,
   "text": "Producenten krijgen een bonus van vierhonderdvijftig tot duizend euro per ton gerecycled plastic dat ze in nieuwe producten verwerken.",
   "chapter": 3
  },
  {
   "start": 141.26,
   "end": 145.1,
   "text": "Dat geldt binnen de uitgebreide producentenverantwoordelijkheid.",
   "chapter": 3
  },
  {
   "start": 145.1,
   "end": 151.26,
   "text": "Het afvalfonds Eco D-D-S en de plasticbranche stapten naar de rechter, maar kregen geen gelijk.",
   "chapter": 3
  },
  {
   "start": 151.26,
   "end": 158.46,
   "text": "Alleen de huishoudapparatenfabrikant Seb kreeg gedeeltelijk gelijk, over de manier waarop bonussen en boetes samenkomen.",
   "chapter": 3
  },
  {
   "start": 158.46,
   "end": 166.37,
   "text": "Voor Nederlandse bedrijven met Franse afzet laat dit zien dat financiële prikkels voor recyclaat blijven bestaan, ook al is de plasticmarkt zwak.",
   "chapter": 3
  },
  {
   "start": 168.71,
   "end": 174.46,
   "text": "De recyclebijdrage voor vlakglas stijgt per één januari tweeduizend zevenentwintig.",
   "chapter": 4
  },
  {
   "start": 174.46,
   "end": 178.86,
   "text": "Dat meldt Afvalgids, op basis van Vlakglas Recycling Nederland.",
   "chapter": 4
  },
  {
   "start": 178.86,
   "end": 187.5,
   "text": "De stichting verhoogt de bijdrage voor isolatieglas van nul komma nul één zeven vijf euro naar nul komma nul twee euro per kilo.",
   "chapter": 4
  },
  {
   "start": 187.5,
   "end": 190.14,
   "text": "Ook de huur van glascontainers gaat omhoog.",
   "chapter": 4
  },
  {
   "start": 190.14,
   "end": 192.46,
   "text": "Een bedrag noemt het bericht daarvoor niet.",
   "chapter": 4
  },
  {
   "start": 192.46,
   "end": 197.34,
   "text": "De stichting wijst op hogere kosten voor inzameling, transport en recycling.",
   "chapter": 4
  },
  {
   "start": 197.34,
   "end": 200.38,
   "text": "Ook komen er nieuwe administratieve verplichtingen.",
   "chapter": 4
  },
  {
   "start": 200.38,
   "end": 205.02,
   "text": "Volgens de stichting is de verhoging nodig om het systeem financieel gezond te houden.",
   "chapter": 4
  },
  {
   "start": 205.02,
   "end": 209.66,
   "text": "Voor bouwbedrijven en glaszetters betekent dit iets hogere kosten per kilo glas.",
   "chapter": 4
  },
  {
   "start": 212.0,
   "end": 214.8,
   "text": "En wat betekent dit voor uw organisatie?",
   "chapter": 5
  },
  {
   "start": 214.8,
   "end": 215.76,
   "text": "Drie dingen.",
   "chapter": 5
  },
  {
   "start": 215.76,
   "end": 218.16,
   "text": "Eén: metaal houdt waarde.",
   "chapter": 5
  },
  {
   "start": 218.16,
   "end": 224.96,
   "text": "Houd koper, aluminium en ander metaal apart van het restafval, want gemengd verliest het veel van zijn opbrengst.",
   "chapter": 5
  },
  {
   "start": 224.96,
   "end": 228.4,
   "text": "Twee: de kwaliteit van de stroom bepaalt de prijs.",
   "chapter": 5
  },
  {
   "start": 228.4,
   "end": 232.72,
   "text": "Amstelveen krijgt geen vergoeding meer voor verpakkingen van te lage kwaliteit.",
   "chapter": 5
  },
  {
   "start": 232.72,
   "end": 234.48,
   "text": "Dat geldt ook op de werkvloer.",
   "chapter": 5
  },
  {
   "start": 234.48,
   "end": 239.84,
   "text": "Bij De Graaf Groep zien wij dat schone, gescheiden stromen meer opbrengen dan gemengd afval.",
   "chapter": 5
  },
  {
   "start": 239.84,
   "end": 245.64,
   "text": "Drie: reken in uw begroting voor tweeduizend zevenentwintig met hogere bijdragen en tarieven.",
   "chapter": 5
  },
  {
   "start": 245.64,
   "end": 249.32,
   "text": "Vraag uw afvalpartner nu om een overzicht van de stromen die duurder worden.",
   "chapter": 5
  },
  {
   "start": 249.77,
   "end": 252.89,
   "text": "Het cijfer van de dag is twintigduizend.",
   "chapter": 6
  },
  {
   "start": 252.89,
   "end": 262.65,
   "text": "Zoveel grijze minicontainers voor plastic, metaal en drankenkartons verdwijnen in Amstelveen bij laagbouwwoningen als de gemeenteraad instemt met het plan.",
   "chapter": 6
  },
  {
   "start": 262.65,
   "end": 264.49,
   "text": "Dat meldt Amstelveenz.",
   "chapter": 6
  },
  {
   "start": 264.49,
   "end": 267.29,
   "text": "Inwoners gooien die verpakkingen dan bij het restafval.",
   "chapter": 6
  },
  {
   "start": 267.74,
   "end": 270.3,
   "text": "Dat was Grondstof voor vandaag.",
   "chapter": 7
  },
  {
   "start": 270.3,
   "end": 274.06,
   "text": "De bronnen bij elk bericht vindt u in de app en in de shownotes.",
   "chapter": 7
  },
  {
   "start": 274.06,
   "end": 280.14,
   "text": "Grondstof wordt gemaakt door De Graaf Groep, Wastenet, Circular and Co en Product for Product.",
   "chapter": 7
  },
  {
   "start": 280.14,
   "end": 282.46,
   "text": "Morgen om negen uur bent u weer bij.",
   "chapter": 7
  },
  {
   "start": 282.46,
   "end": 282.88,
   "text": "Tot dan.",
   "chapter": 7
  }
 ],
