 "transcript": [
  {
   "start": 5.5,
   "end": 6.54,
   "text": "Goedemorgen.",
   "chapter": 0
  },
  {
   "start": 6.54,
   "end": 8.7,
   "text": "Het is dinsdag twintig oktober.",
   "chapter": 0
  },
  {
   "start": 8.7,
   "end": 13.1,
   "text": "U luistert naar Grondstof, het circulaire nieuwsbulletin van De Graaf Groep.",
   "chapter": 0
  },
  {
   "start": 13.1,
   "end": 14.74,
   "text": "Ik ben Frans van den Berge.",
   "chapter": 0
  },
  {
   "start": 14.74,
   "end": 16.22,
   "text": "Dit zijn de koppen.",
   "chapter": 0
  },
  {
   "start": 16.22,
   "end": 20.58,
   "text": "Brussel onderzoekt hoe omzetbelasting hergebruik kan stimuleren.",
   "chapter": 0
  },
  {
   "start": 20.58,
   "end": 25.54,
   "text": "Investeerder E-Q-T neemt het Australische afvalbedrijf Cleanaway over.",
   "chapter": 0
  },
  {
   "start": 25.54,
   "end": 28.21,
   "text": "En statiegeld op pakketten komt in beeld.",
   "chapter": 0
  },
  {
   "start": 30.55,
   "end": 36.23,
   "text": "De Europese Commissie wil weten hoe de omzetbelasting circulaire bedrijfsmodellen kan helpen.",
   "chapter": 1
  },
  {
   "start": 36.23,
   "end": 38.39,
   "text": "Dat meldt vakblad Euwid.",
   "chapter": 1
  },
  {
   "start": 38.39,
   "end": 41.43,
   "text": "De Commissie houdt daarvoor een openbare consultatie.",
   "chapter": 1
  },
  {
   "start": 41.43,
   "end": 43.67,
   "text": "Die loopt tot vier november.",
   "chapter": 1
  },
  {
   "start": 43.67,
   "end": 52.23,
   "text": "Het gaat onder meer om de belasting op tweedehands goederen, om circulaire productieketens en om het vernietigen van goederen die nog bruikbaar zijn.",
   "chapter": 1
  },
  {
   "start": 52.23,
   "end": 56.23,
   "text": "Ook de aftrek van omzetbelasting op bedrijfsauto's komt aan bod.",
   "chapter": 1
  },
  {
   "start": 56.23,
   "end": 63.75,
   "text": "De Commissie wil in het tweede kwartaal van tweeduizend zevenentwintig een voorstel doen om de richtlijn voor omzetbelasting aan te passen.",
   "chapter": 1
  },
  {
   "start": 63.75,
   "end": 67.99,
   "text": "Maatregelen moeten evenredig zijn en bestand tegen fraude.",
   "chapter": 1
  },
  {
   "start": 67.99,
   "end": 73.83,
   "text": "Voor organisaties die refurbished spullen kopen of verkopen, is dit een dossier om te volgen.",
   "chapter": 1
  },
  {
   "start": 73.83,
   "end": 76.89,
   "text": "Belastingregels bepalen vaak of hergebruik loont.",
   "chapter": 1
  },
  {
   "start": 79.22,
   "end": 84.82,
   "text": "De Zweedse investeringsgroep E-Q-T neemt het Australische afvalbedrijf Cleanaway over.",
   "chapter": 2
  },
  {
   "start": 84.82,
   "end": 86.34,
   "text": "Dat meldt Euwid.",
   "chapter": 2
  },
  {
   "start": 86.34,
   "end": 90.9,
   "text": "De partijen sloten een bindende overeenkomst na enkele maanden onderhandelen.",
   "chapter": 2
  },
  {
   "start": 90.9,
   "end": 95.46,
   "text": "De waarde van de overname is negen komma drie miljard Australische dollar.",
   "chapter": 2
  },
  {
   "start": 95.46,
   "end": 99.3,
   "text": "De deal moet nog worden goedgekeurd door de aandeelhouders van Cleanaway.",
   "chapter": 2
  },
  {
   "start": 99.3,
   "end": 102.74,
   "text": "Ook de rechter en toezichthouders moeten nog instemmen.",
   "chapter": 2
  },
  {
   "start": 102.74,
   "end": 106.34,
   "text": "Cleanaway is een van de grote afvalbedrijven in Australië.",
   "chapter": 2
  },
  {
   "start": 106.34,
   "end": 109.78,
   "text": "Over de verdere plannen van de koper is nog weinig bekend.",
   "chapter": 2
  },
  {
   "start": 109.78,
   "end": 116.26,
   "text": "De overname laat zien dat investeerders afvalinzameling en recycling zien als stabiele infrastructuur.",
   "chapter": 2
  },
  {
   "start": 116.26,
   "end": 119.14,
   "text": "Dat past bij een bredere beweging in de sector.",
   "chapter": 2
  },
  {
   "start": 119.14,
   "end": 123.06,
   "text": "Deze maand wisselden ook in Europa bedrijven van eigenaar, zoals Viridor.",
   "chapter": 2
  },
  {
   "start": 125.4,
   "end": 127.72,
   "text": "Komt er statiegeld op pakketten?",
   "chapter": 3
  },
  {
   "start": 127.72,
   "end": 131.64,
   "text": "Die vraag stelt R-T-L Nieuws, zo meldt Afvalgids.",
   "chapter": 3
  },
  {
   "start": 131.64,
   "end": 133.72,
   "text": "Het bericht verscheen maandag.",
   "chapter": 3
  },
  {
   "start": 133.72,
   "end": 138.2,
   "text": "Aanleiding is de groeiende berg papier en karton van online bestellingen.",
   "chapter": 3
  },
  {
   "start": 138.2,
   "end": 141.96,
   "text": "Dat botst met het Europese doel om minder afval te maken.",
   "chapter": 3
  },
  {
   "start": 141.96,
   "end": 146.52,
   "text": "In Nederland bestellen we elk jaar ongeveer zestig pakketjes per huishouden.",
   "chapter": 3
  },
  {
   "start": 146.52,
   "end": 148.6,
   "text": "Er wordt gewerkt aan een oplossing.",
   "chapter": 3
  },
  {
   "start": 148.6,
   "end": 153.08,
   "text": "Herbruikbare dozen met statiegeld worden daarbij genoemd als mogelijkheid.",
   "chapter": 3
  },
  {
   "start": 153.08,
   "end": 155.88,
   "text": "Hoe zo'n systeem moet werken, is nog niet bekend.",
   "chapter": 3
  },
  {
   "start": 155.88,
   "end": 160.92,
   "text": "Het bedrag van de borg, de startdatum en de betrokken partijen staan nog niet vast.",
   "chapter": 3
  },
  {
   "start": 160.92,
   "end": 165.73,
   "text": "Voor webwinkels en vervoerders is het een signaal dat verpakkingen meer aandacht gaan krijgen.",
   "chapter": 3
  },
  {
   "start": 168.07,
   "end": 172.55,
   "text": "Het recyclen van papier en karton in Europa bleef vorig jaar stabiel.",
   "chapter": 4
  },
  {
   "start": 172.55,
   "end": 177.19,
   "text": "Dat meldt de Europese raad voor papierrecycling via Recycling Magazine.",
   "chapter": 4
  },
  {
   "start": 177.19,
   "end": 181.63,
   "text": "Het recyclingpercentage kwam uit op zesenzeventig komma vier procent.",
   "chapter": 4
  },
  {
   "start": 181.63,
   "end": 186.71,
   "text": "In totaal werd drieënvijftig komma negen miljoen ton ingezameld en gerecycled.",
   "chapter": 4
  },
  {
   "start": 186.71,
   "end": 190.15,
   "text": "Dat is nul komma drie procent minder dan een jaar eerder.",
   "chapter": 4
  },
  {
   "start": 190.15,
   "end": 196.47,
   "text": "Het verbruik van papier en karton daalde met nul komma vier procent tot zeventig komma vijf miljoen ton.",
   "chapter": 4
  },
  {
   "start": 196.47,
   "end": 201.75,
   "text": "Voor papieren verpakkingen ligt het Europese gemiddelde op zesentachtig komma zes procent.",
   "chapter": 4
  },
  {
   "start": 201.75,
   "end": 205.11,
   "text": "De raad spreekt van een robuust en volwassen systeem.",
   "chapter": 4
  },
  {
   "start": 205.11,
   "end": 207.35,
   "text": "Het bericht verscheen begin deze maand.",
   "chapter": 4
  },
  {
   "start": 207.35,
   "end": 213.18,
   "text": "Daarmee is het geen nieuws van vandaag, maar wel een betrouwbaar ijkpunt voor de markt van oud papier en karton.",
   "chapter": 4
  },
  {
   "start": 215.52,
   "end": 218.4,
   "text": "En wat betekent dit voor uw organisatie?",
   "chapter": 5
  },
  {
   "start": 218.4,
   "end": 219.92,
   "text": "Drie dingen vallen op.",
   "chapter": 5
  },
  {
   "start": 219.92,
   "end": 227.04,
   "text": "Ten eerste: regels rond belasting en verpakking bepalen vaak of circulair inkopen financieel aantrekkelijk is.",
   "chapter": 5
  },
  {
   "start": 227.04,
   "end": 233.04,
   "text": "Wie gebruikte of herbruikbare producten inkoopt, doet er goed aan mee te denken in consultaties.",
   "chapter": 5
  },
  {
   "start": 233.04,
   "end": 237.2,
   "text": "Ten tweede: online bestellen levert veel verpakkingsafval op.",
   "chapter": 5
  },
  {
   "start": 237.2,
   "end": 242.32,
   "text": "Kijk bij uw eigen bestellingen naar bundelen, minder verpakking en herbruikbare opties.",
   "chapter": 5
  },
  {
   "start": 242.32,
   "end": 250.08,
   "text": "Ten derde: stabiele recyclingcijfers laten zien dat gescheiden inzameling werkt, maar alleen als de kwaliteit goed is.",
   "chapter": 5
  },
  {
   "start": 250.08,
   "end": 253.36,
   "text": "Schone, goed gescheiden stromen leveren meer op.",
   "chapter": 5
  },
  {
   "start": 253.36,
   "end": 256.06,
   "text": "Dat zien wij bij De Graaf Groep in de dagelijkse praktijk.",
   "chapter": 5
  },
  {
   "start": 256.51,
   "end": 259.39,
   "text": "Het cijfer van de dag is zestig.",
   "chapter": 6
  },
  {
   "start": 259.39,
   "end": 265.15,
   "text": "Zoveel pakketjes bestelt een Nederlands huishouden gemiddeld per jaar, volgens R-T-L Nieuws.",
   "chapter": 6
  },
  {
   "start": 265.15,
   "end": 269.57,
   "text": "Dat is elke week meer dan één pakket, en elk pakket heeft een verpakking.",
   "chapter": 6
  },
  {
   "start": 270.02,
   "end": 272.34,
   "text": "Dat was Grondstof voor vandaag.",
   "chapter": 7
  },
  {
   "start": 272.34,
   "end": 275.94,
   "text": "De bronnen bij elk bericht vindt u in de app en in de shownotes.",
   "chapter": 7
  },
  {
   "start": 275.94,
   "end": 278.18,
   "text": "Morgen om negen uur bent u weer bij.",
   "chapter": 7
  },
  {
   "start": 278.18,
   "end": 278.64,
   "text": "Tot dan.",
   "chapter": 7
  }
 ],
