 "transcript": [
  {
   "start": 5.5,
   "end": 6.54,
   "text": "Goedemorgen.",
   "chapter": 0
  },
  {
   "start": 6.54,
   "end": 8.78,
   "text": "Het is donderdag twaalf november.",
   "chapter": 0
  },
  {
   "start": 8.78,
   "end": 13.1,
   "text": "U luistert naar Grondstof, het circulaire nieuwsbulletin van De Graaf Groep.",
   "chapter": 0
  },
  {
   "start": 13.1,
   "end": 14.66,
   "text": "Ik ben Frans van den Berge.",
   "chapter": 0
  },
  {
   "start": 14.66,
   "end": 16.02,
   "text": "Dit zijn de koppen.",
   "chapter": 0
  },
  {
   "start": 16.02,
   "end": 21.18,
   "text": "Duitsland ziet af van een belasting op plastic verpakkingen in tweeduizend zevenentwintig.",
   "chapter": 0
  },
  {
   "start": 21.18,
   "end": 26.18,
   "text": "Afvalbedrijf Prezero onderzoekt de verkoop van zijn hele Nederlandse tak.",
   "chapter": 0
  },
  {
   "start": 26.18,
   "end": 31.34,
   "text": "En de digitale plicht voor grensoverschrijdend afvaltransport wordt opnieuw uitgesteld.",
   "chapter": 0
  },
  {
   "start": 33.68,
   "end": 37.92,
   "text": "Duitsland voert volgend jaar geen belasting op plastic verpakkingen in.",
   "chapter": 1
  },
  {
   "start": 37.92,
   "end": 44.72,
   "text": "Daarover werden de regeringspartijen C-D-U, C-S-U en S-P-D het woensdagavond eens.",
   "chapter": 1
  },
  {
   "start": 44.72,
   "end": 48.72,
   "text": "Dat meldt het vakblad Euwid op basis van het Duitse persbureau.",
   "chapter": 1
  },
  {
   "start": 48.72,
   "end": 52.64,
   "text": "De belasting zou vanaf één juli tweeduizend zevenentwintig gelden.",
   "chapter": 1
  },
  {
   "start": 52.64,
   "end": 57.12,
   "text": "Het tarief was vijfhonderdvijftig euro per ton plastic in verpakkingen.",
   "chapter": 1
  },
  {
   "start": 57.12,
   "end": 62.8,
   "text": "Ook folies en samengestelde verpakkingen met meer dan vijf procent plastic vielen eronder.",
   "chapter": 1
  },
  {
   "start": 62.8,
   "end": 68.92,
   "text": "Minister van Financiën Lars Klingbeil rekende op achthonderdvijf miljoen euro in het eerste jaar.",
   "chapter": 1
  },
  {
   "start": 68.92,
   "end": 73.76,
   "text": "Tweeënveertig brancheorganisaties waarschuwden eerder voor concurrentienadeel.",
   "chapter": 1
  },
  {
   "start": 73.76,
   "end": 77.52,
   "text": "Of de belasting definitief van tafel is, is nog onduidelijk.",
   "chapter": 1
  },
  {
   "start": 77.52,
   "end": 83.85,
   "text": "Christendemocraat Florian Bilic stelt in plaats daarvan een bonus voor het gebruik van gerecycled plastic voor.",
   "chapter": 1
  },
  {
   "start": 86.18,
   "end": 92.34,
   "text": "Afval- en recyclingbedrijf Prezero onderzoekt de verkoop van zijn volledige Nederlandse bedrijf.",
   "chapter": 2
  },
  {
   "start": 92.34,
   "end": 96.18,
   "text": "Dat bevestigde een woordvoerder tegenover het vakblad Euwid.",
   "chapter": 2
  },
  {
   "start": 96.18,
   "end": 98.98,
   "text": "Prezero hoort bij de Duitse Schwarz Groep.",
   "chapter": 2
  },
  {
   "start": 98.98,
   "end": 103.54,
   "text": "Het bedrijf polst de markt, maar een besluit over verkoop is nog niet genomen.",
   "chapter": 2
  },
  {
   "start": 103.54,
   "end": 111.22,
   "text": "Het onderzoek omvat onder meer de afvalenergiecentrale in Roosendaal en de sorteerinstallatie voor verpakkingsafval in Zwolle.",
   "chapter": 2
  },
  {
   "start": 111.22,
   "end": 116.74,
   "text": "Die kan tot vijfentachtigduizend ton verpakkingsafval van huishoudens per jaar sorteren.",
   "chapter": 2
  },
  {
   "start": 116.74,
   "end": 124.18,
   "text": "Prezero werd in Nederland groot door de overname van de afval- en recyclingactiviteiten van Suez in tweeduizend eenentwintig.",
   "chapter": 2
  },
  {
   "start": 124.18,
   "end": 129.07,
   "text": "Voor gemeenten en bedrijven met een contract bij Prezero is het zaak deze ontwikkeling te volgen.",
   "chapter": 2
  },
  {
   "start": 131.41,
   "end": 137.01,
   "text": "De digitale plicht voor een veelgebruikt afvaltransportformulier wordt opnieuw uitgesteld.",
   "chapter": 3
  },
  {
   "start": 137.01,
   "end": 141.33,
   "text": "Het gaat om het formulier uit bijlage zeven van de Europese verordening.",
   "chapter": 3
  },
  {
   "start": 141.33,
   "end": 146.69,
   "text": "Dat is nodig voor grensoverschrijdend transport van zogeheten groen gelijst afval.",
   "chapter": 3
  },
  {
   "start": 146.69,
   "end": 152.85,
   "text": "Dat meldt Euwid op basis van de Portugese milieuautoriteit, die zich beroept op de Europese Commissie.",
   "chapter": 3
  },
  {
   "start": 152.85,
   "end": 156.93,
   "text": "De reden is dat het digitale systeem Diwass instabiel is.",
   "chapter": 3
  },
  {
   "start": 156.93,
   "end": 159.89,
   "text": "Eind dit jaar zou het papieren formulier verdwijnen.",
   "chapter": 3
  },
  {
   "start": 159.89,
   "end": 164.61,
   "text": "Op vijfentwintig november bespreken de Commissie en de lidstaten nieuwe termijnen.",
   "chapter": 3
  },
  {
   "start": 164.61,
   "end": 170.45,
   "text": "Koepel Recycling Europe vraagt uitstel tot minstens dertig juni tweeduizend zevenentwintig.",
   "chapter": 3
  },
  {
   "start": 170.45,
   "end": 174.37,
   "text": "Ook Duitse brancheorganisaties klaagden woensdag in de Bondsdag.",
   "chapter": 3
  },
  {
   "start": 174.37,
   "end": 180.29,
   "text": "Zij noemen problemen met toegangsrechten, koppelingen met eigen systemen en gebrekkige ondersteuning.",
   "chapter": 3
  },
  {
   "start": 180.29,
   "end": 183.26,
   "text": "Zij willen zes tot twaalf maanden extra tijd.",
   "chapter": 3
  },
  {
   "start": 185.6,
   "end": 191.92,
   "text": "In Zwolle stijgt de vaste afvalstoffenheffing volgend jaar waarschijnlijk met eenentwintig komma zes procent.",
   "chapter": 4
  },
  {
   "start": 191.92,
   "end": 195.76,
   "text": "Dat stelt het college voor, meldt R-T-V Focus Zwolle.",
   "chapter": 4
  },
  {
   "start": 195.76,
   "end": 200.48,
   "text": "Een eenpersoonshuishouden betaalt dan ruim zevenenveertig euro per jaar meer.",
   "chapter": 4
  },
  {
   "start": 200.48,
   "end": 204.08,
   "text": "Een gezin betaalt bijna negenenvijftig euro extra.",
   "chapter": 4
  },
  {
   "start": 204.08,
   "end": 206.88,
   "text": "Ook restafval weggooien wordt duurder.",
   "chapter": 4
  },
  {
   "start": 206.88,
   "end": 211.44,
   "text": "Wethouder Paul Guldemond noemde in het begrotingsdebat meerdere oorzaken.",
   "chapter": 4
  },
  {
   "start": 211.44,
   "end": 217.76,
   "text": "Hij wijst op hogere energie- en personeelskosten en op tegenvallende opbrengsten uit grondstoffen.",
   "chapter": 4
  },
  {
   "start": 217.76,
   "end": 221.52,
   "text": "Ook verandert de kostenverdeling binnen afvalbedrijf Rova.",
   "chapter": 4
  },
  {
   "start": 221.52,
   "end": 227.84,
   "text": "Volgens de wethouder betaalden andere Rova-gemeenten jarenlang een te groot deel van de gezamenlijke kosten.",
   "chapter": 4
  },
  {
   "start": 227.84,
   "end": 230.64,
   "text": "Die scheve verdeling wordt nu rechtgezet.",
   "chapter": 4
  },
  {
   "start": 230.64,
   "end": 233.6,
   "text": "De gemeenteraad beslist morgen over de begroting.",
   "chapter": 4
  },
  {
   "start": 233.6,
   "end": 238.42,
   "text": "Het laat zien hoe lagere grondstofopbrengsten uiteindelijk bij de inwoners terechtkomen.",
   "chapter": 4
  },
  {
   "start": 240.75,
   "end": 243.79,
   "text": "En wat betekent dit voor uw organisatie?",
   "chapter": 5
  },
  {
   "start": 243.79,
   "end": 249.23,
   "text": "Het nieuws van vandaag laat zien dat de spelregels voor afval en verpakkingen in beweging blijven.",
   "chapter": 5
  },
  {
   "start": 249.23,
   "end": 256.19,
   "text": "Een aangekondigde belasting verdwijnt, een digitale plicht schuift op en een grote verwerker staat mogelijk te koop.",
   "chapter": 5
  },
  {
   "start": 256.19,
   "end": 258.67,
   "text": "Plan daarom niet op één scenario.",
   "chapter": 5
  },
  {
   "start": 258.67,
   "end": 263.47,
   "text": "Weet welke afvalstromen de grens over gaan en wie daarvoor de papieren regelt.",
   "chapter": 5
  },
  {
   "start": 263.47,
   "end": 268.59,
   "text": "Kijk ook naar de looptijd van uw verwerkingscontracten en wat er gebeurt bij een nieuwe eigenaar.",
   "chapter": 5
  },
  {
   "start": 268.59,
   "end": 273.39,
   "text": "En wacht niet op een belasting om gerecycled materiaal in uw verpakkingen te overwegen.",
   "chapter": 5
  },
  {
   "start": 273.39,
   "end": 279.89,
   "text": "Bij De Graaf Groep zien we dat organisaties met goed inzicht in hun afvalstromen beter bestand zijn tegen zulke wisselingen.",
   "chapter": 5
  },
  {
   "start": 280.34,
   "end": 283.7,
   "text": "Het cijfer van de dag is vijfhonderdvijftig.",
   "chapter": 6
  },
  {
   "start": 283.7,
   "end": 290.18,
   "text": "Zoveel euro per ton plastic in verpakkingen wilde Duitsland vanaf juli tweeduizend zevenentwintig heffen.",
   "chapter": 6
  },
  {
   "start": 290.18,
   "end": 292.74,
   "text": "Die belasting gaat voorlopig niet door.",
   "chapter": 6
  },
  {
   "start": 292.74,
   "end": 298.04,
   "text": "De Duitse schatkist loopt daardoor in het eerste jaar ongeveer achthonderdvijf miljoen euro mis.",
   "chapter": 6
  },
  {
   "start": 298.49,
   "end": 300.65,
   "text": "Dat was Grondstof voor vandaag.",
   "chapter": 7
  },
  {
   "start": 300.65,
   "end": 304.33,
   "text": "De bronnen bij elk bericht vindt u in de app en in de shownotes.",
   "chapter": 7
  },
  {
   "start": 304.33,
   "end": 306.65,
   "text": "Morgen om negen uur bent u weer bij.",
   "chapter": 7
  },
  {
   "start": 306.65,
   "end": 307.1,
   "text": "Tot dan.",
   "chapter": 7
  }
 ],
