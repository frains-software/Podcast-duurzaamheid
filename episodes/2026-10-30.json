 "transcript": [
  {
   "start": 5.5,
   "end": 6.54,
   "text": "Goedemorgen.",
   "chapter": 0
  },
  {
   "start": 6.54,
   "end": 8.62,
   "text": "Het is vrijdag dertig oktober.",
   "chapter": 0
  },
  {
   "start": 8.62,
   "end": 13.1,
   "text": "U luistert naar Grondstof, het circulaire nieuwsbulletin van De Graaf Groep.",
   "chapter": 0
  },
  {
   "start": 13.1,
   "end": 14.66,
   "text": "Ik ben Frans van den Berge.",
   "chapter": 0
  },
  {
   "start": 14.66,
   "end": 16.1,
   "text": "Dit zijn de koppen.",
   "chapter": 0
  },
  {
   "start": 16.1,
   "end": 20.46,
   "text": "De Tweede Kamer debatteert over hogere heffingen op afvalverwerking.",
   "chapter": 0
  },
  {
   "start": 20.46,
   "end": 23.38,
   "text": "Brussel stelt de nieuwe verpakkingslabels uit.",
   "chapter": 0
  },
  {
   "start": 23.38,
   "end": 26.69,
   "text": "En Danone past zijn claims over gerecycled plastic aan.",
   "chapter": 0
  },
  {
   "start": 29.03,
   "end": 34.11,
   "text": "De Tweede Kamer debatteert verder over het Belastingplan tweeduizend zevenentwintig.",
   "chapter": 1
  },
  {
   "start": 34.11,
   "end": 37.31,
   "text": "Dat gebeurde op maandag zesentwintig oktober.",
   "chapter": 1
  },
  {
   "start": 37.31,
   "end": 46.19,
   "text": "Meerdere fracties uitten in de eerste termijn zorgen over de hogere CO-twee-heffing op afvalverwerking, meldt de Vereniging Afvalbedrijven.",
   "chapter": 1
  },
  {
   "start": 46.19,
   "end": 52.59,
   "text": "De vereniging waarschuwt dat afvalstromen, banen en investeringen naar het buitenland kunnen verdwijnen.",
   "chapter": 1
  },
  {
   "start": 52.59,
   "end": 57.71,
   "text": "Ook staan investeringen in CO-twee-afvang onder druk, en het project Aramis.",
   "chapter": 1
  },
  {
   "start": 57.71,
   "end": 62.99,
   "text": "Dat is de geplande opslag van CO-twee in lege gasvelden onder de Noordzee.",
   "chapter": 1
  },
  {
   "start": 62.99,
   "end": 70.51,
   "text": "De vereniging vraagt de Kamer de nationale CO-twee-heffing voor afvalverwerking tot tweeduizend eenendertig op nul te zetten.",
   "chapter": 1
  },
  {
   "start": 70.51,
   "end": 75.61,
   "text": "Het doet ertoe, omdat duurdere verwerking uiteindelijk doorwerkt in de tarieven voor bedrijfsafval.",
   "chapter": 1
  },
  {
   "start": 77.94,
   "end": 85.28,
   "text": "De Europese Commissie stelt de nieuwe, uniforme verpakkingslabels uit tot het tweede kwartaal van tweeduizend zevenentwintig.",
   "chapter": 2
  },
  {
   "start": 85.28,
   "end": 89.12,
   "text": "Dat meldt vakblad Packaging Insights op zesentwintig oktober.",
   "chapter": 2
  },
  {
   "start": 89.12,
   "end": 92.8,
   "text": "Het gaat om vaste pictogrammen op verpakkingen en afvalbakken.",
   "chapter": 2
  },
  {
   "start": 92.8,
   "end": 100.08,
   "text": "Ze moeten consumenten helpen afval te scheiden en herbruikbare verpakkingen te herkennen, of verpakkingen met statiegeld.",
   "chapter": 2
  },
  {
   "start": 100.08,
   "end": 104.0,
   "text": "Ook tonen ze het aandeel gerecycled en biobased materiaal.",
   "chapter": 2
  },
  {
   "start": 104.0,
   "end": 109.28,
   "text": "Voor de vaststelling komt een openbare raadpleging, maar details daarover zijn nog niet bekend.",
   "chapter": 2
  },
  {
   "start": 109.28,
   "end": 119.68,
   "text": "De Britse organisatie On Pack Recycling Label noemt de termijn van twee jaar om etiketten aan te passen zeer uitdagend, vooral voor producenten met een breed assortiment.",
   "chapter": 2
  },
  {
   "start": 119.68,
   "end": 124.6,
   "text": "Het doet ertoe, omdat producenten nog niet precies weten welke labels straks verplicht zijn.",
   "chapter": 2
  },
  {
   "start": 126.94,
   "end": 131.42,
   "text": "Danone gaat zijn claims over gerecycled plastic in flessen aanpassen.",
   "chapter": 3
  },
  {
   "start": 131.42,
   "end": 137.5,
   "text": "De Europese Commissie maakte de toezeggingen op tweeëntwintig oktober bekend, meldt het vakblad Euwid.",
   "chapter": 3
  },
  {
   "start": 137.5,
   "end": 147.18,
   "text": "Een claim van honderd procent gerecycled materiaal mag alleen nog over de fles zelf gaan, niet over dop of etiket, tenzij ook die onderbouwd zijn.",
   "chapter": 3
  },
  {
   "start": 147.18,
   "end": 153.98,
   "text": "Nieuw plastic of productieafval daarvan telt niet mee, tenzij het een erkend recyclingproces heeft doorlopen.",
   "chapter": 3
  },
  {
   "start": 153.98,
   "end": 160.06,
   "text": "Etiketten moeten binnen achttien maanden veranderen, digitale communicatie binnen drie maanden.",
   "chapter": 3
  },
  {
   "start": 160.06,
   "end": 169.9,
   "text": "Eerder deden Coca-Cola en Nestlé Waters vergelijkbare toezeggingen, na een klacht van de Europese consumentenorganisatie van november tweeduizend drieëntwintig.",
   "chapter": 3
  },
  {
   "start": 169.9,
   "end": 175.68,
   "text": "Het doet ertoe, omdat wie over gerecycled materiaal communiceert, dat steeds beter moet kunnen onderbouwen.",
   "chapter": 3
  },
  {
   "start": 178.01,
   "end": 181.53,
   "text": "Gemeenten bereiden zich voor op hogere afvalkosten.",
   "chapter": 4
  },
  {
   "start": 181.53,
   "end": 190.65,
   "text": "Katwijk wil de vaste afvalstoffenheffing in tweeduizend zevenentwintig met zeven komma drie procent verhogen, meldt Afvalgids op negenentwintig oktober.",
   "chapter": 4
  },
  {
   "start": 190.65,
   "end": 199.97,
   "text": "Eenpersoonshuishoudens betalen dan tweehonderdachtenveertig euro vijfenzeventig, meerpersoonshuishoudens driehonderdeenentachtig euro negenentachtig.",
   "chapter": 4
  },
  {
   "start": 199.97,
   "end": 202.81,
   "text": "De gemeenteraad moet de begroting nog behandelen.",
   "chapter": 4
  },
  {
   "start": 202.81,
   "end": 208.69,
   "text": "Almere werkt aan een grondstoffenvisie voor tweeduizend zevenentwintig tot tweeduizend vijfendertig.",
   "chapter": 4
  },
  {
   "start": 208.69,
   "end": 212.09,
   "text": "De stad recyclet nu vierenveertig procent van het afval.",
   "chapter": 4
  },
  {
   "start": 212.09,
   "end": 215.29,
   "text": "Het doel is zestig procent in tweeduizend dertig.",
   "chapter": 4
  },
  {
   "start": 215.29,
   "end": 221.69,
   "text": "Almere verwacht dat verwerken duurder wordt, mede door nationale maatregelen zoals de CO-twee-heffing.",
   "chapter": 4
  },
  {
   "start": 221.69,
   "end": 226.25,
   "text": "Het doet ertoe, omdat deze kosten uiteindelijk bij inwoners en bedrijven terechtkomen.",
   "chapter": 4
  },
  {
   "start": 228.59,
   "end": 231.63,
   "text": "En wat betekent dit voor uw organisatie?",
   "chapter": 5
  },
  {
   "start": 231.63,
   "end": 233.15,
   "text": "Drie dingen vallen op.",
   "chapter": 5
  },
  {
   "start": 233.15,
   "end": 238.35,
   "text": "Ten eerste wordt afval verwerken duurder, door heffingen van het Rijk en van gemeenten.",
   "chapter": 5
  },
  {
   "start": 238.35,
   "end": 244.11,
   "text": "Dat maakt een goede scheiding aan de bron financieel aantrekkelijker, want restafval is de duurste stroom.",
   "chapter": 5
  },
  {
   "start": 244.11,
   "end": 248.43,
   "text": "Ten tweede kijken toezichthouders kritischer naar claims over recycling.",
   "chapter": 5
  },
  {
   "start": 248.43,
   "end": 253.31,
   "text": "Vraag uw leveranciers daarom waarop hun uitspraken over gerecycled materiaal rusten.",
   "chapter": 5
  },
  {
   "start": 253.31,
   "end": 256.91,
   "text": "Ten derde blijven de labelregels nog even onduidelijk.",
   "chapter": 5
  },
  {
   "start": 256.91,
   "end": 263.47,
   "text": "Houd uw gegevens over verpakkingen goed op orde, zodat u snel kunt schakelen als de definitieve pictogrammen er zijn.",
   "chapter": 5
  },
  {
   "start": 263.47,
   "end": 266.86,
   "text": "Bij De Graaf Groep begint dat met inzicht in uw afvalstromen.",
   "chapter": 5
  },
  {
   "start": 267.31,
   "end": 270.75,
   "text": "Het cijfer van de dag is vierenveertig procent.",
   "chapter": 6
  },
  {
   "start": 270.75,
   "end": 274.11,
   "text": "Zoveel van het afval recyclet Almere op dit moment.",
   "chapter": 6
  },
  {
   "start": 274.11,
   "end": 278.43,
   "text": "Dat meldt de gemeente in haar startnotitie voor een nieuwe grondstoffenvisie.",
   "chapter": 6
  },
  {
   "start": 278.43,
   "end": 284.34,
   "text": "Het doel is zestig procent in tweeduizend dertig en vijfenzestig procent in tweeduizend vijfendertig.",
   "chapter": 6
  },
  {
   "start": 284.79,
   "end": 287.11,
   "text": "Dat was Grondstof voor vandaag.",
   "chapter": 7
  },
  {
   "start": 287.11,
   "end": 290.87,
   "text": "De bronnen bij elk bericht vindt u in de app en in de shownotes.",
   "chapter": 7
  },
  {
   "start": 290.87,
   "end": 293.11,
   "text": "Morgen om negen uur bent u weer bij.",
   "chapter": 7
  },
  {
   "start": 293.11,
   "end": 293.56,
   "text": "Tot dan.",
   "chapter": 7
  }
 ],
