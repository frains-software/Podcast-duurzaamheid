 "transcript": [
  {
   "start": 5.5,
   "end": 6.54,
   "text": "Goedemorgen.",
   "chapter": 0
  },
  {
   "start": 6.54,
   "end": 8.7,
   "text": "Het is vrijdag zes november.",
   "chapter": 0
  },
  {
   "start": 8.7,
   "end": 13.1,
   "text": "U luistert naar Grondstof, het circulaire nieuwsbulletin van De Graaf Groep.",
   "chapter": 0
  },
  {
   "start": 13.1,
   "end": 14.58,
   "text": "Ik ben Frans van den Berge.",
   "chapter": 0
  },
  {
   "start": 14.58,
   "end": 15.9,
   "text": "Dit zijn de koppen.",
   "chapter": 0
  },
  {
   "start": 15.9,
   "end": 20.62,
   "text": "Het kabinet wil de uitzonderingen op gescheiden gft-inzameling schrappen.",
   "chapter": 0
  },
  {
   "start": 20.62,
   "end": 25.26,
   "text": "Investeerder Waterland neemt een belang in afvalbedrijf Milieu Service Groep.",
   "chapter": 0
  },
  {
   "start": 25.26,
   "end": 30.09,
   "text": "En accubranden kosten de Europese afvalsector miljarden euro per jaar.",
   "chapter": 0
  },
  {
   "start": 32.43,
   "end": 36.75,
   "text": "Het kabinet wil dat alle gemeenten gft gescheiden inzamelen.",
   "chapter": 1
  },
  {
   "start": 36.75,
   "end": 42.91,
   "text": "Dat blijkt uit een Kamerbrief van dinsdag drie november, meldt de vereniging van gemeentelijke afvalbedrijven.",
   "chapter": 1
  },
  {
   "start": 42.91,
   "end": 50.11,
   "text": "Nu mogen gemeenten bioafval nog samen met ander afval inzamelen als scheiden technisch onmogelijk of erg duur is.",
   "chapter": 1
  },
  {
   "start": 50.11,
   "end": 52.91,
   "text": "Die uitzonderingsgronden wil het kabinet schrappen.",
   "chapter": 1
  },
  {
   "start": 52.91,
   "end": 55.95,
   "text": "Het voorstel gaat komend voorjaar in consultatie.",
   "chapter": 1
  },
  {
   "start": 55.95,
   "end": 64.67,
   "text": "Verder onderzoekt het kabinet prijsprikkels voor restafval, verplichte afvalscheiding op scholen en een consistenter scheidingsbeleid voor bedrijven.",
   "chapter": 1
  },
  {
   "start": 64.67,
   "end": 67.79,
   "text": "Daarvoor wordt eind dit jaar een evaluatie verwacht.",
   "chapter": 1
  },
  {
   "start": 67.79,
   "end": 73.63,
   "text": "In tweeduizend vierentwintig werd drieënvijftig komma vijf procent van het stedelijk afval gerecycled.",
   "chapter": 1
  },
  {
   "start": 73.63,
   "end": 80.75,
   "text": "Zonder extra maatregelen haalt Nederland de Europese doelen voor tweeduizend dertig en tweeduizend vijfendertig waarschijnlijk niet.",
   "chapter": 1
  },
  {
   "start": 80.75,
   "end": 83.79,
   "text": "De vereniging wil financiële steun voor gemeenten.",
   "chapter": 1
  },
  {
   "start": 83.79,
   "end": 88.21,
   "text": "Het doet ertoe, omdat ook uw bedrijfsafval onder strenger scheidingsbeleid kan vallen.",
   "chapter": 1
  },
  {
   "start": 90.54,
   "end": 97.79,
   "text": "Participatiemaatschappij Waterland neemt een belang van vijftig procent in het Nederlandse afvalbedrijf Milieu Service Groep.",
   "chapter": 2
  },
  {
   "start": 97.79,
   "end": 99.87,
   "text": "Dat meldt vakblad Euwid.",
   "chapter": 2
  },
  {
   "start": 99.87,
   "end": 103.39,
   "text": "De overname werd op negenentwintig oktober aangekondigd.",
   "chapter": 2
  },
  {
   "start": 103.39,
   "end": 106.51,
   "text": "Het bedrijf is actief in Nederland en Duitsland.",
   "chapter": 2
  },
  {
   "start": 106.51,
   "end": 109.71,
   "text": "De bestaande aandeelhouders houden de andere helft.",
   "chapter": 2
  },
  {
   "start": 109.71,
   "end": 114.19,
   "text": "Volgens het bericht moet de investering de verdere groei van het bedrijf ondersteunen.",
   "chapter": 2
  },
  {
   "start": 114.19,
   "end": 118.11,
   "text": "De deal heeft nog goedkeuring nodig van de mededingingsautoriteiten.",
   "chapter": 2
  },
  {
   "start": 118.11,
   "end": 121.47,
   "text": "Over de financiële voorwaarden is niets bekendgemaakt.",
   "chapter": 2
  },
  {
   "start": 121.47,
   "end": 126.83,
   "text": "Het doet ertoe, omdat investeerders de afvalsector blijven zien als een markt die groeit.",
   "chapter": 2
  },
  {
   "start": 126.83,
   "end": 130.55,
   "text": "Dat kan de verhoudingen tussen afvalbedrijven op de Nederlandse markt veranderen.",
   "chapter": 2
  },
  {
   "start": 132.89,
   "end": 138.08,
   "text": "Recycler Morssinkhof-Rymoplast heeft in het Belgische Lommel een nieuwe fabriek geopend.",
   "chapter": 3
  },
  {
   "start": 138.08,
   "end": 139.6,
   "text": "Dat meldt Euwid.",
   "chapter": 3
  },
  {
   "start": 139.6,
   "end": 144.96,
   "text": "De fabriek verwerkt verpakkingsafval van polypropyleen en hoge-dichtheidspolyetheen.",
   "chapter": 3
  },
  {
   "start": 144.96,
   "end": 148.48,
   "text": "De capaciteit is maximaal veertigduizend ton per jaar.",
   "chapter": 3
  },
  {
   "start": 148.48,
   "end": 157.04,
   "text": "Het bedrijf investeerde dertig miljoen euro, samen met Fost Plus, de Belgische organisatie voor producentenverantwoordelijkheid voor verpakkingen.",
   "chapter": 3
  },
  {
   "start": 157.04,
   "end": 160.8,
   "text": "Toch kan de fabriek nog niet economisch op volle capaciteit draaien.",
   "chapter": 3
  },
  {
   "start": 160.8,
   "end": 164.0,
   "text": "De vraag naar gerecycleerd plastic blijft te laag.",
   "chapter": 3
  },
  {
   "start": 164.0,
   "end": 167.84,
   "text": "Commercieel directeur Matthijs Veerman zegt dat de vraag achterblijft.",
   "chapter": 3
  },
  {
   "start": 167.84,
   "end": 175.52,
   "text": "Hij vraagt om sterkere prikkels voor gerecycled plastic en gelijke concurrentie met geïmporteerd nieuw en gerecycled plastic.",
   "chapter": 3
  },
  {
   "start": 175.52,
   "end": 180.71,
   "text": "Het doet ertoe, omdat investeren in recyclingcapaciteit niet genoeg is zonder afnemers.",
   "chapter": 3
  },
  {
   "start": 183.04,
   "end": 188.0,
   "text": "Brand door accu's kost de Europese afvalsector jaarlijks miljarden euro.",
   "chapter": 4
  },
  {
   "start": 188.0,
   "end": 193.44,
   "text": "Dat blijkt uit cijfers van de Europese branchevereniging van afvalbedrijven, meldt Euwid.",
   "chapter": 4
  },
  {
   "start": 193.44,
   "end": 199.52,
   "text": "In tweeduizend vijfentwintig ging het in de Europese Unie om ongeveer tienduizend negenhonderd branden.",
   "chapter": 4
  },
  {
   "start": 199.52,
   "end": 203.84,
   "text": "De schade bedroeg ongeveer twee komma zes zes miljard euro.",
   "chapter": 4
  },
  {
   "start": 203.84,
   "end": 209.84,
   "text": "Afvalbedrijven gaven daarnaast ongeveer zevenhonderddertig miljoen euro uit aan brandpreventie.",
   "chapter": 4
  },
  {
   "start": 209.84,
   "end": 215.28,
   "text": "De vereniging vraagt om een door producenten gefinancierd fonds voor preventie en herstel.",
   "chapter": 4
  },
  {
   "start": 215.28,
   "end": 221.2,
   "text": "Ook wil de vereniging statiegeld op batterijen en een verbod op wegwerpproducten met een accu.",
   "chapter": 4
  },
  {
   "start": 221.2,
   "end": 230.1,
   "text": "Het doet ertoe, omdat elektronica en vapes die in het restafval belanden, een brandrisico vormen voor inzamelaars en verwerkers, en dus voor de kosten.",
   "chapter": 4
  },
  {
   "start": 232.44,
   "end": 235.4,
   "text": "En wat betekent dit voor uw organisatie?",
   "chapter": 5
  },
  {
   "start": 235.4,
   "end": 239.64,
   "text": "Strengere regels voor gft komen eraan, ook al duurt het nog even.",
   "chapter": 5
  },
  {
   "start": 239.64,
   "end": 244.2,
   "text": "Kijk nu al hoe uw bedrijf bioafval scheidt, bijvoorbeeld in de kantine.",
   "chapter": 5
  },
  {
   "start": 244.2,
   "end": 248.92,
   "text": "Bij De Graaf Groep zien we dat een schone stroom meer waard is dan een vervuilde stroom.",
   "chapter": 5
  },
  {
   "start": 248.92,
   "end": 254.2,
   "text": "Het nieuws uit Lommel laat zien dat recycling pas rendeert als iemand het materiaal afneemt.",
   "chapter": 5
  },
  {
   "start": 254.2,
   "end": 257.56,
   "text": "Vraag uw leveranciers dus naar gerecycleerde inhoud.",
   "chapter": 5
  },
  {
   "start": 257.56,
   "end": 263.4,
   "text": "En voorkom branden: zorg dat batterijen en elektronica nooit in het restafval terechtkomen.",
   "chapter": 5
  },
  {
   "start": 263.4,
   "end": 266.98,
   "text": "Zet een aparte inzamelbak neer en leg aan medewerkers uit waarom.",
   "chapter": 5
  },
  {
   "start": 267.43,
   "end": 271.07,
   "text": "Het cijfer van de dag is tienduizend negenhonderd.",
   "chapter": 6
  },
  {
   "start": 271.07,
   "end": 276.15,
   "text": "Zoveel accubranden telde de Europese afvalsector in tweeduizend vijfentwintig.",
   "chapter": 6
  },
  {
   "start": 276.15,
   "end": 278.67,
   "text": "Dat is gemiddeld bijna dertig branden per dag.",
   "chapter": 6
  },
  {
   "start": 279.12,
   "end": 281.44,
   "text": "Dat was Grondstof voor vandaag.",
   "chapter": 7
  },
  {
   "start": 281.44,
   "end": 285.2,
   "text": "De bronnen bij elk bericht vindt u in de app en in de shownotes.",
   "chapter": 7
  },
  {
   "start": 285.2,
   "end": 287.44,
   "text": "Morgen om negen uur bent u weer bij.",
   "chapter": 7
  },
  {
   "start": 287.44,
   "end": 287.89,
   "text": "Tot dan.",
   "chapter": 7
  }
 ],
