 "transcript": [
  {
   "start": 5.5,
   "end": 6.54,
   "text": "Goedemorgen.",
   "chapter": 0
  },
  {
   "start": 6.54,
   "end": 8.94,
   "text": "Het is zaterdag zeventien oktober.",
   "chapter": 0
  },
  {
   "start": 8.94,
   "end": 13.22,
   "text": "U luistert naar Grondstof, het circulaire nieuwsbulletin van De Graaf Groep.",
   "chapter": 0
  },
  {
   "start": 13.22,
   "end": 14.78,
   "text": "Ik ben Frans van den Berge.",
   "chapter": 0
  },
  {
   "start": 14.78,
   "end": 15.98,
   "text": "Dit zijn de koppen.",
   "chapter": 0
  },
  {
   "start": 15.98,
   "end": 21.98,
   "text": "Inspecteurs controleren driehonderd organisaties op de regels voor elektronisch afval en textiel.",
   "chapter": 0
  },
  {
   "start": 21.98,
   "end": 27.1,
   "text": "Een recycler pleit voor strengere Europese regels voor de export van metaalschroot.",
   "chapter": 0
  },
  {
   "start": 27.1,
   "end": 30.16,
   "text": "En de recycling van matrassen komt dicht bij het doel.",
   "chapter": 0
  },
  {
   "start": 32.5,
   "end": 38.18,
   "text": "Inspecteurs gaan driehonderd organisaties controleren op regels voor de circulaire economie.",
   "chapter": 1
  },
  {
   "start": 38.18,
   "end": 40.5,
   "text": "Dat meldt Recycling Magazine.",
   "chapter": 1
  },
  {
   "start": 40.5,
   "end": 46.74,
   "text": "De Inspectie Leefomgeving en Transport doet dat samen met de omgevingsdiensten tijdens een inspectieweek.",
   "chapter": 1
  },
  {
   "start": 46.74,
   "end": 55.14,
   "text": "Het gaat om de afgifteplicht voor elektrische en elektronische apparatuur en om het verbod op het vernietigen van nieuwe kleding en schoenen.",
   "chapter": 1
  },
  {
   "start": 55.14,
   "end": 59.58,
   "text": "De afgifteplicht geldt vanaf één januari tweeduizend zevenentwintig.",
   "chapter": 1
  },
  {
   "start": 59.58,
   "end": 65.94,
   "text": "Wie apparatuur afdankt, moet die dan aanbieden aan een erkende inzamelaar of gecertificeerde verwerker.",
   "chapter": 1
  },
  {
   "start": 65.94,
   "end": 70.26,
   "text": "Het vernietigingsverbod geldt sinds juli van dit jaar voor grote bedrijven.",
   "chapter": 1
  },
  {
   "start": 70.26,
   "end": 74.54,
   "text": "Middelgrote bedrijven volgen op negentien juli tweeduizend dertig.",
   "chapter": 1
  },
  {
   "start": 74.54,
   "end": 79.7,
   "text": "De inspectie wil bedrijven vooral informeren en beter zicht krijgen op ketens.",
   "chapter": 1
  },
  {
   "start": 79.7,
   "end": 83.56,
   "text": "Het bericht verscheen begin oktober, maar de regels komen snel dichterbij.",
   "chapter": 1
  },
  {
   "start": 85.89,
   "end": 91.81,
   "text": "Een Nederlandse recycler pleit voor strengere Europese regels voor de export van metaalschroot.",
   "chapter": 2
  },
  {
   "start": 91.81,
   "end": 94.13,
   "text": "Dat meldt Recycling Magazine.",
   "chapter": 2
  },
  {
   "start": 94.13,
   "end": 103.33,
   "text": "Martijn van de Poll, directeur van Myne Circular Metals, reageert op brancheorganisaties die vrezen voor minder toegang tot internationale markten.",
   "chapter": 2
  },
  {
   "start": 103.33,
   "end": 109.57,
   "text": "De herziene Europese verordening voor afvalverscheping is in tweeduizend vierentwintig in werking getreden.",
   "chapter": 2
  },
  {
   "start": 109.57,
   "end": 113.61,
   "text": "De bepalingen gelden vanaf mei tweeduizend zevenentwintig.",
   "chapter": 2
  },
  {
   "start": 113.61,
   "end": 120.93,
   "text": "De Europese Commissie overlegt nu over een vervolg met bredere exportcontroles voor meerdere soorten metaalschroot.",
   "chapter": 2
  },
  {
   "start": 120.93,
   "end": 125.33,
   "text": "Eerder aangekondigde maatregelen speciaal voor aluminium zijn geschrapt.",
   "chapter": 2
  },
  {
   "start": 125.33,
   "end": 129.73,
   "text": "Volgens Van de Poll moet Europa verantwoordelijkheid nemen voor het eigen afval.",
   "chapter": 2
  },
  {
   "start": 129.73,
   "end": 135.17,
   "text": "Anders concurreren technische recyclers met bedrijven die laagwaardig afval exporteren.",
   "chapter": 2
  },
  {
   "start": 135.17,
   "end": 138.16,
   "text": "Hij benadrukt dat de sector niet met één stem spreekt.",
   "chapter": 2
  },
  {
   "start": 140.5,
   "end": 146.58,
   "text": "Recycler Renewi en technologiebedrijf Torrgreen onderzoeken een nieuwe route voor B-hout.",
   "chapter": 3
  },
  {
   "start": 146.58,
   "end": 148.98,
   "text": "Dat meldt Recycling Magazine.",
   "chapter": 3
  },
  {
   "start": 148.98,
   "end": 154.34,
   "text": "B-hout is afvalhout zoals spaanplaat, M-D-F en geverfd sloophout.",
   "chapter": 3
  },
  {
   "start": 154.34,
   "end": 157.62,
   "text": "Door lijm en verf is het moeilijk te recyclen.",
   "chapter": 3
  },
  {
   "start": 157.62,
   "end": 162.18,
   "text": "In Vlaardingen verwerkt Renewi ongeveer tweeduizend ton met torrefactie.",
   "chapter": 3
  },
  {
   "start": 162.18,
   "end": 166.42,
   "text": "Daarbij wordt het hout zonder zuurstof verhit, een soort roosteren.",
   "chapter": 3
  },
  {
   "start": 166.42,
   "end": 171.94,
   "text": "Het resultaat zijn compacte pellets met een hogere energie-inhoud dan gewone houtpellets.",
   "chapter": 3
  },
  {
   "start": 171.94,
   "end": 179.7,
   "text": "Die pellets kunnen later via vergassing dienen als grondstof voor groen gas, methanol en duurzame vliegtuigbrandstof.",
   "chapter": 3
  },
  {
   "start": 179.7,
   "end": 181.62,
   "text": "Het is nadrukkelijk onderzoek.",
   "chapter": 3
  },
  {
   "start": 181.62,
   "end": 185.06,
   "text": "Of de route op grote schaal werkt, staat nog niet vast.",
   "chapter": 3
  },
  {
   "start": 185.06,
   "end": 187.13,
   "text": "Het bericht verscheen op dertien oktober.",
   "chapter": 3
  },
  {
   "start": 189.46,
   "end": 195.14,
   "text": "Het recyclingpercentage van matrassen in Nederland is gestegen naar drieënzeventig procent.",
   "chapter": 4
  },
  {
   "start": 195.14,
   "end": 199.94,
   "text": "Dat meldt Afvalgids, op basis van Stichting Matras Recycling Nederland.",
   "chapter": 4
  },
  {
   "start": 199.94,
   "end": 205.14,
   "text": "Het gaat om de eerste helft van tweeduizend zesentwintig en om een voorlopig cijfer.",
   "chapter": 4
  },
  {
   "start": 205.14,
   "end": 208.82,
   "text": "In tweeduizend tweeëntwintig was dat tweeënveertig procent.",
   "chapter": 4
  },
  {
   "start": 208.82,
   "end": 215.3,
   "text": "Het doel in de afvalbeheerovereenkomst is minimaal vijfenzeventig procent in tweeduizend achtentwintig.",
   "chapter": 4
  },
  {
   "start": 215.3,
   "end": 218.98,
   "text": "De stichting vraagt consumenten oude matrassen droog te houden.",
   "chapter": 4
  },
  {
   "start": 218.98,
   "end": 223.62,
   "text": "Een natte matras is niet meer te recyclen en gaat naar de verbrandingsoven.",
   "chapter": 4
  },
  {
   "start": 223.62,
   "end": 230.9,
   "text": "Een droge matras bevat ongeveer twintig bruikbare onderdelen, bijvoorbeeld voor judomatten of isolatiemateriaal.",
   "chapter": 4
  },
  {
   "start": 230.9,
   "end": 234.76,
   "text": "De stichting vergoedt gemeenten en inzamelaars inmiddels volledig hun kosten.",
   "chapter": 4
  },
  {
   "start": 237.1,
   "end": 240.06,
   "text": "En wat betekent dit voor uw organisatie?",
   "chapter": 5
  },
  {
   "start": 240.06,
   "end": 242.38,
   "text": "Regels komen eerder dan u denkt.",
   "chapter": 5
  },
  {
   "start": 242.38,
   "end": 247.82,
   "text": "Controleer nu hoe u afgedankte apparatuur afgeeft en wat u doet met onverkochte kleding.",
   "chapter": 5
  },
  {
   "start": 247.82,
   "end": 252.22,
   "text": "Vraag uw inzamelaar aan te tonen dat hij erkend of gecertificeerd is.",
   "chapter": 5
  },
  {
   "start": 252.22,
   "end": 257.74,
   "text": "De matrassen laten zien dat een eenvoudige maatregel, droog bewaren, veel verschil maakt.",
   "chapter": 5
  },
  {
   "start": 257.74,
   "end": 261.74,
   "text": "Op de werkvloer werkt het vaak net zo: goede scheiding aan de bron.",
   "chapter": 5
  },
  {
   "start": 261.74,
   "end": 266.82,
   "text": "Bij De Graaf Groep zien wij dat schone, gescheiden stromen meer waard zijn dan gemengd afval.",
   "chapter": 5
  },
  {
   "start": 266.82,
   "end": 272.0,
   "text": "En het debat over export maakt duidelijk dat het loont om te weten waar uw materiaal terechtkomt.",
   "chapter": 5
  },
  {
   "start": 272.45,
   "end": 276.69,
   "text": "Het cijfer van de dag is zesenzeventig komma vier procent.",
   "chapter": 6
  },
  {
   "start": 276.69,
   "end": 282.93,
   "text": "Zo groot was in tweeduizend vijfentwintig het aandeel papier en karton dat in Europa werd gerecycled.",
   "chapter": 6
  },
  {
   "start": 282.93,
   "end": 286.13,
   "text": "Het percentage bleef gelijk aan dat van het jaar ervoor.",
   "chapter": 6
  },
  {
   "start": 286.13,
   "end": 290.65,
   "text": "Het ging om drieënvijftig komma negen miljoen ton, meldt Recycling Magazine.",
   "chapter": 6
  },
  {
   "start": 291.1,
   "end": 293.5,
   "text": "Dat was Grondstof voor vandaag.",
   "chapter": 7
  },
  {
   "start": 293.5,
   "end": 297.26,
   "text": "De bronnen bij elk bericht vindt u in de app en in de shownotes.",
   "chapter": 7
  },
  {
   "start": 297.26,
   "end": 299.58,
   "text": "Morgen om negen uur bent u weer bij.",
   "chapter": 7
  },
  {
   "start": 299.58,
   "end": 300.03,
   "text": "Tot dan.",
   "chapter": 7
  }
 ],
