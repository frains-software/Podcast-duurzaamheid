 "transcript": [
  {
   "start": 5.5,
   "end": 6.5,
   "text": "Goedemorgen.",
   "chapter": 0
  },
  {
   "start": 6.5,
   "end": 8.7,
   "text": "Het is dinsdag dertien oktober.",
   "chapter": 0
  },
  {
   "start": 8.7,
   "end": 13.02,
   "text": "U luistert naar Grondstof, het circulaire nieuwsbulletin van De Graaf Groep.",
   "chapter": 0
  },
  {
   "start": 13.02,
   "end": 14.58,
   "text": "Ik ben Frans van den Berge.",
   "chapter": 0
  },
  {
   "start": 14.58,
   "end": 15.9,
   "text": "Dit zijn de koppen.",
   "chapter": 0
  },
  {
   "start": 15.9,
   "end": 20.14,
   "text": "Europese brancheverenigingen vragen om sterkere handelsbescherming.",
   "chapter": 0
  },
  {
   "start": 20.14,
   "end": 23.14,
   "text": "PreZero neemt een autorecycler over.",
   "chapter": 0
  },
  {
   "start": 23.14,
   "end": 25.89,
   "text": "En de fabriek Empyro in Hengelo draait weer.",
   "chapter": 0
  },
  {
   "start": 28.23,
   "end": 34.31,
   "text": "Vierenveertig Europese brancheverenigingen vragen om sterkere maatregelen tegen oneerlijke handel.",
   "chapter": 1
  },
  {
   "start": 34.31,
   "end": 36.63,
   "text": "Dat meldt het vakblad Euwid.",
   "chapter": 1
  },
  {
   "start": 36.63,
   "end": 46.39,
   "text": "Onder de ondertekenaars zijn Plastic Recyclers Europe, VinylPlus en Plastics Europe, maar ook de chemiekoepel Cefic en de papierkoepel Cepi.",
   "chapter": 1
  },
  {
   "start": 46.39,
   "end": 53.51,
   "text": "Zij willen dat lidstaten meer personeel inzetten voor handelsbescherming en bestaande instrumenten effectiever gebruiken.",
   "chapter": 1
  },
  {
   "start": 53.51,
   "end": 59.59,
   "text": "Ook vragen ze om extra maatregelen tegen concurrentievervalsing die door staten wordt veroorzaakt.",
   "chapter": 1
  },
  {
   "start": 59.59,
   "end": 66.39,
   "text": "Het handelstekort van de Europese Unie met China bedroeg vorig jaar ongeveer driehonderdzestig miljard euro.",
   "chapter": 1
  },
  {
   "start": 66.39,
   "end": 70.07,
   "text": "Ondertussen staat de markt voor gerecycled pet onder druk.",
   "chapter": 1
  },
  {
   "start": 70.07,
   "end": 76.59,
   "text": "Euwid meldt dat de vraag naar vlokken en korrels in september verzwakte, terwijl er ruim voldoende flessen waren.",
   "chapter": 1
  },
  {
   "start": 76.59,
   "end": 79.11,
   "text": "Een verband tussen beide berichten legt de bron niet.",
   "chapter": 1
  },
  {
   "start": 81.44,
   "end": 86.31,
   "text": "PreZero neemt de Duitse autorecycler Autorecycling Kempers over.",
   "chapter": 2
  },
  {
   "start": 86.31,
   "end": 87.67,
   "text": "Dat meldt Euwid.",
   "chapter": 2
  },
  {
   "start": 87.67,
   "end": 94.31,
   "text": "PreZero Automotive Holding, de afvalpoot van de Schwarz Groep, koopt alle aandelen van de familie Kempers.",
   "chapter": 2
  },
  {
   "start": 94.31,
   "end": 101.99,
   "text": "Het bedrijf zit in Meppen en kan jaarlijks tot tienduizend voertuigen verwerken, op een terrein van meer dan vijfendertigduizend vierkante meter.",
   "chapter": 2
  },
  {
   "start": 101.99,
   "end": 104.79,
   "text": "De financiële voorwaarden zijn niet bekendgemaakt.",
   "chapter": 2
  },
  {
   "start": 104.79,
   "end": 110.31,
   "text": "Voor de autosector is dit een teken van schaalvergroting in het recyclen van afgedankte voertuigen.",
   "chapter": 2
  },
  {
   "start": 110.31,
   "end": 115.91,
   "text": "Wie wagens of leaseauto's inlevert, krijgt dus steeds vaker te maken met grotere ketenpartijen.",
   "chapter": 2
  },
  {
   "start": 115.91,
   "end": 119.67,
   "text": "Of die ontwikkeling zich doorzet, valt uit dit bericht niet af te leiden.",
   "chapter": 2
  },
  {
   "start": 119.67,
   "end": 122.12,
   "text": "Het bericht gaat alleen over deze ene overname.",
   "chapter": 2
  },
  {
   "start": 124.46,
   "end": 127.42,
   "text": "De fabriek Empyro in Hengelo draait weer.",
   "chapter": 3
  },
  {
   "start": 127.42,
   "end": 131.5,
   "text": "Dat meldt een energienieuwsoverzicht van zakelijkeenergietarieven.",
   "chapter": 3
  },
  {
   "start": 131.5,
   "end": 139.1,
   "text": "De installatie, nu van Aurora Renewable Carbon, leverde de eerste lading pyrolyse-olie aan FrieslandCampina.",
   "chapter": 3
  },
  {
   "start": 139.1,
   "end": 144.3,
   "text": "Pyrolyse-olie wordt gemaakt van houtresten, die zonder zuurstof sterk worden verhit.",
   "chapter": 3
  },
  {
   "start": 144.3,
   "end": 146.78,
   "text": "De fabriek lag ruim drie jaar stil.",
   "chapter": 3
  },
  {
   "start": 146.78,
   "end": 151.5,
   "text": "Aurora rondde de financiering af met onder meer Triodos Bank en Oost NL.",
   "chapter": 3
  },
  {
   "start": 151.5,
   "end": 157.42,
   "text": "Op termijn wil het bedrijf een bioraffinaderij bouwen, die de olie opwerkt tot chemische grondstoffen.",
   "chapter": 3
  },
  {
   "start": 157.42,
   "end": 161.26,
   "text": "Dat is een stap voor biobased grondstoffen in Nederland.",
   "chapter": 3
  },
  {
   "start": 161.26,
   "end": 165.07,
   "text": "Over de capaciteit van de fabriek zijn in de bronnen geen cijfers te vinden.",
   "chapter": 3
  },
  {
   "start": 165.07,
   "end": 166.97,
   "text": "Wij houden het daarom bij het nieuws zelf.",
   "chapter": 3
  },
  {
   "start": 169.3,
   "end": 178.18,
   "text": "De recyclingbijdrage voor auto's blijft in tweeduizend zevenentwintig gelijk, maar de bijdrage voor accu's van elektrische auto's gaat omhoog.",
   "chapter": 4
  },
  {
   "start": 178.18,
   "end": 182.82,
   "text": "Dat maakte Auto Recycling Nederland bekend, meldt Recycling Magazine.",
   "chapter": 4
  },
  {
   "start": 182.82,
   "end": 190.58,
   "text": "Voor personenauto's en lichte bedrijfswagens blijft de recyclingbijdrage tweeëntwintig euro vijftig, inclusief btw.",
   "chapter": 4
  },
  {
   "start": 190.58,
   "end": 194.34,
   "text": "De beheerbijdragen voor accu's stijgen per één januari.",
   "chapter": 4
  },
  {
   "start": 194.34,
   "end": 202.02,
   "text": "Voor accu's zwaarder dan twaalfhonderd kilo gaat het tarief van honderddertig naar honderdvijftig euro, meldt Automotive Online.",
   "chapter": 4
  },
  {
   "start": 202.02,
   "end": 207.06,
   "text": "Auto Recycling Nederland verwacht dat het aantal afgedankte accu's sterk toeneemt.",
   "chapter": 4
  },
  {
   "start": 207.06,
   "end": 212.07,
   "text": "De hogere tarieven moeten de kosten van inzameling en recycling op middellange termijn dekken.",
   "chapter": 4
  },
  {
   "start": 214.41,
   "end": 217.45,
   "text": "En wat betekent dit voor uw organisatie?",
   "chapter": 5
  },
  {
   "start": 217.45,
   "end": 218.97,
   "text": "Twee dingen vallen op.",
   "chapter": 5
  },
  {
   "start": 218.97,
   "end": 223.13,
   "text": "Ten eerste blijven de kosten van afval en recycling stijgen.",
   "chapter": 5
  },
  {
   "start": 223.13,
   "end": 230.65,
   "text": "De gemeente Het Hogeland verhoogt de afvalstoffenheffing volgend jaar met ongeveer dertig euro, omdat verbranden duurder is geworden.",
   "chapter": 5
  },
  {
   "start": 230.65,
   "end": 233.21,
   "text": "Ook de bijdrage voor accu's loopt op.",
   "chapter": 5
  },
  {
   "start": 233.21,
   "end": 236.81,
   "text": "Reken daar bij uw begroting voor tweeduizend zevenentwintig op.",
   "chapter": 5
  },
  {
   "start": 236.81,
   "end": 240.97,
   "text": "Ten tweede is de markt voor gerecyclede materialen wisselvallig.",
   "chapter": 5
  },
  {
   "start": 240.97,
   "end": 245.45,
   "text": "Zwakke vraag naar gerecycled pet laat zien dat prijzen kunnen schuiven.",
   "chapter": 5
  },
  {
   "start": 245.45,
   "end": 252.65,
   "text": "Wie circulair inkoopt, doet er goed aan om prijsafspraken met leveranciers niet te strak aan de grondstofmarkt te koppelen.",
   "chapter": 5
  },
  {
   "start": 252.65,
   "end": 255.61,
   "text": "Vraag ook na welke afvalstromen u precies heeft.",
   "chapter": 5
  },
  {
   "start": 255.61,
   "end": 257.72,
   "text": "Dan kunt u zien waar de kosten vandaan komen.",
   "chapter": 5
  },
  {
   "start": 258.17,
   "end": 260.17,
   "text": "Eén miljoen ton.",
   "chapter": 6
  },
  {
   "start": 260.17,
   "end": 269.21,
   "text": "Zoveel minder CO-twee wil afvalverwerker Haa Vee Cee uit Alkmaar vanaf tweeduizend vijfendertig per jaar uitstoten dan in tweeduizend vijfentwintig.",
   "chapter": 6
  },
  {
   "start": 269.21,
   "end": 272.41,
   "text": "Dat meldt het Noordhollands Dagblad via Afvalgids.",
   "chapter": 6
  },
  {
   "start": 272.41,
   "end": 274.81,
   "text": "Haa Vee Cee bestaat vijfendertig jaar.",
   "chapter": 6
  },
  {
   "start": 274.81,
   "end": 281.11,
   "text": "Het bedrijf zet in op warmtenetten, hernieuwbare energie, minder restafval en het afvangen van CO-twee.",
   "chapter": 6
  },
  {
   "start": 281.56,
   "end": 283.88,
   "text": "Dat was Grondstof voor vandaag.",
   "chapter": 7
  },
  {
   "start": 283.88,
   "end": 287.72,
   "text": "De bronnen bij elk bericht vindt u in de app en in de shownotes.",
   "chapter": 7
  },
  {
   "start": 287.72,
   "end": 290.04,
   "text": "Morgen om negen uur bent u weer bij.",
   "chapter": 7
  },
  {
   "start": 290.04,
   "end": 290.49,
   "text": "Tot dan.",
   "chapter": 7
  }
 ],
