 "transcript": [
  {
   "start": 5.5,
   "end": 6.62,
   "text": "Goedemorgen.",
   "chapter": 0
  },
  {
   "start": 6.62,
   "end": 8.66,
   "text": "Het is maandag twee november.",
   "chapter": 0
  },
  {
   "start": 8.66,
   "end": 13.1,
   "text": "U luistert naar Grondstof, het circulaire nieuwsbulletin van De Graaf Groep.",
   "chapter": 0
  },
  {
   "start": 13.1,
   "end": 14.66,
   "text": "Ik ben Frans van den Berge.",
   "chapter": 0
  },
  {
   "start": 14.66,
   "end": 16.18,
   "text": "Dit zijn de koppen.",
   "chapter": 0
  },
  {
   "start": 16.18,
   "end": 20.98,
   "text": "Investeerder Waterland neemt de helft van afvalbedrijf Milieu Service Groep.",
   "chapter": 0
  },
  {
   "start": 20.98,
   "end": 26.82,
   "text": "BMW wil in tweeduizend dertig de helft van zijn auto's bouwen uit gerecycled materiaal.",
   "chapter": 0
  },
  {
   "start": 26.82,
   "end": 30.36,
   "text": "En een miljard luiers gaat jaarlijks de verbrandingsoven in.",
   "chapter": 0
  },
  {
   "start": 32.7,
   "end": 38.78,
   "text": "Investeerder Waterland Private Equity neemt vijftig procent van de aandelen in Milieu Service Groep.",
   "chapter": 1
  },
  {
   "start": 38.78,
   "end": 41.66,
   "text": "Dat meldt Afvalgids op dertig oktober.",
   "chapter": 1
  },
  {
   "start": 41.66,
   "end": 44.62,
   "text": "De huidige aandeelhouders houden de andere helft.",
   "chapter": 1
  },
  {
   "start": 44.62,
   "end": 49.1,
   "text": "Het bedrijf zamelt afval in, recyclet en beheert afvalstromen.",
   "chapter": 1
  },
  {
   "start": 49.1,
   "end": 55.1,
   "text": "Het heeft ongeveer vierhonderd medewerkers en een omzet van ongeveer honderdzestig miljoen euro per jaar.",
   "chapter": 1
  },
  {
   "start": 55.1,
   "end": 63.02,
   "text": "Tot de groep horen Milieu Service Nederland, Paridon Containers, TH Containers en het Duitse Lins Recycling.",
   "chapter": 1
  },
  {
   "start": 63.02,
   "end": 67.26,
   "text": "Met de nieuwe partner wil het bedrijf sneller groeien in Nederland en Duitsland.",
   "chapter": 1
  },
  {
   "start": 67.26,
   "end": 71.34,
   "text": "De transactie moet nog worden goedgekeurd door de mededingingsautoriteiten.",
   "chapter": 1
  },
  {
   "start": 71.34,
   "end": 74.54,
   "text": "De financiële details zijn niet bekendgemaakt.",
   "chapter": 1
  },
  {
   "start": 74.54,
   "end": 81.91,
   "text": "Het doet ertoe, omdat de afvalsector verder consolideert en investeerders de inzameling en recycling blijven zien als een kans.",
   "chapter": 1
  },
  {
   "start": 84.24,
   "end": 91.68,
   "text": "Autofabrikant BMW wil in tweeduizend dertig minstens de helft van zijn auto's opbouwen uit gerecycled materiaal.",
   "chapter": 2
  },
  {
   "start": 91.68,
   "end": 95.28,
   "text": "Dat meldt Recycling Magazine op negenentwintig oktober.",
   "chapter": 2
  },
  {
   "start": 95.28,
   "end": 103.12,
   "text": "Technologiechef Franz Geyer zei op een congres over batterijrecycling in Berlijn dat het aandeel nu al op een derde ligt.",
   "chapter": 2
  },
  {
   "start": 103.12,
   "end": 108.0,
   "text": "BMW heeft wereldwijd twee miljoen volledig elektrische auto's geleverd.",
   "chapter": 2
  },
  {
   "start": 108.0,
   "end": 116.88,
   "text": "In Beieren onderzoekt het bedrijf hoe het lithium, kobalt en grafiet direct kan terugwinnen uit afval van de celproductie en uit complete cellen.",
   "chapter": 2
  },
  {
   "start": 116.88,
   "end": 123.52,
   "text": "Volgens Geyer verlaat ongeveer zeventig procent van de waarde van materiaalstromen rond batterijen nu Europa.",
   "chapter": 2
  },
  {
   "start": 123.52,
   "end": 126.64,
   "text": "Gerecycled materiaal is nog niet wettelijk verplicht.",
   "chapter": 2
  },
  {
   "start": 126.64,
   "end": 132.46,
   "text": "Het doet ertoe, omdat grote afnemers met eigen doelen de vraag naar gerecyclede grondstoffen vergroten.",
   "chapter": 2
  },
  {
   "start": 134.8,
   "end": 139.52,
   "text": "In Nederland gaan jaarlijks ongeveer een miljard luiers de verbrandingsoven in.",
   "chapter": 3
  },
  {
   "start": 139.52,
   "end": 144.08,
   "text": "Dat stelt Afvalgids vandaag in een bijdrage van het programma De Pot Op.",
   "chapter": 3
  },
  {
   "start": 144.08,
   "end": 146.8,
   "text": "Dit is dus de visie van een betrokken partij.",
   "chapter": 3
  },
  {
   "start": 146.8,
   "end": 152.72,
   "text": "In Weurt staat de enige recyclinglocatie, met een capaciteit van vijftienduizend ton per jaar.",
   "chapter": 3
  },
  {
   "start": 152.72,
   "end": 157.92,
   "text": "Dat is minder dan vier procent van de ongeveer vierhonderdduizend ton luierafval.",
   "chapter": 3
  },
  {
   "start": 157.92,
   "end": 165.36,
   "text": "De uitgebreide producentenverantwoordelijkheid zou kosten verschuiven, maar volgens De Pot Op voorkomt ze geen enkele luier.",
   "chapter": 3
  },
  {
   "start": 165.36,
   "end": 170.0,
   "text": "Ouders geven nu al zeshonderd tot achthonderd euro per jaar uit aan luiers.",
   "chapter": 3
  },
  {
   "start": 170.0,
   "end": 172.88,
   "text": "De organisatie pleit voor vroeg zindelijk worden.",
   "chapter": 3
  },
  {
   "start": 172.88,
   "end": 180.18,
   "text": "Het doet ertoe, omdat afvalpreventie en recycling hier tegenover elkaar worden gezet, en gemeenten de verbrandingskosten zien stijgen.",
   "chapter": 3
  },
  {
   "start": 182.51,
   "end": 187.91,
   "text": "Dit is een bericht van vijftien oktober, dat aansluit op het exportverbod van gisteren.",
   "chapter": 4
  },
  {
   "start": 187.91,
   "end": 198.83,
   "text": "Recycling Magazine meldt dat Martijn van de Poll, directeur van Myne Circular Metals, stelt dat strengere Europese regels voor schrootexport innovatie juist stimuleren.",
   "chapter": 4
  },
  {
   "start": 198.83,
   "end": 204.43,
   "text": "Hij reageert op brancheorganisaties die vrezen voor toegang tot internationale markten.",
   "chapter": 4
  },
  {
   "start": 204.43,
   "end": 210.51,
   "text": "De herziene verordening voor het vervoer van afvalstoffen gaat in mei tweeduizend zevenentwintig in.",
   "chapter": 4
  },
  {
   "start": 210.51,
   "end": 217.39,
   "text": "Volgens Van de Poll krijgt een recycler te maken met goedkope export van laagwaardig afval, zonder strenge regels.",
   "chapter": 4
  },
  {
   "start": 217.39,
   "end": 220.31,
   "text": "Dan wint handel het van innovatie.",
   "chapter": 4
  },
  {
   "start": 220.31,
   "end": 227.39,
   "text": "Myne is door de Europese Commissie aangewezen als strategisch project onder de Europese wet voor kritieke grondstoffen.",
   "chapter": 4
  },
  {
   "start": 227.39,
   "end": 230.68,
   "text": "Het doet ertoe, omdat de sector over deze regels verdeeld is.",
   "chapter": 4
  },
  {
   "start": 233.02,
   "end": 235.98,
   "text": "En wat betekent dit voor uw organisatie?",
   "chapter": 5
  },
  {
   "start": 235.98,
   "end": 236.94,
   "text": "Drie dingen.",
   "chapter": 5
  },
  {
   "start": 236.94,
   "end": 240.38,
   "text": "Ten eerste de overname bij Milieu Service Groep.",
   "chapter": 5
  },
  {
   "start": 240.38,
   "end": 246.86,
   "text": "In een markt die consolideert, loont het om uw contracten en uw afspraken over rapportage naast elkaar te leggen.",
   "chapter": 5
  },
  {
   "start": 246.86,
   "end": 248.86,
   "text": "Ten tweede BMW.",
   "chapter": 5
  },
  {
   "start": 248.86,
   "end": 255.34,
   "text": "Grote afnemers stellen eisen aan gerecycled materiaal, en die eisen schuiven door naar hun leveranciers.",
   "chapter": 5
  },
  {
   "start": 255.34,
   "end": 259.1,
   "text": "Verzamel daarom nu gegevens over de herkomst van uw materialen.",
   "chapter": 5
  },
  {
   "start": 259.1,
   "end": 260.94,
   "text": "Ten derde de luiers.",
   "chapter": 5
  },
  {
   "start": 260.94,
   "end": 266.3,
   "text": "Preventie en recycling sluiten elkaar niet uit, maar kosten voor verbranding stijgen wel.",
   "chapter": 5
  },
  {
   "start": 266.3,
   "end": 272.44,
   "text": "Bij De Graaf Groep zien wij dat bedrijven die hun afvalstromen goed kennen, de laagste kosten en de meeste grip houden.",
   "chapter": 5
  },
  {
   "start": 272.89,
   "end": 275.85,
   "text": "Het cijfer van de dag is vier procent.",
   "chapter": 6
  },
  {
   "start": 275.85,
   "end": 281.37,
   "text": "Zo weinig van het Nederlandse luierafval kan op de enige recyclinglocatie worden verwerkt.",
   "chapter": 6
  },
  {
   "start": 281.37,
   "end": 286.81,
   "text": "De capaciteit is vijftienduizend ton per jaar, bij ongeveer vierhonderdduizend ton luierafval.",
   "chapter": 6
  },
  {
   "start": 287.26,
   "end": 289.5,
   "text": "Dat was Grondstof voor vandaag.",
   "chapter": 7
  },
  {
   "start": 289.5,
   "end": 293.1,
   "text": "De bronnen bij elk bericht vindt u in de app en in de shownotes.",
   "chapter": 7
  },
  {
   "start": 293.1,
   "end": 295.42,
   "text": "Morgen om negen uur bent u weer bij.",
   "chapter": 7
  },
  {
   "start": 295.42,
   "end": 295.83,
   "text": "Tot dan.",
   "chapter": 7
  }
 ],
