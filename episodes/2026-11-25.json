 "transcript": [
  {
   "start": 5.5,
   "end": 6.38,
   "text": "Goedemorgen.",
   "chapter": 0
  },
  {
   "start": 6.38,
   "end": 9.02,
   "text": "Het is woensdag vijfentwintig november.",
   "chapter": 0
  },
  {
   "start": 9.02,
   "end": 13.42,
   "text": "U luistert naar Grondstof, het circulaire nieuwsbulletin van De Graaf Groep.",
   "chapter": 0
  },
  {
   "start": 13.42,
   "end": 15.02,
   "text": "Ik ben Frans van den Berge.",
   "chapter": 0
  },
  {
   "start": 15.02,
   "end": 16.62,
   "text": "Dit zijn de koppen.",
   "chapter": 0
  },
  {
   "start": 16.62,
   "end": 22.7,
   "text": "De Europese Commissie stelt de Circular Economy Act opnieuw uit, nu tot vijftien december.",
   "chapter": 0
  },
  {
   "start": 22.7,
   "end": 28.06,
   "text": "Metaalrecycler Sims verhoogt zijn winstverwachting dankzij apparatuur uit datacenters.",
   "chapter": 0
  },
  {
   "start": 28.06,
   "end": 33.7,
   "text": "En Verpact bereidt statiegeld voor op alle plastic drankflessen, ook die voor sap en zuivel.",
   "chapter": 0
  },
  {
   "start": 36.04,
   "end": 40.36,
   "text": "De Europese Commissie stelt de Circular Economy Act opnieuw uit.",
   "chapter": 1
  },
  {
   "start": 40.36,
   "end": 42.6,
   "text": "Dat meldt het vakblad Euwid.",
   "chapter": 1
  },
  {
   "start": 42.6,
   "end": 48.12,
   "text": "De presentatie stond voor twee december gepland en schuift nu door naar vijftien december.",
   "chapter": 1
  },
  {
   "start": 48.12,
   "end": 57.24,
   "text": "Vicevoorzitters Teresa Ribera en Stéphane Séjourné presenteren het voorstel dan in Straatsburg, tijdens de plenaire week van het Europees Parlement.",
   "chapter": 1
  },
  {
   "start": 57.24,
   "end": 59.24,
   "text": "Het is niet het eerste uitstel.",
   "chapter": 1
  },
  {
   "start": 59.24,
   "end": 64.76,
   "text": "Eerder vond de interne toetsingscommissie van Brussel tekortkomingen in de effectbeoordeling.",
   "chapter": 1
  },
  {
   "start": 64.76,
   "end": 71.32,
   "text": "De wet moet de handel in gerecyclede grondstoffen binnen Europa makkelijker maken en de vraag ernaar vergroten.",
   "chapter": 1
  },
  {
   "start": 71.32,
   "end": 75.24,
   "text": "Ook de regels voor producentenverantwoordelijkheid worden gelijkgetrokken.",
   "chapter": 1
  },
  {
   "start": 75.24,
   "end": 80.84,
   "text": "Volgens milieucommissaris Jessika Roswall komt er een gelijker speelveld voor wie zich aan de regels houdt.",
   "chapter": 1
  },
  {
   "start": 83.17,
   "end": 87.41,
   "text": "De Australische metaalrecycler Sims verhoogt zijn winstverwachting.",
   "chapter": 2
  },
  {
   "start": 87.41,
   "end": 89.01,
   "text": "Dat meldt Euwid.",
   "chapter": 2
  },
  {
   "start": 89.01,
   "end": 99.57,
   "text": "Het bedrijf rekent voor het halfjaar tot en met eenendertig december op een onderliggend bedrijfsresultaat van tweehonderdzeventig tot tweehonderdvijfentachtig miljoen Australische dollar.",
   "chapter": 2
  },
  {
   "start": 99.57,
   "end": 104.93,
   "text": "Omgerekend is dat ongeveer honderdvierenzestig tot honderddrieënzeventig miljoen euro.",
   "chapter": 2
  },
  {
   "start": 104.93,
   "end": 108.29,
   "text": "Een jaar eerder was het honderdeenentwintig miljoen dollar.",
   "chapter": 2
  },
  {
   "start": 108.29,
   "end": 112.85,
   "text": "De oorzaak ligt bij de dochter die apparatuur uit datacenters verwerkt.",
   "chapter": 2
  },
  {
   "start": 112.85,
   "end": 120.69,
   "text": "Volgens topman Stephen Mikkelsen leveren aanhoudende tekorten aan bepaalde onderdelen voor datacenters nieuwe winstkansen op.",
   "chapter": 2
  },
  {
   "start": 120.69,
   "end": 126.69,
   "text": "Speira heeft in het Noorse Holmestrand een nieuwe smeltoven voor aluminiumschroot in gebruik genomen.",
   "chapter": 2
  },
  {
   "start": 126.69,
   "end": 129.97,
   "text": "De investering bedraagt zesendertig miljoen euro.",
   "chapter": 2
  },
  {
   "start": 129.97,
   "end": 134.61,
   "text": "De oven voegt tweeëntwintigduizend ton recyclingcapaciteit per jaar toe.",
   "chapter": 2
  },
  {
   "start": 134.61,
   "end": 139.41,
   "text": "De fabriek kan daarmee meer soorten schroot verwerken en heeft minder nieuw aluminium nodig.",
   "chapter": 2
  },
  {
   "start": 141.75,
   "end": 147.91,
   "text": "Europa verliest capaciteit voor plasticrecycling, juist nu de verpakkingsregels strenger worden.",
   "chapter": 3
  },
  {
   "start": 147.91,
   "end": 152.63,
   "text": "Dat schrijft het vakblad Packaging Gateway in een analyse die maandag verscheen.",
   "chapter": 3
  },
  {
   "start": 152.63,
   "end": 158.87,
   "text": "In tweeduizend vierentwintig sloten fabrieken met samen ongeveer driehonderdduizend ton jaarcapaciteit.",
   "chapter": 3
  },
  {
   "start": 158.87,
   "end": 165.75,
   "text": "Een jaar eerder was dat honderdvijfendertigduizend ton, volgens de brancheorganisatie Plastics Recyclers Europe.",
   "chapter": 3
  },
  {
   "start": 165.75,
   "end": 171.75,
   "text": "De helft van de capaciteit die in die twee jaar verdween, stond in Nederland en het Verenigd Koninkrijk.",
   "chapter": 3
  },
  {
   "start": 171.75,
   "end": 178.63,
   "text": "De omzet van de Europese plasticrecyclers daalde met vijfenhalf procent, tot acht komma zes miljard euro.",
   "chapter": 3
  },
  {
   "start": 178.63,
   "end": 186.71,
   "text": "Als oorzaken noemt het blad hoge kosten voor stroom, personeel en transport, en lage of grillige prijzen van nieuw plastic.",
   "chapter": 3
  },
  {
   "start": 186.71,
   "end": 191.51,
   "text": "Dat wringt met de Europese verpakkingsverordening, die sinds twaalf augustus geldt.",
   "chapter": 3
  },
  {
   "start": 191.51,
   "end": 196.26,
   "text": "Vanaf tweeduizend dertig moeten verpakkingen een minimumaandeel gerecycled plastic bevatten.",
   "chapter": 3
  },
  {
   "start": 198.59,
   "end": 204.27,
   "text": "Verpact bereidt de invoering voor van statiegeld op alle plastic drankflessen tot drie liter.",
   "chapter": 4
  },
  {
   "start": 204.27,
   "end": 206.43,
   "text": "Dat meldt Recycling Magazine.",
   "chapter": 4
  },
  {
   "start": 206.43,
   "end": 211.07,
   "text": "Het gaat om flessen voor sap en zuivel, waarop nu nog geen statiegeld zit.",
   "chapter": 4
  },
  {
   "start": 211.07,
   "end": 215.47,
   "text": "De beoogde ingangsdatum is één januari tweeduizend achtentwintig.",
   "chapter": 4
  },
  {
   "start": 215.47,
   "end": 219.47,
   "text": "Minister Van Veldhoven kondigde de uitbreiding eerder dit jaar aan.",
   "chapter": 4
  },
  {
   "start": 219.47,
   "end": 225.31,
   "text": "Verpact werkt in tweeduizend zevenentwintig met alle betrokken partijen aan een gefaseerde invoering.",
   "chapter": 4
  },
  {
   "start": 225.31,
   "end": 231.95,
   "text": "Het doel is de wettelijke norm te halen: negentig procent van de plastic drankflessen moet worden ingezameld.",
   "chapter": 4
  },
  {
   "start": 231.95,
   "end": 236.99,
   "text": "Vanaf één januari tweeduizend negenentwintig geldt die eis ook Europees.",
   "chapter": 4
  },
  {
   "start": 236.99,
   "end": 242.67,
   "text": "Elk jaar komen in Nederland ongeveer vier en een half miljard statiegeldverpakkingen op de markt.",
   "chapter": 4
  },
  {
   "start": 242.67,
   "end": 246.25,
   "text": "Door de uitbreiding komen daar naar verwachting zo'n tweehonderd miljoen bij.",
   "chapter": 4
  },
  {
   "start": 248.59,
   "end": 251.39,
   "text": "En wat betekent dit voor uw organisatie?",
   "chapter": 5
  },
  {
   "start": 251.39,
   "end": 253.95,
   "text": "Het nieuws van vandaag laat een spanning zien.",
   "chapter": 5
  },
  {
   "start": 253.95,
   "end": 260.11,
   "text": "De regels vragen steeds meer gerecycled materiaal, terwijl de capaciteit om dat te maken krimpt.",
   "chapter": 5
  },
  {
   "start": 260.11,
   "end": 267.39,
   "text": "Wie verpakkingen inkoopt, doet er goed aan nu al met leveranciers te bespreken waar het gerecyclede plastic straks vandaan komt.",
   "chapter": 5
  },
  {
   "start": 267.39,
   "end": 269.55,
   "text": "Het tweede punt is praktisch.",
   "chapter": 5
  },
  {
   "start": 269.55,
   "end": 274.83,
   "text": "Meer flessen met statiegeld betekent meer lege flessen op kantoor en in de kantine.",
   "chapter": 5
  },
  {
   "start": 274.83,
   "end": 279.2,
   "text": "Bij De Graaf Groep zien we dat een vaste inzamelplek op de werkvloer dan het verschil maakt.",
   "chapter": 5
  },
  {
   "start": 279.65,
   "end": 283.17,
   "text": "Het cijfer van de dag is tweehonderd miljoen.",
   "chapter": 6
  },
  {
   "start": 283.17,
   "end": 291.01,
   "text": "Zoveel verpakkingen komen er naar verwachting per jaar bij in het statiegeldsysteem, als ook plastic flessen voor sap en zuivel meedoen.",
   "chapter": 6
  },
  {
   "start": 291.01,
   "end": 292.79,
   "text": "Dat meldt Recycling Magazine.",
   "chapter": 6
  },
  {
   "start": 293.24,
   "end": 295.72,
   "text": "Dat was Grondstof voor vandaag.",
   "chapter": 7
  },
  {
   "start": 295.72,
   "end": 299.56,
   "text": "De bronnen bij elk bericht vindt u in de app en in de shownotes.",
   "chapter": 7
  },
  {
   "start": 299.56,
   "end": 302.04,
   "text": "Morgen om negen uur bent u weer bij.",
   "chapter": 7
  },
  {
   "start": 302.04,
   "end": 302.44,
   "text": "Tot dan.",
   "chapter": 7
  }
 ],
