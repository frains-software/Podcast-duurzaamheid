 "transcript": [
  {
   "start": 5.5,
   "end": 6.5,
   "text": "Goedemorgen.",
   "chapter": 0
  },
  {
   "start": 6.5,
   "end": 8.94,
   "text": "Het is maandag zesentwintig oktober.",
   "chapter": 0
  },
  {
   "start": 8.94,
   "end": 13.26,
   "text": "U luistert naar Grondstof, het circulaire nieuwsbulletin van De Graaf Groep.",
   "chapter": 0
  },
  {
   "start": 13.26,
   "end": 14.82,
   "text": "Ik ben Frans van den Berge.",
   "chapter": 0
  },
  {
   "start": 14.82,
   "end": 16.1,
   "text": "Dit zijn de koppen.",
   "chapter": 0
  },
  {
   "start": 16.1,
   "end": 22.54,
   "text": "De Europese Commissie keurt aangepaste recyclingclaims van Coca-Cola, Nestlé en Danone goed.",
   "chapter": 0
  },
  {
   "start": 22.54,
   "end": 26.74,
   "text": "Brightfiber Textiles stopt met de vezelproductie in Amsterdam.",
   "chapter": 0
  },
  {
   "start": 26.74,
   "end": 29.61,
   "text": "En in Duitsland blijft oud papier duurder worden.",
   "chapter": 0
  },
  {
   "start": 31.95,
   "end": 39.35,
   "text": "De Europese Commissie heeft aangepaste recyclingclaims van Coca-Cola, Nestlé Waters en Danone goedgekeurd.",
   "chapter": 1
  },
  {
   "start": 39.35,
   "end": 43.27,
   "text": "Dat meldt Duurzaam Ondernemen, op basis van de Commissie.",
   "chapter": 1
  },
  {
   "start": 43.27,
   "end": 50.39,
   "text": "De bedrijven passen hun teksten op plastic flessen aan, na overleg met het Europese netwerk van consumentenautoriteiten.",
   "chapter": 1
  },
  {
   "start": 50.39,
   "end": 60.79,
   "text": "De zin: Ik ben een fles gemaakt van honderd procent gerecycled plastic, wordt: Deze fles is honderd procent gerecycled, exclusief dop en etiket.",
   "chapter": 1
  },
  {
   "start": 60.79,
   "end": 68.95,
   "text": "En Recycle mij opnieuw wordt Recycle mij, omdat de oude tekst suggereert dat de fles al eerder is gerecycled.",
   "chapter": 1
  },
  {
   "start": 68.95,
   "end": 72.95,
   "text": "Coca-Cola en Nestlé voeren een deel van de toezeggingen al door.",
   "chapter": 1
  },
  {
   "start": 72.95,
   "end": 77.59,
   "text": "Nationale toezichthouders controleren de naleving en kunnen handhaven.",
   "chapter": 1
  },
  {
   "start": 77.59,
   "end": 81.59,
   "text": "De Commissie gaat ook in gesprek met de brancheverenigingen van bottelaars.",
   "chapter": 1
  },
  {
   "start": 81.59,
   "end": 86.86,
   "text": "Voor inkopers is dit een signaal: duurzaamheidsclaims op verpakkingen worden scherper bekeken.",
   "chapter": 1
  },
  {
   "start": 89.19,
   "end": 95.11,
   "text": "Brightfiber Textiles stopt per direct en tot nader order met de vezelproductie in Nederland.",
   "chapter": 2
  },
  {
   "start": 95.11,
   "end": 97.27,
   "text": "Dat meldt Duurzaam Ondernemen.",
   "chapter": 2
  },
  {
   "start": 97.27,
   "end": 102.71,
   "text": "Het bedrijf in Amsterdam maakt vezels met minstens veertig procent Nederlands textielafval.",
   "chapter": 2
  },
  {
   "start": 102.71,
   "end": 114.07,
   "text": "Oprichter en directeur Ellen Mensink noemt als oorzaken een markt die te langzaam verandert, handhaving die tekortschiet en druk van ultrasnelle mode op de duurzaamheidsbudgetten van merken.",
   "chapter": 2
  },
  {
   "start": 114.07,
   "end": 117.99,
   "text": "Ook kwam de financiering om de overgang te overbruggen niet op tijd.",
   "chapter": 2
  },
  {
   "start": 117.99,
   "end": 124.55,
   "text": "Het bedrijf gaat door met het sorteren van textiel met kunstmatige intelligentie en met producten voor andere merken.",
   "chapter": 2
  },
  {
   "start": 124.55,
   "end": 128.39,
   "text": "Samen met partners ontwikkelt het circulaire vezels en garens.",
   "chapter": 2
  },
  {
   "start": 128.39,
   "end": 131.03,
   "text": "Productie elders in Europa wordt onderzocht.",
   "chapter": 2
  },
  {
   "start": 131.03,
   "end": 133.99,
   "text": "Het aantal betrokken banen is niet bekendgemaakt.",
   "chapter": 2
  },
  {
   "start": 133.99,
   "end": 139.41,
   "text": "Het nieuws laat zien hoe kwetsbaar textielrecycling is, zolang vraag en handhaving achterblijven.",
   "chapter": 2
  },
  {
   "start": 141.75,
   "end": 146.23,
   "text": "Indaver brengt een bouwgrondstof op de markt die is gemaakt van bodemas.",
   "chapter": 3
  },
  {
   "start": 146.23,
   "end": 148.39,
   "text": "Dat meldt Recycling Magazine.",
   "chapter": 3
  },
  {
   "start": 148.39,
   "end": 152.87,
   "text": "Het granulaat heet Circulith en wordt gemaakt in Doel, in België.",
   "chapter": 3
  },
  {
   "start": 152.87,
   "end": 157.19,
   "text": "Daar verwerkt Indaver jaarlijks ongeveer honderdduizend ton bodemas.",
   "chapter": 3
  },
  {
   "start": 157.19,
   "end": 162.79,
   "text": "Die komt vrij bij de verbranding van ongeveer vierhonderdduizend ton niet-recycleerbaar afval.",
   "chapter": 3
  },
  {
   "start": 162.79,
   "end": 168.23,
   "text": "Met wassen, zeven en scheiden worden metalen, zand en granulaat teruggewonnen.",
   "chapter": 3
  },
  {
   "start": 168.23,
   "end": 172.15,
   "text": "Dat levert jaarlijks ongeveer dertigduizend ton granulaat op.",
   "chapter": 3
  },
  {
   "start": 172.15,
   "end": 177.51,
   "text": "De Vlaamse afvalstoffenmaatschappij heeft het granulaat de status van grondstof gegeven.",
   "chapter": 3
  },
  {
   "start": 177.51,
   "end": 182.07,
   "text": "Betonklinkers met Circulith kregen het Belgische kwaliteitsmerk Benor.",
   "chapter": 3
  },
  {
   "start": 182.07,
   "end": 186.47,
   "text": "Marlux-Stradus gebruikt het nu in beperkte hoeveelheden in het onderbeton.",
   "chapter": 3
  },
  {
   "start": 186.47,
   "end": 188.79,
   "text": "De ontwikkeling duurde bijna tien jaar.",
   "chapter": 3
  },
  {
   "start": 188.79,
   "end": 193.1,
   "text": "Het is een voorbeeld van hoogwaardig hergebruik, waar grind en zand worden vervangen.",
   "chapter": 3
  },
  {
   "start": 195.43,
   "end": 200.86,
   "text": "De Duitse prijzen voor oud papier stijgen in oktober verder, na stijgingen in september.",
   "chapter": 4
  },
  {
   "start": 200.86,
   "end": 203.02,
   "text": "Dat meldt vakblad Euwid.",
   "chapter": 4
  },
  {
   "start": 203.02,
   "end": 210.46,
   "text": "Vooral gemengd papier en karton, kartonnen supermarktverpakkingen en de kwaliteiten voor ontinkting worden duidelijk duurder.",
   "chapter": 4
  },
  {
   "start": 210.46,
   "end": 214.54,
   "text": "Middelhoge en hoge kwaliteiten zijn stabiel tot iets hoger.",
   "chapter": 4
  },
  {
   "start": 214.54,
   "end": 219.26,
   "text": "Papierfabrieken blijven vragen naar deze stromen, terwijl het aanbod zwak is.",
   "chapter": 4
  },
  {
   "start": 219.26,
   "end": 223.66,
   "text": "De inzameling in Duitsland is sinds de zomer hooguit licht gestegen.",
   "chapter": 4
  },
  {
   "start": 223.66,
   "end": 230.38,
   "text": "Eerder deze maand meldde Euwid dat de papierinzameling in Europa vorig jaar met nul komma drie procent daalde.",
   "chapter": 4
  },
  {
   "start": 230.38,
   "end": 237.18,
   "text": "Intussen start Haarlem met statiegeld op herbruikbare verzenddozen, zodat er minder karton bij het oud papier komt.",
   "chapter": 4
  },
  {
   "start": 237.18,
   "end": 238.76,
   "text": "Dat meldt Haarlem Updates.",
   "chapter": 4
  },
  {
   "start": 241.1,
   "end": 243.82,
   "text": "En wat betekent dit voor uw organisatie?",
   "chapter": 5
  },
  {
   "start": 243.82,
   "end": 244.78,
   "text": "Drie dingen.",
   "chapter": 5
  },
  {
   "start": 244.78,
   "end": 247.5,
   "text": "Eén: controleer uw eigen claims.",
   "chapter": 5
  },
  {
   "start": 247.5,
   "end": 254.46,
   "text": "Als Brussel bij grote merken ingrijpt in de tekst op een fles, geldt dezelfde strengheid voor uw duurzaamheidsmededelingen.",
   "chapter": 5
  },
  {
   "start": 254.46,
   "end": 259.34,
   "text": "Twee: let bij circulair inkopen op de continuïteit van uw leverancier.",
   "chapter": 5
  },
  {
   "start": 259.34,
   "end": 264.7,
   "text": "Brightfiber laat zien dat een goed idee zonder vraag en handhaving niet vanzelf overleeft.",
   "chapter": 5
  },
  {
   "start": 264.7,
   "end": 268.3,
   "text": "Spreid uw risico en vraag naar de financiële basis.",
   "chapter": 5
  },
  {
   "start": 268.3,
   "end": 271.5,
   "text": "Drie: oud papier wordt schaarser en duurder.",
   "chapter": 5
  },
  {
   "start": 271.5,
   "end": 275.58,
   "text": "Wie goed gescheiden karton aanlevert, heeft een betere uitgangspositie.",
   "chapter": 5
  },
  {
   "start": 275.58,
   "end": 279.82,
   "text": "Dat vraagt vooral om zuivere inzameling op de werkvloer, en daar begint het bij.",
   "chapter": 5
  },
  {
   "start": 280.27,
   "end": 284.83,
   "text": "Het cijfer van de dag is drieënvijftig komma negen miljoen ton.",
   "chapter": 6
  },
  {
   "start": 284.83,
   "end": 294.03,
   "text": "Zoveel papier werd vorig jaar in Europa ingezameld voor recycling, in de Europese Unie, het Verenigd Koninkrijk, Noorwegen en Zwitserland samen.",
   "chapter": 6
  },
  {
   "start": 294.03,
   "end": 297.8,
   "text": "Dat is nul komma drie procent minder dan een jaar eerder, meldt Euwid.",
   "chapter": 6
  },
  {
   "start": 298.25,
   "end": 300.57,
   "text": "Dat was Grondstof voor vandaag.",
   "chapter": 7
  },
  {
   "start": 300.57,
   "end": 304.25,
   "text": "De bronnen bij elk bericht vindt u in de app en in de shownotes.",
   "chapter": 7
  },
  {
   "start": 304.25,
   "end": 306.65,
   "text": "Morgen om negen uur bent u weer bij.",
   "chapter": 7
  },
  {
   "start": 306.65,
   "end": 307.06,
   "text": "Tot dan.",
   "chapter": 7
  }
 ],
