 "transcript": [
  {
   "start": 5.5,
   "end": 6.54,
   "text": "Goedemorgen.",
   "chapter": 0
  },
  {
   "start": 6.54,
   "end": 9.26,
   "text": "Het is dinsdag vierentwintig november.",
   "chapter": 0
  },
  {
   "start": 9.26,
   "end": 13.74,
   "text": "U luistert naar Grondstof, het circulaire nieuwsbulletin van De Graaf Groep.",
   "chapter": 0
  },
  {
   "start": 13.74,
   "end": 15.34,
   "text": "Ik ben Frans van den Berge.",
   "chapter": 0
  },
  {
   "start": 15.34,
   "end": 16.86,
   "text": "Dit zijn de koppen.",
   "chapter": 0
  },
  {
   "start": 16.86,
   "end": 24.38,
   "text": "De Europese Unie en het Verenigd Koninkrijk koppelen hun emissiehandel, en stemmen hun aanpak van afvalverbranding op elkaar af.",
   "chapter": 0
  },
  {
   "start": 24.38,
   "end": 27.1,
   "text": "Koperschroot wordt in Duitsland goedkoper.",
   "chapter": 0
  },
  {
   "start": 27.1,
   "end": 31.59,
   "text": "En grote webwinkels bieden nauwelijks refurbished huishoudelijke apparaten aan.",
   "chapter": 0
  },
  {
   "start": 33.93,
   "end": 39.68,
   "text": "De Europese Unie en het Verenigd Koninkrijk koppelen hun systemen voor emissiehandel aan elkaar.",
   "chapter": 1
  },
  {
   "start": 39.68,
   "end": 45.16,
   "text": "Dat is vrijdag bevestigd op een gezamenlijke top, meldt het Britse vakblad Letsrecycle.",
   "chapter": 1
  },
  {
   "start": 45.16,
   "end": 49.22,
   "text": "De koppeling moet op één januari tweeduizend achtentwintig ingaan.",
   "chapter": 1
  },
  {
   "start": 49.22,
   "end": 53.48,
   "text": "Vanaf dan tellen emissierechten uit het ene systeem ook in het andere.",
   "chapter": 1
  },
  {
   "start": 53.48,
   "end": 56.12,
   "text": "Het akkoord raakt ook de afvalsector.",
   "chapter": 1
  },
  {
   "start": 56.12,
   "end": 62.24,
   "text": "Beide partijen stemmen hun beleid af over de vraag wanneer afvalverbranding onder de emissiehandel valt.",
   "chapter": 1
  },
  {
   "start": 62.24,
   "end": 68.34,
   "text": "Volgens de Britse regering voorkomt dat dat afval wordt geëxporteerd om CO-twee-kosten te ontlopen.",
   "chapter": 1
  },
  {
   "start": 68.34,
   "end": 70.04,
   "text": "Een datum is er nog niet.",
   "chapter": 1
  },
  {
   "start": 70.04,
   "end": 80.32,
   "text": "De Europese Commissie heeft voorgesteld om de verbranding van huishoudelijk afval vanaf tweeduizend eenendertig op te nemen, met een geleidelijke invoering tot tweeduizend vierendertig.",
   "chapter": 1
  },
  {
   "start": 80.32,
   "end": 83.46,
   "text": "Dat voorstel moet nog door het Europese wetgevingsproces.",
   "chapter": 1
  },
  {
   "start": 85.79,
   "end": 88.67,
   "text": "Koperschroot is in Duitsland goedkoper geworden.",
   "chapter": 2
  },
  {
   "start": 88.67,
   "end": 90.83,
   "text": "Dat meldt het vakblad Euwid.",
   "chapter": 2
  },
  {
   "start": 90.83,
   "end": 97.55,
   "text": "De koperprijs op de Londense metaalbeurs daalde in twee weken met tot wel vijftienhonderd dollar per ton.",
   "chapter": 2
  },
  {
   "start": 97.55,
   "end": 103.79,
   "text": "Duitse handelaren in non-ferroschroot meldden vorige week voor sommige soorten flinke prijsverlagingen.",
   "chapter": 2
  },
  {
   "start": 103.79,
   "end": 106.11,
   "text": "Bij oud papier is het beeld anders.",
   "chapter": 2
  },
  {
   "start": 106.11,
   "end": 113.15,
   "text": "In het Verenigd Koninkrijk bleven de prijzen van de meeste soorten in november stijgen of gelijk, schrijft Letsrecycle.",
   "chapter": 2
  },
  {
   "start": 113.15,
   "end": 116.83,
   "text": "Oud karton wordt duurder door kopers uit Zuidoost-Azië.",
   "chapter": 2
  },
  {
   "start": 116.83,
   "end": 121.07,
   "text": "Ook de vraag uit Turkije is goed, en het Britse aanbod is krap.",
   "chapter": 2
  },
  {
   "start": 121.07,
   "end": 122.83,
   "text": "Marktpartijen zijn verdeeld.",
   "chapter": 2
  },
  {
   "start": 122.83,
   "end": 128.35,
   "text": "Sommigen denken dat de kartonprijs zijn piek heeft bereikt, anderen rekenen op verdere stijging.",
   "chapter": 2
  },
  {
   "start": 128.35,
   "end": 131.36,
   "text": "Bij gemengd papier duiken de eerste lagere biedingen op.",
   "chapter": 2
  },
  {
   "start": 133.7,
   "end": 138.42,
   "text": "Grote webwinkels bieden nauwelijks refurbished huishoudelijke apparaten aan.",
   "chapter": 3
  },
  {
   "start": 138.42,
   "end": 144.34,
   "text": "Dat blijkt uit onderzoek dat Natuur en Milieu vandaag publiceert, in aanloop naar Black Friday.",
   "chapter": 3
  },
  {
   "start": 144.34,
   "end": 152.9,
   "text": "Nederlandse huishoudens bezitten samen bijna een half miljard kleine apparaten, zoals koffiemachines, stofzuigers en broodroosters.",
   "chapter": 3
  },
  {
   "start": 152.9,
   "end": 156.66,
   "text": "Bij smartphones is tweedehands en opgeknapt al gewoon.",
   "chapter": 3
  },
  {
   "start": 156.66,
   "end": 162.1,
   "text": "Coolblue en MediaMarkt hebben daarvan ongeveer evenveel refurbished als nieuwe modellen.",
   "chapter": 3
  },
  {
   "start": 162.1,
   "end": 166.66,
   "text": "Bij huishoudelijke apparaten zijn opgeknapte exemplaren slecht vindbaar.",
   "chapter": 3
  },
  {
   "start": 166.66,
   "end": 169.06,
   "text": "Het prijsverschil loopt sterk uiteen.",
   "chapter": 3
  },
  {
   "start": 169.06,
   "end": 177.38,
   "text": "Een refurbished airfryer was achtenveertig procent goedkoper dan een nieuwe, bij andere apparaten was er weinig of geen verschil.",
   "chapter": 3
  },
  {
   "start": 177.38,
   "end": 183.22,
   "text": "In tweeduizend vierentwintig werd ruim honderddrie miljoen kilo huishoudelijke apparaten weggegooid.",
   "chapter": 3
  },
  {
   "start": 183.22,
   "end": 191.91,
   "text": "De organisatie wil dat fabrikanten beter repareerbare apparaten maken, en dat de overheid met de sector een doel afspreekt voor het aandeel refurbished.",
   "chapter": 3
  },
  {
   "start": 194.24,
   "end": 200.72,
   "text": "In Engeland kan bijna een derde van de gemeenten de stroom afgedankte koelkasten en vriezers niet aan.",
   "chapter": 4
  },
  {
   "start": 200.72,
   "end": 207.68,
   "text": "Dat blijkt uit een enquête van de Engelse koepel van gemeenten onder honderddrieënvijftig gemeenten, meldt Letsrecycle.",
   "chapter": 4
  },
  {
   "start": 207.68,
   "end": 211.04,
   "text": "Negenentwintig procent kon niet aan de vraag voldoen.",
   "chapter": 4
  },
  {
   "start": 211.04,
   "end": 215.84,
   "text": "Sommige gemeenten melden een achterstand van drieduizend apparaten of meer.",
   "chapter": 4
  },
  {
   "start": 215.84,
   "end": 222.0,
   "text": "Van de gemeenten in problemen heeft drieënveertig procent de inzameling sinds juni tijdelijk stilgelegd.",
   "chapter": 4
  },
  {
   "start": 222.0,
   "end": 224.64,
   "text": "De oorzaak ligt vooral bij de verwerking.",
   "chapter": 4
  },
  {
   "start": 224.64,
   "end": 232.56,
   "text": "Negen op de tien gemeenten onder druk wijzen op minder verwerkingscapaciteit, en maar vier op de tien op meer aanbod van inwoners.",
   "chapter": 4
  },
  {
   "start": 232.56,
   "end": 237.52,
   "text": "Bijna de helft maakt extra kosten voor transport, opslag en personeel.",
   "chapter": 4
  },
  {
   "start": 237.52,
   "end": 243.04,
   "text": "Tweeënzeventig procent wil dat producenten voortaan de volledige kosten van verwerking dragen.",
   "chapter": 4
  },
  {
   "start": 243.04,
   "end": 246.63,
   "text": "De koepel vraagt de regering om snel meer verwerkingscapaciteit.",
   "chapter": 4
  },
  {
   "start": 248.97,
   "end": 251.77,
   "text": "En wat betekent dit voor uw organisatie?",
   "chapter": 5
  },
  {
   "start": 251.77,
   "end": 252.81,
   "text": "Twee dingen.",
   "chapter": 5
  },
  {
   "start": 252.81,
   "end": 258.25,
   "text": "Als afvalverbranding onder de emissiehandel komt, krijgt restafval een CO-twee-prijs.",
   "chapter": 5
  },
  {
   "start": 258.25,
   "end": 262.09,
   "text": "Wanneer dat gebeurt is nog onzeker, maar de richting is duidelijk.",
   "chapter": 5
  },
  {
   "start": 262.09,
   "end": 266.97,
   "text": "Elke kilo die u nu al uit het restafval houdt, drukt die toekomstige rekening.",
   "chapter": 5
  },
  {
   "start": 266.97,
   "end": 269.29,
   "text": "Het tweede punt gaat over apparaten.",
   "chapter": 5
  },
  {
   "start": 269.29,
   "end": 274.41,
   "text": "De Engelse koelkasten laten zien hoe kwetsbaar een keten is als de verwerking hapert.",
   "chapter": 5
  },
  {
   "start": 274.41,
   "end": 278.57,
   "text": "Bij De Graaf Groep zien we dat langer gebruiken de goedkoopste route blijft.",
   "chapter": 5
  },
  {
   "start": 278.57,
   "end": 284.07,
   "text": "Vraag daarom bij de inkoop van apparatuur naar reparatie, onderdelen en een refurbished alternatief.",
   "chapter": 5
  },
  {
   "start": 284.52,
   "end": 288.04,
   "text": "Het cijfer van de dag is zesenvijftig procent.",
   "chapter": 6
  },
  {
   "start": 288.04,
   "end": 294.44,
   "text": "Zo'n groot deel van de afgedankte huishoudelijke apparaten in Nederland wordt verbrand, meldt Natuur en Milieu.",
   "chapter": 6
  },
  {
   "start": 294.44,
   "end": 298.72,
   "text": "Daarmee gaan waardevolle materialen zoals aluminium en koper verloren.",
   "chapter": 6
  },
  {
   "start": 299.17,
   "end": 301.65,
   "text": "Dat was Grondstof voor vandaag.",
   "chapter": 7
  },
  {
   "start": 301.65,
   "end": 305.41,
   "text": "De bronnen bij elk bericht vindt u in de app en in de shownotes.",
   "chapter": 7
  },
  {
   "start": 305.41,
   "end": 307.65,
   "text": "Morgen om negen uur bent u weer bij.",
   "chapter": 7
  },
  {
   "start": 307.65,
   "end": 308.09,
   "text": "Tot dan.",
   "chapter": 7
  }
 ],
