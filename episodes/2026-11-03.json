 "transcript": [
  {
   "start": 5.5,
   "end": 6.54,
   "text": "Goedemorgen.",
   "chapter": 0
  },
  {
   "start": 6.54,
   "end": 8.74,
   "text": "Het is dinsdag drie november.",
   "chapter": 0
  },
  {
   "start": 8.74,
   "end": 13.1,
   "text": "U luistert naar Grondstof, het circulaire nieuwsbulletin van De Graaf Groep.",
   "chapter": 0
  },
  {
   "start": 13.1,
   "end": 14.7,
   "text": "Ik ben Frans van den Berge.",
   "chapter": 0
  },
  {
   "start": 14.7,
   "end": 16.14,
   "text": "Dit zijn de koppen.",
   "chapter": 0
  },
  {
   "start": 16.14,
   "end": 21.26,
   "text": "Het Circulair Materialenplan wordt voor het eerst aangepast en u kunt reageren.",
   "chapter": 0
  },
  {
   "start": 21.26,
   "end": 25.42,
   "text": "In het Belgische Lommel opent een nieuwe fabriek voor verpakkingsplastic.",
   "chapter": 0
  },
  {
   "start": 25.42,
   "end": 30.04,
   "text": "En investeerder Main Capital neemt softwarebedrijf Twenty-one South over.",
   "chapter": 0
  },
  {
   "start": 32.38,
   "end": 40.46,
   "text": "De minister van Klimaat en Groene Groei heeft de eerste wijziging van de toetsingskaders van het Circulair Materialenplan ter inzage gelegd.",
   "chapter": 1
  },
  {
   "start": 40.46,
   "end": 42.78,
   "text": "Dat meldt Afvalgids vandaag.",
   "chapter": 1
  },
  {
   "start": 42.78,
   "end": 49.5,
   "text": "Het plan bepaalt hoe overheden omgaan met secundaire grondstoffen, zoals bodemassen uit afvalverbranding.",
   "chapter": 1
  },
  {
   "start": 49.5,
   "end": 53.9,
   "text": "De voorstellen schrappen de oproep tegen generieke lokale beperkingen.",
   "chapter": 1
  },
  {
   "start": 53.9,
   "end": 59.26,
   "text": "Ook worden de overgangstermijnen voor bodemassen verlengd, en er komen verduidelijkingen.",
   "chapter": 1
  },
  {
   "start": 59.26,
   "end": 64.94,
   "text": "Reageren kan van drie november tot en met veertien december via de inspraakprocedure.",
   "chapter": 1
  },
  {
   "start": 64.94,
   "end": 71.74,
   "text": "Het doet ertoe, omdat deze kaders bepalen hoeveel ruimte bedrijven krijgen om secundaire bouwstoffen in te zetten.",
   "chapter": 1
  },
  {
   "start": 71.74,
   "end": 78.31,
   "text": "Wie met zulke materialen werkt, kan nu invloed uitoefenen op de spelregels, voordat ze definitief worden vastgesteld.",
   "chapter": 1
  },
  {
   "start": 80.64,
   "end": 88.24,
   "text": "Morssinkhof-Rymoplast heeft vrijdag dertig oktober officieel een nieuwe recyclingfabriek geopend in het Belgische Lommel.",
   "chapter": 2
  },
  {
   "start": 88.24,
   "end": 94.88,
   "text": "Dat blijkt uit een persbericht van Fost Plus, de organisatie die in België verpakkingsafval laat inzamelen.",
   "chapter": 2
  },
  {
   "start": 94.88,
   "end": 97.92,
   "text": "De investering bedraagt dertig miljoen euro.",
   "chapter": 2
  },
  {
   "start": 97.92,
   "end": 102.72,
   "text": "De fabriek kan per jaar tot veertigduizend ton plastic verpakkingen verwerken.",
   "chapter": 2
  },
  {
   "start": 102.72,
   "end": 108.8,
   "text": "Daarvan levert Fost Plus vierentwintigduizend ton uit de blauwe zak, en dat voor negen jaar.",
   "chapter": 2
  },
  {
   "start": 108.8,
   "end": 114.4,
   "text": "Het gaat om boterbakjes, yoghurtpotten en flessen voor melk, shampoo en wasmiddel.",
   "chapter": 2
  },
  {
   "start": 114.4,
   "end": 121.6,
   "text": "Na het sorteren op soort en kleur wordt het plastic gemalen en gewassen tot hoogwaardig materiaal voor nieuwe verpakkingen.",
   "chapter": 2
  },
  {
   "start": 121.6,
   "end": 124.8,
   "text": "Op termijn komen er vijfenzestig banen.",
   "chapter": 2
  },
  {
   "start": 124.8,
   "end": 130.32,
   "text": "Het doet ertoe, omdat Europese recyclingcapaciteit voor verpakkingsplastic zo groeit.",
   "chapter": 2
  },
  {
   "start": 130.32,
   "end": 135.11,
   "text": "Daarmee blijft meer plastic uit de verbrandingsoven en meer grondstof binnen de regio.",
   "chapter": 2
  },
  {
   "start": 137.45,
   "end": 141.69,
   "text": "Main Capital Partners neemt een meerderheidsbelang in Twenty-one South.",
   "chapter": 3
  },
  {
   "start": 141.69,
   "end": 143.85,
   "text": "Dat meldt Afvalgids vandaag.",
   "chapter": 3
  },
  {
   "start": 143.85,
   "end": 148.25,
   "text": "Main Capital is een Haagse investeerder in zakelijke softwarebedrijven.",
   "chapter": 3
  },
  {
   "start": 148.25,
   "end": 152.33,
   "text": "Twenty-one South levert software aan de afval en milieusector.",
   "chapter": 3
  },
  {
   "start": 152.33,
   "end": 159.17,
   "text": "Het belangrijkste product is een platform waarmee afvalinzamelaars en recyclingbedrijven hun bedrijfsprocessen beheren.",
   "chapter": 3
  },
  {
   "start": 159.17,
   "end": 163.77,
   "text": "Meer dan drieduizend driehonderd gebruikers werken ermee, aldus Afvalgids.",
   "chapter": 3
  },
  {
   "start": 163.77,
   "end": 170.97,
   "text": "Met de investering wil het bedrijf zijn marktpositie versterken, het platform sneller ontwikkelen en de dienstverlening uitbreiden.",
   "chapter": 3
  },
  {
   "start": 170.97,
   "end": 173.93,
   "text": "Over de overnamesom is niets bekendgemaakt.",
   "chapter": 3
  },
  {
   "start": 173.93,
   "end": 181.57,
   "text": "Het doet ertoe, omdat ook de software achter transportplanning, afvalregistratie en facturatie in de sector in handen van investeerders komt.",
   "chapter": 3
  },
  {
   "start": 183.9,
   "end": 190.22,
   "text": "De recyclebijdrage voor isolatieglas gaat per een januari tweeduizend zevenentwintig omhoog.",
   "chapter": 4
  },
  {
   "start": 190.22,
   "end": 194.46,
   "text": "Dat meldt Afvalgids, en Glas in Beeld berichtte er vandaag over.",
   "chapter": 4
  },
  {
   "start": 194.46,
   "end": 203.82,
   "text": "Stichting VlakglasRecyclingNederland verhoogt de bijdrage van nul komma nul één zeven vijf euro naar nul komma nul twee euro per kilo.",
   "chapter": 4
  },
  {
   "start": 203.82,
   "end": 208.54,
   "text": "Ook de huurprijzen van glascontainers stijgen, maar bedragen worden niet genoemd.",
   "chapter": 4
  },
  {
   "start": 208.54,
   "end": 215.98,
   "text": "De stichting wijst op hogere kosten voor inzameling, transport en recycling, en op nieuwe administratieve verplichtingen.",
   "chapter": 4
  },
  {
   "start": 215.98,
   "end": 219.1,
   "text": "Het besluit werd al begin oktober bekendgemaakt.",
   "chapter": 4
  },
  {
   "start": 219.1,
   "end": 224.68,
   "text": "Het doet ertoe, omdat producenten en importeurs van isolatieglas deze kosten moeten inkalkuleren.",
   "chapter": 4
  },
  {
   "start": 227.02,
   "end": 229.9,
   "text": "En wat betekent dit voor uw organisatie?",
   "chapter": 5
  },
  {
   "start": 229.9,
   "end": 230.94,
   "text": "Drie dingen.",
   "chapter": 5
  },
  {
   "start": 230.94,
   "end": 234.86,
   "text": "Ten eerste de inspraak over het Circulair Materialenplan.",
   "chapter": 5
  },
  {
   "start": 234.86,
   "end": 241.66,
   "text": "Werkt u met secundaire bouwstoffen, dan loont het om voor veertien december te kijken of de voorstellen uw praktijk raken.",
   "chapter": 5
  },
  {
   "start": 241.66,
   "end": 243.5,
   "text": "Ten tweede de kosten.",
   "chapter": 5
  },
  {
   "start": 243.5,
   "end": 250.14,
   "text": "De bijdrage voor isolatieglas stijgt, en transport en administratie wegen steeds zwaarder in recycling.",
   "chapter": 5
  },
  {
   "start": 250.14,
   "end": 253.74,
   "text": "Vraag uw leveranciers dus tijdig naar de tarieven voor volgend jaar.",
   "chapter": 5
  },
  {
   "start": 253.74,
   "end": 256.46,
   "text": "Ten derde de recyclingcapaciteit.",
   "chapter": 5
  },
  {
   "start": 256.46,
   "end": 261.66,
   "text": "Nieuwe fabrieken in Europa vergroten de kans dat verpakkingsplastic hier hoogwaardig terugkomt.",
   "chapter": 5
  },
  {
   "start": 261.66,
   "end": 269.26,
   "text": "Bij De Graaf Groep zien wij dat organisaties die hun afvalstromen scheiden en vastleggen, het beste kunnen sturen op kosten en kwaliteit.",
   "chapter": 5
  },
  {
   "start": 269.71,
   "end": 272.91,
   "text": "Het cijfer van de dag is veertigduizend.",
   "chapter": 6
  },
  {
   "start": 272.91,
   "end": 277.87,
   "text": "Zoveel ton plastic verpakkingen kan de nieuwe fabriek in Lommel per jaar verwerken.",
   "chapter": 6
  },
  {
   "start": 277.87,
   "end": 282.15,
   "text": "Meer dan de helft daarvan, vierentwintigduizend ton, komt van Fost Plus.",
   "chapter": 6
  },
  {
   "start": 282.6,
   "end": 284.92,
   "text": "Dat was Grondstof voor vandaag.",
   "chapter": 7
  },
  {
   "start": 284.92,
   "end": 288.6,
   "text": "De bronnen bij elk bericht vindt u in de app en in de shownotes.",
   "chapter": 7
  },
  {
   "start": 288.6,
   "end": 290.92,
   "text": "Morgen om negen uur bent u weer bij.",
   "chapter": 7
  },
  {
   "start": 290.92,
   "end": 291.48,
   "text": "Tot dan.",
   "chapter": 7
  }
 ],
