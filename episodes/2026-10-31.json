 "transcript": [
  {
   "start": 5.5,
   "end": 6.54,
   "text": "Goedemorgen.",
   "chapter": 0
  },
  {
   "start": 6.54,
   "end": 8.98,
   "text": "Het is zaterdag eenendertig oktober.",
   "chapter": 0
  },
  {
   "start": 8.98,
   "end": 13.26,
   "text": "U luistert naar Grondstof, het circulaire nieuwsbulletin van De Graaf Groep.",
   "chapter": 0
  },
  {
   "start": 13.26,
   "end": 14.82,
   "text": "Ik ben Frans van den Berge.",
   "chapter": 0
  },
  {
   "start": 14.82,
   "end": 16.3,
   "text": "Dit zijn de koppen.",
   "chapter": 0
  },
  {
   "start": 16.3,
   "end": 21.02,
   "text": "Investeerder Waterland neemt de helft van afvalbedrijf Milieu Service Groep.",
   "chapter": 0
  },
  {
   "start": 21.02,
   "end": 25.42,
   "text": "Beleggers vragen ruimte bij de Europese rapportage over duurzaamheid.",
   "chapter": 0
  },
  {
   "start": 25.42,
   "end": 30.87,
   "text": "En Bee Em Wee wil dat de helft van elke nieuwe auto uit gerecycled materiaal bestaat.",
   "chapter": 0
  },
  {
   "start": 33.21,
   "end": 42.49,
   "text": "Beleggersvereniging Eumedion wil dat grote bedrijven van buiten de Europese Unie zelf mogen kiezen hoe breed zij rapporteren over duurzaamheid.",
   "chapter": 1
  },
  {
   "start": 42.49,
   "end": 49.85,
   "text": "Dat staat in de reactie die Eumedion op dertig oktober indiende bij de Europese adviesorganisatie voor verslaggeving.",
   "chapter": 1
  },
  {
   "start": 49.85,
   "end": 54.41,
   "text": "Het gaat om een conceptstandaard voor grote ondernemingen van buiten de Unie.",
   "chapter": 1
  },
  {
   "start": 54.41,
   "end": 63.37,
   "text": "Zij mogen volgens Eumedion kiezen tussen wereldwijd rapporteren, rapporteren voor Europa, of een onderbouwde mix per onderwerp.",
   "chapter": 1
  },
  {
   "start": 63.37,
   "end": 68.89,
   "text": "Over die mix heeft Eumedion bedenkingen, omdat bedrijven dan lastiger te vergelijken zijn.",
   "chapter": 1
  },
  {
   "start": 68.89,
   "end": 74.33,
   "text": "De keuze moet rusten op een gedegen analyse van de effecten en controleerbaar zijn.",
   "chapter": 1
  },
  {
   "start": 74.33,
   "end": 78.89,
   "text": "Ook moet de standaard zo veel mogelijk aansluiten op internationale standaarden.",
   "chapter": 1
  },
  {
   "start": 78.89,
   "end": 82.41,
   "text": "Zo kunnen bedrijven bestaande gegevens hergebruiken.",
   "chapter": 1
  },
  {
   "start": 82.41,
   "end": 88.91,
   "text": "Het doet ertoe voor inkopers, omdat zulke regels bepalen welke gegevens grote leveranciers straks moeten leveren.",
   "chapter": 1
  },
  {
   "start": 91.24,
   "end": 97.32,
   "text": "Investeerder Waterland Private Equity neemt een belang van vijftig procent in Milieu Service Groep.",
   "chapter": 2
  },
  {
   "start": 97.32,
   "end": 100.2,
   "text": "Dat meldt Afvalgids op dertig oktober.",
   "chapter": 2
  },
  {
   "start": 100.2,
   "end": 103.08,
   "text": "De huidige aandeelhouders houden de andere helft.",
   "chapter": 2
  },
  {
   "start": 103.08,
   "end": 107.64,
   "text": "De investering moet de groei van het bedrijf in Nederland en Duitsland versnellen.",
   "chapter": 2
  },
  {
   "start": 107.64,
   "end": 112.76,
   "text": "Milieu Service Groep houdt zich bezig met inzameling, recycling en afvalbeheer.",
   "chapter": 2
  },
  {
   "start": 112.76,
   "end": 118.84,
   "text": "Het bedrijf heeft ongeveer vierhonderd medewerkers en een omzet van circa honderdzestig miljoen euro.",
   "chapter": 2
  },
  {
   "start": 118.84,
   "end": 128.52,
   "text": "Onder de groep vallen Milieu Service Nederland, Paridon Containers, TH Containers en het Duitse Lins Recycling, dat de groep onlangs overnam.",
   "chapter": 2
  },
  {
   "start": 128.52,
   "end": 131.24,
   "text": "Financiële details zijn niet bekendgemaakt.",
   "chapter": 2
  },
  {
   "start": 131.24,
   "end": 135.4,
   "text": "De transactie moet nog worden goedgekeurd door de mededingingsautoriteiten.",
   "chapter": 2
  },
  {
   "start": 135.4,
   "end": 140.17,
   "text": "Het doet ertoe, omdat een nieuwe aandeelhouder ook de koers van een afvalpartner kan veranderen.",
   "chapter": 2
  },
  {
   "start": 142.51,
   "end": 150.03,
   "text": "Het Barneveldse bedrijf PaperFoam krijgt een lening van twee miljoen euro van Invest International, de staatsinvesteerder.",
   "chapter": 3
  },
  {
   "start": 150.03,
   "end": 153.71,
   "text": "Dat meldt Duurzaam Ondernemen op negenentwintig oktober.",
   "chapter": 3
  },
  {
   "start": 153.71,
   "end": 160.99,
   "text": "Het geld gaat naar uitbreiding van de fabriek in Tsjechië en naar werkkapitaal voor de fabrieken in Maleisië en de Verenigde Staten.",
   "chapter": 3
  },
  {
   "start": 160.99,
   "end": 164.99,
   "text": "PaperFoam maakt verpakkingen van zetmeel en natuurlijke vezels.",
   "chapter": 3
  },
  {
   "start": 164.99,
   "end": 169.55,
   "text": "De verpakking is composteerbaar en de vezels zijn te recyclen tot papier.",
   "chapter": 3
  },
  {
   "start": 169.55,
   "end": 173.15,
   "text": "Klanten zijn onder meer Puig, Hema en Medtronic.",
   "chapter": 3
  },
  {
   "start": 173.15,
   "end": 180.35,
   "text": "Volgens investeringsdirecteur Jeroen Plag zien traditionele financiers de volgende groeifase nog als te risicovol.",
   "chapter": 3
  },
  {
   "start": 180.35,
   "end": 184.8,
   "text": "Het doet ertoe, omdat jonge verpakkingsbedrijven in die fase moeilijk aan geld komen.",
   "chapter": 3
  },
  {
   "start": 187.13,
   "end": 195.45,
   "text": "Autofabrikant Bee Em Wee wil dat in tweeduizend dertig minstens de helft van elke nieuwe auto uit gerecycled materiaal bestaat.",
   "chapter": 4
  },
  {
   "start": 195.45,
   "end": 197.85,
   "text": "Nu is dat ongeveer een derde.",
   "chapter": 4
  },
  {
   "start": 197.85,
   "end": 206.57,
   "text": "Dat zei technologiechef Franz Geyer op een congres over batterijrecycling in Berlijn, meldt Recycling Magazine op negenentwintig oktober.",
   "chapter": 4
  },
  {
   "start": 206.57,
   "end": 213.21,
   "text": "Het gaat om lithium, kobalt en grafiet uit afval van de batterijproductie en uit complete cellen.",
   "chapter": 4
  },
  {
   "start": 213.21,
   "end": 219.69,
   "text": "Daarvoor gebruikt het bedrijf directe recycling, zonder energievretende thermische of chemische processen.",
   "chapter": 4
  },
  {
   "start": 219.69,
   "end": 227.37,
   "text": "Het grootste onderzoekscentrum voor celrecycling staat in het Beierse Salching en kreeg tien miljoen euro aan investeringsgeld.",
   "chapter": 4
  },
  {
   "start": 227.37,
   "end": 234.49,
   "text": "Geyer schat dat ongeveer zeventig procent van de waarde van batterijgerelateerde materiaalstromen Europa verlaat.",
   "chapter": 4
  },
  {
   "start": 234.49,
   "end": 239.38,
   "text": "Het doet ertoe, omdat grote afnemers zo de vraag naar gerecycled materiaal vergroten.",
   "chapter": 4
  },
  {
   "start": 241.72,
   "end": 244.52,
   "text": "En wat betekent dit voor uw organisatie?",
   "chapter": 5
  },
  {
   "start": 244.52,
   "end": 245.48,
   "text": "Drie dingen.",
   "chapter": 5
  },
  {
   "start": 245.48,
   "end": 252.12,
   "text": "Ten eerste vragen grote afnemers steeds vaker om gegevens over herkomst en gerecycled gehalte.",
   "chapter": 5
  },
  {
   "start": 252.12,
   "end": 254.68,
   "text": "Begin daarom bij uw afvalstromen.",
   "chapter": 5
  },
  {
   "start": 254.68,
   "end": 260.04,
   "text": "Weet welke fracties u heeft, hoeveel er gescheiden wordt en wat er met het materiaal gebeurt.",
   "chapter": 5
  },
  {
   "start": 260.04,
   "end": 263.88,
   "text": "Ten tweede wisselen bedrijven in de afvalmarkt van eigenaar.",
   "chapter": 5
  },
  {
   "start": 263.88,
   "end": 267.72,
   "text": "Kijk dus op tijd naar looptijd en voorwaarden van uw afvalcontract.",
   "chapter": 5
  },
  {
   "start": 267.72,
   "end": 272.92,
   "text": "Ten derde laat Bee Em Wee zien dat gerecycled gehalte een inkoopeis kan worden.",
   "chapter": 5
  },
  {
   "start": 272.92,
   "end": 278.36,
   "text": "Vraag leveranciers naar het aandeel gerecycled materiaal en leg het vast in uw inkoopbeleid.",
   "chapter": 5
  },
  {
   "start": 278.36,
   "end": 283.29,
   "text": "Bij De Graaf Groep zien wij dat organisaties met goede afvaldata sneller kunnen verduurzamen.",
   "chapter": 5
  },
  {
   "start": 283.74,
   "end": 286.94,
   "text": "Het cijfer van de dag is vijftig procent.",
   "chapter": 6
  },
  {
   "start": 286.94,
   "end": 292.66,
   "text": "Zoveel gerecycled materiaal wil Bee Em Wee in tweeduizend dertig in elke nieuwe auto hebben.",
   "chapter": 6
  },
  {
   "start": 292.66,
   "end": 294.78,
   "text": "Nu is dat ongeveer een derde.",
   "chapter": 6
  },
  {
   "start": 294.78,
   "end": 298.2,
   "text": "Dat vraagt om een stabiele aanvoer van goed gescheiden grondstoffen.",
   "chapter": 6
  },
  {
   "start": 298.65,
   "end": 301.05,
   "text": "Dat was Grondstof voor vandaag.",
   "chapter": 7
  },
  {
   "start": 301.05,
   "end": 304.81,
   "text": "De bronnen bij elk bericht vindt u in de app en in de shownotes.",
   "chapter": 7
  },
  {
   "start": 304.81,
   "end": 307.21,
   "text": "Morgen om negen uur bent u weer bij.",
   "chapter": 7
  },
  {
   "start": 307.21,
   "end": 307.61,
   "text": "Tot dan.",
   "chapter": 7
  }
 ],
