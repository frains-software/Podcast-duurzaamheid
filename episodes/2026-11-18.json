 "transcript": [
  {
   "start": 5.5,
   "end": 6.54,
   "text": "Goedemorgen.",
   "chapter": 0
  },
  {
   "start": 6.54,
   "end": 8.78,
   "text": "Het is woensdag achttien november.",
   "chapter": 0
  },
  {
   "start": 8.78,
   "end": 13.18,
   "text": "U luistert naar Grondstof, het circulaire nieuwsbulletin van De Graaf Groep.",
   "chapter": 0
  },
  {
   "start": 13.18,
   "end": 14.74,
   "text": "Ik ben Frans van den Berge.",
   "chapter": 0
  },
  {
   "start": 14.74,
   "end": 16.3,
   "text": "Dit zijn de koppen.",
   "chapter": 0
  },
  {
   "start": 16.3,
   "end": 21.38,
   "text": "Vanaf zaterdag mag Europa veel minder plastic afval naar het buitenland sturen.",
   "chapter": 0
  },
  {
   "start": 21.38,
   "end": 25.86,
   "text": "Renewi gaat het vertrouwelijke papier van de Rijksoverheid inzamelen.",
   "chapter": 0
  },
  {
   "start": 25.86,
   "end": 31.18,
   "text": "En inwoners van Urk betalen vanaf volgend jaar per keer dat ze restafval aanbieden.",
   "chapter": 0
  },
  {
   "start": 33.52,
   "end": 44.64,
   "text": "Vanaf zaterdag eenentwintig november mag de Europese Unie geen plastic afval meer uitvoeren naar landen die geen lid zijn van de Organisatie voor Economische Samenwerking en Ontwikkeling.",
   "chapter": 1
  },
  {
   "start": 44.64,
   "end": 50.24,
   "text": "Dat staat in de vernieuwde Europese verordening voor afvaltransport, meldt de Europese Commissie.",
   "chapter": 1
  },
  {
   "start": 50.24,
   "end": 55.52,
   "text": "De Unie voerde vorig jaar ongeveer een komma vier miljoen ton plastic afval uit.",
   "chapter": 1
  },
  {
   "start": 55.52,
   "end": 59.36,
   "text": "Ongeveer de helft daarvan ging naar landen buiten die organisatie.",
   "chapter": 1
  },
  {
   "start": 59.36,
   "end": 63.6,
   "text": "Belangrijke bestemmingen waren Maleisië, Indonesië en Vietnam.",
   "chapter": 1
  },
  {
   "start": 63.6,
   "end": 67.84,
   "text": "De grootste afnemer is Turkije, met vijfhonderdtienduizend ton.",
   "chapter": 1
  },
  {
   "start": 67.84,
   "end": 71.36,
   "text": "Turkije is wel lid en valt dus niet onder het verbod.",
   "chapter": 1
  },
  {
   "start": 71.36,
   "end": 80.88,
   "text": "Voor andere soorten afval volgt in mei tweeduizend zevenentwintig een vergelijkbare regel, met uitzonderingen voor landen die aantonen dat ze het afval goed verwerken.",
   "chapter": 1
  },
  {
   "start": 80.88,
   "end": 85.05,
   "text": "Het gevolg is dat meer plastic afval binnen Europa een bestemming moet vinden.",
   "chapter": 1
  },
  {
   "start": 87.38,
   "end": 92.34,
   "text": "Renewi gaat het vertrouwelijke papier van de Rijksoverheid inzamelen en verwerken.",
   "chapter": 2
  },
  {
   "start": 92.34,
   "end": 96.26,
   "text": "Het afvalbedrijf won daarvoor een aanbesteding, meldt Afvalgids.",
   "chapter": 2
  },
  {
   "start": 96.26,
   "end": 100.42,
   "text": "Het contract loopt vier jaar, met een mogelijke verlenging van één jaar.",
   "chapter": 2
  },
  {
   "start": 100.42,
   "end": 104.58,
   "text": "Het gaat om ongeveer achthonderdvijftig locaties in heel Nederland.",
   "chapter": 2
  },
  {
   "start": 104.58,
   "end": 110.34,
   "text": "Daaronder zijn de Belastingdienst, Defensie en het Centraal Orgaan opvang asielzoekers.",
   "chapter": 2
  },
  {
   "start": 110.34,
   "end": 117.38,
   "text": "Jaarlijks gaat het om zo'n drieduizend honderd ton vertrouwelijk papier en achttienhonderd ton gewoon papier en karton.",
   "chapter": 2
  },
  {
   "start": 117.38,
   "end": 123.86,
   "text": "Renewi zet ongeveer negenduizend tweehonderd containers neer, deels met elektronisch beveiligde sloten.",
   "chapter": 2
  },
  {
   "start": 123.86,
   "end": 128.1,
   "text": "De opdracht is gegund op de beste verhouding tussen prijs en kwaliteit.",
   "chapter": 2
  },
  {
   "start": 128.1,
   "end": 131.7,
   "text": "Het papier wordt waar mogelijk hoogwaardig gerecycled.",
   "chapter": 2
  },
  {
   "start": 131.7,
   "end": 138.62,
   "text": "Volgens het ministerie van Financiën combineert de opdracht een veilige omgang met informatie en duurzaam grondstoffengebruik.",
   "chapter": 2
  },
  {
   "start": 140.96,
   "end": 147.36,
   "text": "Microsoft heeft gisteren toegelicht waarom het via zijn klimaatfonds investeert in Cyclic Materials.",
   "chapter": 3
  },
  {
   "start": 147.36,
   "end": 153.36,
   "text": "Dat bedrijf wint zeldzame aardmetalen terug uit afgedankte producten, zoals harde schijven.",
   "chapter": 3
  },
  {
   "start": 153.36,
   "end": 158.64,
   "text": "Bij traditionele afvalverwerking gaan die metalen vaak verloren, schrijft Microsoft.",
   "chapter": 3
  },
  {
   "start": 158.64,
   "end": 167.76,
   "text": "In september opende Cyclic in Mesa, in de Amerikaanse staat Arizona, zijn eerste fabriek op commerciële schaal voor het recyclen van magneten.",
   "chapter": 3
  },
  {
   "start": 167.76,
   "end": 173.44,
   "text": "Die kan jaarlijks tot vijfentwintigduizend ton afgedankte producten met magneten verwerken.",
   "chapter": 3
  },
  {
   "start": 173.44,
   "end": 176.56,
   "text": "Eerst wordt het magneetmateriaal mechanisch gescheiden.",
   "chapter": 3
  },
  {
   "start": 176.56,
   "end": 182.16,
   "text": "Daarna worden de zeldzame aardmetalen teruggewonnen voor nieuwe permanente magneten.",
   "chapter": 3
  },
  {
   "start": 182.16,
   "end": 187.52,
   "text": "In South Carolina komt een tweede locatie, die in tweeduizend achtentwintig moet opengaan.",
   "chapter": 3
  },
  {
   "start": 187.52,
   "end": 190.24,
   "text": "Daar ontstaan meer dan negentig banen.",
   "chapter": 3
  },
  {
   "start": 190.24,
   "end": 193.34,
   "text": "Hoeveel Microsoft investeert, maakt het bedrijf niet bekend.",
   "chapter": 3
  },
  {
   "start": 195.67,
   "end": 201.26,
   "text": "Inwoners van Urk betalen vanaf volgend jaar voor elke keer dat ze restafval aanbieden.",
   "chapter": 4
  },
  {
   "start": 201.26,
   "end": 204.54,
   "text": "Dat heeft de gemeenteraad besloten, meldt de gemeente.",
   "chapter": 4
  },
  {
   "start": 204.54,
   "end": 209.14,
   "text": "Elk huishouden betaalt een vast bedrag van driehonderdvijftig euro per jaar.",
   "chapter": 4
  },
  {
   "start": 209.14,
   "end": 214.25,
   "text": "Daarbovenop komt zeven euro per lediging van een container van honderdveertig liter.",
   "chapter": 4
  },
  {
   "start": 214.25,
   "end": 218.65,
   "text": "Voor een container van tweehonderdveertig liter is dat elf euro vijftig.",
   "chapter": 4
  },
  {
   "start": 218.65,
   "end": 223.06,
   "text": "Bij een ondergrondse container kost het één of twee euro per keer.",
   "chapter": 4
  },
  {
   "start": 223.06,
   "end": 229.94,
   "text": "De heffing stijgt vooral omdat de gemeente de kosten straks volledig dekt, in plaats van voor negenenzeventig procent.",
   "chapter": 4
  },
  {
   "start": 229.94,
   "end": 233.3,
   "text": "Ook de hogere belasting op restafval speelt mee.",
   "chapter": 4
  },
  {
   "start": 233.3,
   "end": 241.02,
   "text": "De Tweede Kamer nam het Belastingplan voor tweeduizend zevenentwintig aan zonder de afvalheffingen te wijzigen, meldt Afvalgids.",
   "chapter": 4
  },
  {
   "start": 241.02,
   "end": 248.62,
   "text": "Volgens de Vereniging Afvalbedrijven betekent dat een lastenverzwaring van vierhonderdachtennegentig miljoen euro per jaar voor de sector.",
   "chapter": 4
  },
  {
   "start": 250.96,
   "end": 253.84,
   "text": "En wat betekent dit voor uw organisatie?",
   "chapter": 5
  },
  {
   "start": 253.84,
   "end": 257.52,
   "text": "Afval is steeds meer een kostenpost die u zelf kunt sturen.",
   "chapter": 5
  },
  {
   "start": 257.52,
   "end": 260.56,
   "text": "Wie minder restafval aanbiedt, betaalt minder.",
   "chapter": 5
  },
  {
   "start": 260.56,
   "end": 265.04,
   "text": "Bij De Graaf Groep zien we dat goed scheiden aan de bron daarbij het grootste verschil maakt.",
   "chapter": 5
  },
  {
   "start": 265.04,
   "end": 272.48,
   "text": "Het exportverbod voor plastic maakt schone stromen nog belangrijker, want Europese recyclers hebben zuiver materiaal nodig.",
   "chapter": 5
  },
  {
   "start": 272.48,
   "end": 279.44,
   "text": "En de opdracht van de Rijksoverheid laat zien dat inkopers veilige vernietiging en recycling in één contract kunnen vragen.",
   "chapter": 5
  },
  {
   "start": 279.44,
   "end": 281.6,
   "text": "Dat kan ook bij uw eigen papierstroom.",
   "chapter": 5
  },
  {
   "start": 282.05,
   "end": 285.25,
   "text": "Het cijfer van de dag is één miljoen.",
   "chapter": 6
  },
  {
   "start": 285.25,
   "end": 291.97,
   "text": "Zoveel statiegeldblikjes zijn ingeleverd bij de automaat van een tuincentrum in Edam, meldt de Stadskrant.",
   "chapter": 6
  },
  {
   "start": 291.97,
   "end": 294.21,
   "text": "Die automaat staat er nog geen jaar.",
   "chapter": 6
  },
  {
   "start": 294.21,
   "end": 297.59,
   "text": "Volgens de leverancier zorgt hij vooral voor minder zwerfafval.",
   "chapter": 6
  },
  {
   "start": 298.04,
   "end": 300.36,
   "text": "Dat was Grondstof voor vandaag.",
   "chapter": 7
  },
  {
   "start": 300.36,
   "end": 304.12,
   "text": "De bronnen bij elk bericht vindt u in de app en in de shownotes.",
   "chapter": 7
  },
  {
   "start": 304.12,
   "end": 306.44,
   "text": "Morgen om negen uur bent u weer bij.",
   "chapter": 7
  },
  {
   "start": 306.44,
   "end": 306.9,
   "text": "Tot dan.",
   "chapter": 7
  }
 ],
